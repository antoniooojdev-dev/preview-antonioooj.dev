---
// /pruebas-servicio-fivem — propuesta de diseño distinto para /servicios/fivem.
// Mismos datos que la página real (services.ts, scripts-fivem.ts, policia.ts, bandas.ts),
// otra forma de contarlo:
//   1. portada partida: titular grande + pila de capturas que va rotando sola
//   3. «lo último»: el script nuevo a sangre, captura de fondo y caja de compra
//   4. catálogo en tarjetas anchas con captura, alternando lado
//   (todos los scripts van en español e inglés: chips ES / EN)
//   5. características como un «resmon» (monitor de recursos de FiveM)
//   6. «hecho o a medida»: selector que cambia entre el escaparate y la ruta del encargo
//   7. dudas: lista de preguntas + un chat que las va respondiendo, y cierre en color con botón «imán»
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icono from "@/components/servicios/Icono.astro";
import { services, serviceDetails } from "@/data/services";
import { scriptsFivem } from "@/data/scripts-fivem";
import { policia } from "@/data/policia";
import { bandas } from "@/data/bandas";
import logoMask from "@/assets/logo-mask.png";

const service = services.find((s) => s.id === "fivem")!;
const detail = serviceDetails.fivem;
const contacto = `/contacto?tipo=${encodeURIComponent(detail.tipo)}`;

// precio de los que se venden en Tebex (los demás llevan a su ficha)
const precios: Record<string, { precio: number; antes?: number; descuento?: number }> = {
  policia: { precio: policia.precio, antes: policia.precioAntes, descuento: policia.descuento },
  "sistema-bandas": { precio: bandas.precio, antes: bandas.precioAntes, descuento: bandas.descuento },
};
const euros = (n: number) => `${n.toLocaleString("es-ES", { minimumFractionDigits: Number.isInteger(n) ? 0 : 2, maximumFractionDigits: 2 })} €`;

const lista = [...scriptsFivem].sort(
  (a, b) => Number(a.estado === "desarrollo") - Number(b.estado === "desarrollo") || Number(!!b.nuevo) - Number(!!a.nuevo),
);
const destacado = lista.find((s) => s.nuevo && s.portada) ?? lista[0];
const pDest = precios[destacado.id];
// todos los scripts vienen traducidos al español y al inglés
const idiomas = [
  { c: "ES", t: "Español" },
  { c: "EN", t: "English" },
];

// pila de capturas de la portada: los disponibles con captura, el destacado delante
const pila = [destacado, ...lista.filter((s) => s.portada && s.id !== destacado.id)].slice(0, 3);

// «resmon»: cada característica como un recurso del monitor
const resmon = detail.incluye.map((x, i) => ({
  ...x,
  ms: x.icono === "zap" ? "0.00" : (0.01 * ((i % 3) + 1)).toFixed(2),
  mem: `${(1.2 + i * 0.37).toFixed(2)} MiB`,
}));

---

<BaseLayout title="Pruebas · Scripts FiveM" description="Propuesta de diseño para la página de Scripts FiveM." noindex>
  <article class="fx" style={`--acc:${detail.color}`}>
    <!-- 1. portada -->
    <header class="fx-hero ink">
      <div class="fx-hero__grid" aria-hidden="true"></div>
      <div class="container fx-hero__in">
        <div class="fx-hero__txt">
          <h1>
            Scripts que tu servidor <em>todavía</em> no tiene.
          </h1>
          <p class="fx-lead">{detail.lead}</p>
          <div class="fx-actions">
            <a href="#catalogo" class="btn btn-primary">Ver los scripts</a>
            <a href={contacto} class="btn btn-ghost">Encargar uno a medida</a>
          </div>
          <p class="fx-hero__idiomas mono">
            {idiomas.map((l) => <span><b>{l.c}</b> {l.t}</span>)}
            <span class="fx-hero__idiomas-t">todos los scripts, en los dos idiomas</span>
          </p>
        </div>

        <!-- pila de capturas: la de delante cambia sola; se puede pulsar -->
        <div class="fx-pila" data-pila>
          {
            pila.map((s, i) => (
              <a href={`/servicios/fivem/${s.id}`} class="fx-pila__c" data-pos={i} aria-label={s.nombre} tabindex={i === 0 ? 0 : -1}>
                <img src={s.portada} alt="" width="1920" height="1080" loading={i === 0 ? "eager" : "lazy"} />
                <span class="fx-pila__pie">
                  <span class="fx-pila__ico" aria-hidden="true">
                    <Icono nombre={s.icono} size={16} />
                  </span>
                  <span>
                    <b>{s.nombre}</b>
                    <small class="mono">{s.categoria}</small>
                  </span>
                  {precios[s.id] && <span class="fx-pila__precio">{euros(precios[s.id].precio)}</span>}
                </span>
              </a>
            ))
          }
          <span class="fx-pila__puntos" aria-hidden="true">
            {pila.map((_, i) => <i class:list={{ "is-on": i === 0 }} />)}
          </span>
        </div>
      </div>
    </header>

    <div class="container">
      <!-- 3. destacado -->
      <section class="fx-dest" data-reveal>
        <a href={`/servicios/fivem/${destacado.id}`} class="fx-dest__a">
          <img class="fx-dest__bg" src={destacado.portada} alt={`Captura de ${destacado.nombre}`} width="1920" height="1080" loading="eager" />
          <span class="fx-dest__velo" aria-hidden="true"></span>

          <span class="fx-dest__top">
            <span class="fx-dest__sello mono"><i aria-hidden="true"></i> Lo último</span>
            <span class="fx-dest__recurso mono">{destacado.recurso}</span>
          </span>

          <span class="fx-dest__info">
            <span class="fx-dest__ico" aria-hidden="true">
              <Icono nombre={destacado.icono} size={26} />
            </span>
            <span class="fx-dest__h">{destacado.nombre}</span>
            <span class="fx-dest__res">{destacado.resumen}</span>
            <span class="fx-chips">
              {destacado.frameworks.map((f) => <span>{f}</span>)}
              {idiomas.map((l) => <span class="fx-chip--idioma">{l.c}</span>)}
            </span>
          </span>

          <span class="fx-dest__caja">
            <span class="fx-dest__claves">
              {destacado.claves.map((k) => (
                <span>
                  <Icono nombre="check" size={15} /> {k}
                </span>
              ))}
            </span>
            <span class="fx-dest__compra">
              {pDest && (
                <span class="fx-precio">
                  <b>{euros(pDest.precio)}</b>
                  {pDest.antes && <s>{euros(pDest.antes)}</s>}
                  {pDest.descuento && <em class="mono">-{pDest.descuento} %</em>}
                </span>
              )}
              <span class="fx-dest__ir">
                Ver el script <Icono nombre="arrow" size={16} />
              </span>
            </span>
          </span>
        </a>
      </section>

      <!-- 4. catálogo -->
      <section class="fx-sec" id="catalogo">
        <div class="fx-sec__head">
          <p class="fx-k mono">// catálogo</p>
          <h2 class="fx-h2">Todos los <span>scripts</span></h2>
        </div>

        <ol role="list" class="fx-lista">
          {
            lista.map((s, i) => {
              const dev = s.estado === "desarrollo";
              const p = precios[s.id];
              return (
                <li class:list={["fx-sc", { "fx-sc--dev": dev }]} data-reveal style={`--i:${i}`}>
                  <a href={`/servicios/fivem/${s.id}`}>
                    <span class="fx-sc__media">
                      {s.portada ? (
                        <img src={s.portada} alt="" loading="lazy" width="1920" height="1080" />
                      ) : (
                        <span class="fx-sc__wip" aria-hidden="true">
                          <Icono nombre={s.icono} size={38} />
                          <small class="mono">en desarrollo</small>
                        </span>
                      )}
                      <span class="fx-sc__n mono">{String(i + 1).padStart(2, "0")}</span>
                      {s.nuevo && <span class="fx-sc__nuevo mono">nuevo</span>}
                    </span>

                    <span class="fx-sc__body">
                      <span class="fx-sc__cab">
                        <span class="fx-sc__ico" aria-hidden="true">
                          <Icono nombre={s.icono} size={18} />
                        </span>
                        <span class="fx-sc__cat mono">{s.categoria}</span>
                        <span class="fx-sc__idiomas mono" title="Español e inglés">
                          {idiomas.map((l) => <span>{l.c}</span>)}
                        </span>
                      </span>
                      <span class="fx-sc__t">{s.nombre}</span>
                      <span class="fx-sc__r">{s.resumen}</span>
                      <span class="fx-sc__claves">
                        {s.claves.map((k) => (
                          <span>
                            <Icono nombre={dev ? "hourglass" : "check"} size={14} /> {k}
                          </span>
                        ))}
                      </span>
                      <span class="fx-sc__pie">
                        <span class="fx-sc__fw mono">{s.frameworks.join(" · ")}</span>
                        <span class="fx-sc__precio">
                          {dev ? (
                            <span class="fx-wip">
                              <i aria-hidden="true" /> próximamente
                            </span>
                          ) : p ? (
                            <>
                              {p.antes && <s>{euros(p.antes)}</s>}
                              <b>{euros(p.precio)}</b>
                            </>
                          ) : (
                            <span class="fx-ok">
                              <i aria-hidden="true" /> disponible
                            </span>
                          )}
                          <span class="fx-sc__flecha" aria-hidden="true">
                            <Icono nombre="arrow" size={16} />
                          </span>
                        </span>
                      </span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ol>
      </section>

      <!-- 5. resmon -->
      <section class="fx-sec fx-res">
        <div class="fx-res__txt">
          <p class="fx-k mono">// características</p>
          <h2 class="fx-h2">Lo que llevan <span>todos</span></h2>
          {detail.consiste.map((p) => <p class="fx-sub">{p}</p>)}
        </div>
        <div class="fx-mon" data-reveal>
          <div class="fx-mon__bar mono">
            <span>Resource Monitor</span>
            <span>{resmon.length} running</span>
          </div>
          <div class="fx-mon__cab mono" aria-hidden="true">
            <span>característica</span><span>cpu</span><span>mem</span>
          </div>
          <ul role="list">
            {
              resmon.map((r) => (
                <li>
                  <span class="fx-mon__ico" aria-hidden="true">
                    <Icono nombre={r.icono} size={18} />
                  </span>
                  <span class="fx-mon__t">
                    <strong>{r.t}</strong>
                    <small>{r.d}</small>
                  </span>
                  <span class="fx-mon__ms mono" aria-hidden="true">{r.ms} ms</span>
                  <span class="fx-mon__mem mono" aria-hidden="true">{r.mem}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- 6. cómo lo quieres: selector «ya hecho» / «a medida» -->
      <section class="fx-sec fx-modo" data-modo>
        <div class="fx-modo__head">
          <div>
            <p class="fx-k mono">// cómo lo quieres</p>
            <h2 class="fx-h2">Hecho o <span>a medida</span></h2>
          </div>
          <div class="fx-modo__sel" role="tablist" aria-label="Cómo quieres el script">
            <span class="fx-modo__pildora" aria-hidden="true"></span>
            <button type="button" role="tab" id="tab-hecho" aria-controls="panel-hecho" aria-selected="true" data-tab="hecho">
              <Icono nombre="bag" size={16} /> Uno ya hecho
            </button>
            <button type="button" role="tab" id="tab-medida" aria-controls="panel-medida" aria-selected="false" data-tab="medida">
              <Icono nombre="tool" size={16} /> A medida
            </button>
          </div>
        </div>

        <!-- ya hecho -->
        <div class="fx-panel" id="panel-hecho" role="tabpanel" aria-labelledby="tab-hecho" data-panel="hecho">
          <div class="fx-panel__txt">
            <p class="fx-panel__big">Lo compras, lo descargas y <em>en minutos</em> está en tu servidor.</p>
            <ul role="list" class="fx-ventajas">
              <li><span><Icono nombre="zap" size={18} /></span><b>Al momento</b><small>Sin esperas ni reuniones</small></li>
              <li><span><Icono nombre="sliders" size={18} /></span><b>Config abierta</b><small>Comentada línea a línea</small></li>
              <li><span><Icono nombre="refresh" size={18} /></span><b>Actualizaciones</b><small>Incluidas, sin pagar más</small></li>
              <li><span><Icono nombre="message" size={18} /></span><b>ES · EN</b><small>Textos en los dos idiomas</small></li>
            </ul>
            <a href="#catalogo" class="btn btn-ghost">Ver todo el catálogo</a>
          </div>
          <ul role="list" class="fx-tienda">
            {
              lista
                .filter((s) => s.estado === "disponible" && s.portada)
                .map((s) => (
                  <li>
                    <a href={`/servicios/fivem/${s.id}`}>
                      <img src={s.portada} alt="" loading="lazy" width="1920" height="1080" />
                      <span class="fx-tienda__pie">
                        <b>{s.nombre}</b>
                        <span class="mono">{precios[s.id] ? euros(precios[s.id].precio) : "ver ficha"}</span>
                      </span>
                    </a>
                  </li>
                ))
            }
          </ul>
        </div>

        <!-- a medida -->
        <div class="fx-panel fx-panel--medida" id="panel-medida" role="tabpanel" aria-labelledby="tab-medida" data-panel="medida">
          <div class="fx-panel__txt">
            <p class="fx-panel__big">Me cuentas la idea y la hago <em>para tu servidor</em>, con tu estilo y tu framework.</p>
            <p class="fx-plazo mono"><Icono nombre="clock" size={15} /> Plazo habitual: <b>{service.timeline}</b></p>
            <a href={contacto} class="btn btn-primary">Pedir presupuesto</a>
          </div>
          <ol role="list" class="fx-ruta">
            {
              detail.proceso.map((p, i) => (
                <li style={`--i:${i}`}>
                  <span class="fx-ruta__n mono">{String(i + 1).padStart(2, "0")}</span>
                  <strong>{p.t}</strong>
                  <small>{p.d}</small>
                </li>
              ))
            }
          </ol>
          <div class="fx-para">
            <span class="mono">pensado para</span>
            <ul role="list">
              {detail.idealPara.map((x) => <li>{x}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- 7. dudas: lista de preguntas a la izquierda y un chat que las responde -->
      <section class="fx-sec fx-faq" data-faq>
        <div class="fx-faq__lado">
          <p class="fx-k mono">// dudas</p>
          <h2 class="fx-h2">Pregúntame <span>lo que quieras</span></h2>
          <p class="fx-sub">Las que más me llegan, respondidas. Pulsa una y te contesto.</p>
          <ol role="list" class="fx-preg">
            {
              detail.faq.map((f, i) => (
                <li>
                  <button type="button" class:list={["fx-preg__b", { "is-on": i === 0 }]} aria-pressed={i === 0 ? "true" : "false"} data-preg={i}>
                    <span class="fx-preg__n mono">{String(i + 1).padStart(2, "0")}</span>
                    <span class="fx-preg__q">{f.q}</span>
                    <span class="fx-preg__ir" aria-hidden="true"><Icono nombre="arrow" size={16} /></span>
                  </button>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="fx-chat">
          <div class="fx-chat__cab">
            <span class="fx-chat__av" style={`--logo:url("${logoMask.src}")`} aria-hidden="true"></span>
            <span class="fx-chat__quien">
              <b>AntonioooJ</b>
              <small class="mono"><i aria-hidden="true"></i> responde en el día · ES / EN</small>
            </span>
            <span class="fx-chat__n mono" aria-hidden="true"><b data-chat-n>01</b> / {String(detail.faq.length).padStart(2, "0")}</span>
          </div>

          <div class="fx-chat__cuerpo" aria-live="polite">
            {
              detail.faq.map((f, i) => (
                <div class="fx-chat__par" data-par={i}>
                  <p class="fx-burbuja fx-burbuja--tu">{f.q}</p>
                  <span class="fx-escribe" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                  </span>
                  <p class="fx-burbuja fx-burbuja--yo">{f.a}</p>
                </div>
              ))
            }
          </div>

          <a href={contacto} class="fx-chat__input">
            <span>Escribe tu duda…</span>
            <span class="fx-chat__enviar" aria-hidden="true"><Icono nombre="send" size={17} /></span>
          </a>
        </div>
      </section>

      <!-- cierre -->
      <aside class="fx-fin">
        <span class="fx-fin__fondo" aria-hidden="true">FIVEM</span>
        <div class="fx-fin__txt">
          <h2>¿Lo <em>arrancamos</em>?</h2>
          <ul role="list" class="fx-fin__lista mono">
            <li><Icono nombre="check" size={15} /> Presupuesto cerrado</li>
            <li><Icono nombre="check" size={15} /> Código tuyo y legible</li>
            <li><Icono nombre="check" size={15} /> Español e inglés</li>
          </ul>
        </div>
        <a href={contacto} class="fx-fin__boton" data-iman>
          <span>Cuéntame<br />tu script</span>
          <Icono nombre="arrow" size={26} />
        </a>
      </aside>
    </div>
  </article>
</BaseLayout>

<script>
  // Pila de capturas de la portada: cada 4 s la de delante pasa al fondo.
  // Se para con el ratón encima y no se mueve si se pide menos movimiento.
  const pila = document.querySelector<HTMLElement>("[data-pila]");
  if (pila && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const cartas = [...pila.querySelectorAll<HTMLElement>(".fx-pila__c")];
    const puntos = [...pila.querySelectorAll<HTMLElement>(".fx-pila__puntos i")];
    let frente = 0;
    let pausa = false;
    const pintar = () =>
      cartas.forEach((c, i) => {
        const pos = (i - frente + cartas.length) % cartas.length;
        c.dataset.pos = String(pos);
        c.tabIndex = pos === 0 ? 0 : -1;
        puntos[i]?.classList.toggle("is-on", pos === 0);
      });
    pila.addEventListener("pointerenter", () => (pausa = true));
    pila.addEventListener("pointerleave", () => (pausa = false));
    if (cartas.length > 1)
      setInterval(() => {
        if (pausa || document.hidden) return;
        frente = (frente + 1) % cartas.length;
        pintar();
      }, 4000);
  }

  // «Hecho o a medida»: sin JS se ven los dos paneles; con JS, uno cada vez.
  const modo = document.querySelector<HTMLElement>("[data-modo]");
  if (modo) {
    const tabs = [...modo.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const paneles = [...modo.querySelectorAll<HTMLElement>("[data-panel]")];
    const elegir = (id: string, foco = false) => {
      modo.dataset.activo = id;
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && foco) t.focus();
      });
      paneles.forEach((p) => (p.hidden = p.dataset.panel !== id));
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => elegir(t.dataset.tab!));
      t.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        const sig = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        elegir(sig.dataset.tab!, true);
      });
    });
    elegir("hecho");
  }

  // Dudas: sin JS se ven todas las respuestas en el chat; con JS, la de la pregunta elegida,
  // con un «escribiendo…» corto antes de la respuesta.
  const faq = document.querySelector<HTMLElement>("[data-faq]");
  if (faq) {
    const botones = [...faq.querySelectorAll<HTMLButtonElement>("[data-preg]")];
    const pares = [...faq.querySelectorAll<HTMLElement>("[data-par]")];
    const num = faq.querySelector<HTMLElement>("[data-chat-n]");
    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let espera = 0;
    const mostrar = (n: number, animar: boolean) => {
      clearTimeout(espera);
      botones.forEach((b, i) => {
        b.classList.toggle("is-on", i === n);
        b.setAttribute("aria-pressed", String(i === n));
      });
      pares.forEach((par, i) => {
        par.hidden = i !== n;
        par.classList.remove("is-anim", "is-escribiendo");
      });
      if (num) num.textContent = String(n + 1).padStart(2, "0");
      const par = pares[n];
      if (!animar || quieto || !par) return;
      void par.offsetWidth;
      par.classList.add("is-anim", "is-escribiendo");
      espera = window.setTimeout(() => par.classList.remove("is-escribiendo"), 900);
    };
    botones.forEach((b) => b.addEventListener("click", () => mostrar(Number(b.dataset.preg), true)));
    mostrar(0, false);
  }

  // Botón redondo del cierre: se acerca un poco al cursor (solo con ratón).
  const iman = document.querySelector<HTMLElement>("[data-iman]");
  if (iman && matchMedia("(hover: hover) and (pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const zona = iman.parentElement!;
    zona.addEventListener("pointermove", (e) => {
      const r = iman.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2);
      const dy = e.clientY - (r.top + r.height / 2);
      const dist = Math.hypot(dx, dy);
      const k = dist < 260 ? 0.25 : 0;
      iman.style.translate = `${dx * k}px ${dy * k}px`;
    });
    zona.addEventListener("pointerleave", () => (iman.style.translate = ""));
  }
</script>

<style>
  .fx {
    --acc-soft: color-mix(in srgb, var(--acc) 16%, transparent);
    overflow-x: clip;
  }
  .fx-k {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--acc);
    margin-bottom: var(--space-3);
  }
  .fx-h2 {
    font-size: var(--fs-xl);
    font-weight: 800;
    font-stretch: 112%;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .fx-h2 span {
    color: var(--fg-subtle);
  }
  .fx-sub {
    margin-top: var(--space-4);
    max-width: 40rem;
    color: var(--fg-muted);
    line-height: 1.6;
  }
  .fx-sec {
    padding-block: var(--section) 0;
  }
  .fx-sec__head {
    margin-bottom: var(--space-7);
  }

  /* ── 1. portada ── */
  .fx-hero {
    position: relative;
    background: var(--bg);
    color: var(--fg);
    padding: calc(var(--header-h) + var(--space-8)) 0 var(--space-9);
    overflow: hidden;
  }
  .fx-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 70% at 70% 40%, #000 20%, transparent 75%);
    opacity: 0.6;
  }
  .fx-hero::after {
    content: "";
    position: absolute;
    width: 46rem;
    height: 46rem;
    right: -12rem;
    top: -14rem;
    background: radial-gradient(circle, var(--acc-soft), transparent 65%);
    pointer-events: none;
  }
  .fx-hero__in {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }
  .fx-hero h1 {
    font-size: clamp(2.5rem, 1.2rem + 5.2vw, 6rem);
    font-weight: 850;
    font-stretch: 115%;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .fx-hero h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--acc);
  }
  .fx-lead {
    margin-top: var(--space-5);
    max-width: 34rem;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--fg-muted);
  }
  .fx-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .fx-hero__idiomas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-6);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }
  .fx-hero__idiomas > span:not(.fx-hero__idiomas-t) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem 0.35rem 0.35rem;
    border: 1px solid var(--border-strong);
    border-radius: 99px;
  }
  .fx-hero__idiomas b {
    padding: 0.15rem 0.4rem;
    border-radius: 99px;
    background: var(--acc);
    color: #fff;
    font-weight: 500;
  }
  .fx-hero__idiomas-t {
    color: var(--fg-subtle);
    margin-left: 0.3rem;
  }

  /* pila de capturas */
  .fx-pila {
    position: relative;
    aspect-ratio: 16 / 11;
  }
  .fx-pila__c {
    position: absolute;
    inset: 0 0 12% 0;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: #000;
    box-shadow: 0 40px 80px -40px color-mix(in srgb, var(--acc) 55%, transparent);
    transition:
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.6s ease;
  }
  .fx-pila__c[data-pos="0"] {
    z-index: 3;
    transform: rotate(-2deg);
  }
  .fx-pila__c[data-pos="1"] {
    z-index: 2;
    transform: translate(7%, 7%) rotate(3deg) scale(0.92);
    filter: brightness(0.55);
  }
  .fx-pila__c[data-pos="2"] {
    z-index: 1;
    transform: translate(13%, 13%) rotate(7deg) scale(0.84);
    filter: brightness(0.35);
  }
  .fx-pila__c:not([data-pos="0"]) {
    pointer-events: none;
  }
  .fx-pila__c img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fx-pila__pie {
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.8rem;
    border-radius: 14px;
    background: rgb(10 10 10 / 0.7);
    backdrop-filter: blur(10px);
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.12);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.4s ease 0.3s,
      transform 0.4s ease 0.3s;
  }
  .fx-pila__c[data-pos="0"] .fx-pila__pie {
    opacity: 1;
    transform: none;
  }
  .fx-pila__pie b {
    display: block;
    font-size: var(--fs-sm);
  }
  .fx-pila__pie small {
    font-size: 0.6875rem;
    color: rgb(255 255 255 / 0.6);
  }
  .fx-pila__ico {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9px;
    background: var(--acc);
    flex: none;
  }
  .fx-pila__precio {
    margin-left: auto;
    font-weight: 800;
  }
  .fx-pila__puntos {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    gap: 6px;
  }
  .fx-pila__puntos i {
    width: 18px;
    height: 3px;
    border-radius: 3px;
    background: var(--border-strong);
    transition:
      width 0.4s ease,
      background 0.4s ease;
  }
  .fx-pila__puntos i.is-on {
    width: 34px;
    background: var(--acc);
  }

  /* ── 3. destacado: «lo último», a sangre con la captura de fondo ── */
  .fx-dest {
    padding-top: var(--section);
  }
  .fx-dest__a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    gap: var(--space-6);
    min-height: clamp(32rem, 60vw, 42rem);
    padding: var(--space-6);
    border-radius: var(--radius-tile);
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background: #050505;
    border: 1px solid color-mix(in srgb, var(--acc) 30%, transparent);
  }
  .fx-dest__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1.2s var(--ease);
  }
  .fx-dest__a:hover .fx-dest__bg {
    transform: scale(1.07);
  }
  .fx-dest__velo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(5 5 5 / 0.92) 0%, rgb(5 5 5 / 0.55) 45%, rgb(5 5 5 / 0.15) 100%),
      linear-gradient(0deg, rgb(5 5 5 / 0.85) 0%, transparent 55%),
      radial-gradient(ellipse at 0% 100%, color-mix(in srgb, var(--acc) 35%, transparent), transparent 60%);
  }
  .fx-dest__top {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }
  .fx-dest__sello {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.9rem;
    border-radius: 99px;
    background: var(--acc);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .fx-dest__sello i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
    animation: fx-lat 1.6s ease-in-out infinite;
  }
  .fx-dest__recurso {
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.55);
  }
  .fx-dest__info {
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 36rem;
  }
  .fx-dest__ico {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.18);
    backdrop-filter: blur(8px);
  }
  .fx-dest__h {
    font-size: clamp(2.4rem, 1.4rem + 4vw, 5rem);
    font-weight: 850;
    font-stretch: 115%;
    line-height: 0.92;
    letter-spacing: -0.04em;
  }
  .fx-dest__res {
    color: rgb(255 255 255 / 0.75);
    font-size: var(--fs-md);
    line-height: 1.55;
  }
  .fx-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .fx-chips span {
    padding: 0.3rem 0.7rem;
    border-radius: 99px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    border: 1px solid rgb(255 255 255 / 0.22);
    background: rgb(255 255 255 / 0.06);
  }
  .fx-chips .fx-chip--idioma {
    border-color: var(--acc);
    background: color-mix(in srgb, var(--acc) 30%, transparent);
  }
  .fx-dest__caja {
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-5);
    border-radius: 20px;
    background: rgb(15 15 15 / 0.6);
    border: 1px solid rgb(255 255 255 / 0.14);
    backdrop-filter: blur(14px);
  }
  .fx-dest__claves {
    display: grid;
    gap: 0.65rem;
    font-size: var(--fs-sm);
  }
  .fx-dest__claves span {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .fx-dest__claves :global(svg) {
    color: var(--acc);
    flex: none;
  }
  .fx-dest__compra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .fx-precio {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .fx-precio b {
    font-size: 2.4rem;
    font-weight: 850;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .fx-precio s {
    color: rgb(255 255 255 / 0.5);
  }
  .fx-precio em {
    font-style: normal;
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    background: var(--acc);
  }
  .fx-dest__ir {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.2rem;
    border-radius: 99px;
    background: #fff;
    color: #0a0a0a;
    font-weight: 600;
    font-size: var(--fs-sm);
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }
  .fx-dest__ir :global(svg) {
    transition: transform 0.25s ease;
  }
  .fx-dest__a:hover .fx-dest__ir {
    background: var(--acc);
    color: #fff;
  }
  .fx-dest__a:hover .fx-dest__ir :global(svg) {
    transform: translateX(4px);
  }

  /* ── 4. catálogo: tarjetas anchas con captura, alternando lado ── */
  .fx-lista {
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }
  .fx-sc a {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    border: 1px solid var(--border);
    border-radius: var(--radius-tile);
    background: var(--bg-elev);
    overflow: hidden;
    transition:
      border-color 0.3s ease,
      transform 0.4s var(--ease),
      box-shadow 0.4s ease;
  }
  .fx-sc:nth-child(even) a {
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  }
  .fx-sc:nth-child(even) .fx-sc__media {
    order: 2;
  }
  .fx-sc a:hover {
    border-color: color-mix(in srgb, var(--acc) 60%, transparent);
    transform: translateY(-3px);
    box-shadow: 0 30px 60px -35px color-mix(in srgb, var(--acc) 60%, transparent);
  }
  .fx-sc__media {
    position: relative;
    min-height: 17rem;
    background: #0a0a0a;
    overflow: hidden;
  }
  .fx-sc__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .fx-sc a:hover .fx-sc__media img {
    transform: scale(1.05);
  }
  .fx-sc__wip {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.8rem;
    color: #d97706;
    background:
      radial-gradient(circle at 50% 45%, rgb(217 119 6 / 0.14), transparent 55%),
      repeating-linear-gradient(-45deg, #101010 0 14px, #151515 14px 28px);
  }
  .fx-sc__wip small {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .fx-sc__n {
    position: absolute;
    left: 1rem;
    top: 0.8rem;
    font-size: 2.2rem;
    font-weight: 500;
    color: #fff;
    text-shadow: 0 2px 20px rgb(0 0 0 / 0.6);
    opacity: 0.9;
  }
  .fx-sc__nuevo {
    position: absolute;
    right: 1rem;
    top: 1rem;
    padding: 0.3rem 0.7rem;
    border-radius: 99px;
    background: var(--acc);
    color: #fff;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .fx-sc__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
  }
  .fx-sc__cab {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .fx-sc__ico {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 10px;
    background: var(--acc-soft);
    color: var(--acc);
  }
  .fx-sc__cat {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-subtle);
  }
  .fx-sc__idiomas {
    margin-left: auto;
    display: inline-flex;
    border: 1px solid var(--border-strong);
    border-radius: 99px;
    overflow: hidden;
    font-size: 0.625rem;
  }
  .fx-sc__idiomas span {
    padding: 0.2rem 0.5rem;
  }
  .fx-sc__idiomas span + span {
    border-left: 1px solid var(--border-strong);
  }
  .fx-sc__t {
    font-size: clamp(1.5rem, 1.1rem + 1.3vw, 2.2rem);
    font-weight: 800;
    font-stretch: 110%;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .fx-sc__r {
    color: var(--fg-muted);
    line-height: 1.55;
  }
  .fx-sc__claves {
    display: grid;
    gap: 0.45rem;
    margin-top: var(--space-2);
    font-size: var(--fs-sm);
  }
  .fx-sc__claves span {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .fx-sc__claves :global(svg) {
    color: var(--acc);
    flex: none;
  }
  .fx-sc--dev .fx-sc__claves :global(svg) {
    color: #d97706;
  }
  .fx-sc__pie {
    margin-top: auto;
    padding-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .fx-sc__fw {
    font-size: 0.6875rem;
    color: var(--fg-subtle);
  }
  .fx-sc__precio {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .fx-sc__precio b {
    font-size: 1.5rem;
    font-weight: 850;
    letter-spacing: -0.02em;
  }
  .fx-sc__precio s {
    color: var(--fg-subtle);
    font-size: var(--fs-sm);
  }
  .fx-sc__flecha {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      transform 0.35s var(--ease);
  }
  .fx-sc a:hover .fx-sc__flecha {
    background: var(--acc);
    border-color: var(--acc);
    color: #fff;
    transform: rotate(-45deg);
  }
  .fx-wip,
  .fx-ok {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }
  .fx-wip i,
  .fx-ok i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d97706;
  }
  .fx-ok i {
    background: var(--ok);
  }
  @keyframes fx-lat {
    50% {
      opacity: 0.3;
    }
  }

  /* ── 5. resmon ── */
  .fx-res {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-8);
    align-items: start;
  }
  .fx-res__txt {
    position: sticky;
    top: calc(var(--header-h) + var(--space-6));
  }
  .fx-mon {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-tile);
    background: var(--bg-elev);
    overflow: hidden;
  }
  .fx-mon__bar {
    display: flex;
    justify-content: space-between;
    padding: 0.9rem 1.3rem;
    font-size: 0.75rem;
    border-bottom: 1px solid var(--border);
    color: var(--fg-subtle);
  }
  .fx-mon__bar span:first-child {
    color: var(--fg);
  }
  .fx-mon__cab,
  .fx-mon li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 5.5rem 5.5rem;
    gap: var(--space-4);
    align-items: center;
    padding: 0.75rem 1.3rem;
  }
  .fx-mon__cab {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-subtle);
    background: var(--bg-code);
  }
  .fx-mon__cab span:first-child {
    grid-column: 1 / 3;
  }
  .fx-mon__cab span:not(:first-child) {
    text-align: right;
  }
  .fx-mon li {
    border-top: 1px solid var(--border);
    padding-block: 1.1rem;
    transition: background 0.25s ease;
  }
  .fx-mon li:hover {
    background: var(--acc-soft);
  }
  .fx-mon__ico {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    background: var(--acc-soft);
    color: var(--acc);
  }
  .fx-mon__t {
    display: grid;
    gap: 0.2rem;
  }
  .fx-mon__t small {
    color: var(--fg-muted);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }
  .fx-mon__ms,
  .fx-mon__mem {
    text-align: right;
    font-size: 0.75rem;
    color: var(--ok);
  }
  .fx-mon__mem {
    color: var(--fg-subtle);
  }

  /* ── 6. hecho o a medida ── */
  .fx-modo__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }
  .fx-modo__sel {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    padding: 5px;
    border-radius: 99px;
    border: 1px solid var(--border-strong);
    background: var(--bg-elev);
  }
  .fx-modo__pildora {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: 5px;
    width: calc(50% - 5px);
    border-radius: 99px;
    background: var(--fg);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fx-modo[data-activo="medida"] .fx-modo__pildora {
    transform: translateX(100%);
    background: var(--acc);
  }
  .fx-modo__sel button {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.3rem;
    border: 0;
    border-radius: 99px;
    background: none;
    color: var(--fg-muted);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.3s ease;
  }
  .fx-modo__sel button[aria-selected="true"] {
    color: var(--bg);
  }
  .fx-modo[data-activo="medida"] .fx-modo__sel button[aria-selected="true"] {
    color: #fff;
  }
  .fx-modo__sel button:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 2px;
  }

  .fx-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-7);
    padding: var(--space-7);
    border-radius: var(--radius-tile);
    border: 1px solid var(--border);
    background: var(--bg-elev);
    animation: fx-entra 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fx-panel + .fx-panel {
    margin-top: var(--space-4);
  }
  .fx-panel[hidden] {
    display: none;
  }
  .fx-panel--medida {
    background:
      radial-gradient(ellipse at 100% 0%, var(--acc-soft), transparent 55%),
      var(--bg-elev);
    border-color: color-mix(in srgb, var(--acc) 35%, var(--border));
  }
  @keyframes fx-entra {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .fx-panel__txt {
    display: flex;
    flex-direction: column;
