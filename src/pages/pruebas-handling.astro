---
// /pruebas-handling — propuesta de diseño distinto para /servicios/fivem/menu-handling.
// Mismos datos que la ficha real (pack «menu-handling» en src/data/packs.ts), otra forma de contarlo:
//   1. portada: titular + simulador del ajuste rápido (barras, plantillas y telemetría de mentira)
//   2. vídeo grabado en el juego
//   3. «antes / con el panel»: el bucle del handling.meta frente a ajustar en el juego
//   4. cifras grandes
//   5. todo lo que hace, como hoja de especificaciones (las teclas salen como <kbd>)
//   6. para quién (encajan) y bajo el capó (técnico)
//   7. preguntas y cierre, con los otros scripts debajo
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icono from "@/components/servicios/Icono.astro";
import OtrosScripts from "@/components/servicios/OtrosScripts.astro";
import { fivemPacks } from "@/data/packs";

const pack = fivemPacks.find((p) => p.id === "menu-handling")!;
const s = pack.scripts[0];
const contacto = `/contacto?tipo=${encodeURIComponent("Script FiveM")}`;
// chips de la portada: sin «En español» (va en los dos idiomas, sale aparte)
const chips = pack.chips.filter((c) => c !== "En español" && c !== "/admincar");

// simulador: barras en % sobre el de fábrica y plantillas de un clic (valores orientativos)
const barras = [
  { id: "pot", t: "Potencia" },
  { id: "vel", t: "Velocidad punta" },
  { id: "fre", t: "Frenos" },
  { id: "aga", t: "Agarre" },
  { id: "sus", t: "Dureza" },
  { id: "pes", t: "Peso" },
];
const plantillas: Record<string, Record<string, number>> = {
  Fábrica: { pot: 100, vel: 100, fre: 100, aga: 100, sus: 100, pes: 100 },
  Confort: { pot: 95, vel: 100, fre: 105, aga: 100, sus: 70, pes: 105 },
  Deportivo: { pot: 130, vel: 120, fre: 125, aga: 120, sus: 130, pes: 90 },
  Drift: { pot: 125, vel: 105, fre: 100, aga: 70, sus: 115, pes: 95 },
  Rally: { pot: 115, vel: 105, fre: 110, aga: 115, sus: 80, pes: 100 },
  Todoterreno: { pot: 105, vel: 90, fre: 100, aga: 125, sus: 60, pes: 115 },
  Blindado: { pot: 110, vel: 90, fre: 115, aga: 105, sus: 110, pes: 150 },
};

// las teclas de las funciones (RePág, AvPág, Ctrl+Z…) se pintan como teclas
const TECLAS = /(RePág|AvPág|Ctrl\+Z|Ctrl\+Y)/;
const trocear = (t: string) => t.split(TECLAS).map((p) => ({ p, tecla: TECLAS.test(p) }));
// cada función: lo de antes de los dos puntos va de título
const funciones = s.funciones.map((f) => {
  const i = f.indexOf(": ");
  return i > 0 && i < 70 ? { t: f.slice(0, i), d: f.slice(i + 2) } : { t: "", d: f };
});

const antes = ["Abrir el handling.meta y cambiar un número", "Reiniciar el recurso", "Entrar al coche y probarlo", "No te convence: vuelta a empezar"];
const despues = ["/admincar sobre el coche", "Mueves una barra o eliges una plantilla", "Lo conduces con el panel abierto", "Guardas: todos los de ese modelo van igual"];
---

<BaseLayout title="Pruebas · Menú de handling" description="Propuesta de diseño para la ficha del menú de handling." noindex>
  <article class="hd" style={`--acc:${pack.color}`}>
    <!-- 1. portada con simulador -->
    <header class="hd-hero">
      <div class="hd-hero__grid" aria-hidden="true"></div>
      <div class="container hd-hero__in">
        <div class="hd-hero__txt">
          <a href="/servicios/fivem#catalogo" class="hd-back mono">← scripts FiveM</a>
          <p class="hd-cmd mono"><span>&gt;</span> /admincar</p>
          <h1>Cada coche, <em>como tú quieras</em>.</h1>
          <p class="hd-lead">{pack.lead}</p>
          <ul role="list" class="hd-chips mono">
            {chips.map((c) => <li>{c}</li>)}
            <li class="hd-chips__idioma">ES · EN</li>
          </ul>
          <div class="hd-actions">
            <a href={contacto} class="btn btn-primary">Pedir presupuesto</a>
            <a href="#video" class="btn btn-ghost"><Icono nombre="play" size={14} /> Verlo en el juego</a>
          </div>
        </div>

        <div class="hd-sim" data-sim data-plantillas={JSON.stringify(plantillas)}>
          <div class="hd-sim__bar mono">
            <span><Icono nombre="car" size={15} /> sultan · ajuste rápido</span>
            <span class="hd-sim__tag">simulación</span>
          </div>
          <div class="hd-sim__plant" role="group" aria-label="Plantillas">
            {
              Object.keys(plantillas).map((p, i) => (
                <button type="button" class:list={["mono", { "is-on": i === 0 }]} data-plantilla={p}>
                  {p}
                </button>
              ))
            }
          </div>
          <div class="hd-sim__barras">
            {
              barras.map((b) => (
                <label class="hd-barra">
                  <span class="hd-barra__t">{b.t}</span>
                  <span class="hd-barra__v mono" data-v={b.id}>100 %</span>
                  <span class="hd-barra__pista">
                    <i class="hd-barra__fabrica" aria-hidden="true" />
                    <input type="range" min="50" max="150" step="1" value="100" data-barra={b.id} aria-label={b.t} />
                  </span>
                </label>
              ))
            }
          </div>
          <div class="hd-sim__tele">
            <div>
              <small class="mono">punta</small>
              <b data-tele="punta">220</b>
              <span class="mono">km/h</span>
            </div>
            <div>
              <small class="mono">0-100</small>
              <b data-tele="cero">5.2</b>
              <span class="mono">s</span>
            </div>
            <div>
              <small class="mono">frenada 100-0</small>
              <b data-tele="frena">38</b>
              <span class="mono">m</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="container">
      <!-- 2. vídeo -->
      <section class="hd-sec" id="video">
        <figure class="hd-video" data-reveal>
          <video src={s.video} poster={s.poster} controls preload="none" playsinline width="1920" height="1080"></video>
          <figcaption class="mono"><i aria-hidden="true"></i> {pack.videoTexto}</figcaption>
        </figure>
      </section>

      <!-- 3. antes / con el panel -->
      <section class="hd-sec">
        <div class="hd-head">
          <p class="hd-k mono">// el problema</p>
          <h2 class="hd-h2">Adiós al <span>handling.meta</span></h2>
          <p class="hd-sub">{s.desarrollo[0]}</p>
        </div>
        <div class="hd-vs">
          <div class="hd-vs__lado hd-vs__lado--antes" data-reveal>
            <p class="hd-vs__t mono">Antes</p>
            <ol role="list">
              {antes.map((a, i) => <li><span class="mono">{i + 1}</span> {a}</li>)}
            </ol>
            <p class="hd-vs__pie mono"><Icono nombre="refresh" size={14} /> y otra vez, y otra…</p>
          </div>
          <span class="hd-vs__flecha" aria-hidden="true"><Icono nombre="arrow" size={22} /></span>
          <div class="hd-vs__lado hd-vs__lado--ahora" data-reveal style="--i:1">
            <p class="hd-vs__t mono">Con el panel</p>
            <ol role="list">
              {despues.map((a, i) => <li><span class="mono">{i + 1}</span> {a}</li>)}
            </ol>
            <p class="hd-vs__pie mono"><Icono nombre="zap" size={14} /> sin reiniciar nada</p>
          </div>
        </div>
      </section>

      <!-- 4. cifras -->
      <section class="hd-cifras" aria-label="En cifras">
        {
          s.cifras.map((c, i) => (
            <div data-reveal style={`--i:${i}`}>
              <b>{c.v}</b>
              <span>{c.l}</span>
            </div>
          ))
        }
      </section>

      <!-- 5. funciones como hoja de especificaciones -->
      <section class="hd-sec hd-spec">
        <div class="hd-spec__lado">
          <p class="hd-k mono">// qué hace</p>
          <h2 class="hd-h2">Todo lo que <span>trae</span></h2>
          <p class="hd-sub">{s.resumen}</p>
          <img src={s.poster} alt="El panel de handling abierto en el juego" loading="lazy" width="1920" height="1080" />
        </div>
        <ol role="list" class="hd-spec__lista">
          {
            funciones.map((f, i) => (
              <li data-reveal style={`--i:${i % 4}`}>
                <span class="hd-spec__n mono">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  {f.t && <strong>{f.t}</strong>}
                  <p>{trocear(f.d).map((x) => (x.tecla ? <kbd class="mono">{x.p}</kbd> : x.p))}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- 6. para quién + bajo el capó -->
      <section class="hd-sec">
        <div class="hd-head">
          <p class="hd-k mono">// en tu servidor</p>
          <h2 class="hd-h2">{pack.encajanTitulo?.[0]}<span>{pack.encajanTitulo?.[1]}</span></h2>
        </div>
        <ul role="list" class="hd-quien">
          {
            pack.encajan.map((e, i) => (
              <li data-reveal style={`--i:${i}`}>
                <span class="hd-quien__ico" aria-hidden="true"><Icono nombre={e.icono} size={20} /></span>
                <strong>{e.t}</strong>
                <p>{e.d}</p>
              </li>
            ))
          }
        </ul>

        <div class="hd-capo">
          <div class="hd-capo__cab">
            <p class="hd-k mono">// bajo el capó</p>
            <p class="hd-capo__t">Cómo está hecho</p>
            <p class="hd-capo__sub">{s.desarrollo[2]}</p>
          </div>
          <dl class="hd-capo__lista">
            {
              pack.tecnico.map((t) => (
                <div>
                  <dt>
                    <Icono nombre={t.icono} size={17} /> {t.t === "En español" ? "En español e inglés" : t.t}
                  </dt>
                  <dd>{t.t === "En español" ? "Cada valor con su nombre y una explicación de qué hace, en los dos idiomas, para que lo entienda cualquier admin." : t.d}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- 7. preguntas -->
      <section class="hd-sec hd-faq">
        <div class="hd-head">
          <p class="hd-k mono">// dudas</p>
          <h2 class="hd-h2">Preguntas <span>rápidas</span></h2>
        </div>
        <div class="hd-faq__grid">
          {
            pack.faq.map((f, i) => (
              <details class="hd-faq__i" open={i === 0} data-reveal style={`--i:${i}`}>
                <summary>
                  <span class="mono">{String(i + 1).padStart(2, "0")}</span>
                  {f.q}
                  <i aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <aside class="hd-cta">
        <div>
          <p class="hd-cta__t">¿Lo quieres en tu servidor?</p>
          <p class="hd-cta__sub mono">instalación incluida · soporte tras la entrega · ES / EN</p>
        </div>
        <a href={contacto} class="btn btn-primary">Pedir presupuesto</a>
      </aside>

      <OtrosScripts />
    </div>
  </article>
</BaseLayout>

<script>
  // Simulador del ajuste rápido: barras, plantillas y una telemetría aproximada (de adorno).
  const sim = document.querySelector<HTMLElement>("[data-sim]");
  if (sim) {
    const plantillas = JSON.parse(sim.dataset.plantillas || "{}") as Record<string, Record<string, number>>;
    const barras = [...sim.querySelectorAll<HTMLInputElement>("[data-barra]")];
    const botones = [...sim.querySelectorAll<HTMLButtonElement>("[data-plantilla]")];
    const tele = (k: string) => sim.querySelector<HTMLElement>(`[data-tele="${k}"]`)!;
    const val = (id: string) => Number(barras.find((b) => b.dataset.barra === id)?.value ?? 100) / 100;
    let anim = 0;

    const pintar = () => {
      barras.forEach((b) => {
        const v = Number(b.value);
        b.style.setProperty("--p", `${v - 50}%`);
        b.closest(".hd-barra")!.classList.toggle("is-cambiada", v !== 100);
        sim.querySelector<HTMLElement>(`[data-v="${b.dataset.barra}"]`)!.textContent = `${v} %`;
      });
      const pot = val("pot"), vel = val("vel"), fre = val("fre"), aga = val("aga"), pes = val("pes");
      tele("punta").textContent = String(Math.round((220 * Math.sqrt(vel) * Math.pow(pot, 0.2)) / Math.pow(pes, 0.1)));
      tele("cero").textContent = ((5.2 * Math.pow(pes, 0.6)) / (Math.pow(pot, 0.8) * Math.pow(aga, 0.2))).toFixed(1);
      tele("frena").textContent = String(Math.round((38 * Math.pow(pes, 0.5)) / (Math.pow(fre, 0.6) * Math.pow(aga, 0.4))));
    };

    // de los valores actuales a los de la plantilla, en 0,5 s
    const aplicar = (nombre: string) => {
      const meta = plantillas[nombre];
      if (!meta) return;
      botones.forEach((b) => b.classList.toggle("is-on", b.dataset.plantilla === nombre));
      cancelAnimationFrame(anim);
      const desde = Object.fromEntries(barras.map((b) => [b.dataset.barra!, Number(b.value)]));
      const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const t0 = performance.now();
      const paso = (t: number) => {
        const k = quieto ? 1 : Math.min(1, (t - t0) / 500);
        const e = 1 - Math.pow(1 - k, 3);
        barras.forEach((b) => (b.value = String(Math.round(desde[b.dataset.barra!] + (meta[b.dataset.barra!] - desde[b.dataset.barra!]) * e))));
        pintar();
        if (k < 1) anim = requestAnimationFrame(paso);
      };
      anim = requestAnimationFrame(paso);
    };

    botones.forEach((b) => b.addEventListener("click", () => aplicar(b.dataset.plantilla!)));
    barras.forEach((b) =>
      b.addEventListener("input", () => {
        botones.forEach((x) => x.classList.remove("is-on"));
        pintar();
      }),
    );
    pintar();
  }
</script>

<style>
  .hd {
    --acc-soft: color-mix(in srgb, var(--acc) 16%, transparent);
    overflow-x: clip;
  }
  .hd-k {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--acc);
    margin-bottom: var(--space-3);
  }
  .hd-h2 {
    font-size: var(--fs-xl);
    font-weight: 800;
    font-stretch: 112%;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .hd-h2 span {
    color: var(--fg-subtle);
  }
  .hd-sub {
    margin-top: var(--space-4);
    max-width: 42rem;
    color: var(--fg-muted);
    line-height: 1.6;
  }
  .hd-sec {
    padding-top: var(--section);
  }
  .hd-head {
    margin-bottom: var(--space-7);
  }

  /* ── 1. portada ── */
  .hd-hero {
    position: relative;
    padding: calc(var(--header-h) + var(--space-7)) 0 var(--space-8);
    overflow: hidden;
  }
  .hd-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 70% at 75% 45%, #000 15%, transparent 75%);
    opacity: 0.6;
  }
  .hd-hero::after {
    content: "";
    position: absolute;
    width: 44rem;
    height: 44rem;
    right: -10rem;
    top: -10rem;
    background: radial-gradient(circle, var(--acc-soft), transparent 65%);
    pointer-events: none;
  }
  .hd-hero__in {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }
  .hd-back {
    display: inline-block;
    font-size: var(--fs-sm);
    color: var(--fg-subtle);
    margin-bottom: var(--space-5);
  }
  .hd-back:hover {
    color: var(--fg);
  }
  .hd-cmd {
    display: inline-flex;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border-radius: 10px;
    background: var(--bg-code);
    font-size: var(--fs-sm);
  }
  .hd-cmd span {
    color: var(--acc);
  }
  .hd-hero h1 {
    margin-top: var(--space-4);
    font-size: clamp(2.5rem, 1.2rem + 5vw, 5.6rem);
    font-weight: 850;
    font-stretch: 115%;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .hd-hero h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--acc);
  }
  .hd-lead {
    margin-top: var(--space-5);
    max-width: 36rem;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--fg-muted);
  }
  .hd-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-5);
    font-size: 0.75rem;
  }
  .hd-chips li {
    padding: 0.3rem 0.7rem;
    border-radius: 99px;
    border: 1px solid var(--border-strong);
    color: var(--fg-muted);
  }
  .hd-chips .hd-chips__idioma {
    border-color: var(--acc);
    background: var(--acc-soft);
    color: var(--fg);
  }
  .hd-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* simulador */
  .hd-sim {
    border-radius: var(--radius-tile);
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--bg-elev) 90%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 40px 80px -40px color-mix(in srgb, var(--acc) 50%, transparent);
    overflow: hidden;
  }
  .hd-sim__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.2rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }
  .hd-sim__bar > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hd-sim__tag {
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    background: var(--acc-soft);
    color: var(--acc);
  }
  .hd-sim__plant {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 1rem 1.2rem 0.4rem;
  }
  .hd-sim__plant button {
    padding: 0.4rem 0.75rem;
    border-radius: 99px;
    border: 1px solid var(--border-strong);
    background: none;
    color: var(--fg-muted);
    font-size: 0.75rem;
    cursor: pointer;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }
  .hd-sim__plant button:hover {
    border-color: var(--acc);
    color: var(--fg);
  }
  .hd-sim__plant button.is-on {
    background: var(--acc);
    border-color: var(--acc);
    color: #fff;
  }
  .hd-sim__barras {
    display: grid;
    gap: 0.85rem;
    padding: 1rem 1.2rem 1.2rem;
  }
  .hd-barra {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 1rem;
    font-size: var(--fs-sm);
  }
  .hd-barra__v {
    font-size: 0.75rem;
    color: var(--fg-subtle);
    transition: color 0.2s ease;
  }
  .hd-barra.is-cambiada .hd-barra__v {
    color: var(--acc);
  }
  .hd-barra__pista {
    grid-column: 1 / -1;
    position: relative;
    display: block;
  }
  .hd-barra__fabrica {
    position: absolute;
    left: 50%;
    top: -3px;
    bottom: -3px;
    width: 2px;
    background: var(--fg-subtle);
    opacity: 0.5;
    pointer-events: none;
  }
  .hd-barra input {
    --p: 50%;
    width: 100%;
    height: 6px;
    appearance: none;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--acc) var(--p), var(--border-strong) var(--p));
    cursor: pointer;
  }
  .hd-barra input::-webkit-slider-thumb {
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--bg-elev);
    border: 3px solid var(--acc);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.25);
  }
  .hd-barra input::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg-elev);
    border: 3px solid var(--acc);
  }
  .hd-barra input:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 4px;
  }
  .hd-sim__tele {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--border);
  }
  .hd-sim__tele div {
    display: grid;
    padding: 0.9rem 1.2rem;
  }
  .hd-sim__tele div + div {
    border-left: 1px solid var(--border);
  }
  .hd-sim__tele small {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-subtle);
  }
  .hd-sim__tele b {
    font-size: 1.9rem;
    font-weight: 850;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .hd-sim__tele span {
    font-size: 0.6875rem;
    color: var(--fg-subtle);
  }

  /* ── 2. vídeo ── */
  .hd-video {
    margin: 0;
  }
  .hd-video video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-tile);
    border: 1px solid var(--border-strong);
    background: #000;
  }
  .hd-video figcaption {
    display: flex;
    align-items: center;
