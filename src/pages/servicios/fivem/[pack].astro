---
// Página de un pack de scripts FiveM (/servicios/fivem/<pack>): qué incluye, demos jugables
// (la NUI real de cada script dentro de un iframe a 1920×1080 escalado), el desarrollo de
// cada script con su vídeo y capturas, cómo encajan entre ellos y detalles técnicos.
// Contenido en src/data/packs.ts; demos y medios en public/fivem/<pack>/.
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icono from "@/components/servicios/Icono.astro";
import { fivemPacks, type Pack } from "@/data/packs";

export const getStaticPaths = (() => fivemPacks.map((pack) => ({ params: { pack: pack.id }, props: { pack } }))) satisfies GetStaticPaths;

interface Props {
  pack: Pack;
}

const { pack } = Astro.props;
const contacto = `/contacto?tipo=${encodeURIComponent("Script FiveM")}`;
const hero = pack.scripts[0];
---

<BaseLayout title={`${pack.titulo} · Scripts FiveM`} description={pack.lead} image={hero.poster}>
  <article class="page" style={`--acc:${pack.color}`}>
    <div class="glow" aria-hidden="true"></div>
    <div class="container">
      <a href="/servicios/fivem" class="back mono">← cd ../scripts-fivem</a>

      <!-- ── cabecera ── -->
      <header class="head">
        <span class="eyebrow mono"><span class="pill"><i aria-hidden="true"></i> pack</span> scripts fivem · {pack.scripts.length} recursos</span>
        <h1>
          <span class="h1-icon" aria-hidden="true"><Icono nombre={pack.icono} size={34} /></span>
          {pack.titulo}
        </h1>
        <p class="lead">{pack.lead}</p>
        <ul role="list" class="chips mono">
          {pack.chips.map((c) => <li>{c}</li>)}
        </ul>
        <div class="head-actions">
          <a href="#probar" class="btn btn-primary"><Icono nombre="play" size={14} /> Probar las demos</a>
          <a href={contacto} class="btn btn-ghost">Pedir presupuesto <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </header>

      <!-- ── vídeo grande ── -->
      <figure class="hero-video" data-reveal>
        <div class="screen-frame">
          <div class="screen-bar mono">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>FiveM · {hero.recurso}</span>
            <span class="rec"><i aria-hidden="true"></i> grabado de la demo</span>
          </div>
          <video class="vid" src={hero.video} poster={hero.poster} muted loop playsinline preload="metadata" data-autoplay aria-label={`Vídeo: ${hero.nombre}`}></video>
        </div>
        <figcaption class="mono">{hero.nombre}: conversación con el vendedor, consejo, catálogo, giro y compra.</figcaption>
      </figure>

      <!-- ── qué incluye ── -->
      <section class="block">
        <div class="block-head">
          <h2 class="kicker mono">// qué incluye</h2>
          <p class="block-title">Tres scripts, <span>un mismo coche</span></p>
          <p class="block-sub">{pack.resumen}</p>
        </div>
        <ul role="list" class="scripts">
          {
            pack.scripts.map((s, i) => (
              <li class="script" data-reveal style={`--i:${i}`}>
                <a href={`#${s.id}`} class="script__img">
                  <img src={s.poster} alt="" loading="lazy" width="1920" height="1080" />
                  <span class="script__num mono">{String(i + 1).padStart(2, "0")}</span>
                </a>
                <div class="script__body">
                  <span class="script__icon" aria-hidden="true"><Icono nombre={s.icono} size={22} /></span>
                  <div>
                    <h3>{s.nombre}</h3>
                    <span class="mono script__res">{s.recurso}</span>
                  </div>
                </div>
                <p class="script__text">{s.resumen}</p>
                <ul role="list" class="script__keys">
                  {s.claves.map((k) => (
                    <li>
                      <Icono nombre="check" size={16} /> {k}
                    </li>
                  ))}
                </ul>
                <div class="script__foot mono">
                  <a href={`#${s.id}`}>ver desarrollo ↓</a>
                  <button type="button" data-try={s.id}>▶ probar</button>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ── demos jugables ── -->
      <section class="block play" id="probar">
        <div class="play-bg" aria-hidden="true"></div>
        <div class="play-head">
          <span class="live mono"><i aria-hidden="true"></i> demo jugable</span>
          <h2 class="kicker mono">// pruébalo tú</h2>
          <p class="play-title">La interfaz del juego, <span>en tu navegador</span></p>
          <p class="play-sub">Es la misma NUI que corre dentro de FiveM. Lo de alrededor (el coche, el surtidor, la carretera y el servidor) está simulado para que puedas jugar sin instalar nada.</p>
        </div>

        <div class="tabs" role="tablist" aria-label="Demos del pack">
          {
            pack.scripts.map((s, i) => (
              <button type="button" role="tab" class:list={["tab", { "is-on": i === 0 }]} aria-selected={i === 0 ? "true" : "false"} data-tab={s.id}>
                <Icono nombre={s.icono} size={16} />
                {s.nombre}
              </button>
            ))
          }
        </div>

        <div class="play-grid">
          <div class="screen-frame">
            <div class="screen-bar mono">
              <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span data-play-res>{hero.recurso}</span>
              <span class="screen-actions">
                <button type="button" data-reset title="Empezar de nuevo"><Icono nombre="refresh" size={14} /> reiniciar</button>
                <button type="button" data-full title="Pantalla completa"><Icono nombre="monitor" size={14} /> pantalla completa</button>
              </span>
            </div>
            <div class="screen" data-screen>
              <iframe title="Demo jugable" data-frame loading="lazy" tabindex="0"></iframe>
              <button type="button" class="screen-start" data-start>
                <span class="screen-start__btn"><Icono nombre="play" size={22} /></span>
                <span>Cargar la demo</span>
              </button>
            </div>
          </div>

          <aside class="play-side">
            {
              pack.scripts.map((s, i) => (
                <div class="howto" data-howto={s.id} hidden={i !== 0}>
                  <span class="mono howto__k">cómo se juega</span>
                  <h3>{s.demo.titulo}</h3>
                  <ol role="list">
                    {s.demo.pasos.map((p, j) => (
                      <li>
                        <span class="mono">{j + 1}</span>
                        {p}
                      </li>
                    ))}
                  </ol>
                  <p class="howto__note">Haz clic dentro de la pantalla para usar el teclado. También puedes pulsar las teclas que salen abajo a la izquierda.</p>
                </div>
              ))
            }
          </aside>
        </div>
        <p class="play-note mono">Demo de demostración: nada de lo que hagas aquí se guarda ni se envía.</p>
      </section>

      <!-- ── desarrollo ── -->
      <section class="block">
        <div class="block-head">
          <h2 class="kicker mono">// desarrollo</h2>
          <p class="block-title">Cómo está hecho <span>cada script</span></p>
        </div>

        {
          pack.scripts.map((s, i) => (
            <section class:list={["dev", { "dev--rev": i % 2 === 1 }]} id={s.id}>
              <header class="dev__head" data-reveal>
                <span class="dev__num mono">{String(i + 1).padStart(2, "0")}</span>
                <span class="dev__icon" aria-hidden="true"><Icono nombre={s.icono} size={24} /></span>
                <div>
                  <h3>{s.nombre}</h3>
                  <p class="mono">{s.recurso} · {s.sub}</p>
                </div>
              </header>

              <div class="dev__main">
                <div class="dev__media" data-reveal>
                  <div class="screen-frame">
                    <video class="vid" src={s.video} poster={s.poster} muted loop playsinline preload="none" data-autoplay aria-label={`Vídeo: ${s.nombre}`}></video>
                  </div>
                  <dl class="cifras">
                    {s.cifras.map((c) => (
                      <div>
                        <dt>{c.l}</dt>
                        <dd>{c.v}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
                <div class="dev__text" data-reveal>
                  {s.desarrollo.map((p) => <p>{p}</p>)}
                  <button type="button" class="btn btn-ghost dev__try" data-try={s.id}>
                    <Icono nombre="play" size={14} /> Probar {s.nombre.toLowerCase()}
                  </button>
                </div>
              </div>

              <ul role="list" class="funciones">
                {s.funciones.map((f, j) => (
                  <li data-reveal style={`--i:${j % 4}`}>
                    <Icono nombre="check" size={18} />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>

              <ul role="list" class="galeria" data-galeria>
                {s.galeria.map((g, j) => (
                  <li data-reveal style={`--i:${j}`}>
                    <button type="button" data-shot={g.src} data-caption={g.t}>
                      <img src={g.src} alt={g.t} loading="lazy" width="1920" height="1080" />
                      <span>{g.t}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </section>

      <!-- ── cómo encajan ── -->
      <section class="block">
        <div class="block-head">
          <h2 class="kicker mono">// cómo encajan</h2>
          <p class="block-title">Se hablan <span>entre ellos</span></p>
        </div>
        <ul role="list" class="encajan">
          {
            pack.encajan.map((e, i) => (
              <li data-reveal style={`--i:${i}`}>
                <span class="enc__icon">
                  <Icono nombre={e.icono} size={22} />
                </span>
                <strong>{e.t}</strong>
                <p>{e.d}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ── técnico ── -->
      <section class="block">
        <div class="block-head">
          <h2 class="kicker mono">// detalles técnicos</h2>
          <p class="block-title">Por dentro, <span>sin sorpresas</span></p>
        </div>
        <ul role="list" class="tecnico">
          {
            pack.tecnico.map((t, i) => (
              <li data-reveal style={`--i:${i}`}>
                <Icono nombre={t.icono} size={20} />
                <div>
                  <strong>{t.t}</strong>
                  <p>{t.d}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ── preguntas ── -->
      <section class="block">
        <h2 class="kicker mono">// preguntas frecuentes</h2>
        <div class="faq">
          {
            pack.faq.map((f, i) => (
              <details class="faq__item">
                <summary>
                  <span class="faq__n mono">{String(i + 1).padStart(2, "0")}</span>
                  <span>{f.q}</span>
                  <span class="faq__plus" aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <aside class="cta">
        <div>
          <p class="cta-title">¿Quieres el {pack.titulo.toLowerCase()} en tu servidor?</p>
          <p class="cta-sub mono">adaptado a tu estilo · instalación incluida · soporte tras la entrega</p>
        </div>
        <a href={contacto} class="btn btn-primary">Pedir presupuesto <span class="arrow" aria-hidden="true">→</span></a>
      </aside>
    </div>

    <!-- visor de capturas -->
    <dialog class="lightbox" data-lightbox>
      <button type="button" class="lb-close" data-lb-close aria-label="Cerrar">✕</button>
      <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label="Anterior">‹</button>
      <figure>
        <img alt="" data-lb-img />
        <figcaption data-lb-cap></figcaption>
      </figure>
      <button type="button" class="lb-nav lb-next" data-lb-next aria-label="Siguiente">›</button>
    </dialog>
  </article>
</BaseLayout>

<script define:vars={{ demos: pack.scripts.map((s) => ({ id: s.id, url: s.demo.url, recurso: s.recurso })) }}>
  // ── Demos jugables: el iframe se pinta a 1920×1080 (como el juego) y se escala ──
  const screen = document.querySelector("[data-screen]");
  const frame = document.querySelector("[data-frame]");
  const start = document.querySelector("[data-start]");
  let actual = demos[0].id;
  let cargada = false;

  function escalar() {
    const s = screen.clientWidth / 1920;
    frame.style.transform = `scale(${s})`;
  }
  new ResizeObserver(escalar).observe(screen);
  escalar();

  function cargar(id, foco) {
    const d = demos.find((x) => x.id === id);
    actual = id;
    cargada = true;
    frame.src = d.url;
    start.hidden = true;
    document.querySelector("[data-play-res]").textContent = d.recurso;
    if (foco) frame.addEventListener("load", () => frame.focus(), { once: true });
  }

  function elegir(id, cargarYa) {
    document.querySelectorAll("[data-tab]").forEach((t) => {
      const on = t.dataset.tab === id;
      t.classList.toggle("is-on", on);
      t.setAttribute("aria-selected", on ? "true" : "false");
    });
    document.querySelectorAll("[data-howto]").forEach((h) => (h.hidden = h.dataset.howto !== id));
    if (cargarYa || cargada) cargar(id);
    else actual = id;
  }

  document.querySelectorAll("[data-tab]").forEach((t) => t.addEventListener("click", () => elegir(t.dataset.tab, cargada)));
  start.addEventListener("click", () => cargar(actual, true));
  document.querySelector("[data-reset]").addEventListener("click", () => {
    if (cargada) frame.contentWindow.postMessage({ demo: "reset" }, location.origin);
  });
  document.querySelector("[data-full]").addEventListener("click", () => {
    if (!cargada) cargar(actual);
    const el = screen;
    (el.requestFullscreen || el.webkitRequestFullscreen)?.call(el);
  });
  document.addEventListener("fullscreenchange", escalar);

  // «Probar» desde las tarjetas y el desarrollo
  document.querySelectorAll("[data-try]").forEach((b) =>
    b.addEventListener("click", () => {
      elegir(b.dataset.try, true);
      document.getElementById("probar").scrollIntoView({ behavior: "smooth", block: "start" });
    }),
  );

  // ── Vídeos: solo se reproducen mientras se ven ──
  const vids = document.querySelectorAll("video[data-autoplay]");
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const v = e.target;
        if (e.isIntersecting) {
          if (v.preload === "none") v.preload = "auto";
          v.play().catch(() => {});
        } else v.pause();
      }
    },
    { threshold: 0.35 },
  );
  vids.forEach((v) => io.observe(v));

  // ── Visor de capturas ──
  const lb = document.querySelector("[data-lightbox]");
  const shots = [...document.querySelectorAll("[data-shot]")];
  let idx = 0;
  function ver(i) {
    idx = (i + shots.length) % shots.length;
    const b = shots[idx];
    lb.querySelector("[data-lb-img]").src = b.dataset.shot;
    lb.querySelector("[data-lb-img]").alt = b.dataset.caption;
    lb.querySelector("[data-lb-cap]").textContent = b.dataset.caption;
  }
  shots.forEach((b, i) =>
    b.addEventListener("click", () => {
      ver(i);
      lb.showModal();
    }),
  );
  lb.querySelector("[data-lb-close]").addEventListener("click", () => lb.close());
  lb.querySelector("[data-lb-prev]").addEventListener("click", () => ver(idx - 1));
  lb.querySelector("[data-lb-next]").addEventListener("click", () => ver(idx + 1));
  lb.addEventListener("click", (e) => e.target === lb && lb.close());
  lb.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") ver(idx - 1);
    if (e.key === "ArrowRight") ver(idx + 1);
  });
</script>

<style>
  .page {
    position: relative;
    padding-block: var(--space-7) var(--section);
    overflow-x: clip;
  }

  .glow {
    position: absolute;
    inset: 0 0 auto;
    height: 760px;
    background:
      radial-gradient(ellipse 55% 55% at 50% 0%, color-mix(in srgb, var(--acc) 26%, transparent), transparent 70%),
      radial-gradient(ellipse 35% 40% at 90% 15%, color-mix(in srgb, var(--acc) 12%, transparent), transparent 70%);
    pointer-events: none;
    animation: fade-in 1.2s ease both;
  }

  .container {
    position: relative;
  }

  .back {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }

  .back:hover {
    color: var(--fg);
  }

  /* ── cabecera ── */
  .head {
    display: grid;
    justify-items: center;
    max-width: 54rem;
    margin: var(--space-7) auto var(--space-7);
    text-align: center;
  }

  .head > * {
    animation: page-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .head > :nth-child(2) { animation-delay: 0.06s; }
  .head > :nth-child(3) { animation-delay: 0.14s; }
  .head > :nth-child(4) { animation-delay: 0.22s; }
  .head > :nth-child(5) { animation-delay: 0.3s; }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-xs);
    color: var(--fg-subtle);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--acc) 45%, transparent);
    background: color-mix(in srgb, var(--acc) 12%, transparent);
    color: color-mix(in srgb, var(--acc) 70%, var(--fg));
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .pill i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--acc);
  }

  h1 {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-block: var(--space-4) var(--space-4);
    font-size: clamp(2.6rem, 1.6rem + 4.4vw, 5.2rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .h1-icon {
    display: grid;
    place-items: center;
    width: 4.4rem;
    height: 4.4rem;
    flex-shrink: 0;
    border-radius: 20px;
    color: #fff;
    background:
      radial-gradient(circle at 30% 20%, rgb(255 255 255 / 0.35), transparent 50%),
      linear-gradient(145deg, color-mix(in srgb, var(--acc) 80%, #fff), var(--acc) 55%, color-mix(in srgb, var(--acc) 70%, #000));
    box-shadow: 0 20px 50px -18px var(--acc), inset 0 1px 0 rgb(255 255 255 / 0.4);
    animation: float 6s ease-in-out infinite;
  }

  .lead {
    max-width: 44rem;
    font-size: var(--fs-lg);
    color: var(--fg-muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font-size: var(--fs-xs);
  }

  .chips li {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--fg-muted);
  }

  .head-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* ── marcos de pantalla (vídeos y demo) ── */
  .screen-frame {
    position: relative;
    padding: 1.5px;
    border-radius: 18px;
    background: conic-gradient(from var(--ang, 0deg), var(--acc), transparent 25%, transparent 50%, color-mix(in srgb, var(--acc) 60%, #fff), transparent 75%, var(--acc));
    box-shadow: 0 50px 120px -60px color-mix(in srgb, var(--acc) 80%, transparent);
    animation: spin-border 8s linear infinite;
  }

  .screen-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.65rem 1rem;
    border-radius: 17px 17px 0 0;
    background: var(--bg-elev);
    border-bottom: 1px solid var(--border);
    font-size: 0.6875rem;
    color: var(--fg-subtle);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .dots i:nth-child(2) { background: #febc2e; }
  .dots i:nth-child(3) { background: #28c840; }

  .rec {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
  }

  .rec i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ef4444;
    animation: blink 1.2s steps(2, start) infinite;
  }

  .vid {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0b0c10;
    border-radius: 0 0 17px 17px;
    object-fit: cover;
  }

  .screen-frame > .vid:first-child {
    border-radius: 17px;
  }

  .hero-video {
    margin: 0 auto var(--space-9);
    max-width: 64rem;
  }

  .hero-video figcaption {
    margin-top: var(--space-3);
    text-align: center;
    font-size: var(--fs-xs);
    color: var(--fg-subtle);
  }

  /* ── bloques ── */
  .block {
    margin-bottom: var(--space-9);
  }

  .kicker {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--fg-subtle);
    margin-bottom: var(--space-4);
  }

  .block-head {
    display: grid;
    gap: var(--space-1);
    margin-bottom: var(--space-6);
  }

  .block-head .kicker {
    margin-bottom: 0;
  }

  .block-title {
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .block-title span,
  .play-title span {
    color: var(--acc);
  }

  .block-sub {
    max-width: 44rem;
    margin-top: var(--space-2);
    color: var(--fg-muted);
  }

  /* ── tarjetas de los scripts ── */
  .scripts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .script {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-3) var(--space-4);
    border-radius: 22px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    transition:
      border-color 0.3s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s ease;
