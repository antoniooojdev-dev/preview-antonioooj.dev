---
// /pruebas-fivem — propuestas de diseño para el apartado de cada script de las fichas
// /servicios/fivem/<pack> (hoy: el bloque «desarrollo» de [pack].astro). Seis maneras
// distintas de organizar lo mismo (captura/vídeo, cifras, cómo está hecho, funciones y
// capturas), con los datos reales de src/data/packs.ts. Arriba se elige diseño y pack
// (?d=1..6&pack=<id>). Cuando se elija uno, se pasa a [pack].astro y esta página se borra.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icono from "@/components/servicios/Icono.astro";
import { fivemPacks, type Pack, type PackScript } from "@/data/packs";

const disenos = [
  { n: 1, t: "Portada", d: "Cada script abre con una captura a todo el ancho y el nombre encima, como la portada de una revista. Debajo, cifras grandes, el texto y las funciones a dos columnas y una tira de capturas que se desliza." },
  { n: 2, t: "Pestañas", d: "Una tarjeta por script: a la izquierda un visor con miniaturas, a la derecha pestañas (qué hace, cómo está hecho, funciones). Corto de alto y todo a mano." },
  { n: 3, t: "Columna fija", d: "La captura, el nombre y las cifras se quedan fijos a la izquierda mientras a la derecha bajas por el texto, las funciones en tarjetas y las capturas." },
  { n: 4, t: "Bento", d: "Todo el script en una cuadrícula de bloques de distintos tamaños: vídeo, cifras sueltas, texto, funciones y capturas encajadas." },
  { n: 5, t: "Línea de tiempo", d: "El desarrollo contado por pasos en una línea vertical, cada paso con su captura al lado. Las funciones cierran como lista compacta." },
  { n: 6, t: "Navegador", d: "Un solo panel para todo el pack: lista de scripts a la izquierda y, al elegir uno, su visor, texto, funciones y cifras a la derecha. Sin scroll largo." },
];

const n2 = (i: number) => String(i + 1).padStart(2, "0");
const conVideo = (p: Pack, s: PackScript) => Boolean(s.video && s.video !== p.video);
const fichaDe = (p: Pack) => `/servicios/fivem/${p.id}`;
---

<BaseLayout title="Pruebas · fichas FiveM" noindex intro={false}>
  <div class="pf" data-no-i18n>
    <!-- ── selector ── -->
    <div class="pf-bar">
      <div class="container pf-bar__in">
        <div class="pf-grupo" role="group" aria-label="Diseño">
          <span class="pf-grupo__t mono">Diseño</span>
          {disenos.map((d, i) => (
            <button type="button" class:list={["pf-btn", { "is-on": i === 0 }]} data-elige-d={d.n}>
              <b class="mono">{d.n}</b> {d.t}
            </button>
          ))}
        </div>
        <div class="pf-grupo" role="group" aria-label="Pack">
          <span class="pf-grupo__t mono">Pack</span>
          {fivemPacks.map((p, i) => (
            <button type="button" class:list={["pf-btn", { "is-on": i === 0 }]} data-elige-pack={p.id}>
              {p.titulo}
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="container">
      <header class="pf-head">
        {disenos.map((d, i) => (
          <div data-desc={d.n} hidden={i !== 0}>
            <p class="pf-head__n mono">Propuesta {d.n} de {disenos.length}</p>
            <h1>{d.t}</h1>
            <p class="pf-head__d">{d.d}</p>
          </div>
        ))}
      </header>

      {fivemPacks.map((p, ip) => (
        <>
          <!-- ════════ 1 · PORTADA ════════ -->
          <section class="d1" data-d="1" data-pack={p.id} hidden={ip !== 0}>
            {p.scripts.map((s, i) => (
              <article class="d1-s">
                <figure class="d1-hero">
                  {conVideo(p, s) ? (
                    <video src={s.video} poster={s.poster} muted loop playsinline preload="none" data-autoplay />
                  ) : (
                    <img src={s.poster} alt="" loading="lazy" width="1920" height="1080" />
                  )}
                  <span class="d1-num" aria-hidden="true">{n2(i)}</span>
                  <figcaption>
                    <span class="mono">{s.recurso}</span>
                    <h2>{s.nombre}</h2>
                    <p>{s.sub}</p>
                  </figcaption>
                </figure>

                <dl class="d1-cifras">
                  {s.cifras.map((c) => (
                    <div>
                      <dd>{c.v}</dd>
                      <dt>{c.l}</dt>
                    </div>
                  ))}
                </dl>

                <div class="d1-cols">
                  <div class="d1-texto">
                    <p class="d1-lead">{s.resumen}</p>
                    {s.desarrollo.map((t) => <p>{t}</p>)}
                    <div class="d1-acc">
                      {s.demo && <a class="btn btn-primary" href={`${fichaDe(p)}#probar`}><Icono nombre="play" size={14} /> Probar la demo</a>}
                    </div>
                  </div>
                  <div>
                    <p class="pf-label mono">Lo que hace</p>
                    <ol class="d1-fun" role="list">
                      {s.funciones.map((f, j) => (
                        <li><span class="mono">{n2(j)}</span>{f}</li>
                      ))}
                    </ol>
                  </div>
                </div>

                {s.galeria.length > 0 && (
                  <ul class="d1-tira" role="list">
                    {s.galeria.map((g) => (
                      <li>
                        <button type="button" data-shot={g.src} data-caption={g.t}>
                          <img src={g.src} alt={g.t} loading="lazy" width="1920" height="1080" />
                          <span>{g.t}</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </section>

          <!-- ════════ 2 · PESTAÑAS ════════ -->
          <section class="d2" data-d="2" data-pack={p.id} hidden>
            {p.scripts.map((s, i) => {
              const fotos = s.galeria.length ? s.galeria : [{ src: s.poster, t: s.nombre }];
              return (
                <article class="d2-s">
                  <div class="d2-visor" data-visor>
                    <button type="button" class="d2-main" data-shot={fotos[0].src} data-caption={fotos[0].t} data-visor-main>
                      <img src={fotos[0].src} alt={fotos[0].t} loading="lazy" width="1920" height="1080" data-visor-img />
                    </button>
                    <p class="d2-cap" data-visor-cap>{fotos[0].t}</p>
                    {fotos.length > 1 && (
                      <ul class="d2-thumbs" role="list">
                        {fotos.map((g, j) => (
                          <li>
                            <button type="button" class:list={{ "is-on": j === 0 }} data-thumb={g.src} data-caption={g.t} aria-label={g.t}>
                              <img src={g.src} alt="" loading="lazy" width="1920" height="1080" />
                            </button>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>

                  <div class="d2-info" data-tabs>
                    <header class="d2-head">
                      <span class="d2-num mono">{n2(i)}</span>
                      <div>
                        <h2>{s.nombre}</h2>
                        <p class="mono">{s.recurso} · {s.sub}</p>
                      </div>
                    </header>
                    <div class="d2-tabs" role="tablist">
                      <button type="button" role="tab" class="is-on" data-tab="que">Qué hace</button>
                      <button type="button" role="tab" data-tab="como">Cómo está hecho</button>
                      <button type="button" role="tab" data-tab="fun">Funciones <span class="mono">{s.funciones.length}</span></button>
                    </div>
                    <div class="d2-panel" data-panel="que">
                      <p class="d2-res">{s.resumen}</p>
                      <ul role="list" class="d2-claves">
                        {s.claves.map((k) => <li><Icono nombre="check" size={16} />{k}</li>)}
                      </ul>
                    </div>
                    <div class="d2-panel" data-panel="como" hidden>
                      {s.desarrollo.map((t) => <p>{t}</p>)}
                    </div>
                    <div class="d2-panel d2-panel--fun" data-panel="fun" hidden data-lenis-prevent>
                      <ul role="list">
                        {s.funciones.map((f) => <li><Icono nombre="check" size={16} />{f}</li>)}
                      </ul>
                    </div>
                    <dl class="d2-cifras">
                      {s.cifras.map((c) => (
                        <div><dd>{c.v}</dd><dt>{c.l}</dt></div>
                      ))}
                    </dl>
                    {s.demo && <a class="d2-probar mono" href={`${fichaDe(p)}#probar`}>Probar la demo →</a>}
                  </div>
                </article>
              );
            })}
          </section>

          <!-- ════════ 3 · COLUMNA FIJA ════════ -->
          <section class="d3" data-d="3" data-pack={p.id} hidden>
            {p.scripts.map((s, i) => (
              <article class="d3-s">
                <aside class="d3-fija">
                  <div class="d3-fija__in">
                    {conVideo(p, s) ? (
                      <video src={s.video} poster={s.poster} muted loop playsinline preload="none" data-autoplay />
                    ) : (
                      <img src={s.poster} alt="" loading="lazy" width="1920" height="1080" />
                    )}
                    <p class="mono d3-n">{n2(i)} / {n2(p.scripts.length - 1)}</p>
                    <h2>{s.nombre}</h2>
                    <p class="d3-sub">{s.sub}</p>
                    <dl class="d3-cifras">
                      {s.cifras.map((c) => (
                        <div><dt>{c.l}</dt><span aria-hidden="true"></span><dd>{c.v}</dd></div>
                      ))}
                    </dl>
                    <div class="d3-acc">
                      {s.demo && <a class="btn btn-primary" href={`${fichaDe(p)}#probar`}><Icono nombre="play" size={14} /> Probar</a>}
                      <span class="mono d3-rec">{s.recurso}</span>
                    </div>
                  </div>
                </aside>

                <div class="d3-flujo">
                  <p class="d3-res">{s.resumen}</p>

                  <p class="pf-label mono">Cómo está hecho</p>
                  <div class="d3-dev">
                    {s.desarrollo.map((t, j) => (
                      <div><span class="mono">{n2(j)}</span><p>{t}</p></div>
                    ))}
                  </div>

                  <p class="pf-label mono">Funciones</p>
                  <ul role="list" class="d3-fun">
                    {s.funciones.map((f) => <li>{f}</li>)}
                  </ul>

                  {s.galeria.length > 0 && (
                    <>
                      <p class="pf-label mono">Capturas</p>
                      <ul role="list" class="d3-gal">
                        {s.galeria.map((g) => (
                          <li>
                            <button type="button" data-shot={g.src} data-caption={g.t}>
                              <img src={g.src} alt={g.t} loading="lazy" width="1920" height="1080" />
                              <span>{g.t}</span>
                            </button>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                </div>
              </article>
            ))}
          </section>

          <!-- ════════ 4 · BENTO ════════ -->
          <section class="d4" data-d="4" data-pack={p.id} hidden>
            {p.scripts.map((s, i) => (
              <article class="d4-s">
                <div class="d4-t d4-media">
                  {conVideo(p, s) ? (
                    <video src={s.video} poster={s.poster} muted loop playsinline preload="none" data-autoplay />
                  ) : (
                    <img src={s.poster} alt="" loading="lazy" width="1920" height="1080" />
                  )}
                </div>
                <div class="d4-t d4-tit">
                  <span class="mono">{n2(i)} · {s.recurso}</span>
                  <h2>{s.nombre}</h2>
                  <p>{s.resumen}</p>
                </div>
                {s.cifras.map((c) => (
                  <div class="d4-t d4-cifra">
                    <b>{c.v}</b>
                    <span>{c.l}</span>
                  </div>
                ))}
                <div class="d4-t d4-dev">
                  <p class="pf-label mono">Cómo está hecho</p>
                  {s.desarrollo.map((t) => <p>{t}</p>)}
                </div>
                <div class="d4-t d4-fun">
                  <p class="pf-label mono">Funciones · {s.funciones.length}</p>
                  <ul role="list">
                    {s.funciones.map((f) => <li>{f}</li>)}
                  </ul>
                </div>
                {s.galeria.slice(0, 3).map((g) => (
                  <button type="button" class="d4-t d4-foto" data-shot={g.src} data-caption={g.t}>
                    <img src={g.src} alt={g.t} loading="lazy" width="1920" height="1080" />
                    <span>{g.t}</span>
                  </button>
                ))}
                <a class="d4-t d4-cta" href={s.demo ? `${fichaDe(p)}#probar` : `/contacto?tipo=${encodeURIComponent("Script FiveM")}`}>
                  <span class="mono">{s.demo ? "demo jugable" : "a medida"}</span>
                  <b>{s.demo ? "Pruébalo en el navegador" : "Pedir presupuesto"}</b>
                  <Icono nombre="arrow" size={22} />
                </a>
              </article>
            ))}
          </section>

          <!-- ════════ 5 · LÍNEA DE TIEMPO ════════ -->
          <section class="d5" data-d="5" data-pack={p.id} hidden>
            {p.scripts.map((s, i) => (
              <article class="d5-s">
                <header class="d5-head">
                  <span class="d5-num">{n2(i)}</span>
                  <div>
                    <h2>{s.nombre}</h2>
                    <p>{s.resumen}</p>
                    <ul role="list" class="d5-cifras mono">
                      {s.cifras.map((c) => <li><b>{c.v}</b> {c.l}</li>)}
                    </ul>
                  </div>
                </header>

                <ol role="list" class="d5-linea">
                  {s.desarrollo.map((t, j) => {
                    const g = s.galeria[j] ?? (j === 0 ? { src: s.poster, t: s.nombre } : null);
                    return (
                      <li class="d5-paso">
                        <span class="d5-punto mono" aria-hidden="true">{j + 1}</span>
                        <p>{t}</p>
                        {g && (
                          <button type="button" data-shot={g.src} data-caption={g.t}>
                            <img src={g.src} alt={g.t} loading="lazy" width="1920" height="1080" />
                            <span>{g.t}</span>
                          </button>
                        )}
                      </li>
                    );
                  })}
                </ol>

                {s.galeria.length > s.desarrollo.length && (
                  <ul role="list" class="d5-mas">
                    {s.galeria.slice(s.desarrollo.length).map((g) => (
                      <li>
                        <button type="button" data-shot={g.src} data-caption={g.t}>
                          <img src={g.src} alt={g.t} loading="lazy" width="1920" height="1080" />
                        </button>
                      </li>
                    ))}
                  </ul>
                )}

                <div class="d5-fun">
                  <p class="pf-label mono">Todo lo que hace</p>
                  <ul role="list">
                    {s.funciones.map((f) => <li>{f}</li>)}
                  </ul>
                </div>
              </article>
            ))}
          </section>

          <!-- ════════ 6 · NAVEGADOR ════════ -->
          <section class="d6" data-d="6" data-pack={p.id} hidden data-nav>
            <nav class="d6-lista" aria-label="Scripts del pack">
              <p class="mono d6-ruta">resources / {p.id}</p>
              {p.scripts.map((s, i) => (
                <button type="button" class:list={["d6-item", { "is-on": i === 0 }]} data-nav-btn={s.id}>
                  <span class="mono">{n2(i)}</span>
                  <span>
                    <b>{s.nombre}</b>
                    <small class="mono">{s.recurso}</small>
                  </span>
                </button>
              ))}
              <a class="btn btn-primary d6-pres" href={`/contacto?tipo=${encodeURIComponent("Script FiveM")}`}>Pedir presupuesto</a>
            </nav>

            <div class="d6-paneles">
              {p.scripts.map((s, i) => {
                const fotos = s.galeria.length ? s.galeria : [{ src: s.poster, t: s.nombre }];
                return (
                  <div class="d6-panel" data-nav-panel={s.id} hidden={i !== 0}>
                    <div class="d6-visor" data-visor>
                      <button type="button" class="d6-main" data-shot={fotos[0].src} data-caption={fotos[0].t} data-visor-main>
                        <img src={fotos[0].src} alt={fotos[0].t} loading="lazy" width="1920" height="1080" data-visor-img />
                        <span class="d6-cap" data-visor-cap>{fotos[0].t}</span>
                      </button>
                      {fotos.length > 1 && (
                        <ul class="d6-thumbs" role="list">
                          {fotos.map((g, j) => (
                            <li>
                              <button type="button" class:list={{ "is-on": j === 0 }} data-thumb={g.src} data-caption={g.t} aria-label={g.t}>
                                <img src={g.src} alt="" loading="lazy" width="1920" height="1080" />
                              </button>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                    <header class="d6-head">
                      <h2>{s.nombre}</h2>
                      <p>{s.sub}</p>
                      {s.demo && <a class="mono d6-probar" href={`${fichaDe(p)}#probar`}>▶ probar</a>}
                    </header>
                    <div class="d6-cols">
                      <div class="d6-dev">
                        <p class="pf-label mono">Cómo está hecho</p>
                        {s.desarrollo.map((t) => <p>{t}</p>)}
                      </div>
                      <div>
                        <p class="pf-label mono">Funciones</p>
                        <ul role="list" class="d6-fun">
                          {s.funciones.map((f) => <li>{f}</li>)}
                        </ul>
                      </div>
                      <dl class="d6-cifras">
                        {s.cifras.map((c) => (
                          <div><dd>{c.v}</dd><dt>{c.l}</dt></div>
                        ))}
                      </dl>
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        </>
      ))}
    </div>

    <!-- visor de capturas (común a todos los diseños) -->
    <dialog class="pf-lb" data-lb aria-label="Captura">
      <button type="button" class="pf-lb__x" data-lb-x aria-label="Cerrar">✕</button>
      <button type="button" class="pf-lb__nav pf-lb__prev" data-lb-prev aria-label="Anterior">‹</button>
      <figure>
        <img alt="" data-lb-img />
        <figcaption data-lb-cap></figcaption>
      </figure>
      <button type="button" class="pf-lb__nav pf-lb__next" data-lb-next aria-label="Siguiente">›</button>
    </dialog>
  </div>
</BaseLayout>

<script>
  // ── Selector de diseño y pack (se guarda en la URL: ?d=3&pack=sistema-bandas) ──
  const q = new URLSearchParams(location.search);
  let d = q.get("d") ?? "1";
  let pack = q.get("pack") ?? document.querySelector<HTMLElement>("[data-elige-pack]")!.dataset.eligePack!;

  const vids = document.querySelectorAll<HTMLVideoElement>("video[data-autoplay]");
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) { v.preload = "auto"; v.play().catch(() => {}); } else v.pause();
    }),
    { threshold: 0.3 },
  );
  vids.forEach((v) => io.observe(v));

  function pintar() {
    document.querySelectorAll<HTMLElement>("[data-d][data-pack]").forEach((s) => (s.hidden = !(s.dataset.d === d && s.dataset.pack === pack)));
    document.querySelectorAll<HTMLElement>("[data-desc]").forEach((s) => (s.hidden = s.dataset.desc !== d));
    document.querySelectorAll<HTMLElement>("[data-elige-d]").forEach((b) => b.classList.toggle("is-on", b.dataset.eligeD === d));
    document.querySelectorAll<HTMLElement>("[data-elige-pack]").forEach((b) => b.classList.toggle("is-on", b.dataset.eligePack === pack));
    history.replaceState(null, "", `?d=${d}&pack=${pack}`);
  }
  document.querySelectorAll<HTMLElement>("[data-elige-d]").forEach((b) =>
    b.addEventListener("click", () => { d = b.dataset.eligeD!; pintar(); scrollTo({ top: 0, behavior: "smooth" }); }),
  );
  document.querySelectorAll<HTMLElement>("[data-elige-pack]").forEach((b) =>
    b.addEventListener("click", () => { pack = b.dataset.eligePack!; pintar(); }),
  );
  pintar();

  // ── Pestañas (diseño 2) ──
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((c) => {
    const tabs = [...c.querySelectorAll<HTMLElement>("[data-tab]")];
    tabs.forEach((t) =>
      t.addEventListener("click", () => {
        tabs.forEach((x) => x.classList.toggle("is-on", x === t));
        c.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => (p.hidden = p.dataset.panel !== t.dataset.tab));
      }),
    );
  });

  // ── Visor con miniaturas (diseños 2 y 6) ──
  document.querySelectorAll<HTMLElement>("[data-visor]").forEach((v) => {
    const main = v.querySelector<HTMLElement>("[data-visor-main]")!;
    const img = v.querySelector<HTMLImageElement>("[data-visor-img]")!;
    const cap = v.querySelector<HTMLElement>("[data-visor-cap]");
    const th = [...v.querySelectorAll<HTMLElement>("[data-thumb]")];
    th.forEach((b) =>
      b.addEventListener("click", () => {
        th.forEach((x) => x.classList.toggle("is-on", x === b));
        img.src = b.dataset.thumb!;
        img.alt = b.dataset.caption!;
        main.dataset.shot = b.dataset.thumb!;
        main.dataset.caption = b.dataset.caption!;
        if (cap) cap.textContent = b.dataset.caption!;
        img.animate([{ opacity: 0.3 }, { opacity: 1 }], { duration: 250 });
      }),
    );
  });

  // ── Navegador (diseño 6) ──
  document.querySelectorAll<HTMLElement>("[data-nav]").forEach((n) => {
    const bs = [...n.querySelectorAll<HTMLElement>("[data-nav-btn]")];
    bs.forEach((b) =>
      b.addEventListener("click", () => {
        bs.forEach((x) => x.classList.toggle("is-on", x === b));
        n.querySelectorAll<HTMLElement>("[data-nav-panel]").forEach((p) => (p.hidden = p.dataset.navPanel !== b.dataset.navBtn));
      }),
    );
  });

  // ── Visor de capturas: recorre las capturas del diseño y pack que se ven ──
  const lb = document.querySelector<HTMLDialogElement>("[data-lb]")!;
  const lbImg = lb.querySelector<HTMLImageElement>("[data-lb-img]")!;
  const lbCap = lb.querySelector<HTMLElement>("[data-lb-cap]")!;
  let lista: HTMLElement[] = [];
  let idx = 0;
  const ver = (i: number) => {
    idx = (i + lista.length) % lista.length;
    lbImg.src = lista[idx].dataset.shot!;
    lbCap.textContent = `${idx + 1} / ${lista.length} · ${lista[idx].dataset.caption}`;
  };
  document.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>("[data-shot]");
    if (!b) return;
    const sec = b.closest<HTMLElement>("[data-d]")!;
    lista = [...sec.querySelectorAll<HTMLElement>("[data-shot]")].filter((x) => !x.closest("[hidden]"));
    ver(lista.indexOf(b));
    lb.showModal();
  });
  lb.querySelector("[data-lb-x]")!.addEventListener("click", () => lb.close());
  lb.querySelector("[data-lb-prev]")!.addEventListener("click", () => ver(idx - 1));
  lb.querySelector("[data-lb-next]")!.addEventListener("click", () => ver(idx + 1));
  lb.addEventListener("click", (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") ver(idx - 1);
    if (e.key === "ArrowRight") ver(idx + 1);
  });
</script>

