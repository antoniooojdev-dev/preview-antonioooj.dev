---
// /pruebas-fivem — propuesta de ficha de pack FiveM al estilo de una tienda de scripts:
// visor de vídeo/capturas con miniaturas a la izquierda, caja de compra a la derecha,
// tira de puntos fuertes, pestañas (descripción, scripts, técnico, preguntas) y otros packs
// abajo. Monocromo como el resto de la web. Datos reales de src/data/packs.ts; arriba se
// elige el pack (?pack=<id>). Cuando guste, se pasa a /servicios/fivem/[pack].astro.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { fivemPacks, type Pack } from "@/data/packs";

const FW = ["ESX Legacy", "QBCore", "Qbox"];
const corto: Record<string, string> = { "ESX Legacy": "ESX", QBCore: "QB", Qbox: "QBOX" };
const frameworks = (p: Pack) => FW.filter((f) => p.chips.includes(f));
// puntos fuertes: los chips que no son frameworks ni el número de scripts
const fuertes = (p: Pack) => p.chips.filter((c) => !FW.includes(c) && !/^\d+ scripts?$/.test(c)).slice(0, 4);

type Medio = { tipo: "video" | "img"; src: string; poster?: string; t: string };
const medios = (p: Pack): Medio[] => {
  const out: Medio[] = [];
  const vistos = new Set<string>();
  for (const s of p.scripts) {
    if (s.video && !vistos.has(s.video)) {
      vistos.add(s.video);
      out.push({ tipo: "video", src: s.video, poster: s.poster, t: `${s.nombre} en vídeo` });
    }
    for (const g of s.galeria) {
      if (vistos.has(g.src)) continue;
      vistos.add(g.src);
      out.push({ tipo: "img", src: g.src, t: g.t });
    }
  }
  return out;
};
const ficha = (p: Pack) => `/servicios/fivem/${p.id}`;
const contacto = `/contacto?tipo=${encodeURIComponent("Script FiveM")}`;
const pestanas = ["Descripción", "Scripts incluidos", "Detalles técnicos", "Preguntas frecuentes"];
---

<BaseLayout title="Pruebas · ficha FiveM" noindex intro={false}>
  <div class="tf" data-no-i18n>
    <div class="tf-bar">
      <div class="container tf-bar__in">
        <span class="mono tf-bar__t">Pack</span>
        {fivemPacks.map((p, i) => (
          <button type="button" class:list={["tf-chip", { "is-on": i === 0 }]} data-elige={p.id}>{p.titulo}</button>
        ))}
      </div>
    </div>

    {fivemPacks.map((p, ip) => {
      const ms = medios(p);
      const fws = frameworks(p);
      const otros = fivemPacks.filter((o) => o.id !== p.id);
      const demo = p.scripts.some((s) => s.demo);
      return (
        <article class="container tf-pack" data-pack={p.id} hidden={ip !== 0}>
          <nav class="tf-migas mono" aria-label="Migas">
            <a href="/servicios/fivem">Scripts FiveM</a><span>›</span><a href="/servicios/fivem#scripts">Packs</a><span>›</span><b>{p.titulo}</b>
          </nav>

          <div class="tf-top">
            <div class="tf-visor caja">
              <div class="tf-visor__esc">
                {ms.map((m, i) => (
                  <figure class="tf-medio" data-i={i} hidden={i !== 0}>
                    {m.tipo === "video"
                      ? <video src={m.src} poster={m.poster} muted loop playsinline controls preload="none"></video>
                      : <img src={m.src} alt={m.t} loading={i === 0 ? "eager" : "lazy"} />}
                    <figcaption>{m.t}</figcaption>
                  </figure>
                ))}
                <button class="tf-flecha tf-flecha--a" type="button" data-paso="-1" aria-label="Anterior">‹</button>
                <button class="tf-flecha tf-flecha--s" type="button" data-paso="1" aria-label="Siguiente">›</button>
                <span class="tf-cont mono"><b data-n>1</b> / {ms.length}</span>
              </div>
              <div class="tf-minis">
                {ms.map((m, i) => (
                  <button type="button" class:list={["tf-mini", { "is-on": i === 0 }]} data-ir={i} aria-label={m.t}>
                    <img src={m.tipo === "video" ? m.poster : m.src} alt="" loading="lazy" />
                    {m.tipo === "video" && <span class="tf-mini__play">▶</span>}
                  </button>
                ))}
              </div>
            </div>

            <aside class="tf-info">
              <div class="tf-tags">
                <span class="tag">Scripts</span>
                <span class="tag">{p.scripts.length > 1 ? "Pack" : "Script"}</span>
                <span class="tag tag--neg">{p.etiqueta ?? `${p.scripts.length} ${p.scripts.length === 1 ? "script" : "scripts"}`}</span>
              </div>
              <h1 class="tf-h1">{p.titulo}</h1>
              <p class="tf-lead">{p.resumen}</p>
              <div class="tf-fw">{fws.map((f) => <span class="fw" title={f}>{corto[f]}</span>)}</div>

              <div class="caja tf-compra">
                <p class="tf-precio">A medida</p>
                <p class="tf-precio__sub">Lo adapto a tu servidor: framework, textos, precios y estilo.</p>
                <a href={contacto} class="tf-cta">Pedir presupuesto</a>
                <div class="tf-sec">
                  {demo && <a href={`${ficha(p)}#probar`} class="tf-mini-btn">▶ Probar la demo</a>}
                  <button type="button" class="tf-mini-btn" data-copiar={ficha(p)}>Copiar enlace</button>
                  <a href={ficha(p)} class="tf-mini-btn">Ficha actual</a>
                </div>
                <p class="tf-nota">Validado en servidor real · Interfaces propias · En español</p>
              </div>

              <div class="caja tf-incluye">
                <p class="tf-incluye__t">Incluye</p>
                <ul>
                  {p.scripts.map((s) => (
                    <li><b>{s.nombre}</b><span>{s.sub}</span></li>
                  ))}
                </ul>
              </div>
            </aside>
          </div>

          <ul class="tf-fuertes">
            {fuertes(p).map((f) => (
              <li class="caja"><span class="tf-check" aria-hidden="true">✓</span>{f}</li>
            ))}
          </ul>

          <div class="tf-tabs" role="tablist">
            {pestanas.map((t, i) => (
              <button type="button" role="tab" class:list={["tf-tab", { "is-on": i === 0 }]} data-tab={i}>{t}</button>
            ))}
          </div>

          <div class="caja tf-panel" data-panel="0">
            <div class="tf-cols">
              <p class="tf-intro">{p.lead}</p>
              {p.scripts.map((s) => (
                <section class="tf-grupo">
                  <h3>{s.nombre}</h3>
                  <ul class="tf-lista">{s.funciones.map((f) => <li>{f}</li>)}</ul>
                </section>
              ))}
              <section class="tf-grupo">
                <h3>Compatibilidad</h3>
                <ul class="tf-lista">
                  <li>Frameworks: {fws.join(", ")}</li>
                  {[...new Set(p.scripts.map((s) => s.recurso))].map((r) => <li>Recurso <code>{r}</code></li>)}
                </ul>
              </section>
            </div>
          </div>

          <div class="caja tf-panel" data-panel="1" hidden>
            <div class="tf-scripts">
              {p.scripts.map((s) => (
                <section class="tf-script">
                  <img src={s.poster} alt="" loading="lazy" />
                  <div>
                    <p class="mono tf-script__r">{s.recurso}</p>
                    <h3>{s.nombre}</h3>
                    <p class="tf-script__sub">{s.sub}</p>
                    <p>{s.resumen}</p>
                    <dl class="tf-cifras">
                      {s.cifras.map((c) => <div><dt>{c.v}</dt><dd>{c.l}</dd></div>)}
                    </dl>
                    <details class="tf-dev">
                      <summary>Cómo está hecho</summary>
                      {s.desarrollo.map((d) => <p>{d}</p>)}
                    </details>
                  </div>
                </section>
              ))}
            </div>
          </div>

          <div class="caja tf-panel" data-panel="2" hidden>
            <div class="tf-tec">
              {[...p.tecnico, ...p.encajan].map((t) => (
                <div class="tf-tec__i"><h3>{t.t}</h3><p>{t.d}</p></div>
              ))}
            </div>
          </div>

          <div class="caja tf-panel" data-panel="3" hidden>
            <div class="tf-faq">
              {p.faq.map((f, i) => (
                <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
              ))}
            </div>
          </div>

          <div class="tf-otros">
            <h2 class="tf-h2">También te puede interesar</h2>
            <div class="tf-cards">
              {otros.map((o) => (
                <button type="button" class="caja tf-card" data-elige={o.id}>
                  <span class="tf-card__img"><img src={o.scripts[0].poster} alt="" loading="lazy" /><span class="tag tag--neg">{o.scripts.length} {o.scripts.length === 1 ? "script" : "scripts"}</span></span>
                  <span class="mono tf-card__k">Scripts</span>
                  <b>{o.titulo}</b>
                  <span class="tf-card__d">{o.resumen}</span>
                  <span class="tf-fw">{frameworks(o).map((f) => <span class="fw">{corto[f]}</span>)}</span>
                  <span class="tf-card__pie"><span>A medida</span><span class="tf-card__ir" aria-hidden="true">→</span></span>
                </button>
              ))}
            </div>
          </div>
        </article>
      );
    })}
  </div>
</BaseLayout>

<script>
  const packs = [...document.querySelectorAll<HTMLElement>(".tf-pack")];
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".tf-chip")];

  function mostrar(id: string, subir = false) {
    if (!packs.some((p) => p.dataset.pack === id)) return;
    packs.forEach((p) => {
      p.hidden = p.dataset.pack !== id;
      if (p.hidden) p.querySelectorAll("video").forEach((v) => v.pause());
    });
    chips.forEach((c) => c.classList.toggle("is-on", c.dataset.elige === id));
    const u = new URL(location.href);
    u.searchParams.set("pack", id);
    history.replaceState(null, "", u);
    if (subir) window.scrollTo({ top: 0, behavior: "smooth" });
  }
  document.querySelectorAll<HTMLElement>("[data-elige]").forEach((b) =>
    b.addEventListener("click", () => mostrar(b.dataset.elige!, b.classList.contains("tf-card"))),
  );
  const ini = new URLSearchParams(location.search).get("pack");
  if (ini) mostrar(ini);

  packs.forEach((pack) => {
    // visor
    const medios = [...pack.querySelectorAll<HTMLElement>(".tf-medio")];
    const minis = [...pack.querySelectorAll<HTMLButtonElement>(".tf-mini")];
    const n = pack.querySelector<HTMLElement>("[data-n]")!;
    let actual = 0;
    const ir = (i: number) => {
      actual = (i + medios.length) % medios.length;
      medios.forEach((m, k) => {
        m.hidden = k !== actual;
        const v = m.querySelector("video");
        if (v) {
          if (k === actual) v.play().catch(() => {});
          else v.pause();
        }
      });
      minis.forEach((m, k) => m.classList.toggle("is-on", k === actual));
      const fila = minis[actual]?.parentElement;
      if (fila && minis[actual]) fila.scrollTo({ left: minis[actual].offsetLeft - fila.clientWidth / 2 + 52, behavior: "smooth" });
      n.textContent = String(actual + 1);
    };
    minis.forEach((m) => m.addEventListener("click", () => ir(Number(m.dataset.ir))));
    pack.querySelectorAll<HTMLButtonElement>("[data-paso]").forEach((b) =>
      b.addEventListener("click", () => ir(actual + Number(b.dataset.paso))),
    );

    // pestañas
    const tabs = [...pack.querySelectorAll<HTMLButtonElement>(".tf-tab")];
    const paneles = [...pack.querySelectorAll<HTMLElement>(".tf-panel")];
    tabs.forEach((t) =>
      t.addEventListener("click", () => {
        tabs.forEach((x) => x.classList.toggle("is-on", x === t));
        paneles.forEach((p) => (p.hidden = p.dataset.panel !== t.dataset.tab));
      }),
    );

    // copiar enlace
    pack.querySelectorAll<HTMLButtonElement>("[data-copiar]").forEach((b) =>
      b.addEventListener("click", async () => {
        const txt = b.textContent;
        try {
          await navigator.clipboard.writeText(new URL(b.dataset.copiar!, location.origin).href);
          b.textContent = "Copiado ✓";
        } catch {
          b.textContent = "No se pudo copiar";
        }
        setTimeout(() => (b.textContent = txt), 1600);
      }),
    );
  });
</script>

<style>
  .tf {
    --b: 2px solid var(--fg);
    --sombra: 4px 4px 0 var(--fg);
    --r: 12px;
    padding-bottom: var(--space-9);
    background:
      repeating-linear-gradient(115deg, transparent 0 90px, color-mix(in srgb, var(--fg) 3%, transparent) 90px 180px),
      var(--bg);
  }
  .caja {
    border: var(--b);
    border-radius: var(--r);
    background: var(--bg-elev, var(--bg));
    box-shadow: var(--sombra);
  }
  [hidden] { display: none !important; }

  .tf-bar {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .tf-bar__in { display: flex; gap: 8px; align-items: center; padding-block: 10px; overflow-x: auto; }
  .tf-bar__t { font-size: var(--fs-xs); color: var(--fg-muted); text-transform: uppercase; margin-right: 4px; }
  .tf-chip {
    white-space: nowrap; border: 1.5px solid var(--border-strong); border-radius: 999px;
    padding: 6px 14px; font-size: var(--fs-sm); background: none; color: var(--fg); cursor: pointer;
  }
  .tf-chip.is-on { background: var(--fg); color: var(--bg); border-color: var(--fg); }

  .tf-pack { padding-top: var(--space-5); }
  .tf-migas { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: var(--fs-xs); margin-bottom: var(--space-4); }
  .tf-migas a, .tf-migas b {
    border: 1.5px solid var(--fg); border-radius: 6px; padding: 3px 9px; color: var(--fg);
    text-decoration: none; box-shadow: 2px 2px 0 var(--fg); font-weight: 600; background: var(--bg);
  }
  .tf-migas span { color: var(--fg-muted); }

  .tf-top { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(300px, 1fr); gap: var(--space-5); align-items: start; }
  .tf-visor { padding: 10px; min-width: 0; }
  .tf-visor__esc { position: relative; aspect-ratio: 16 / 9; border-radius: 8px; overflow: hidden; background: #0b0b0b; }
  .tf-medio { position: absolute; inset: 0; margin: 0; }
  .tf-medio img, .tf-medio video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tf-medio figcaption {
    position: absolute; left: 12px; bottom: 12px; max-width: 70%; padding: 5px 10px; border-radius: 6px;
    background: rgb(0 0 0 / .7); color: #fff; font-size: var(--fs-xs); pointer-events: none;
  }
  .tf-medio:has(video) figcaption { bottom: 56px; }
  .tf-flecha {
    position: absolute; top: 50%; translate: 0 -50%; width: 40px; height: 40px; border-radius: 50%;
    border: 2px solid #fff; background: rgb(0 0 0 / .55); color: #fff; font-size: 24px; line-height: 1;
    cursor: pointer; transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .tf-flecha:hover { background: #fff; color: #000; }
  .tf-flecha--a { left: 12px; }
  .tf-flecha--s { right: 12px; }
  .tf-cont {
    position: absolute; right: 12px; top: 12px; padding: 3px 9px; border-radius: 6px;
    background: #fff; color: #000; font-size: var(--fs-xs);
  }
  .tf-minis { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; padding: 2px 4px 6px 2px; scrollbar-width: thin; }
  .tf-mini {
    position: relative; flex: 0 0 104px; aspect-ratio: 16 / 9; padding: 0; border-radius: 6px; overflow: hidden;
    border: 2px solid var(--border-strong); background: #000; cursor: pointer; opacity: .55;
    transition: opacity var(--dur) var(--ease);
  }
  .tf-mini:hover { opacity: 1; }
  .tf-mini.is-on { opacity: 1; border-color: var(--fg); box-shadow: 2px 2px 0 var(--fg); }
  .tf-mini img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tf-mini__play {
    position: absolute; inset: 0; display: grid; place-items: center; color: #fff; font-size: 14px;
    background: rgb(0 0 0 / .35);
  }

  .tf-info { display: grid; gap: var(--space-3); }
  .tf-tags, .tf-fw { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag, .fw {
    border: 1.5px solid var(--fg); border-radius: 6px; padding: 2px 8px; font-size: var(--fs-xs);
    font-weight: 700; text-transform: uppercase; letter-spacing: .02em; color: var(--fg); background: var(--bg);
  }
  .tag--neg { background: var(--fg); color: var(--bg); }
  .fw { font-family: var(--font-mono); font-size: 11px; padding: 1px 6px; }
  .tf-h1 {
    font-family: var(--font-display); font-stretch: 75%; font-weight: 800; text-transform: uppercase;
    font-size: clamp(2rem, 3.4vw, 2.9rem); line-height: .95; margin: 0;
  }
  .tf-lead { color: var(--fg-muted); margin: 0; font-size: var(--fs-sm); line-height: 1.55; }

  .tf-compra { padding: var(--space-4); display: grid; gap: 10px; }
  .tf-precio { margin: 0; font-family: var(--font-display); font-stretch: 75%; font-weight: 800; font-size: 2rem; line-height: 1; text-transform: uppercase; }
  .tf-precio__sub { margin: 0; font-size: var(--fs-sm); color: var(--fg-muted); }
  .tf-cta {
    display: block; text-align: center; padding: 13px; border-radius: 8px; border: var(--b);
    background: var(--fg); color: var(--bg); font-weight: 800; text-transform: uppercase; letter-spacing: .03em;
    text-decoration: none; box-shadow: 3px 3px 0 var(--fg-muted);
    transition: translate var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .tf-cta:hover { translate: -2px -2px; box-shadow: 5px 5px 0 var(--fg-muted); }
  .tf-cta:active { translate: 2px 2px; box-shadow: 0 0 0 var(--fg-muted); }
  .tf-sec { display: flex; flex-wrap: wrap; gap: 8px; }
  .tf-mini-btn {
    border: 1.5px solid var(--fg); border-radius: 7px; padding: 6px 10px; font-size: var(--fs-xs); font-weight: 700;
    text-transform: uppercase; background: var(--bg); color: var(--fg); text-decoration: none; cursor: pointer;
    box-shadow: 2px 2px 0 var(--fg); font-family: inherit;
  }
  .tf-mini-btn:hover { background: var(--fg); color: var(--bg); }
  .tf-nota { margin: 0; font-size: 12px; color: var(--fg-subtle); }

  .tf-incluye { padding: var(--space-3) var(--space-4); }
  .tf-incluye__t { margin: 0 0 8px; font-weight: 800; text-transform: uppercase; font-size: var(--fs-sm); }
  .tf-incluye ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .tf-incluye li { display: grid; font-size: var(--fs-sm); padding-left: 16px; position: relative; }
  .tf-incluye li::before { content: ""; position: absolute; left: 0; top: .45em; width: 8px; height: 8px; border-radius: 2px; background: var(--fg); }
  .tf-incluye li span { color: var(--fg-muted); font-size: var(--fs-xs); }

  .tf-fuertes { list-style: none; padding: 0; margin: var(--space-6) 0 var(--space-5); display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-3); }
  .tf-fuertes li { display: flex; align-items: center; gap: 12px; padding: 12px 14px; font-size: var(--fs-sm); font-weight: 600; }
  .tf-check { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 7px; background: var(--fg); color: var(--bg); font-size: 14px; }

  .tf-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: var(--space-3); }
  .tf-tab {
    border: var(--b); border-radius: 8px; padding: 8px 14px; background: var(--bg); color: var(--fg);
    font-weight: 800; text-transform: uppercase; font-size: var(--fs-xs); letter-spacing: .03em; cursor: pointer;
    box-shadow: 2px 2px 0 var(--fg); font-family: inherit;
  }
  .tf-tab.is-on { background: var(--fg); color: var(--bg); }
  .tf-panel { padding: var(--space-5); }
  .tf-cols { columns: 2; column-gap: var(--space-6); }
  .tf-intro { margin: 0 0 var(--space-4); color: var(--fg-muted); line-height: 1.6; break-inside: avoid; }
  .tf-grupo { break-inside: avoid; margin-bottom: var(--space-4); }
  .tf-grupo h3, .tf-script h3, .tf-tec h3 {
    font-family: var(--font-display); font-stretch: 75%; font-weight: 800; text-transform: uppercase;
    font-size: var(--fs-md); margin: 0 0 8px;
  }
  .tf-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .tf-lista li { position: relative; padding-left: 20px; font-size: var(--fs-sm); color: var(--fg-muted); line-height: 1.5; }
  .tf-lista li::before { content: ""; position: absolute; left: 0; top: .42em; width: 9px; height: 9px; border-radius: 2px; background: var(--fg); }
  .tf-lista code { font-family: var(--font-mono); font-size: .92em; color: var(--fg); }

  .tf-scripts { display: grid; gap: var(--space-5); }
  .tf-script { display: grid; grid-template-columns: minmax(0, 320px) 1fr; gap: var(--space-5); align-items: start; }
  .tf-script + .tf-script { border-top: 1px solid var(--border); padding-top: var(--space-5); }
  .tf-script img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; border: var(--b); }
  .tf-script p { margin: 0 0 10px; font-size: var(--fs-sm); line-height: 1.6; color: var(--fg-muted); }
  .tf-script .tf-script__r { font-size: var(--fs-xs); margin-bottom: 4px; }
  .tf-script .tf-script__sub { color: var(--fg); font-weight: 600; }
  .tf-cifras { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
  .tf-cifras div { border: 1.5px solid var(--fg); border-radius: 8px; padding: 6px 12px; }
  .tf-cifras dt { font-family: var(--font-display); font-stretch: 75%; font-weight: 800; font-size: 1.4rem; line-height: 1; }
