---
// /pruebas1 — solo la animación de entrada (no la web): alguien se sienta ante el portátil,
// la cámara entra en la pantalla, pulsa el logo y la pantalla «se abre».
// Escena y coreografía en src/scripts/pruebas1/escena.ts (Three.js + GSAP).
import logoMask from "@/assets/logo-mask.png";
import "@/styles/global.css";
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Pruebas 1 · Animación de entrada</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <main class="p1" data-p1>
      <canvas class="p1-lienzo" data-logo={logoMask.src} aria-label="Animación: una persona se sienta ante el portátil y abre la web"></canvas>

      <!-- cargando la escena -->
      <div class="p1-carga" data-p1-carga>
        <span class="p1-carga__logo" style={`--logo:url("${logoMask.src}")`}></span>
        <span class="p1-carga__barra"><i></i></span>
      </div>

      <!-- rótulo de cada momento -->
      <p class="p1-capitulo" aria-live="polite" data-p1-capitulo></p>

      <div class="p1-controles">
        <span class="p1-etiqueta">pruebas1 · animación de entrada</span>
        <button type="button" class="p1-boton" data-p1-saltar>Saltar</button>
      </div>

      <!-- destello al «entrar» en la pantalla -->
      <div class="p1-destello" data-p1-destello></div>

      <!-- aquí empezaría la web -->
      <section class="p1-fin" data-p1-fin>
        <span class="p1-fin__logo" style={`--logo:url("${logoMask.src}")`}></span>
        <h1>Aquí se abriría la web</h1>
        <p>Esto es solo la animación de entrada: justo en este momento aparecería la página.</p>
        <div class="p1-fin__acciones">
          <button type="button" class="p1-boton p1-boton--claro" data-p1-repetir>
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path></svg>
            Ver otra vez
          </button>
          <a class="p1-boton" href="/">Ir a la portada</a>
        </div>
      </section>
    </main>

    <script>
      import gsap from "gsap";
      import { crearAnimacion } from "@/scripts/pruebas1/escena";

      const raiz = document.querySelector<HTMLElement>("[data-p1]")!;
      const lienzo = raiz.querySelector<HTMLCanvasElement>(".p1-lienzo")!;
      const capitulo = raiz.querySelector<HTMLElement>("[data-p1-capitulo]")!;
      const carga = raiz.querySelector<HTMLElement>("[data-p1-carga]")!;
      const fin = raiz.querySelector<HTMLElement>("[data-p1-fin]")!;
      const destello = raiz.querySelector<HTMLElement>("[data-p1-destello]")!;
      const saltar = raiz.querySelector<HTMLButtonElement>("[data-p1-saltar]")!;

      // rótulo: el anterior se va hacia arriba y entra el nuevo
      function ponerCapitulo(t: string) {
        gsap.to(capitulo, {
          y: -10,
          autoAlpha: 0,
          duration: 0.25,
          onComplete: () => {
            capitulo.textContent = t;
            if (t) gsap.fromTo(capitulo, { y: 12, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.5, ease: "power2.out" });
          },
        });
      }

      gsap.set([fin, destello], { autoAlpha: 0 });

      crearAnimacion(lienzo, lienzo.dataset.logo!, { capitulo: ponerCapitulo, fin, destello })
        .then(({ linea }) => {
          // en local, la línea de tiempo queda a mano en la consola: __p1.seek(8), __p1.pause()…
          if (import.meta.env.DEV) Object.assign(window, { __p1: linea });
          gsap.to(carga, { autoAlpha: 0, duration: 0.6, delay: 0.2, onComplete: () => linea.play() });
          linea.eventCallback("onComplete", () => (saltar.hidden = true));

          saltar.addEventListener("click", () => linea.progress(1));
          raiz.querySelector("[data-p1-repetir]")!.addEventListener("click", () => {
            saltar.hidden = false;
            linea.restart();
          });
        })
        .catch(() => {
          carga.hidden = true;
          capitulo.textContent = "Tu navegador no puede mostrar la escena 3D.";
          gsap.set(capitulo, { autoAlpha: 1 });
        });
    </script>

    <style is:global>
      html,
      body {
        height: 100%;
        background: #0a0a0a;
        overflow: hidden;
      }
    </style>

    <style>
      .p1 {
        position: fixed;
        inset: 0;
        color: #f2f2f2;
        font-family: var(--font-sans);
      }

      .p1-lienzo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
      }

      /* cargando: el logo con su línea, como la entrada de siempre */
      .p1-carga {
        position: absolute;
        inset: 0;
        z-index: 5;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        background: #0a0a0a;
      }

      .p1-carga__logo,
      .p1-fin__logo {
        width: min(180px, 46vw);
        aspect-ratio: 895 / 879;
        background: #f2f2f2;
        -webkit-mask: var(--logo) center / contain no-repeat;
        mask: var(--logo) center / contain no-repeat;
      }

      .p1-carga__logo {
        animation: p1-respira 2s ease-in-out infinite;
      }

      .p1-carga__barra {
        width: 180px;
        height: 2px;
        overflow: hidden;
        background: #262626;
      }

      .p1-carga__barra i {
        display: block;
        width: 40%;
        height: 100%;
        background: #f2f2f2;
        animation: p1-barra 1.1s cubic-bezier(0.6, 0, 0.4, 1) infinite;
      }

      .p1-capitulo {
        position: absolute;
        left: 50%;
        bottom: clamp(4.5rem, 10vh, 6.5rem);
        z-index: 3;
        translate: -50% 0;
        margin: 0;
        padding: 0.55rem 1.1rem;
        border: 1px solid rgb(255 255 255 / 0.12);
        border-radius: 999px;
        background: rgb(10 10 10 / 0.55);
        backdrop-filter: blur(8px);
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        white-space: nowrap;
        visibility: hidden;
      }

      .p1-controles {
        position: absolute;
        left: clamp(1rem, 3vw, 2rem);
        right: clamp(1rem, 3vw, 2rem);
        bottom: clamp(1rem, 3vw, 1.75rem);
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .p1-etiqueta {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: #6a6a6a;
      }

      .p1-boton {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.7rem 1.2rem;
        border: 1px solid #333;
        border-radius: 999px;
        color: #f2f2f2;
        font-size: 0.9375rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.25s, color 0.25s, border-color 0.25s;
      }

      .p1-boton:hover {
        background: #f2f2f2;
        color: #0a0a0a;
        border-color: #f2f2f2;
      }

      .p1-boton[hidden] {
        display: none;
      }

      .p1-boton--claro {
        background: #f2f2f2;
        color: #0a0a0a;
        border-color: #f2f2f2;
      }

      .p1-boton--claro:hover {
        background: transparent;
        color: #f2f2f2;
      }

      .p1-destello {
        position: absolute;
        inset: 0;
        z-index: 6;
        background: #f2f2f2;
        pointer-events: none;
      }

      .p1-fin {
        position: absolute;
        inset: 0;
        z-index: 4;
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 1.25rem;
        padding: 1.5rem;
        text-align: center;
        background: radial-gradient(ellipse at center, #161616 0%, #0a0a0a 70%);
      }

      .p1-fin h1 {
        font-family: var(--font-display);
        font-size: clamp(2.2rem, 1.2rem + 4vw, 4.5rem);
        font-weight: 800;
        font-stretch: 105%;
        letter-spacing: -0.04em;
        line-height: 1;
      }

      .p1-fin p {
        max-width: 30rem;
        color: #9a9a9a;
        line-height: 1.6;
      }

      .p1-fin__acciones {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 0.5rem;
      }

      @keyframes p1-respira {
        50% {
          opacity: 0.6;
        }
      }

      @keyframes p1-barra {
        from {
          transform: translateX(-100%);
        }
        to {
          transform: translateX(250%);
        }
      }
    </style>
  </body>
</html>
