  .chat-msgs::-webkit-scrollbar-thumb:hover,
  .chat-convs__list::-webkit-scrollbar-thumb:hover,
  .chat-cmds::-webkit-scrollbar-thumb:hover,
  .chat-form textarea::-webkit-scrollbar-thumb:hover {
    border-width: 3px;
    background-color: color-mix(in srgb, var(--fg) 50%, transparent);
  }

  .chat-msgs::-webkit-scrollbar-thumb:active,
  .chat-convs__list::-webkit-scrollbar-thumb:active {
    background-color: var(--fg);
  }

  .chat-msgs::-webkit-scrollbar-corner,
  .chat-convs__list::-webkit-scrollbar-corner {
    background: transparent;
  }

