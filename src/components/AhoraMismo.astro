  @keyframes pc-rise { from { opacity: 0; transform: translateY(12px); } }
  @keyframes pc-slide { from { opacity: 0; transform: translateX(-10px); } }
  @keyframes pc-eq { 0% { transform: scaleY(0.25); } 100% { transform: scaleY(1); } }
