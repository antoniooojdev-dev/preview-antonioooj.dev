---
// Ficha de venta del script de policía (antoniooojdev_police). La usan
// /servicios/fivem/policia (la real) y /pruebas-fivem (copia noindex). Estética
// de la web: visor de vídeo y capturas + caja de compra, cifras, un bloque por módulo (cada uno
// con su vídeo; si aún no hay, el hueco «vídeo en grabación»), documentación tipo README y
// preguntas. Datos en src/data/policia.ts.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { policia as p } from "@/data/policia";
import { fivemPacks } from "@/data/packs";

interface Props { pruebas?: boolean }
const { pruebas = false } = Astro.props;
const euros = (n: number) => n.toLocaleString("es-ES", { minimumFractionDigits: 2 }) + " €";
const precio = euros(p.precio);
const precioAntes = euros(p.precioAntes);
const n2 = (i: number) => String(i + 1).padStart(2, "0");

type Medio = { tipo: "video" | "img" | "hueco"; src?: string; poster?: string; t: string; mod: string };
const medios: Medio[] = p.modulos.flatMap((m) => [
  m.video
    ? { tipo: "video" as const, src: m.video, poster: m.poster, t: `${m.nombre} en vídeo`, mod: m.nombre }
    : { tipo: "hueco" as const, t: `${m.nombre} · vídeo en grabación`, mod: m.nombre },
  ...m.galeria.map((g) => ({ tipo: "img" as const, src: g.src, t: g.t, mod: m.nombre })),
]);
// la app SAPD tiene vídeo de verdad: que el visor empiece por él
const primero = Math.max(0, medios.findIndex((m) => m.tipo === "video"));
const ordenados = [...medios.slice(primero), ...medios.slice(0, primero)];
---

<BaseLayout
  title={pruebas ? "Pruebas · Sistema de Policía SAPD" : "Sistema de Policía SAPD · Script FiveM"}
  description={pruebas ? undefined : `${p.lema}. ${p.lead}`}
  noindex={pruebas}
  intro={false}
>
  <div class="pf" data-no-i18n>
    <div class="container">
      <a href="#modulos" class="pf-nuevo">
        <span class="pf-nuevo__tag mono">Nuevo</span>
        <span class="pf-nuevo__t">Acaba de salir el Sistema de Policía SAPD · <b>-{p.descuento}% de lanzamiento</b></span>
        <span class="pf-nuevo__ir" aria-hidden="true">→</span>
      </a>

      <nav class="pf-migas mono" aria-label="Migas">
        <a href="/servicios/fivem">scripts-fivem</a><span>/</span><b>{p.recurso}</b>
      </nav>

      <!-- ── cabecera ── -->
      <section class="pf-top">
        <div class="pf-visor" data-visor>
          <div class="pf-marco">
            <div class="pf-barra mono">
              <span class="pf-puntos" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="pf-barra__t" data-titulo>{ordenados[0].t}</span>
              <span class="pf-rec" aria-hidden="true"><i></i>REC</span>
            </div>
            <div class="pf-esc">
              {ordenados.map((m, i) => (
                <figure class:list={["pf-medio", { "is-on": i === 0 }]} data-i={i} data-t={m.t}>
                  {m.tipo === "video" && <video src={m.src} poster={m.poster} muted playsinline preload="metadata"></video>}
                  {m.tipo === "img" && <img src={m.src} alt={m.t} loading={i < 2 ? "eager" : "lazy"} />}
                  {m.tipo === "hueco" && (
                    <div class="pf-hueco">
                      <span class="pf-hueco__ruido" aria-hidden="true"></span>
                      <span class="mono pf-hueco__k">Vídeo en grabación</span>
                      <b>{m.mod}</b>
                    </div>
                  )}
                </figure>
              ))}
              <button class="pf-flecha pf-flecha--a" type="button" data-paso="-1" aria-label="Anterior">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <button class="pf-flecha pf-flecha--s" type="button" data-paso="1" aria-label="Siguiente">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <span class="pf-cont mono"><b data-n>01</b> / {String(ordenados.length).padStart(2, "0")}</span>
              <span class="pf-progreso" aria-hidden="true"><i data-barra></i></span>
            </div>
          </div>
          <div class="pf-minis">
            {ordenados.map((m, i) => (
              <button type="button" class:list={["pf-mini", { "is-on": i === 0 }]} data-ir={i} aria-label={m.t}>
                {m.tipo === "img" && <img src={m.src} alt="" loading="lazy" />}
                {m.tipo === "video" && <img src={m.poster} alt="" loading="lazy" />}
                {m.tipo === "hueco" && <span class="pf-mini__hueco mono">{m.mod}</span>}
                {m.tipo !== "img" && (
                  <span class="pf-mini__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></span>
                )}
              </button>
            ))}
          </div>
        </div>

        <aside class="pf-info">
          <p class="mono pf-kicker"><span class="pf-badge">Nuevo</span> Script FiveM · v{p.version}</p>
          <h1 class="pf-h1">{p.titulo}</h1>
          <p class="pf-lema">{p.lema}</p>
          <p class="pf-lead">{p.lead}</p>
          <div class="pf-fw">
            <span class="pf-fw__todos">Todos los frameworks</span>
            {p.frameworks.map((f) => <span class="pf-fw__i mono">{f}</span>)}
          </div>

          <div class="pf-compra">
            <div class="pf-precio">
              <div class="pf-precio__fila">
                <b data-precio>{precio}</b>
                <s class="pf-precio__antes" aria-label={`Antes ${precioAntes}`}>{precioAntes}</s>
                <span class="pf-precio__dto mono">-{p.descuento}%</span>
              </div>
              <span>Oferta de lanzamiento · pago único · licencia en tu cuenta de Cfx.re</span>
            </div>
            <button type="button" class="btn btn-primary pf-comprar" data-comprar>
              Comprar ahora
            </button>
            <div class="pf-sec">
              <a href="#documentacion" class="btn btn-ghost">Documentación</a>
              <a href="#modulos" class="btn btn-ghost">Ver módulos</a>
            </div>
            <ul class="pf-garantias">
              <li>Configuración abierta y comentada en español</li>
              <li>Base de datos que se crea y actualiza sola</li>
              <li>Soporte por chat y Discord</li>
            </ul>
          </div>
        </aside>
      </section>

      <!-- ── cifras ── -->
      <section class="pf-cifras" data-rv>
        {p.cifras.map((c, i) => (
          <div class="pf-cifra" style={`--i:${i}`}>
            <b data-cuenta={c.v}>{c.v}</b>
            <span>{c.l}</span>
          </div>
        ))}
      </section>

      <!-- ── módulos ── -->
      <section class="pf-bloque" id="modulos">
        <header class="pf-cab" data-rv>
          <p class="mono pf-kicker">Qué incluye</p>
          <h2 class="pf-h2">Cinco partes, <span>un solo recurso</span></h2>
          <p class="pf-sub">Todo comparte datos: la multa que pones en la calle aparece en la tablet y en el móvil del ciudadano.</p>
        </header>

        <div class="pf-mods">
          {p.modulos.map((m, i) => (
            <article class="pf-mod" id={`mod-${m.id}`} data-rv>
              <div class="pf-mod__media">
                <div class="pf-marco pf-marco--s">
                  {m.video ? (
                    <video class="pf-mod__vid" src={m.video} poster={m.poster} muted loop playsinline preload="none" data-auto></video>
                  ) : (
                    <div class="pf-hueco pf-hueco--mod">
                      <span class="pf-hueco__ruido" aria-hidden="true"></span>
                      <span class="pf-rec pf-rec--hueco" aria-hidden="true"><i></i>REC</span>
                      <span class="mono pf-hueco__k">Vídeo en grabación</span>
                      <b>{m.nombre}</b>
                    </div>
                  )}
                </div>
              </div>
              <div class="pf-mod__txt">
                <p class="mono pf-mod__n">{n2(i)} / {n2(p.modulos.length - 1)}</p>
                <h3>{m.nombre}</h3>
                <p class="pf-mod__sub">{m.sub}</p>
                <p class="pf-mod__res">{m.resumen}</p>
                <ul class="pf-lista">
                  {m.funciones.map((f, k) => <li style={`--k:${k}`}>{f}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ── documentación ── -->
      <section class="pf-bloque" id="documentacion">
        <header class="pf-cab" data-rv>
          <p class="mono pf-kicker">README.md</p>
          <h2 class="pf-h2">Documentación</h2>
          <p class="pf-sub">Instalación, configuración y comandos. Lo mismo que viene dentro del recurso.</p>
        </header>

        <div class="pf-docs" data-rv>
          <nav class="pf-docs__nav" aria-label="Índice">
            <p class="mono">Índice</p>
            {p.docs.map((d, i) => (
              <a href={`#doc-${d.id}`} class:list={{ "is-on": i === 0 }} data-doc={d.id}><span class="mono">{n2(i)}</span>{d.t}</a>
            ))}
          </nav>
          <div class="pf-docs__cuerpo">
            <div class="pf-readme mono"><span>{p.recurso}</span><span>/</span><b>README.md</b></div>
            {p.docs.map((d) => (
              <section class="pf-doc" id={`doc-${d.id}`}>
                <h3><span aria-hidden="true">#</span> {d.t}</h3>
                {d.intro && <p>{d.intro}</p>}
                {d.pasos && <ol>{d.pasos.map((s) => <li>{s}</li>)}</ol>}
                {d.tabla && (
                  <div class="pf-tabla">
                    <table>
                      <thead><tr>{d.tabla.cols.map((c) => <th>{c}</th>)}</tr></thead>
                      <tbody>{d.tabla.filas.map((f) => <tr>{f.map((c, k) => k === 0 ? <td><code>{c}</code></td> : <td>{c}</td>)}</tr>)}</tbody>
                    </table>
                  </div>
                )}
                {d.codigo && (
                  <div class="pf-code">
                    <div class="pf-code__bar mono"><span>{d.codigo.lang}</span><button type="button" data-copiar-code>Copiar</button></div>
                    <pre><code>{d.codigo.txt}</code></pre>
                  </div>
                )}
                {d.nota && <p class="pf-nota">{d.nota}</p>}
              </section>
            ))}
          </div>
        </div>
      </section>

      <!-- ── preguntas ── -->
      <section class="pf-bloque pf-faq-b">
        <header class="pf-cab" data-rv>
          <p class="mono pf-kicker">Preguntas</p>
          <h2 class="pf-h2">Antes de comprar</h2>
        </header>
        <div class="pf-faq" data-rv>
          {p.faq.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}<span class="pf-faq__x" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- ── otros ── -->
      <section class="pf-bloque">
        <header class="pf-cab" data-rv>
          <p class="mono pf-kicker">Más scripts</p>
          <h2 class="pf-h2">También te puede interesar</h2>
        </header>
        <div class="pf-otros">
          {fivemPacks.map((o, i) => (
            <a class="pf-otro" href={`/servicios/fivem/${o.id}`} data-rv style={`--i:${i}`}>
              <span class="pf-otro__img"><img src={o.scripts[0].poster} alt="" loading="lazy" /></span>
              <span class="mono pf-otro__k">{o.scripts.length} {o.scripts.length === 1 ? "script" : "scripts"}</span>
              <b>{o.titulo}</b>
              <span class="pf-otro__d">{o.resumen}</span>
              <span class="pf-otro__ir">Ver ficha <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </section>
    </div>

    <div class="pf-toast" role="status" aria-live="polite" data-toast></div>
  </div>
</BaseLayout>

<script>
  const reducido = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const toastEl = document.querySelector<HTMLElement>("[data-toast]")!;
  let toastT = 0;
  const toast = (t: string) => {
    toastEl.textContent = t;
    toastEl.classList.add("is-on");
    clearTimeout(toastT);
    toastT = window.setTimeout(() => toastEl.classList.remove("is-on"), 2600);
  };

  // ── visor: cambia solo cada 5 s (los vídeos, al terminar), se para con el ratón encima ──
  const visor = document.querySelector<HTMLElement>("[data-visor]")!;
  const medios = [...visor.querySelectorAll<HTMLElement>(".pf-medio")];
  const minis = [...visor.querySelectorAll<HTMLButtonElement>(".pf-mini")];
  const titulo = visor.querySelector<HTMLElement>("[data-titulo]")!;
  const num = visor.querySelector<HTMLElement>("[data-n]")!;
  const barra = visor.querySelector<HTMLElement>("[data-barra]")!;
  const DUR = 5000;
  let actual = 0;
  let t0 = performance.now();
  let pausa = false;
  let visible = true;

  const ir = (i: number) => {
    actual = (i + medios.length) % medios.length;
    medios.forEach((m, k) => {
      m.classList.toggle("is-on", k === actual);
      const v = m.querySelector("video");
      if (!v) return;
      if (k === actual) {
        v.currentTime = 0;
        v.play().catch(() => {});
      } else v.pause();
    });
    minis.forEach((m, k) => m.classList.toggle("is-on", k === actual));
    const fila = minis[actual].parentElement!;
    fila.scrollTo({ left: minis[actual].offsetLeft - fila.clientWidth / 2 + minis[actual].clientWidth / 2, behavior: "smooth" });
    titulo.textContent = medios[actual].dataset.t ?? "";
    num.textContent = String(actual + 1).padStart(2, "0");
    t0 = performance.now();
  };
  minis.forEach((m) => m.addEventListener("click", () => ir(Number(m.dataset.ir))));
  visor.querySelectorAll<HTMLButtonElement>("[data-paso]").forEach((b) => b.addEventListener("click", () => ir(actual + Number(b.dataset.paso))));
  visor.addEventListener("pointerenter", () => (pausa = true));
  visor.addEventListener("pointerleave", () => { pausa = false; t0 = performance.now() - Number(barra.dataset.p ?? 0) * DUR; });
  medios.forEach((m) => m.querySelector("video")?.addEventListener("ended", () => ir(actual + 1)));
  new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(visor);

  const tick = (now: number) => {
    const v = medios[actual].querySelector("video");
    let prog: number;
    if (v && v.duration) prog = v.currentTime / v.duration;
    else {
      if (pausa || !visible) t0 = now - Number(barra.dataset.p ?? 0) * DUR;
      prog = Math.min(1, (now - t0) / DUR);
      if (prog >= 1 && !reducido) ir(actual + 1);
    }
    barra.dataset.p = String(prog);
    barra.style.transform = `scaleX(${prog})`;
    requestAnimationFrame(tick);
  };
  medios[0].querySelector("video")?.play().catch(() => {});
  requestAnimationFrame(tick);

  // ── comprar (la tienda de Tebex aún no está publicada) ──
  document.querySelector("[data-comprar]")?.addEventListener("click", () => toast("La tienda abre muy pronto. Mientras, escríbeme por el chat."));

  // ── aparecer al hacer scroll + contadores + vídeos de los módulos ──
  const contar = (el: HTMLElement) => {
    const fin = Number(el.dataset.cuenta);
    if (reducido) return;
    const ini = performance.now();
    const paso = (now: number) => {
      const k = Math.min(1, (now - ini) / 1400);
      el.textContent = String(Math.round(fin * (1 - Math.pow(1 - k, 3))));
      if (k < 1) requestAnimationFrame(paso);
    };
    el.textContent = "0";
    requestAnimationFrame(paso);
  };
  const io = new IntersectionObserver(
    (ents) =>
      ents.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add("is-in");
        e.target.querySelectorAll<HTMLElement>("[data-cuenta]").forEach(contar);
        io.unobserve(e.target);
      }),
    { threshold: 0.18, rootMargin: "0px 0px -8% 0px" },
  );
  document.documentElement.classList.add("pf-js");
  document.querySelectorAll("[data-rv]").forEach((el) => io.observe(el));

  const ioVid = new IntersectionObserver((ents) =>
    ents.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) v.play().catch(() => {});
      else v.pause();
    }), { threshold: 0.4 });
  document.querySelectorAll<HTMLVideoElement>("video[data-auto]").forEach((v) => ioVid.observe(v));

  // ── índice de la documentación: marca la sección que estás leyendo ──
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>("[data-doc]")];
  const ioDoc = new IntersectionObserver(
    (ents) =>
      ents.forEach((e) => {
        if (!e.isIntersecting) return;
        enlaces.forEach((a) => a.classList.toggle("is-on", a.dataset.doc === e.target.id.slice(4)));
      }),
    { rootMargin: "-30% 0px -60% 0px" },
  );
  document.querySelectorAll(".pf-doc").forEach((s) => ioDoc.observe(s));

  // ── copiar bloques de código ──
  document.querySelectorAll<HTMLButtonElement>("[data-copiar-code]").forEach((b) =>
    b.addEventListener("click", async () => {
      const code = b.closest(".pf-code")?.querySelector("code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        b.textContent = "Copiado";
      } catch {
        b.textContent = "Error";
      }
      setTimeout(() => (b.textContent = "Copiar"), 1500);
    }),
  );
</script>

<style>
  .pf {
    padding-bottom: var(--space-9);
    position: relative;
  }

  /* entrada de la cabecera */
  @keyframes pf-in {
    from { opacity: 0; transform: translateY(18px); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  .pf-migas, .pf-visor, .pf-info > * { animation: pf-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .pf-visor { animation-delay: 0.08s; }
  .pf-info > :nth-child(1) { animation-delay: 0.14s; }
  .pf-info > :nth-child(2) { animation-delay: 0.2s; }
  .pf-info > :nth-child(3) { animation-delay: 0.26s; }
  .pf-info > :nth-child(4) { animation-delay: 0.32s; }
  .pf-info > :nth-child(5) { animation-delay: 0.38s; }
  .pf-info > :nth-child(6) { animation-delay: 0.46s; }

  /* aparecer con scroll */
  :global(.pf-js) [data-rv] {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(6px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), filter 0.9s;
    transition-delay: calc(var(--i, 0) * 70ms);
  }
  :global(.pf-js) [data-rv].is-in { opacity: 1; transform: none; filter: none; }

  .pf-migas { display: flex; gap: 0.5rem; padding-top: var(--space-6); font-size: var(--fs-xs); color: var(--fg-subtle); }
  .pf-migas a { color: var(--fg-subtle); text-decoration: none; }
  .pf-migas a:hover { color: var(--fg); }
  .pf-migas b { color: var(--fg); font-weight: 500; }

  .pf-kicker { font-size: var(--fs-xs); color: var(--fg-subtle); margin: 0; }

  /* ── cabecera ── */
  .pf-top {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(320px, 1fr);
    gap: var(--space-7);
    align-items: start;
    margin-top: var(--space-5);
  }

  .pf-marco {
    position: relative;
    border-radius: 18px;
    padding: 1.5px;
    background: conic-gradient(from var(--pf-ang, 0deg), var(--fg), transparent 22%, transparent 50%, color-mix(in srgb, var(--fg) 55%, transparent), transparent 78%, var(--fg));
    animation: pf-giro 9s linear infinite;
    box-shadow: 0 50px 120px -70px color-mix(in srgb, var(--fg) 60%, transparent);
  }
  .pf-marco--s { border-radius: 16px; }
  @property --pf-ang { syntax: "<angle>"; initial-value: 0deg; inherits: false; }
  @keyframes pf-giro { to { --pf-ang: 360deg; } }

  .pf-barra {
    display: flex; align-items: center; gap: var(--space-3);
    padding: 0.65rem 1rem; border-radius: 17px 17px 0 0;
    background: var(--bg-elev); border-bottom: 1px solid var(--border);
    font-size: 0.6875rem; color: var(--fg-subtle);
  }
  .pf-barra__t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pf-puntos { display: flex; gap: 6px; flex: none; }
  .pf-puntos i { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }
  .pf-puntos i:first-child { background: var(--fg); }
  .pf-rec { display: inline-flex; align-items: center; gap: 0.4rem; margin-left: auto; flex: none; }
  .pf-rec i { width: 7px; height: 7px; border-radius: 50%; background: #ef4444; animation: pf-parpadeo 1.2s steps(2, start) infinite; }
  @keyframes pf-parpadeo { to { visibility: hidden; } }

  .pf-esc {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden;
    border-radius: 0 0 17px 17px; background: #0b0b0b;
  }
  .pf-medio {
    position: absolute; inset: 0; margin: 0;
    opacity: 0; transform: scale(1.035); transition: opacity 0.6s ease, transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  .pf-medio.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .pf-medio img, .pf-medio video { width: 100%; height: 100%; object-fit: cover; display: block; }

  .pf-hueco {
    position: relative; width: 100%; height: 100%; display: grid; place-content: center; justify-items: center; gap: 0.4rem;
    background: radial-gradient(ellipse at center, #1a1a1a, #070707 70%); color: #fff; overflow: hidden; text-align: center;
  }
  .pf-hueco b { font-size: clamp(1.2rem, 2.4vw, 2rem); font-weight: 600; letter-spacing: -0.03em; position: relative; }
