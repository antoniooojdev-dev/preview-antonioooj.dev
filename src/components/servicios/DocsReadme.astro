---
// Documentación de un script con el diseño de las fichas (índice a la izquierda + README.md):
// el mismo que el bloque «Documentación» de FichaScript.astro y FichaBandas.astro.
// La usa /documentacion (varias en la misma página: `prefijo` hace únicos los id).
import type { DocSeccion } from "@/data/fichas";

interface Props { recurso: string; docs: DocSeccion[]; prefijo?: string }
const { recurso, docs, prefijo = "" } = Astro.props;
const n2 = (i: number) => String(i + 1).padStart(2, "0");
const idDe = (id: string) => `doc-${prefijo ? `${prefijo}-` : ""}${id}`;
---

<div class="pf-docs" data-readme>
  <nav class="pf-docs__nav" aria-label="Índice">
    <p class="mono">Índice</p>
    {docs.map((d, i) => (
      <a href={`#${idDe(d.id)}`} class:list={{ "is-on": i === 0 }} data-doc={idDe(d.id)}><span class="mono">{n2(i)}</span>{d.t}</a>
    ))}
  </nav>
  <div class="pf-docs__cuerpo">
    <div class="pf-readme mono"><span>{recurso}</span><span>/</span><b>README.md</b></div>
    {docs.map((d) => (
      <section class="pf-doc" id={idDe(d.id)}>
        <h3><span aria-hidden="true">#</span> {d.t}</h3>
        {d.intro && <p>{d.intro}</p>}
        {d.pasos && <ol>{d.pasos.map((s) => <li>{s}</li>)}</ol>}
        {d.tabla && (
          <div class="pf-tabla">
            <table>
              <thead><tr>{d.tabla.cols.map((c) => <th>{c}</th>)}</tr></thead>
              <tbody>{d.tabla.filas.map((f) => <tr>{f.map((c, k) => k === 0 ? <td><code>{c}</code></td> : <td>{c}</td>)}</tr>)}</tbody>
            </table>
          </div>
        )}
        {d.codigo && (
          <div class="pf-code">
            <div class="pf-code__bar mono"><span>{d.codigo.lang}</span><button type="button" data-copiar-code>Copiar</button></div>
            <pre><code>{d.codigo.txt}</code></pre>
          </div>
        )}
        {d.nota && <p class="pf-nota">{d.nota}</p>}
      </section>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-readme]").forEach((caja) => {
    // índice: marca la sección que estás leyendo
    const enlaces = [...caja.querySelectorAll<HTMLAnchorElement>("[data-doc]")];
    const io = new IntersectionObserver(
      (ents) =>
        ents.forEach((e) => {
          if (!e.isIntersecting) return;
          enlaces.forEach((a) => a.classList.toggle("is-on", a.dataset.doc === e.target.id));
        }),
      { rootMargin: "-30% 0px -60% 0px" },
    );
    caja.querySelectorAll(".pf-doc").forEach((s) => io.observe(s));

    // copiar bloques de código
    caja.querySelectorAll<HTMLButtonElement>("[data-copiar-code]").forEach((b) =>
      b.addEventListener("click", async () => {
        const code = b.closest(".pf-code")?.querySelector("code")?.textContent ?? "";
        try {
          await navigator.clipboard.writeText(code);
          b.textContent = "Copiado";
        } catch {
          b.textContent = "Error";
        }
        setTimeout(() => (b.textContent = "Copiar"), 1500);
      }),
    );
  });
</script>

<style>
  .pf-docs { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: var(--space-7); align-items: start; }
  .pf-docs__nav { position: sticky; top: calc(var(--header-h) + var(--space-5)); display: grid; gap: 2px; }
  .pf-docs__nav p { margin: 0 0 var(--space-2); font-size: var(--fs-xs); color: var(--fg-subtle); }
  .pf-docs__nav a {
    display: flex; gap: 0.7rem; align-items: baseline; padding: 0.5rem 0.75rem; border-radius: 10px;
    color: var(--fg-muted); text-decoration: none; font-size: var(--fs-sm); transition: background 0.25s, color 0.25s;
  }
  .pf-docs__nav a span { font-size: 0.6875rem; color: var(--fg-subtle); }
  .pf-docs__nav a:hover { color: var(--fg); }
  .pf-docs__nav a.is-on { background: var(--bg-elev); color: var(--fg); box-shadow: inset 0 0 0 1px var(--border); }

  .pf-docs__cuerpo { border: 1px solid var(--border); border-radius: var(--radius-tile); background: var(--bg-elev); overflow: hidden; }
  .pf-readme { display: flex; gap: 0.5rem; padding: 0.85rem var(--space-5); border-bottom: 1px solid var(--border); font-size: var(--fs-xs); color: var(--fg-subtle); }
  .pf-readme b { color: var(--fg); font-weight: 500; }
  .pf-doc { padding: var(--space-6) var(--space-6) 0; scroll-margin-top: calc(var(--header-h) + var(--space-5)); }
  .pf-doc:last-child { padding-bottom: var(--space-6); }
  .pf-doc + .pf-doc { border-top: 1px solid var(--border); margin-top: var(--space-6); }
  .pf-doc h3 { margin: 0 0 var(--space-3); font-size: var(--fs-lg); font-weight: 600; letter-spacing: -0.02em; }
  .pf-doc h3 span { color: var(--fg-subtle); font-family: var(--font-mono); font-weight: 400; }
  .pf-doc p, .pf-doc li { color: var(--fg-muted); font-size: var(--fs-sm); line-height: 1.65; }
  .pf-doc p { margin: 0 0 var(--space-3); }
  .pf-doc ol { margin: 0 0 var(--space-4); padding: 0; list-style: none; counter-reset: paso; display: grid; gap: 0.6rem; }
  .pf-doc ol li { counter-increment: paso; display: grid; grid-template-columns: 1.8rem 1fr; gap: 0.5rem; }
  .pf-doc ol li::before {
    content: counter(paso); display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%;
    border: 1px solid var(--border-strong); font-family: var(--font-mono); font-size: 0.6875rem; color: var(--fg);
  }
  .pf-tabla { overflow-x: auto; margin-bottom: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-sm); }
  .pf-tabla table { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
  .pf-tabla th { text-align: left; font-weight: 500; font-size: var(--fs-xs); color: var(--fg-subtle); padding: 0.6rem 0.9rem; background: var(--bg); border-bottom: 1px solid var(--border); }
  .pf-tabla td { padding: 0.65rem 0.9rem; color: var(--fg-muted); border-top: 1px solid var(--border); vertical-align: top; }
  .pf-tabla tr:first-child td { border-top: 0; }
  .pf-tabla code, .pf-tabla td:first-child { color: var(--fg); font-family: var(--font-mono); font-size: 0.8125rem; white-space: nowrap; }
  .pf-code { border-radius: var(--radius-sm); overflow: hidden; margin-bottom: var(--space-4); background: #0b0b0b; color: #e8e8e8; }
  .pf-code__bar { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0.9rem; font-size: 0.6875rem; color: #8a8a8a; border-bottom: 1px solid #222; }
  .pf-code__bar button { background: none; border: 1px solid #333; border-radius: 6px; padding: 0.15rem 0.55rem; color: #cfcfcf; font: inherit; cursor: pointer; }
  .pf-code__bar button:hover { background: #fff; color: #000; }
  .pf-code pre { margin: 0; padding: 0.9rem; overflow-x: auto; font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.6; }
  .pf-nota { padding: 0.8rem 1rem; border-left: 2px solid var(--fg); background: var(--bg); border-radius: 0 10px 10px 0; }

  @media (max-width: 1080px) {
    .pf-docs { grid-template-columns: 1fr; }
    .pf-docs__nav { position: static; display: flex; overflow-x: auto; gap: 0.3rem; }
    .pf-docs__nav p { display: none; }
    .pf-docs__nav a { white-space: nowrap; }
  }
  @media (max-width: 560px) {
    .pf-doc { padding-inline: var(--space-4); }
  }
</style>
