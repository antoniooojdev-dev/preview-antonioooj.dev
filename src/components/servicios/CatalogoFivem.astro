---
// Catálogo de scripts FiveM de /servicios/fivem: una ventana tipo explorador de la
// carpeta resources/[antoniooojdev] con un buscador, filtros por estado y una tarjeta
// («carpeta») por script. Al pulsar una tarjeta se abre la ficha del script
// (/servicios/fivem/<id>). Los datos están en src/data/scripts-fivem.ts.
import Icono from "@/components/servicios/Icono.astro";
import { scriptsFivem } from "@/data/scripts-fivem";

// primero los disponibles, luego los que están en desarrollo
// disponibles primero y, dentro de ellos, los nuevos delante
const lista = [...scriptsFivem].sort((a, b) => Number(a.estado === "desarrollo") - Number(b.estado === "desarrollo") || Number(!!b.nuevo) - Number(!!a.nuevo));
const total = lista.length;
const disponibles = lista.filter((s) => s.estado === "disponible").length;
const desarrollo = total - disponibles;
const quitarTildes = (t: string) => t.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
const filtros = [
  { id: "todos", t: "Todos", n: total },
  { id: "disponible", t: "Disponibles", n: disponibles },
  { id: "desarrollo", t: "En desarrollo", n: desarrollo },
];
---

<section class="block cat" id="scripts">
  <div class="cat-head">
    <h2 class="kicker mono">// scripts</h2>
    <p class="cat-title">Scripts <span>hechos y probados</span></p>
    <p class="cat-sub">
      Cada carpeta es un script que ya funciona en un servidor real. Ábrela y verás todo: qué hace, cómo está hecho, capturas y detalles técnicos.
    </p>
  </div>

  <div class="ex" data-explorer>
    <!-- barra de la ventana: ruta y buscador -->
    <div class="ex-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="ex-path mono">
        <Icono nombre="folder" size={15} />
        <span class="ex-path__dim">server /</span> resources / <b>[antoniooojdev]</b>
      </span>
      <label class="ex-search">
        <Icono nombre="search" size={15} />
        <input type="search" placeholder="Buscar script…" aria-label="Buscar script" autocomplete="off" spellcheck="false" data-buscar />
        <kbd class="mono" aria-hidden="true">/</kbd>
      </label>
    </div>

    <!-- filtros por estado -->
    <div class="ex-tools" role="group" aria-label="Filtrar scripts">
      {
        filtros.map((f, i) => (
          <button type="button" class:list={["ex-filtro", "mono", { "is-on": i === 0 }]} aria-pressed={i === 0 ? "true" : "false"} data-filtro={f.id}>
            {f.id !== "todos" && <i class:list={["punto", `punto--${f.id}`]} aria-hidden="true" />}
            <span>{f.t}</span>
            <span class="ex-filtro__n">{f.n}</span>
          </button>
        ))
      }
    </div>

    <!-- carpetas -->
    <ul role="list" class="ex-grid" data-lista>
      {
        lista.map((s, i) => {
          const dev = s.estado === "desarrollo";
          const texto = quitarTildes([s.nombre, s.recurso, s.categoria, s.resumen, ...s.claves, ...s.frameworks].join(" "));
          return (
            <li class:list={["sc", { "sc--dev": dev }]} data-estado={s.estado} data-texto={texto} data-reveal style={`--i:${i}`}>
              <a href={`/servicios/fivem/${s.id}`} class="sc__a" aria-label={`${s.nombre}${dev ? " (en desarrollo)" : ""}`}>
                <div class="sc__media">
                  {s.portada ? (
                    <img src={s.portada} alt="" loading="lazy" width="1920" height="1080" />
                  ) : (
                    <div class="sc__wip" aria-hidden="true">
                      <span class="sc__wip-grid" />
                      <span class="sc__wip-scan" />
                      <span class="sc__wip-icon">
                        <Icono nombre={s.icono} size={40} />
                      </span>
                      <span class="sc__wip-txt mono">compilando…</span>
                    </div>
                  )}
                  <span class="sc__tab mono">
                    <Icono nombre="folder" size={13} />
                    {s.recurso}/
                  </span>
                  <span class:list={["sc__estado", "mono", { "sc__estado--dev": dev }]}>
                    <i aria-hidden="true" />
                    {dev ? "en desarrollo" : "disponible"}
                  </span>
                  {s.nuevo && <span class="sc__nuevo mono">nuevo</span>}
                </div>

                <div class="sc__body">
                  <div class="sc__head">
                    <span class="sc__icon" aria-hidden="true">
                      <Icono nombre={s.icono} size={20} />
                    </span>
                    <div>
                      <h3>{s.nombre}</h3>
                      <p class="sc__meta mono">
                        {s.categoria} · {s.frameworks.join(" · ")}
                      </p>
                    </div>
                  </div>
                  <p class="sc__resumen">{s.resumen}</p>
                  <ul role="list" class="sc__claves">
                    {s.claves.map((k) => (
                      <li>
                        <Icono nombre={dev ? "hourglass" : "check"} size={15} />
                        {k}
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="sc__foot mono">
                  <span class="sc__datos">
                    {s.datos.map((d) => (
                      <span>
                        <b>{d.v}</b> {d.l}
                      </span>
                    ))}
                  </span>
                  <span class="sc__ir">
                    {dev ? "ver avance" : "abrir ficha"} <Icono nombre="arrow" size={14} />
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>

    <p class="ex-vacio" data-vacio hidden>
      <Icono nombre="search" size={18} />
      <span>Ningún script coincide con tu búsqueda.</span>
      <button type="button" class="mono" data-limpiar>limpiar</button>
    </p>

    <!-- barra de estado -->
    <div class="ex-status mono">
      <span><i class="punto punto--disponible" aria-hidden="true"></i> <b data-visibles>{total}</b> de {total} recursos</span>
      <span class="ex-status__cmd" aria-hidden="true">ensure [antoniooojdev]</span>
    </div>
  </div>
</section>

<script>
  // Buscador y filtros del catálogo (sin recargar). «/» enfoca el buscador.
  const quitarTildes = (t: string) => t.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

  document.querySelectorAll<HTMLElement>("[data-explorer]").forEach((ex) => {
    const input = ex.querySelector<HTMLInputElement>("[data-buscar]")!;
    const botones = [...ex.querySelectorAll<HTMLButtonElement>("[data-filtro]")];
    const tarjetas = [...ex.querySelectorAll<HTMLElement>(".sc")];
    const vacio = ex.querySelector<HTMLElement>("[data-vacio]")!;
    const visibles = ex.querySelector<HTMLElement>("[data-visibles]")!;
    let filtro = "todos";

    const aplicar = () => {
      const q = quitarTildes(input.value.trim());
      let n = 0;
      tarjetas.forEach((c) => {
        const ok = (filtro === "todos" || c.dataset.estado === filtro) && (!q || q.split(/\s+/).every((p) => c.dataset.texto!.includes(p)));
        c.hidden = !ok;
        if (ok) n++;
      });
      visibles.textContent = String(n);
      vacio.hidden = n > 0;
    };

    botones.forEach((b) =>
      b.addEventListener("click", () => {
        filtro = b.dataset.filtro!;
        botones.forEach((x) => {
          x.classList.toggle("is-on", x === b);
          x.setAttribute("aria-pressed", String(x === b));
        });
        aplicar();
      }),
    );
    input.addEventListener("input", aplicar);
    ex.querySelector("[data-limpiar]")!.addEventListener("click", () => {
      input.value = "";
      filtro = "todos";
      botones.forEach((x, i) => {
        x.classList.toggle("is-on", i === 0);
        x.setAttribute("aria-pressed", String(i === 0));
      });
      aplicar();
      input.focus();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey) return;
      const t = e.target as HTMLElement;
      if (t.closest("input, textarea, select, [contenteditable]")) return;
      e.preventDefault();
      input.focus();
    });

    // foco de luz que sigue al ratón por las carpetas
    ex.addEventListener("pointermove", (e) => {
      tarjetas.forEach((c) => {
        const r = c.getBoundingClientRect();
        c.style.setProperty("--mx", `${e.clientX - r.left}px`);
        c.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });
  });
</script>

<style>
  .cat {
    scroll-margin-top: calc(var(--header-h) + var(--space-5));
  }

  .cat-head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .kicker {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--fg-subtle);
  }

  .cat-title {
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .cat-title span {
    color: var(--acc);
  }

  .cat-sub {
    max-width: 44rem;
    font-size: var(--fs-md);
    color: var(--fg-muted);
  }

  /* ── ventana del explorador ── */
  .ex {
    border-radius: 22px;
    border: 1px solid var(--border);
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, color-mix(in srgb, var(--acc) 7%, transparent), transparent 70%),
      color-mix(in srgb, var(--bg-elev) 70%, var(--bg));
    box-shadow: 0 40px 90px -60px color-mix(in srgb, var(--acc) 60%, transparent);
    overflow: hidden;
  }

  .ex-bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--fg) 3%, var(--bg-elev));
  }

  .dots {
    display: flex;
    gap: 6px;
    flex: none;
  }

  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--fg) 16%, transparent);
  }

  .dots i:first-child {
    background: var(--acc);
  }

  .ex-path {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    font-size: var(--fs-xs);
    color: var(--fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ex-path :global(.icono) {
    flex: none;
    color: var(--acc);
  }

  .ex-path b {
    color: var(--fg);
    font-weight: 600;
  }

  .ex-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    width: min(18rem, 45%);
    padding: 0.45rem 0.7rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg-subtle);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ex-search:focus-within {
    border-color: color-mix(in srgb, var(--acc) 60%, var(--border));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--acc) 18%, transparent);
  }

  .ex-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    font-size: var(--fs-sm);
  }

  .ex-search input::-webkit-search-cancel-button {
    filter: grayscale(1);
  }

  .ex-search kbd {
    padding: 0 0.4rem;
    border-radius: 5px;
    border: 1px solid var(--border);
    font-size: 0.6875rem;
    color: var(--fg-subtle);
  }

  .ex-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) 0;
  }

  .ex-filtro {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--fg-muted);
    font-size: var(--fs-xs);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .ex-filtro:hover {
    color: var(--fg);
    border-color: color-mix(in srgb, var(--fg) 30%, var(--border));
  }

  .ex-filtro.is-on {
    color: var(--fg);
    border-color: color-mix(in srgb, var(--acc) 55%, transparent);
    background: color-mix(in srgb, var(--acc) 14%, transparent);
  }

  .ex-filtro__n {
    min-width: 1.4em;
    padding: 0 0.35rem;
    border-radius: 999px;
    text-align: center;
    background: color-mix(in srgb, var(--fg) 8%, transparent);
  }

  .punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .punto--disponible {
    background: #22c55e;
    box-shadow: 0 0 0 3px rgb(34 197 94 / 0.18);
  }

  .punto--desarrollo {
    background: #f59e0b;
    box-shadow: 0 0 0 3px rgb(245 158 11 / 0.18);
  }

  /* ── carpetas ── */
  .ex-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .sc {
    --mx: 50%;
    --my: 0%;
    position: relative;
    border-radius: 18px;
  }

  .sc[hidden] {
    display: none;
  }

  /* los disponibles ocupan más: dos por fila en escritorio */
  @media (min-width: 62rem) {
    .ex-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .sc {
      grid-column: span 2;
    }

    .sc:not(.sc--dev) {
      grid-column: span 3;
    }
  }

  .sc__a {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    border-radius: inherit;
    border: 1px solid var(--border);
    background:
      radial-gradient(380px circle at var(--mx) var(--my), color-mix(in srgb, var(--acc) 10%, transparent), transparent 45%),
      var(--bg-elev);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s ease,
      border-color 0.3s ease;
  }

  /* borde que se ilumina donde está el ratón */
  .sc__a::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: 1px;
    border-radius: inherit;
    background: radial-gradient(240px circle at var(--mx) var(--my), var(--acc), transparent 60%);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .ex-grid:hover .sc__a::before {
    opacity: 1;
  }

  .sc__a:hover {
    transform: translateY(-5px);
    box-shadow: 0 30px 60px -36px color-mix(in srgb, var(--acc) 80%, transparent);
  }

  .sc__a:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 3px;
  }

  .sc__media {
    position: relative;
    aspect-ratio: 16 / 8;
    overflow: hidden;
    background: #0b0b0f;
    border-bottom: 1px solid var(--border);
  }

  .sc--dev .sc__media {
    aspect-ratio: 16 / 9;
  }

  .sc__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
    filter: saturate(0.9);
  }

  .sc__a:hover .sc__media img {
    transform: scale(1.07);
    filter: saturate(1.05);
  }

  /* degradado abajo para que se lean las etiquetas */
  .sc__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.45), transparent 35%, transparent 70%, rgb(0 0 0 / 0.35));
    pointer-events: none;
  }

  .sc__tab,
  .sc__estado {
    position: absolute;
    z-index: 1;
    top: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.6rem;
    border-radius: 8px;
    font-size: 0.6875rem;
    color: #fff;
    background: rgb(10 10 14 / 0.6);
    border: 1px solid rgb(255 255 255 / 0.14);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .sc__tab {
    left: var(--space-3);
    max-width: calc(100% - 9.5rem);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sc__tab :global(.icono) {
    flex: none;
    color: color-mix(in srgb, var(--acc) 70%, #fff);
  }

  .sc__estado {
    right: var(--space-3);
    border-radius: 999px;
  }

  .sc__estado i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: latido 2s ease-in-out infinite;
  }

  .sc__estado--dev i {
    background: #f59e0b;
    box-shadow: 0 0 8px #f59e0b;
  }

  .sc__nuevo {
    position: absolute;
    z-index: 1;
    left: var(--space-3);
    bottom: var(--space-3);
    overflow: hidden;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #0a0a0e;
    background: #fff;
    box-shadow: 0 4px 18px rgb(0 0 0 / 0.35);
  }

  .sc__nuevo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgb(0 0 0 / 0.14) 50%, transparent 70%);
    transform: translateX(-120%);
    animation: sc-brillo 3.2s 1s ease-in-out infinite;
  }

  @keyframes sc-brillo {
    0%, 60% { transform: translateX(-120%); }
    100% { transform: translateX(120%); }
  }

  @keyframes latido {
    50% {
      opacity: 0.35;
    }
  }

  /* portada de los que aún están en desarrollo */
  .sc__wip {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--space-3);
    color: #fff;
    background: radial-gradient(ellipse 60% 70% at 50% 45%, color-mix(in srgb, var(--acc) 28%, #0b0b0f), #0b0b0f 75%);
  }

  .sc__wip-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000, transparent);
  }

  .sc__wip-scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--acc) 35%, transparent) 50%, transparent);
    height: 40%;
    animation: escaneo 3.2s linear infinite;
    opacity: 0.5;
  }

  @keyframes escaneo {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(260%);
    }
  }

  .sc__wip-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.6rem;
    height: 4.6rem;
    border-radius: 20px;
    border: 1px solid rgb(255 255 255 / 0.16);
    background: rgb(255 255 255 / 0.06);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sc__a:hover .sc__wip-icon {
    transform: rotate(-6deg) scale(1.08);
  }

  .sc__wip-txt {
    position: relative;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: rgb(255 255 255 / 0.6);
  }

  .sc__body {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-5) var(--space-4);
  }

  .sc__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .sc__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 12px;
    color: var(--acc);
    background: color-mix(in srgb, var(--acc) 12%, var(--bg));
    border: 1px solid color-mix(in srgb, var(--acc) 28%, transparent);
    transition: background 0.3s ease, color 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sc__a:hover .sc__icon {
    background: var(--acc);
    color: #fff;
    transform: rotate(-6deg);
  }

  .sc--dev .sc__icon {
    color: var(--fg-muted);
    background: color-mix(in srgb, var(--fg) 6%, var(--bg));
    border-color: var(--border);
  }

  .sc--dev .sc__a:hover .sc__icon {
    background: color-mix(in srgb, var(--fg) 14%, var(--bg));
    color: var(--fg);
  }

  .sc h3 {
    font-size: var(--fs-md);
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .sc:not(.sc--dev) h3 {
    font-size: 1.35rem;
  }

  .sc__meta {
    margin-top: 0.15rem;
    font-size: 0.6875rem;
    color: var(--fg-subtle);
  }

  .sc__resumen {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }

  .sc__claves {
    display: grid;
    gap: 0.4rem;
    font-size: var(--fs-sm);
  }

  .sc__claves li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .sc__claves :global(.icono) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--acc);
  }

  .sc--dev .sc__claves {
    color: var(--fg-muted);
  }

