---
// Ficha de venta del menú de handling. Cabecera (visor + compra) y final (preguntas + más scripts)
// iguales que la del police (FichaScript.astro); el centro es propio y va por el slot «centro»:
//  1. cifras como cuadro de instrumentos: tacómetro con los 63 valores y lecturas a los lados
//  2. módulos como marchas: palanca en H que cambia el módulo, y en cada uno una demo del panel
//     (barras y plantillas con radar, buscador del modo avanzado, HUD de prueba, guardado, staff)
//  3. documentación: instalación con luces de salida y el resto en fichas técnicas
// Datos en src/data/handling.ts. La usa /pruebas-handling.
import FichaScript from "./FichaScript.astro";
import { handling as p, handlingBarras as barras, handlingPlantillas as plantillas, handlingValores as valores } from "@/data/handling";

interface Props { pruebas?: boolean }
const { pruebas = false } = Astro.props;
const n2 = (i: number) => String(i + 1).padStart(2, "0");

// ── tacómetro (ángulo 0 = arriba, sentido horario, barrido de -135° a 135°) ──
const C = 110, R = 92;
const pt = (a: number, r: number) => {
  const t = (a * Math.PI) / 180;
  return `${(C + r * Math.sin(t)).toFixed(2)} ${(C - r * Math.cos(t)).toFixed(2)}`;
};
const tope = p.cifras[0].v;
const ang = (v: number) => -135 + (270 * v) / tope;
const arco = `M ${pt(-135, R)} A ${R} ${R} 0 1 1 ${pt(135, R)}`;
const rayas = Array.from({ length: tope / 3 + 1 }, (_, i) => i * 3);
const numeros = Array.from({ length: tope / 9 + 1 }, (_, i) => i * 9);
const lecturas = p.cifras.slice(1);
const izq = lecturas.slice(0, 3);
const der = lecturas.slice(3);

// ── velocímetro del HUD (0-260 km/h) ──
const velArco = `M ${pt(-135, 80)} A 80 80 0 1 1 ${pt(135, 80)}`;
const velNums = [0, 40, 80, 120, 160, 200, 240];

// ── palanca en H ──
const marchas = [
  { x: 40, y: 34 }, { x: 40, y: 186 }, { x: 100, y: 34 }, { x: 100, y: 186 }, { x: 160, y: 34 },
];

// ── radar del ajuste rápido ──
const ejes = ["Aceleración", "Punta", "Frenada", "Curva", "Aguante"];
const poli = (r: number) =>
  ejes.map((_, i) => {
    const a = ((-90 + i * 72) * Math.PI) / 180;
    return `${(r * Math.cos(a)).toFixed(1)},${(r * Math.sin(a)).toFixed(1)}`;
  }).join(" ");
const eje = (i: number, r: number) => {
  const a = ((-90 + i * 72) * Math.PI) / 180;
  return { x: +(r * Math.cos(a)).toFixed(1), y: +(r * Math.sin(a)).toFixed(1) };
};

const grupos = [...new Set(valores.map((v) => v.g))];
const cambios = valores.filter((v) => v.cambio).length;

const inst = p.docs.find((d) => d.id === "instalacion");
const fichas = p.docs.filter((d) => d.id !== "instalacion");
const teclas = (t: string) => t.split(" · ").map((c) => c.split("+"));
---

<FichaScript ficha={p} pruebas={pruebas}>
  <div slot="centro" class="fh">
    <!-- ── 1. cuadro de instrumentos ── -->
    <section class="fh-dash fh-rv" data-dash aria-label="El script en cifras">
      <div class="fh-dash__lado">
        {izq.map((c, i) => (
          <div class="fh-lect" style={`--i:${i}`}>
            <b class="mono" data-cuenta={c.v}>{c.v}</b>
            <span>{c.l}</span>
          </div>
        ))}
      </div>

      <div class="fh-tacho">
        <svg viewBox="0 0 220 200" aria-hidden="true">
          <path d={arco} class="fh-tacho__pista" />
          <path d={arco} class="fh-tacho__lleno" pathLength="100" />
          <path d={`M ${pt(ang(tope - 9), R)} A ${R} ${R} 0 0 1 ${pt(135, R)}`} class="fh-tacho__rojo" />
          {rayas.map((v) => {
            const a = ang(v);
            const larga = v % 9 === 0;
            return <line x1={pt(a, R - 6).split(" ")[0]} y1={pt(a, R - 6).split(" ")[1]} x2={pt(a, R - (larga ? 18 : 12)).split(" ")[0]} y2={pt(a, R - (larga ? 18 : 12)).split(" ")[1]} class:list={["fh-tacho__raya", { "is-l": larga }]} />;
          })}
          {numeros.map((v) => {
            const [x, y] = pt(ang(v), R - 32).split(" ");
            return <text x={x} y={y} class="fh-tacho__num">{v}</text>;
          })}
          <g class="fh-tacho__aguja">
            <line x1={C} y1={C + 12} x2={C} y2={C - R + 14} />
            <circle cx={C} cy={C} r="7" />
          </g>
        </svg>
        <div class="fh-tacho__lec">
          <b class="mono" data-cuenta={p.cifras[0].v}>{p.cifras[0].v}</b>
          <span>{p.cifras[0].l}</span>
        </div>
      </div>

      <div class="fh-dash__lado fh-dash__lado--d">
        {der.map((c, i) => (
          <div class="fh-lect" style={`--i:${i + 3}`}>
            <b class="mono" data-cuenta={c.v}>{c.v}</b>
            <span>{c.l}</span>
          </div>
        ))}
        <div class="fh-lect" style="--i:5">
          <b class="mono">v{p.version}</b>
          <span>versión del recurso</span>
        </div>
      </div>
    </section>

    <!-- ── 2. módulos como marchas ── -->
    <section class="fh-bloque" id="modulos">
      <header class="fh-cab fh-rv">
        <p class="mono fh-kicker">Qué incluye · {p.modulos.length} marchas</p>
        <h2 class="fh-h2">{p.modulosTitulo[0]}<span>{p.modulosTitulo[1]}</span></h2>
        <p class="fh-sub">{p.modulosSub}</p>
      </header>

      <div class="fh-caja fh-rv" data-caja>
        <div class="fh-cambio">
          <svg class="fh-h" viewBox="0 0 200 220" aria-hidden="true">
            <rect x="4" y="4" width="192" height="212" rx="26" class="fh-h__fondo" />
            <path d="M40 34 V186 M100 34 V186 M160 34 V186 M40 110 H160" class="fh-h__guia" />
            {marchas.map((m, i) => (
              <g class="fh-h__pos" data-ir={i}>
                <circle cx={m.x} cy={m.y} r="18" class="fh-h__zona" />
                <text x={m.x + (m.x === 160 ? -26 : 26)} y={m.y + 5} class="fh-h__n">{i + 1}</text>
              </g>
            ))}
            <text x="134" y="191" class="fh-h__n fh-h__n--r">R</text>
            <g class="fh-h__pomo" data-pomo style={`transform: translate(${marchas[0].x}px, ${marchas[0].y}px)`}>
              <circle r="15" class="fh-h__bola" />
              <circle r="5" class="fh-h__brillo" />
            </g>
          </svg>
          <ol class="fh-marchas" role="tablist" aria-label="Módulos">
            {p.modulos.map((m, i) => (
              <li>
                <button type="button" role="tab" class:list={["fh-marcha", { "is-on": i === 0 }]} data-marcha={i} aria-selected={i === 0 ? "true" : "false"} aria-controls={`mod-${m.id}`}>
                  <span class="mono">{i + 1}ª</span>
                  <b>{m.nombre}</b>
                </button>
              </li>
            ))}
          </ol>
          <p class="fh-ayuda mono">Teclas 1-{p.modulos.length} o flechas para cambiar</p>
        </div>

        <div class="fh-esc">
          {p.modulos.map((m, i) => (
            <article class:list={["fh-mod", { "is-on": i === 0 }]} id={`mod-${m.id}`} role="tabpanel" data-mod={m.id}>
              <!-- demo del módulo -->
              {m.id === "ajuste" && (
                <div class="fh-pan" data-ajuste>
                  <div class="fh-pan__bar mono"><i></i>/admincar · <b>sultan</b><span class="fh-pan__est" data-estado>Fábrica</span></div>
                  <div class="fh-chips" role="group" aria-label="Plantillas">
                    {plantillas.map((pl) => (
                      <button type="button" class:list={["fh-chip", { "is-on": pl.id === "fabrica" }]} data-plantilla={JSON.stringify(pl.v)} title={pl.d}>{pl.l}</button>
                    ))}
                  </div>
                  <div class="fh-aj">
                    <div class="fh-barras">
                      {barras.map((b) => (
                        <label class="fh-barra" data-barra={b.id} data-abs={b.abs ? "1" : undefined}>
                          <span class="fh-barra__l">{b.l}<small>{b.d}</small></span>
                          <span class="fh-barra__v mono" data-val>{b.abs ? "0 cm" : "100 %"}</span>
                          <span class="fh-rng">
                            <i class="fh-rng__c"></i><i class="fh-rng__f"></i>
                            <input type="range" min="-1" max="1" step="0.005" value="0" aria-label={b.l} />
                          </span>
                        </label>
                      ))}
                    </div>
                    <div class="fh-radar">
                      <svg viewBox="-118 -112 236 224" aria-hidden="true">
                        {[0.25, 0.5, 0.75, 1].map((k) => <polygon points={poli(90 * k)} class="fh-radar__red" />)}
                        {ejes.map((_, i) => <line x1="0" y1="0" x2={eje(i, 90).x} y2={eje(i, 90).y} class="fh-radar__red" />)}
                        <polygon points={poli(90 * 0.55)} class="fh-radar__fab" />
                        <polygon points={poli(90 * 0.55)} class="fh-radar__tus" data-radar />
                        {ejes.map((e, i) => {
                          const q = eje(i, 104);
                          return <text x={q.x} y={q.y + 3} class="fh-radar__t" text-anchor={q.x > 5 ? "start" : q.x < -5 ? "end" : "middle"}>{e}</text>;
                        })}
                      </svg>
                      <p class="fh-radar__pie mono"><span><i class="is-fab"></i>Fábrica</span><span><i></i>Tus ajustes</span></p>
                    </div>
                  </div>
                </div>
              )}

              {m.id === "avanzado" && (
                <div class="fh-pan" data-avanzado>
                  <div class="fh-pan__bar mono"><i></i>Modo avanzado · <b>{tope} valores</b><span class="fh-pan__est">{cambios} cambios</span></div>
                  <div class="fh-busca">
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                    <input type="search" placeholder="Busca un valor: freno, agarre, fMass…" aria-label="Buscar un valor" data-busca />
                  </div>
                  <div class="fh-chips" role="group" aria-label="Apartados">
                    <button type="button" class="fh-chip is-on" data-grupo="">Todos</button>
                    {grupos.map((g) => <button type="button" class="fh-chip" data-grupo={g}>{g}</button>)}
                  </div>
                  <ul class="fh-vals">
                    {valores.map((v) => (
                      <li data-g={v.g} data-txt={`${v.k} ${v.l} ${v.d} ${v.g}`.toLowerCase()} class:list={{ "is-cambio": !!v.cambio }}>
                        <div><b>{v.l}</b><code>{v.k}</code></div>
                        <p>{v.d}</p>
                        {v.cambio && <span class="fh-vals__c mono">{v.cambio}</span>}
                      </li>
                    ))}
                  </ul>
                  <p class="fh-vals__vacio mono" data-vacio hidden>Ese no está en la muestra, pero sí en el panel.</p>
                  <p class="fh-vals__pie mono">Muestra de <b data-nv>{valores.length}</b> de {tope} · con su explicación en español e inglés</p>
                </div>
              )}

              {m.id === "prueba" && (
                <div class="fh-pan fh-hud" data-hud>
                  <div class="fh-pan__bar mono"><i class="is-rec"></i>Prueba en marcha · <b>panel abierto</b><span class="fh-pan__est" data-hud-modo>Tus valores</span></div>
                  <div class="fh-hud__cuerpo">
                    <div class="fh-velo">
                      <svg viewBox="0 0 220 200" aria-hidden="true">
                        <path d={velArco} class="fh-velo__pista" />
                        <path d={velArco} class="fh-velo__lleno" pathLength="100" data-vel-arco />
                        {velNums.map((v) => {
                          const [x, y] = pt(-135 + (270 * v) / 260, 60).split(" ");
                          return <text x={x} y={y} class="fh-velo__num">{v}</text>;
                        })}
                        <line x1={C} y1={C} x2={C} y2={C - 74} class="fh-velo__aguja" data-vel-aguja />
                        <circle cx={C} cy={C} r="5" class="fh-velo__eje" />
                      </svg>
                      <div class="fh-velo__lec">
                        <b class="mono" data-kmh>0</b>
                        <span>km/h</span>
                      </div>
                      <span class="fh-velo__marcha mono">Marcha <b data-gear>1</b></span>
                    </div>
                    <div class="fh-hud__datos">
                      <div class="fh-rpm"><span class="mono">RPM</span><i><i data-rpm></i></i></div>
                      <dl class="fh-tele">
                        <div><dt class="mono">0-100</dt><dd class="mono" data-t100>—</dd></div>
                        <div><dt class="mono">Punta</dt><dd class="mono" data-punta>0 km/h</dd></div>
                      </dl>
                      <div class="fh-modo" role="group" aria-label="Comparar">
                        <button type="button" class="is-on" data-modo="tus">Tus valores</button>
                        <button type="button" data-modo="fab">Fábrica</button>
                      </div>
                      <p class="fh-hud__teclas"><kbd>AvPág</kbd> alterna · <kbd>RePág</kbd> vuelve al panel</p>
                    </div>
                  </div>
                  <p class="fh-hud__nota mono">Recreación del HUD de telemetría · cifras de ejemplo</p>
                </div>
              )}

              {m.id === "guardado" && (
                <div class="fh-pan fh-guarda" data-guarda>
                  <div class="fh-pan__bar mono"><i></i>Guardar · <b>sultan</b><span class="fh-pan__est" data-g-est>Borrador</span></div>
                  <ol class="fh-flujo">
                    <li data-paso="0" class="is-on"><span class="mono">01</span><b>Borrador</b><small>Solo lo notas tú</small></li>
                    <li data-paso="1"><span class="mono">02</span><b>Validado</b><small>El servidor revisa cada valor</small></li>
                    <li data-paso="2"><span class="mono">03</span><b>En todo el servidor</b><small>Todos los sultan, al momento</small></li>
                  </ol>
                  <div class="fh-coches" aria-hidden="true">
                    {Array.from({ length: 12 }, (_, k) => (
                      <i style={`--k:${k}`}><svg viewBox="0 0 32 16"><path d="M3 11.5V9l3-1.2L9.5 4h10l4.5 3.6 5 1V11.5H26a2.6 2.6 0 0 0-5.2 0H11.2a2.6 2.6 0 0 0-5.2 0z" fill="currentColor" /><circle cx="8.6" cy="11.8" r="2" fill="currentColor" /><circle cx="23.4" cy="11.8" r="2" fill="currentColor" /></svg></i>
                    ))}
                  </div>
                  <div class="fh-guarda__pie">
                    <button type="button" class="fh-guardar" data-guardar>Guardar cambios</button>
                    <p class="fh-hud__teclas"><kbd>Ctrl</kbd>+<kbd>Z</kbd> deshacer · <kbd>Ctrl</kbd>+<kbd>Y</kbd> rehacer</p>
                  </div>
                  <ol class="fh-hist mono" data-hist aria-label="Historial de versiones">
                    <li><b>v3</b><span>Fundador · ayer</span><em>Recuperar</em></li>
                    <li><b>v2</b><span>Staff · hace 4 días</span><em>Recuperar</em></li>
                    <li><b>v1</b><span>Fábrica</span><em>Recuperar</em></li>
                  </ol>
                </div>
              )}

              {m.id === "staff" && (
                <div class="fh-pan fh-staff">
                  <div class="fh-pan__bar mono"><i></i>Acceso · <b>botón del escudo</b><span class="fh-pan__est">2 niveles</span></div>
                  <div class="fh-niveles">
                    <div class="fh-nivel is-alto">
                      <p class="mono">Nivel 1</p>
                      <h4>Fundadores</h4>
                      <small>Abren el panel y deciden quién entra</small>
                      <ul><li><span class="fh-av">F</span><b>Fundador</b><code>license:4f1c…a92e</code></li></ul>
                    </div>
                    <div class="fh-nivel">
                      <p class="mono">Nivel 2</p>
                      <h4>Staff</h4>
                      <small>Ajustan y guardan</small>
                      <ul>
                        <li><span class="fh-av">S</span><b>Staff</b><code>ID 12</code></li>
                        <li><span class="fh-av">S</span><b>Staff</b><code>ID 37</code></li>
                      </ul>
                    </div>
                  </div>
                  <pre class="fh-consola mono"><span>&gt; admincar_list</span>
[admincar] fundadores: 1 · staff: 2
[admincar] guardado sultan v3 por Fundador</pre>
                </div>
              )}

              <div class="fh-mod__txt">
                <div>
                  <p class="mono fh-mod__n">{i + 1}ª marcha · {n2(i)} / {String(p.modulos.length).padStart(2, "0")}</p>
                  <h3>{m.nombre}</h3>
                  <p class="fh-mod__sub">{m.sub}</p>
                  <p class="fh-mod__res">{m.resumen}</p>
                </div>
                <ul class="fh-lista">
                  {m.funciones.map((f, k) => <li style={`--k:${k}`}>{f}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 3. documentación ── -->
    <section class="fh-bloque" id="documentacion">
      <header class="fh-cab fh-rv">
        <p class="mono fh-kicker">Puesta a punto</p>
        <h2 class="fh-h2">Documentación</h2>
        <p class="fh-sub">Instalación, permisos, teclas y configuración. Lo mismo que viene en el README del recurso.</p>
      </header>

      {inst && (
        <div class="fh-salida fh-rv" data-salida>
          <div class="fh-salida__cab">
            <h3>{inst.t}</h3>
            <span class="fh-salida__go mono" aria-hidden="true">Luz verde: a rodar</span>
          </div>
          <ol class="fh-luces">
            {inst.pasos?.map((s, i) => (
              <li class="fh-luz" style={`--i:${i}`}>
                <span class="fh-luz__caja" aria-hidden="true"><i></i><i></i></span>
                <span class="mono fh-luz__n">Paso {n2(i)}</span>
                <p>{s}</p>
              </li>
            ))}
          </ol>
          {inst.codigo && (
            <div class="fh-code">
              <div class="fh-code__bar mono"><span>server.cfg</span><button type="button" data-copiar>Copiar</button></div>
              <pre><code>{inst.codigo.txt}</code></pre>
            </div>
          )}
        </div>
      )}

      <div class="fh-fichas">
        {fichas.map((d, i) => (
          <article class="fh-ficha fh-rv" id={`doc-${d.id}`} style={`--i:${i % 2}`}>
            <header class="fh-ficha__cab">
              <span class="mono">{String(i + 2).padStart(2, "0")}</span>
              <h3>{d.t}</h3>
            </header>
            {d.intro && <p class="fh-ficha__intro">{d.intro}</p>}
            {d.tabla && d.id === "teclas" && (
              <dl class="fh-spec">
                {d.tabla.filas.map((f) => (
                  <div>
                    <dt class="fh-keys">{teclas(f[0]).map((g, gi) => <>{gi > 0 && <span class="fh-keys__o">o</span>}{g.map((k, ki) => <>{ki > 0 && "+"}<kbd>{k}</kbd></>)}</>)}</dt>
                    <dd>{f[1]}</dd>
                  </div>
                ))}
              </dl>
            )}
            {d.tabla && d.id !== "teclas" && (
              <dl class="fh-spec">
                {d.tabla.filas.map((f) => (
                  <div>
                    <dt class="mono">{f[0]}</dt>
                    <dd>{f[1]}{f[2] && <em class:list={["mono", { "is-op": f[2] === "Opcional" }]}>{f[2]}</em>}</dd>
                  </div>
                ))}
              </dl>
            )}
            {d.pasos && d.id === "problemas" && (
              <ul class="fh-prob">
                {d.pasos.map((s) => {
                  const [a, ...b] = s.split(": ");
                  return <li><b>{a}</b><span>{b.join(": ")}</span></li>;
                })}
              </ul>
            )}
            {d.pasos && d.id !== "problemas" && <ol class="fh-pasos">{d.pasos.map((s) => <li>{s}</li>)}</ol>}
            {d.codigo && (
              <div class="fh-code">
                <div class="fh-code__bar mono"><span>{d.codigo.lang}</span><button type="button" data-copiar>Copiar</button></div>
                <pre><code>{d.codigo.txt}</code></pre>
              </div>
            )}
            {d.nota && <p class="fh-ficha__nota">{d.nota}</p>}
          </article>
        ))}
      </div>
    </section>
  </div>
</FichaScript>

<script>
  const reducido = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const raiz = document.querySelector<HTMLElement>(".fh");
  if (raiz) {
    document.documentElement.classList.add("fh-js");

    // ── contadores ──
    const contar = (el: HTMLElement) => {
      const fin = Number(el.dataset.cuenta);
      if (reducido) return;
      const ini = performance.now();
      const paso = (now: number) => {
        const k = Math.min(1, (now - ini) / 1600);
        el.textContent = String(Math.round(fin * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(paso);
      };
      el.textContent = "0";
      requestAnimationFrame(paso);
    };

    // ── luces de salida: se encienden una a una y se apagan todas a la vez ──
    const salida = (el: HTMLElement) => {
      const luces = [...el.querySelectorAll<HTMLElement>(".fh-luz")];
      if (reducido) { el.classList.add("is-go"); return; }
      luces.forEach((l, i) => setTimeout(() => l.classList.add("is-on"), 300 + i * 550));
      setTimeout(() => {
        luces.forEach((l) => l.classList.remove("is-on"));
        el.classList.add("is-go");
      }, 300 + luces.length * 550 + 700);
    };

    // ── aparecer al hacer scroll ──
    const io = new IntersectionObserver(
      (ents) =>
        ents.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          el.classList.add("is-in");
          el.querySelectorAll<HTMLElement>("[data-cuenta]").forEach(contar);
          if (el.matches("[data-salida]")) salida(el);
          io.unobserve(el);
        }),
      { threshold: 0.2, rootMargin: "0px 0px -8% 0px" },
    );
    raiz.querySelectorAll(".fh-rv").forEach((el) => io.observe(el));

    // ── palanca en H ──
    const POS = [[40, 34], [40, 186], [100, 34], [100, 186], [160, 34]];
    const caja = raiz.querySelector<HTMLElement>("[data-caja]")!;
    const pomo = caja.querySelector<SVGGElement>("[data-pomo]")!;
    const botones = [...caja.querySelectorAll<HTMLButtonElement>("[data-marcha]")];
    const mods = [...caja.querySelectorAll<HTMLElement>(".fh-mod")];
    let marcha = 0;
    const tr = (x: number, y: number) => ({ transform: `translate(${x}px, ${y}px)` });
    const meter = (i: number, foco = false) => {
      i = (i + mods.length) % mods.length;
      if (i === marcha) return;
      const [x1, y1] = POS[marcha];
      const [x2, y2] = POS[i];
      pomo.style.transform = `translate(${x2}px, ${y2}px)`;
      if (!reducido) {
        const pasos = x1 === x2 ? [tr(x1, y1), tr(x2, y2)] : [tr(x1, y1), tr(x1, 110), tr(x2, 110), tr(x2, y2)];
        pomo.animate(pasos, { duration: x1 === x2 ? 260 : 520, easing: "cubic-bezier(0.65, 0, 0.35, 1)" });
      }
      marcha = i;
      botones.forEach((b, k) => {
        b.classList.toggle("is-on", k === i);
        b.setAttribute("aria-selected", k === i ? "true" : "false");
        b.tabIndex = k === i ? 0 : -1;
      });
      mods.forEach((m, k) => m.classList.toggle("is-on", k === i));
      if (foco) botones[i].focus();
      hud.activo(mods[i].dataset.mod === "prueba");
    };
    botones.forEach((b, k) => {
      b.tabIndex = k === 0 ? 0 : -1;
      b.addEventListener("click", () => meter(k));
      b.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown" || e.key === "ArrowRight") { e.preventDefault(); meter(marcha + 1, true); }
        if (e.key === "ArrowUp" || e.key === "ArrowLeft") { e.preventDefault(); meter(marcha - 1, true); }
      });
    });
    caja.querySelectorAll<SVGGElement>("[data-ir]").forEach((g) => g.addEventListener("click", () => meter(Number(g.dataset.ir))));
    // teclas 1-5 mientras la caja está a la vista (no al escribir en el buscador)
    let cajaVista = false;
    new IntersectionObserver(([e]) => (cajaVista = e.isIntersecting), { threshold: 0.35 }).observe(caja);
    addEventListener("keydown", (e) => {
      if (!cajaVista || e.ctrlKey || e.metaKey || e.altKey) return;
      if ((e.target as HTMLElement).closest("input, textarea, [contenteditable]")) return;
      const n = Number(e.key);
      if (n >= 1 && n <= mods.length) meter(n - 1);
    });

    // ── 1ª: barras + plantillas + radar ──
    const aj = caja.querySelector<HTMLElement>("[data-ajuste]");
    if (aj) {
      const filas = [...aj.querySelectorAll<HTMLElement>("[data-barra]")];
      const chips = [...aj.querySelectorAll<HTMLButtonElement>("[data-plantilla]")];
      const radar = aj.querySelector<SVGPolygonElement>("[data-radar]")!;
      const estado = aj.querySelector<HTMLElement>("[data-estado]")!;
      const x: Record<string, number> = {};
      filas.forEach((f) => (x[f.dataset.barra!] = 0));
      // barra en -1..1: las de porcentaje van de 33 % a 300 % (3^x, como el panel), la altura ±15 cm
      const ratio = (id: string) => Math.pow(3, x[id]);
      const pintar = () => {
        filas.forEach((f) => {
          const id = f.dataset.barra!;
          const v = x[id];
          const inp = f.querySelector("input")!;
          inp.value = String(v);
          const pos = (v + 1) / 2;
          const fill = f.querySelector<HTMLElement>(".fh-rng__f")!;
          fill.style.left = `${Math.min(pos, 0.5) * 100}%`;
          fill.style.width = `${Math.abs(pos - 0.5) * 100}%`;
          const cm = Math.round(v * 15);
          f.querySelector("[data-val]")!.textContent = f.dataset.abs ? `${cm > 0 ? "+" : cm < 0 ? "−" : ""}${Math.abs(cm)} cm` : `${Math.round(ratio(id) * 100)} %`;
          f.classList.toggle("is-cambio", Math.abs(v) > 0.004);
        });
        const r = (id: string) => ratio(id);
        const val = [
          r("power") / Math.sqrt(r("mass")),
          r("top"),
          r("brake") / Math.pow(r("mass"), 0.3),
          Math.pow(r("grip"), 0.7) * Math.pow(r("roll"), 0.15) * Math.pow(r("steer"), 0.15),
          Math.sqrt(r("mass")) / Math.pow(r("dmg"), 0.6),
        ];
        radar.setAttribute("points", val.map((q, i) => {
          const rad = Math.max(0.12, Math.min(1, 0.55 * Math.pow(q, 0.7))) * 90;
          const a = ((-90 + i * 72) * Math.PI) / 180;
          return `${(rad * Math.cos(a)).toFixed(1)},${(rad * Math.sin(a)).toFixed(1)}`;
        }).join(" "));
        const tocado = filas.some((f) => f.classList.contains("is-cambio"));
        estado.textContent = tocado ? "Borrador" : "Fábrica";
        estado.classList.toggle("is-on", tocado);
      };
      let anim = 0;
      const irA = (obj: Record<string, number>) => {
        const ini = { ...x };
        const fin: Record<string, number> = {};
        filas.forEach((f) => {
          const id = f.dataset.barra!;
          const v = obj[id];
          fin[id] = v == null ? 0 : f.dataset.abs ? v / 15 : Math.log(v) / Math.log(3);
        });
        cancelAnimationFrame(anim);
        const t0 = performance.now();
        const paso = (now: number) => {
          const k = reducido ? 1 : Math.min(1, (now - t0) / 550);
          const e = 1 - Math.pow(1 - k, 3);
          for (const id in fin) x[id] = ini[id] + (fin[id] - ini[id]) * e;
          pintar();
          if (k < 1) anim = requestAnimationFrame(paso);
        };
        anim = requestAnimationFrame(paso);
      };
      chips.forEach((c) =>
        c.addEventListener("click", () => {
          chips.forEach((o) => o.classList.toggle("is-on", o === c));
          irA(JSON.parse(c.dataset.plantilla!));
        }),
      );
      filas.forEach((f) =>
        f.querySelector("input")!.addEventListener("input", (e) => {
          x[f.dataset.barra!] = Number((e.target as HTMLInputElement).value);
          chips.forEach((o) => o.classList.remove("is-on"));
          pintar();
        }),
      );
      pintar();
    }

    // ── 2ª: buscador del modo avanzado ──
    const av = caja.querySelector<HTMLElement>("[data-avanzado]");
    if (av) {
      const busca = av.querySelector<HTMLInputElement>("[data-busca]")!;
      const items = [...av.querySelectorAll<HTMLElement>(".fh-vals li")];
      const chips = [...av.querySelectorAll<HTMLButtonElement>("[data-grupo]")];
      const nv = av.querySelector<HTMLElement>("[data-nv]")!;
      const vacio = av.querySelector<HTMLElement>("[data-vacio]")!;
      let grupo = "";
      const sinTildes = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "");
      const filtrar = () => {
        const q = sinTildes(busca.value.trim().toLowerCase());
        let n = 0;
        items.forEach((li) => {
          const ok = (!grupo || li.dataset.g === grupo) && (!q || sinTildes(li.dataset.txt!).includes(q));
          li.hidden = !ok;
          if (ok) n++;
        });
        nv.textContent = String(n);
        vacio.hidden = n > 0;
      };
      busca.addEventListener("input", filtrar);
      chips.forEach((c) =>
        c.addEventListener("click", () => {
          grupo = c.dataset.grupo!;
          chips.forEach((o) => o.classList.toggle("is-on", o === c));
          filtrar();
        }),
      );
    }

    // ── 3ª: HUD de prueba (simulación sencilla que se repite) ──
    const hud = (() => {
      const el = caja.querySelector<HTMLElement>("[data-hud]");
      if (!el) return { activo: (_: boolean) => {} };
      const kmh = el.querySelector<HTMLElement>("[data-kmh]")!;
      const gear = el.querySelector<HTMLElement>("[data-gear]")!;
      const rpm = el.querySelector<HTMLElement>("[data-rpm]")!;
      const t100 = el.querySelector<HTMLElement>("[data-t100]")!;
      const punta = el.querySelector<HTMLElement>("[data-punta]")!;
      const aguja = el.querySelector<SVGLineElement>("[data-vel-aguja]")!;
      const arcoV = el.querySelector<SVGPathElement>("[data-vel-arco]")!;
      const modoTxt = el.querySelector<HTMLElement>("[data-hud-modo]")!;
      const btns = [...el.querySelectorAll<HTMLButtonElement>("[data-modo]")];
      const MODOS = { tus: { k: 27, max: 244 }, fab: { k: 21, max: 230 } };
      let modo: keyof typeof MODOS = "tus";
      let v = 0, t = 0, maxV = 0, cruce = 0, espera = 0, last = 0, on = false, vista = false, raf = 0;
      const reset = () => { v = 0; t = 0; maxV = 0; cruce = 0; espera = 0; t100.textContent = "—"; };
      const pintar = () => {
        const { max } = MODOS[modo];
        const f = v / max;
        const lims = [0, 0.18, 0.34, 0.5, 0.66, 0.82, 1.01];
        let g = 0;
        while (g < 5 && f >= lims[g + 1]) g++;
        const r = 0.3 + 0.65 * ((f - lims[g]) / (lims[g + 1] - lims[g]));
        kmh.textContent = String(Math.round(v));
        gear.textContent = String(g + 1);
        rpm.style.transform = `scaleX(${Math.min(1, r).toFixed(3)})`;
        punta.textContent = `${Math.round(maxV)} km/h`;
        aguja.style.transform = `rotate(${-135 + (270 * Math.min(v, 260)) / 260}deg)`;
        arcoV.style.strokeDashoffset = String(100 - (100 * Math.min(v, 260)) / 260);
      };
      const tick = (now: number) => {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        const { k, max } = MODOS[modo];
        if (espera > 0) {
          espera -= dt;
          v = Math.max(0, v - 160 * dt);
          if (espera <= 0) reset();
        } else {
          v += k * (1 - Math.pow(v / max, 2)) * dt * 1.6;
          t += dt * 1.6;
          maxV = Math.max(maxV, v);
          if (!cruce && v >= 100) { cruce = t; t100.textContent = `${t.toFixed(2).replace(".", ",")} s`; }
          if (v >= max * 0.985) espera = 1.6;
        }
        pintar();
        if (on && vista) raf = requestAnimationFrame(tick);
      };
      const arrancar = () => {
        cancelAnimationFrame(raf);
        if (on && vista && !reducido) { last = performance.now(); raf = requestAnimationFrame(tick); }
      };
      new IntersectionObserver(([e]) => { vista = e.isIntersecting; arrancar(); }, { threshold: 0.3 }).observe(el);
      btns.forEach((b) =>
        b.addEventListener("click", () => {
          modo = b.dataset.modo as keyof typeof MODOS;
          btns.forEach((o) => o.classList.toggle("is-on", o === b));
          modoTxt.textContent = modo === "tus" ? "Tus valores" : "Fábrica";
          reset();
          pintar();
        }),
      );
      if (reducido) { v = 180; maxV = 244; t100.textContent = "—"; pintar(); }
      return { activo: (a: boolean) => { on = a; if (a) reset(); arrancar(); } };
    })();

    // ── 4ª: guardar y repartir ──
    const gu = caja.querySelector<HTMLElement>("[data-guarda]");
    if (gu) {
      const btn = gu.querySelector<HTMLButtonElement>("[data-guardar]")!;
      const pasos = [...gu.querySelectorAll<HTMLElement>("[data-paso]")];
      const est = gu.querySelector<HTMLElement>("[data-g-est]")!;
      const hist = gu.querySelector<HTMLElement>("[data-hist]")!;
      let ver = 3;
      btn.addEventListener("click", () => {
        btn.disabled = true;
        btn.textContent = "Guardando…";
        gu.classList.remove("is-reparto");
        const d = reducido ? 0 : 1;
        setTimeout(() => { pasos[1].classList.add("is-on"); est.textContent = "Validado"; }, 450 * d);
        setTimeout(() => {
          pasos[2].classList.add("is-on");
          est.textContent = "En el servidor";
          void gu.offsetWidth;
          gu.classList.add("is-reparto");
          ver++;
          const li = document.createElement("li");
          li.className = "is-nueva";
          li.innerHTML = `<b>v${ver}</b><span>Tú · ahora</span><em>Actual</em>`;
          hist.prepend(li);
          [...hist.children].slice(4).forEach((c) => c.remove());
          btn.textContent = "Guardado ✓";
        }, 950 * d);
        setTimeout(() => {
          pasos[1].classList.remove("is-on");
          pasos[2].classList.remove("is-on");
          est.textContent = "Borrador";
          btn.disabled = false;
          btn.textContent = "Guardar cambios";
          hist.querySelector(".is-nueva em")!.textContent = "Recuperar";
          hist.querySelector(".is-nueva")!.classList.remove("is-nueva");
        }, 3400 * d + 50);
      });
    }

    // ── copiar código ──
    raiz.querySelectorAll<HTMLButtonElement>("[data-copiar]").forEach((b) =>
      b.addEventListener("click", async () => {
        const code = b.closest(".fh-code")?.querySelector("code")?.textContent ?? "";
        try {
          await navigator.clipboard.writeText(code);
          b.textContent = "Copiado";
        } catch {
          b.textContent = "Error";
        }
        setTimeout(() => (b.textContent = "Copiar"), 1500);
      }),
    );
  }
</script>

<style>
  .fh {
    --fh-pan: #0c0c0e;
    --fh-pan-2: #151518;
    --fh-linea: rgb(255 255 255 / 0.09);
    --fh-txt: #f2f2f2;
    --fh-sub: rgb(255 255 255 / 0.55);
    --fh-ease: cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.fh-js) .fh-rv {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(6px);
    transition: opacity 0.9s var(--fh-ease), transform 0.9s var(--fh-ease), filter 0.9s;
    transition-delay: calc(var(--i, 0) * 80ms);
  }
  :global(.fh-js) .fh-rv.is-in { opacity: 1; transform: none; filter: none; }

  .fh-kicker { margin: 0; font-size: var(--fs-xs); color: var(--fg-subtle); }
  .fh-bloque { margin-top: var(--space-9); scroll-margin-top: calc(var(--header-h) + var(--space-5)); }
  .fh-cab { display: grid; gap: var(--space-2); margin-bottom: var(--space-7); max-width: 46rem; }
  .fh-h2 { margin: 0; font-size: var(--fs-xl); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; }
  .fh-h2 span { color: var(--fg-subtle); }
  .fh-sub { margin: 0; color: var(--fg-muted); }

  kbd {
    display: inline-block; min-width: 1.6em; padding: 0.1rem 0.4rem; border-radius: 6px; text-align: center;
    font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.5;
    border: 1px solid currentColor; border-bottom-width: 2px; opacity: 0.9;
  }

  /* ── 1. cuadro de instrumentos ── */
  .fh-dash {
    display: grid; grid-template-columns: 1fr minmax(260px, 360px) 1fr; align-items: center; gap: var(--space-5);
    margin-top: var(--space-9); padding: var(--space-6) var(--space-6);
    border-radius: 28px; background: radial-gradient(ellipse at 50% 120%, #1d1d21, var(--fh-pan) 65%); color: var(--fh-txt);
    box-shadow: inset 0 0 0 1px var(--fh-linea), 0 50px 120px -70px rgb(0 0 0 / 0.8);
    position: relative; overflow: hidden;
  }
  .fh-dash::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(90deg, transparent 0 3px, rgb(255 255 255 / 0.012) 3px 4px);
  }
  .fh-dash__lado { display: grid; gap: var(--space-4); }
  .fh-dash__lado--d { text-align: right; }
  .fh-lect { display: grid; gap: 0.2rem; padding: var(--space-3) var(--space-4); border-radius: 14px; background: rgb(255 255 255 / 0.03); box-shadow: inset 0 0 0 1px var(--fh-linea); }
  .fh-lect b { font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.2rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; font-variant-numeric: tabular-nums; }
  .fh-lect span { font-size: var(--fs-xs); color: var(--fh-sub); }

  .fh-tacho { position: relative; }
  .fh-tacho svg { display: block; width: 100%; overflow: visible; }
  .fh-tacho__pista { fill: none; stroke: rgb(255 255 255 / 0.08); stroke-width: 10; stroke-linecap: round; }
  .fh-tacho__lleno {
    fill: none; stroke: #fff; stroke-width: 10; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100;
    filter: drop-shadow(0 0 8px rgb(255 255 255 / 0.45));
    transition: stroke-dashoffset 1.6s cubic-bezier(0.33, 1, 0.68, 1) 0.2s;
  }
  .fh-tacho__rojo { fill: none; stroke: #ef4444; stroke-width: 3; transform: scale(1.09); transform-origin: 110px 110px; opacity: 0.85; }
  .fh-tacho__raya { stroke: rgb(255 255 255 / 0.35); stroke-width: 1.5; }
  .fh-tacho__raya.is-l { stroke: #fff; stroke-width: 2.2; }
  .fh-tacho__num { fill: rgb(255 255 255 / 0.6); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; dominant-baseline: middle; }
  .fh-tacho__aguja { transform-origin: 110px 110px; transform: rotate(-135deg); transition: transform 1.6s cubic-bezier(0.34, 1.3, 0.64, 1) 0.2s; }
  .fh-tacho__aguja line { stroke: #fff; stroke-width: 3; stroke-linecap: round; }
  .fh-tacho__aguja circle { fill: var(--fh-pan); stroke: #fff; stroke-width: 3; }
  .fh-dash.is-in .fh-tacho__lleno { stroke-dashoffset: 0; }
  .fh-dash.is-in .fh-tacho__aguja { transform: rotate(135deg); }
  .fh-tacho__lec { position: absolute; left: 0; right: 0; top: 64%; display: grid; justify-items: center; gap: 0.15rem; text-align: center; }
  .fh-tacho__lec b { font-size: clamp(2.2rem, 1.6rem + 2vw, 3.2rem); font-weight: 500; letter-spacing: -0.05em; line-height: 1; }
  .fh-tacho__lec span { font-size: var(--fs-xs); color: var(--fh-sub); }

  /* ── 2. caja de cambios ── */
  .fh-caja { display: grid; grid-template-columns: 236px minmax(0, 1fr); gap: var(--space-7); align-items: start; }
  .fh-cambio { position: sticky; top: calc(var(--header-h) + var(--space-5)); display: grid; gap: var(--space-4); }
  .fh-h { display: block; width: 100%; max-width: 236px; }
  .fh-h__fondo { fill: var(--bg-elev); stroke: var(--border); }
  .fh-h__guia { fill: none; stroke: var(--border-strong); stroke-width: 14; stroke-linecap: round; stroke-linejoin: round; }
  .fh-h__pos { cursor: pointer; }
  .fh-h__zona { fill: transparent; }
  .fh-h__n { fill: var(--fg-subtle); font-family: var(--font-mono); font-size: 15px; text-anchor: middle; transition: fill 0.25s; }
  .fh-h__pos:hover .fh-h__n { fill: var(--fg); }
  .fh-h__n--r { opacity: 0.4; }
  .fh-h__pomo { pointer-events: none; }
  .fh-h__bola { fill: var(--fg); filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.35)); }
  .fh-h__brillo { fill: var(--bg); opacity: 0.35; transform: translate(-4px, -4px); }

  .fh-marchas { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .fh-marcha {
    display: flex; align-items: baseline; gap: 0.75rem; width: 100%; padding: 0.55rem 0.8rem; border: 0; border-radius: 10px;
    background: none; color: var(--fg-muted); font: inherit; font-size: var(--fs-sm); text-align: left; cursor: pointer;
    transition: background 0.25s, color 0.25s;
  }
  .fh-marcha span { font-size: 0.6875rem; color: var(--fg-subtle); min-width: 1.6rem; }
  .fh-marcha b { font-weight: 500; }
  .fh-marcha:hover { color: var(--fg); }
  .fh-marcha.is-on { background: var(--bg-elev); color: var(--fg); box-shadow: inset 0 0 0 1px var(--border); }
  .fh-marcha.is-on span { color: var(--fg); }
  .fh-ayuda { margin: 0; font-size: 0.6875rem; color: var(--fg-subtle); }

  .fh-esc { min-width: 0; }
  .fh-mod { display: none; gap: var(--space-6); }
  .fh-mod.is-on { display: grid; animation: fh-entra 0.6s var(--fh-ease) both; }
  @keyframes fh-entra { from { opacity: 0; transform: translateX(24px); filter: blur(4px); } to { opacity: 1; transform: none; filter: none; } }
  .fh-mod__txt { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-6); align-items: start; }
  .fh-mod__n { margin: 0 0 var(--space-3); font-size: var(--fs-xs); color: var(--fg-subtle); }
  .fh-mod h3 { margin: 0; font-size: clamp(1.6rem, 1rem + 1.6vw, 2.4rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .fh-mod__sub { margin: 0.5rem 0 0; color: var(--fg); }
  .fh-mod__res { margin: var(--space-3) 0 0; color: var(--fg-muted); font-size: var(--fs-sm); line-height: 1.65; }
  .fh-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; border-left: 1px solid var(--border); padding-left: var(--space-4); }
  .fh-lista li { position: relative; font-size: var(--fs-sm); color: var(--fg-muted); line-height: 1.5; animation: fh-entra 0.6s var(--fh-ease) both; animation-delay: calc(0.15s + var(--k) * 60ms); }
  .fh-lista li::before { content: ""; position: absolute; left: calc(-1 * var(--space-4) - 3px); top: 0.5em; width: 5px; height: 5px; border-radius: 50%; background: var(--fg); }

  /* panel de juego (siempre oscuro) */
