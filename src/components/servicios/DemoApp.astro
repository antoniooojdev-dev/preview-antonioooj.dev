---
// Ejemplo de «Aplicación web»: panel de reservas de un centro de fisioterapia.
//  - Roles (admin / recepción / fisio) con permisos distintos.
//  - Vista de lista (búsqueda, filtros, cambio de estado, borrar) y vista de agenda
//    (línea del día con las citas de hoy colocadas por hora).
//  - Ficha lateral de cada reserva con su historial.
//  - Cada cierto tiempo entra una reserva «online» nueva: notificación, campana con
//    contador y fila resaltada. Estadísticas animadas y barras de scroll propias.
// Todo vive en memoria.
const reservas = [
  { id: 1, cliente: "Lucía Martín", servicio: "Fisioterapia", fecha: "Hoy", hora: "09:30", estado: "confirmada", precio: 45 },
  { id: 2, cliente: "Javier Ruiz", servicio: "Masaje deportivo", fecha: "Hoy", hora: "11:00", estado: "pendiente", precio: 50 },
  { id: 3, cliente: "Marta Gil", servicio: "Pilates", fecha: "Hoy", hora: "12:30", estado: "confirmada", precio: 30 },
  { id: 4, cliente: "Pablo Serrano", servicio: "Punción seca", fecha: "Hoy", hora: "16:00", estado: "confirmada", precio: 55 },
  { id: 5, cliente: "Andrés López", servicio: "Fisioterapia", fecha: "Mañana", hora: "10:00", estado: "pendiente", precio: 45 },
  { id: 6, cliente: "Sara Núñez", servicio: "Punción seca", fecha: "Mañana", hora: "17:30", estado: "cancelada", precio: 55 },
];
const servicios = ["Fisioterapia", "Masaje deportivo", "Pilates", "Punción seca"];
const precios: Record<string, number> = { Fisioterapia: 45, "Masaje deportivo": 50, Pilates: 30, "Punción seca": 55 };
---

<div class="da" data-demo-app data-reservas={JSON.stringify(reservas)} data-precios={JSON.stringify(precios)} data-rol="admin">
  <aside class="da__side">
    <strong class="da__brand"><span aria-hidden="true">🩺</span> FisioCentro</strong>
    <nav class="da__nav mono" aria-label="Menú de la app">
      <button type="button" class="is-on" data-vista="lista">▦ Reservas</button>
      <button type="button" data-vista="agenda">🗓 Agenda de hoy</button>
      <span>👥 Clientes</span>
      <span class="da__only-admin">📈 Informes</span>
    </nav>
    <label class="da__role">
      <span class="mono">entrar como</span>
      <select class="da__rol">
        <option value="admin">👑 Admin</option>
        <option value="recepcion">🧾 Recepción</option>
        <option value="fisio">🩺 Fisio (solo lectura)</option>
      </select>
    </label>
    <p class="da__perm mono"></p>
  </aside>

  <div class="da__main">
    <!-- barra superior -->
    <header class="da__top">
      <div class="da__hello">
        <span class="mono da__today"></span>
        <strong class="da__greet">Buenos días 👋</strong>
      </div>
      <div class="da__top-tools">
        <span class="da__live mono"><i aria-hidden="true"></i> reservas online activas</span>
        <button type="button" class="da__bell" aria-label="Notificaciones" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 8 3 8H3s3-1 3-8"/><path d="M10 20a2 2 0 0 0 4 0"/></svg>
          <b class="da__badge" hidden>0</b>
        </button>
        <span class="da__avatar" aria-hidden="true"></span>
      </div>

      <div class="da__notifs" hidden>
        <div class="da__notifs-head">
          <strong>Notificaciones</strong>
          <button type="button" class="da__readall">marcar leídas</button>
        </div>
        <ul role="list" class="da__notifs-list"></ul>
        <p class="da__notifs-empty">Todo al día ✨</p>
      </div>
    </header>

    <div class="da__scroll">
      <div class="da__stats">
        <div data-k="hoy"><span class="mono">reservas hoy</span><strong>0</strong><i class="da__spark" aria-hidden="true"></i></div>
        <div data-k="conf"><span class="mono">confirmadas</span><strong>0</strong><i class="da__spark" aria-hidden="true"></i></div>
        <div data-k="pend"><span class="mono">pendientes</span><strong>0</strong><i class="da__spark" aria-hidden="true"></i></div>
        <div data-k="eur" class="da__only-admin"><span class="mono">ingresos previstos</span><strong>0 €</strong><i class="da__spark" aria-hidden="true"></i></div>
      </div>

      <!-- vista lista -->
      <section class="da__view" data-vista="lista">
        <div class="da__tools">
          <input type="search" class="da__search" placeholder="Buscar cliente o servicio…" aria-label="Buscar" />
          <div class="da__chips" role="group" aria-label="Estado">
            <button type="button" class="is-on" data-f="">todas</button>
            <button type="button" data-f="confirmada">confirmadas</button>
            <button type="button" data-f="pendiente">pendientes</button>
            <button type="button" data-f="cancelada">canceladas</button>
          </div>
          <button type="button" class="da__new da__can-edit">+ Nueva reserva</button>
        </div>

        <form class="da__form" hidden>
          <input name="cliente" type="text" placeholder="Nombre del cliente" autocomplete="off" required />
          <select name="servicio">{servicios.map((s) => <option>{s}</option>)}</select>
          <select name="fecha"><option>Hoy</option><option>Mañana</option></select>
          <input name="hora" type="time" value="18:00" min="09:00" max="20:00" required />
          <button type="submit">Guardar</button>
        </form>

        <div class="da__table-wrap">
          <table class="da__table">
            <thead>
              <tr><th>Cliente</th><th>Servicio</th><th>Cuándo</th><th>Estado</th><th class="da__only-admin"><span class="visually-hidden">Acciones</span></th></tr>
            </thead>
            <tbody></tbody>
          </table>
          <p class="da__none mono" hidden>Sin resultados</p>
        </div>
      </section>

      <!-- vista agenda -->
      <section class="da__view" data-vista="agenda" hidden>
        <div class="da__agenda">
          <div class="da__hours mono" aria-hidden="true"></div>
          <div class="da__lane">
            <span class="da__now" aria-hidden="true"><b class="mono">ahora</b></span>
          </div>
        </div>
        <p class="da__agenda-note mono">Pulsa una cita para ver su ficha · las canceladas no aparecen</p>
      </section>

      <div class="da__log">
        <span class="mono">// actividad</span>
        <ul role="list"></ul>
      </div>
    </div>

    <!-- ficha de la reserva -->
    <aside class="da__sheet" hidden aria-label="Ficha de la reserva">
      <div class="da__sheet-head">
        <span class="da__sheet-ava" aria-hidden="true"></span>
        <div>
          <strong class="da__sheet-name"></strong>
          <span class="mono da__sheet-sub"></span>
        </div>
        <button type="button" class="da__sheet-close" aria-label="Cerrar">✕</button>
      </div>
      <dl class="da__sheet-data mono"></dl>
      <span class="mono da__sheet-kicker">// historial</span>
      <ol role="list" class="da__sheet-hist"></ol>
      <div class="da__sheet-actions da__can-edit">
        <button type="button" data-set="confirmada">✓ Confirmar</button>
        <button type="button" data-set="cancelada" class="is-danger">Cancelar</button>
      </div>
    </aside>
  </div>

  <div class="da__toasts" aria-live="polite"></div>
</div>

<script>
  interface Reserva {
    id: number;
    cliente: string;
    servicio: string;
    fecha: string;
    hora: string;
    estado: "confirmada" | "pendiente" | "cancelada";
    precio: number;
    historial?: { t: string; h: string }[];
    nueva?: boolean;
  }

  const PERMISOS: Record<string, string> = {
    admin: "Puede crear, cambiar estados, borrar y ver ingresos.",
    recepcion: "Puede crear reservas y cambiar estados. No ve ingresos ni puede borrar.",
    fisio: "Solo consulta su agenda: no puede modificar nada.",
  };
  const ROLES: Record<string, string> = { admin: "Admin", recepcion: "Recepción", fisio: "Fisio" };
  const AVATAR: Record<string, string> = { admin: "AJ", recepcion: "RC", fisio: "FS" };
  const NOMBRES = ["Carmen Vidal", "Hugo Torres", "Irene Campos", "Diego Molina", "Nuria Blanco", "Álvaro Ramos", "Paula Ortega", "Rubén Castro"];
  const INICIO = 9;
  const FIN = 20;

  const ahoraHHMM = () => new Date().toLocaleTimeString("es-ES", { hour: "2-digit", minute: "2-digit" });

  document.querySelectorAll<HTMLElement>("[data-demo-app]").forEach((demo) => {
    const reservas = JSON.parse(demo.dataset.reservas!) as Reserva[];
    const precios = JSON.parse(demo.dataset.precios!) as Record<string, number>;
    const $ = <T extends Element>(s: string) => demo.querySelector<T>(s)!;
    const tbody = $<HTMLTableSectionElement>(".da__table tbody");
    const form = $<HTMLFormElement>(".da__form");
    const avisos: { t: string; i: string; h: string; leido: boolean }[] = [];
    let filtro = "";
    let vista = "lista";
    let siguiente = reservas.length + 1;
    let abierta: Reserva | null = null;
    const previo: Record<string, number> = {};

    reservas.forEach((r) => (r.historial = [{ t: "Reserva creada", h: "08:12" }, ...(r.estado === "confirmada" ? [{ t: "Confirmada por recepción", h: "08:40" }] : [])]));

    const rol = () => demo.dataset.rol ?? "admin";
    const puedeEditar = () => rol() !== "fisio";

    // ── avisos ──
    function toast(t: string, icono = "🔔") {
      const el = document.createElement("div");
      el.className = "da__toast";
      el.textContent = `${icono}  ${t}`;
      $(".da__toasts").append(el);
      setTimeout(() => el.classList.add("is-out"), 3000);
      setTimeout(() => el.remove(), 3400);
    }

    function notificar(t: string, i: string) {
      avisos.unshift({ t, i, h: ahoraHHMM(), leido: false });
      toast(t, i);
      pintarAvisos();
      const b = $<HTMLElement>(".da__bell");
      b.classList.remove("is-ring");
      void b.offsetWidth;
      b.classList.add("is-ring");
    }

    function pintarAvisos() {
      const n = avisos.filter((a) => !a.leido).length;
      const badge = $<HTMLElement>(".da__badge");
      badge.hidden = !n;
      badge.textContent = String(n);
      $<HTMLElement>(".da__notifs-empty").hidden = avisos.length > 0;
      $(".da__notifs-list").replaceChildren(
        ...avisos.slice(0, 10).map((a) => {
          const li = document.createElement("li");
          if (!a.leido) li.className = "is-new";
          const i = document.createElement("span");
          i.textContent = a.i;
          const p = document.createElement("p");
          p.textContent = a.t;
          const h = document.createElement("small");
          h.textContent = a.h;
          li.append(i, p, h);
          return li;
        }),
      );
    }

    const panelAvisos = $<HTMLElement>(".da__notifs");
    $(".da__bell").addEventListener("click", (e) => {
      e.stopPropagation();
      panelAvisos.hidden = !panelAvisos.hidden;
      $(".da__bell").setAttribute("aria-expanded", String(!panelAvisos.hidden));
    });
    $(".da__readall").addEventListener("click", () => {
      avisos.forEach((a) => (a.leido = true));
      pintarAvisos();
    });
    demo.addEventListener("click", (e) => {
      if (!panelAvisos.hidden && !(e.target as HTMLElement).closest(".da__notifs, .da__bell")) panelAvisos.hidden = true;
    });

    function log(t: string) {
      const li = document.createElement("li");
      li.textContent = `${ahoraHHMM()} · ${ROLES[rol()]} · ${t}`;
      $(".da__log ul").prepend(li);
      while ($(".da__log ul").children.length > 5) $(".da__log ul").lastElementChild!.remove();
    }

    function anotar(r: Reserva, t: string) {
      r.historial = [...(r.historial ?? []), { t, h: ahoraHHMM() }];
    }

    // ── estadísticas animadas ──
    function stat(k: string, valor: number, sufijo = "") {
      const caja = $<HTMLElement>(`.da__stats [data-k="${k}"]`);
      const el = caja.querySelector("strong")!;
      const desde = previo[k] ?? 0;
      previo[k] = valor;
      if (desde === valor && el.textContent !== "0" + sufijo) return;
      if (desde !== valor) {
        caja.classList.remove("is-bump");
        void caja.offsetWidth;
        caja.classList.add("is-bump");
      }
      const t0 = performance.now();
      const paso = (t: number) => {
        const p = Math.min(1, (t - t0) / 600);
        el.textContent = `${Math.round(desde + (valor - desde) * (1 - (1 - p) ** 3))}${sufijo}`;
        if (p < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    }

    // ── lista ──
    function fila(r: Reserva): HTMLTableRowElement {
      const tr = document.createElement("tr");
      tr.dataset.estado = r.estado;
      tr.dataset.id = String(r.id);
      if (r.nueva) tr.classList.add("is-new");
      const celda = (t: string) => {
        const td = document.createElement("td");
        td.textContent = t;
        return td;
      };
      const tdCliente = document.createElement("td");
      const ini = document.createElement("span");
      ini.className = "da__ini";
      ini.textContent = r.cliente.split(" ").map((x) => x[0]).join("").slice(0, 2);
      tdCliente.append(ini, r.cliente);
      if (r.nueva) {
        const nuevo = document.createElement("span");
        nuevo.className = "da__nuevo mono";
        nuevo.textContent = "online";
        tdCliente.append(nuevo);
      }
      const tdEstado = document.createElement("td");
      if (puedeEditar()) {
        const sel = document.createElement("select");
        sel.className = "da__estado";
        sel.setAttribute("aria-label", `Estado de ${r.cliente}`);
        for (const e of ["confirmada", "pendiente", "cancelada"]) sel.add(new Option(e, e, false, e === r.estado));
        sel.addEventListener("click", (e) => e.stopPropagation());
        sel.addEventListener("change", () => cambiarEstado(r, sel.value as Reserva["estado"]));
        tdEstado.append(sel);
      } else {
        const b = document.createElement("span");
        b.className = "da__badge-st";
        b.textContent = r.estado;
        tdEstado.append(b);
      }
      const tdAcc = document.createElement("td");
      tdAcc.className = "da__only-admin";
      const borrar = document.createElement("button");
      borrar.type = "button";
      borrar.className = "da__del";
      borrar.textContent = "🗑";
      borrar.setAttribute("aria-label", `Borrar reserva de ${r.cliente}`);
      borrar.addEventListener("click", (e) => {
        e.stopPropagation();
        tr.classList.add("is-leaving");
        setTimeout(() => {
          reservas.splice(reservas.indexOf(r), 1);
          log(`borró la reserva de ${r.cliente}`);
          toast("Reserva eliminada", "🗑");
          if (abierta === r) abrirFicha(null);
          pintar();
        }, 300);
      });
      tdAcc.append(borrar);
      tr.append(tdCliente, celda(r.servicio), celda(`${r.fecha} · ${r.hora}`), tdEstado, tdAcc);
      tr.addEventListener("click", () => abrirFicha(r));
      return tr;
    }

    function cambiarEstado(r: Reserva, estado: Reserva["estado"]) {
      if (r.estado === estado) return;
      r.estado = estado;
      anotar(r, `${estado[0].toUpperCase()}${estado.slice(1)} por ${ROLES[rol()].toLowerCase()}`);
      log(`${r.cliente} → ${estado}`);
      notificar(`Reserva de ${r.cliente} ${estado}`, estado === "confirmada" ? "✅" : estado === "cancelada" ? "✕" : "⏳");
      pintar();
      if (abierta === r) abrirFicha(r);
    }

    // ── agenda ──
    const horasCol = $<HTMLElement>(".da__hours");
    horasCol.replaceChildren(
      ...Array.from({ length: FIN - INICIO + 1 }, (_, i) => {
        const s = document.createElement("span");
        s.textContent = `${String(INICIO + i).padStart(2, "0")}:00`;
        s.style.setProperty("--y", String(i / (FIN - INICIO)));
        return s;
      }),
    );

    function pintarAgenda() {
      const lane = $<HTMLElement>(".da__lane");
      lane.querySelectorAll(".da__slot").forEach((x) => x.remove());
      reservas
        .filter((r) => r.fecha === "Hoy" && r.estado !== "cancelada")
        .forEach((r, i) => {
          const [h, m] = r.hora.split(":").map(Number);
          const y = (h + m / 60 - INICIO) / (FIN - INICIO);
          const b = document.createElement("button");
          b.type = "button";
          b.className = "da__slot";
          b.dataset.estado = r.estado;
          b.style.setProperty("--y", String(Math.max(0, Math.min(0.96, y))));
          b.style.setProperty("--i", String(i));
          const t = document.createElement("strong");
          t.textContent = `${r.hora} · ${r.cliente}`;
          const s = document.createElement("span");
          s.textContent = `${r.servicio} · ${r.estado}`;
          b.append(t, s);
          b.addEventListener("click", () => abrirFicha(r));
          lane.append(b);
        });
      const ahora = new Date();
      const y = (ahora.getHours() + ahora.getMinutes() / 60 - INICIO) / (FIN - INICIO);
      const marca = $<HTMLElement>(".da__now");
      marca.hidden = y < 0 || y > 1;
      marca.style.setProperty("--y", String(Math.max(0, Math.min(1, y))));
    }

    // ── ficha ──
    function abrirFicha(r: Reserva | null) {
      abierta = r;
      const ficha = $<HTMLElement>(".da__sheet");
      ficha.hidden = !r;
      demo.querySelectorAll("tbody tr").forEach((tr) => tr.classList.toggle("is-sel", !!r && (tr as HTMLElement).dataset.id === String(r.id)));
      if (!r) return;
      $(".da__sheet-ava").textContent = r.cliente.split(" ").map((x) => x[0]).join("").slice(0, 2);
      $(".da__sheet-name").textContent = r.cliente;
      $(".da__sheet-sub").textContent = `reserva #${String(r.id).padStart(4, "0")}`;
      const datos: [string, string][] = [
        ["servicio", r.servicio],
        ["cuándo", `${r.fecha} · ${r.hora}`],
        ["estado", r.estado],
      ];
      if (rol() === "admin") datos.push(["importe", `${r.precio} €`]);
      $(".da__sheet-data").replaceChildren(
        ...datos.map(([k, v]) => {
          const d = document.createElement("div");
          const dt = document.createElement("dt");
          dt.textContent = k;
          const dd = document.createElement("dd");
          dd.textContent = v;
          d.append(dt, dd);
          return d;
        }),
      );
      $(".da__sheet-hist").replaceChildren(
        ...(r.historial ?? []).map((h) => {
          const li = document.createElement("li");
          const b = document.createElement("b");
          b.textContent = h.h;
          li.append(b, ` ${h.t}`);
          return li;
        }),
      );
    }
    $(".da__sheet-close").addEventListener("click", () => abrirFicha(null));
    demo.querySelectorAll<HTMLButtonElement>(".da__sheet-actions button").forEach((b) =>
      b.addEventListener("click", () => abierta && cambiarEstado(abierta, b.dataset.set as Reserva["estado"])),
    );

    // ── pintar todo ──
    function pintar() {
      const q = $<HTMLInputElement>(".da__search").value.trim().toLowerCase();
      const lista = reservas.filter(
        (r) => (!filtro || r.estado === filtro) && (!q || `${r.cliente} ${r.servicio}`.toLowerCase().includes(q)),
      );
      tbody.replaceChildren(...lista.map(fila));
      $<HTMLElement>(".da__none").hidden = lista.length > 0;
      if (abierta) abrirFicha(reservas.includes(abierta) ? abierta : null);

      stat("hoy", reservas.filter((r) => r.fecha === "Hoy" && r.estado !== "cancelada").length);
      stat("conf", reservas.filter((r) => r.estado === "confirmada").length);
      stat("pend", reservas.filter((r) => r.estado === "pendiente").length);
      stat("eur", reservas.filter((r) => r.estado !== "cancelada").reduce((s, r) => s + r.precio, 0), " €");
      pintarAgenda();
      reservas.forEach((r) => delete r.nueva);
    }

    // ── controles ──
    $<HTMLSelectElement>(".da__rol").addEventListener("change", (e) => {
      demo.dataset.rol = (e.target as HTMLSelectElement).value;
      $(".da__perm").textContent = PERMISOS[rol()];
      $(".da__avatar").textContent = AVATAR[rol()];
      form.hidden = true;
      toast(`Has entrado como ${ROLES[rol()]}`, "👤");
      log("inició sesión");
      pintar();
    });

    $<HTMLInputElement>(".da__search").addEventListener("input", pintar);

    demo.querySelectorAll<HTMLButtonElement>(".da__chips button").forEach((b) =>
      b.addEventListener("click", () => {
        filtro = b.dataset.f ?? "";
        demo.querySelectorAll(".da__chips button").forEach((x) => x.classList.toggle("is-on", x === b));
        pintar();
      }),
    );

    demo.querySelectorAll<HTMLButtonElement>(".da__nav [data-vista]").forEach((b) =>
      b.addEventListener("click", () => {
        vista = b.dataset.vista!;
        demo.querySelectorAll(".da__nav [data-vista]").forEach((x) => x.classList.toggle("is-on", x === b));
        demo.querySelectorAll<HTMLElement>(".da__view").forEach((v) => (v.hidden = v.dataset.vista !== vista));
        pintarAgenda();
      }),
    );

    $(".da__new").addEventListener("click", () => {
      form.hidden = !form.hidden;
      if (!form.hidden) form.querySelector<HTMLInputElement>('[name="cliente"]')!.focus();
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const cliente = String(d.get("cliente") ?? "").trim().slice(0, 40);
      if (!cliente) return;
      const servicio = String(d.get("servicio"));
      const r: Reserva = {
        id: siguiente++,
        cliente,
        servicio,
        fecha: String(d.get("fecha")),
        hora: String(d.get("hora") || "18:00"),
        estado: "pendiente",
        precio: precios[servicio] ?? 40,
        historial: [{ t: `Creada por ${ROLES[rol()].toLowerCase()}`, h: ahoraHHMM() }],
        nueva: true,
      };
      reservas.unshift(r);
      log(`creó una reserva para ${cliente}`);
      notificar(`Reserva creada para ${cliente} · email de confirmación enviado`, "📨");
      form.reset();
      form.hidden = true;
      pintar();
    });

    // ── reservas online que entran solas ──
    let entrada = 0;
    const llegar = () => {
      if (document.hidden || !demo.isConnected || entrada >= 6) return;
      entrada++;
      const servicio = servicios()[Math.floor(Math.random() * 4)];
      const hora = `${String(10 + Math.floor(Math.random() * 9)).padStart(2, "0")}:${Math.random() > 0.5 ? "00" : "30"}`;
      const r: Reserva = {
        id: siguiente++,
        cliente: NOMBRES[(entrada - 1) % NOMBRES.length],
        servicio,
        fecha: Math.random() > 0.4 ? "Hoy" : "Mañana",
        hora,
        estado: "pendiente",
        precio: precios[servicio] ?? 40,
        historial: [{ t: "Reservada online desde la web", h: ahoraHHMM() }],
        nueva: true,
      };
      reservas.unshift(r);
      notificar(`Nueva reserva online: ${r.cliente} · ${r.servicio} ${r.fecha.toLowerCase()} ${r.hora}`, "🆕");
      log(`entró una reserva online de ${r.cliente}`);
      pintar();
    };
    function servicios() {
      return Object.keys(precios);
    }
    const t1 = window.setTimeout(llegar, 5000);
    const t2 = window.setInterval(llegar, 16000);
    window.addEventListener(
      "pagehide",
      () => {
        clearTimeout(t1);
        clearInterval(t2);
      },
      { once: true },
    );

    // ── inicio ──
    const hoy = new Date();
    $(".da__today").textContent = hoy.toLocaleDateString("es-ES", { weekday: "long", day: "numeric", month: "long" });
    const h = hoy.getHours();
    $(".da__greet").textContent = h < 14 ? "Buenos días 👋" : h < 21 ? "Buenas tardes 👋" : "Buenas noches 👋";
    $(".da__perm").textContent = PERMISOS[rol()];
    $(".da__avatar").textContent = AVATAR[rol()];
    pintarAvisos();
    pintar();
  });
</script>

