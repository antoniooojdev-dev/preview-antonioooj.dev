---
// Página de un script FiveM que aún está en desarrollo (/servicios/fivem/<id>): cabecera con el
// nombre, un «PRÓXIMAMENTE» animado, lo que tendrá y botones para volver o pedir presupuesto.
// Lo usan src/pages/servicios/fivem/policia.astro, inventario.astro y panel-admin.astro.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icono from "@/components/servicios/Icono.astro";

interface Props {
  titulo: string;
  icono: string;
  lead: string;
  tendra: string[];
  color?: string;
}

const { titulo, icono, lead, tendra, color = "#a855f7" } = Astro.props;
const contacto = `/contacto?tipo=${encodeURIComponent("Script FiveM")}`;
---

<BaseLayout title={`${titulo} · Scripts FiveM`} description={lead}>
  <article class="page" style={`--acc:${color}`}>
    <div class="glow" aria-hidden="true"></div>
    <div class="container">
      <a href="/servicios/fivem#scripts" class="back mono">← cd ../scripts-fivem</a>

      <header class="head">
        <span class="eyebrow mono"><span class="pill"><i aria-hidden="true"></i> en desarrollo</span> scripts fivem</span>
        <h1>
          <span class="h1-icon" aria-hidden="true"><Icono nombre={icono} size={34} /></span>
          {titulo}
        </h1>
        <p class="lead">{lead}</p>
      </header>

      <section class="soon ink" aria-labelledby="soon-t">
        <div class="soon__grid" aria-hidden="true"></div>
        <div class="soon__scan" aria-hidden="true"></div>
        <span class="soon__tag mono"><i aria-hidden="true"></i> compilando…</span>
        <h2 id="soon-t" class="soon__title">
          {"PRÓXIMAMENTE".split("").map((c, i) => <span style={`--i:${i}`}>{c}</span>)}
        </h2>
        <p class="soon__text">Este script todavía está en desarrollo. Estoy terminándolo y probándolo en un servidor real antes de enseñarlo aquí con su vídeo y sus capturas.</p>
        <div class="soon__bar" role="progressbar" aria-label="En desarrollo" aria-valuetext="En desarrollo"><i></i></div>
      </section>

      <section class="block">
        <div class="block-head">
          <h2 class="kicker mono">// lo que tendrá</h2>
          <p class="block-title">Lo que estoy <span>preparando</span></p>
        </div>
        <ul role="list" class="tendra">
          {
            tendra.map((t, i) => (
              <li style={`--i:${i}`}>
                <span class="tendra__icon" aria-hidden="true">
                  <Icono nombre="hourglass" size={16} />
                </span>
                {t}
              </li>
            ))
          }
        </ul>
      </section>

      <div class="actions">
        <a href="/servicios/fivem#scripts" class="btn btn-ghost">Ver los scripts disponibles</a>
        <a href={contacto} class="btn btn-primary">Pedir presupuesto</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    position: relative;
    padding-block: var(--space-7) var(--section);
    overflow-x: clip;
  }

  .glow {
    position: absolute;
    inset: 0 0 auto;
    height: 700px;
    background: radial-gradient(ellipse 55% 55% at 50% 0%, color-mix(in srgb, var(--acc) 24%, transparent), transparent 70%);
    pointer-events: none;
  }

  .container {
    position: relative;
  }

  .back {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }

  .back:hover {
    color: var(--fg);
  }

  .head {
    display: grid;
    gap: var(--space-4);
    max-width: 46rem;
    margin-block: var(--space-6) var(--space-7);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    color: var(--fg);
    background: color-mix(in srgb, var(--acc) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--acc) 35%, transparent);
  }

  .pill i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #f5b14c;
    box-shadow: 0 0 10px #f5b14c;
    animation: parpadeo 1.6s ease-in-out infinite;
  }

  h1 {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .h1-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 4rem;
    height: 4rem;
    border-radius: 20px;
    color: var(--acc);
    background: color-mix(in srgb, var(--acc) 12%, var(--bg));
    border: 1px solid color-mix(in srgb, var(--acc) 30%, transparent);
  }

  .lead {
    color: var(--fg-muted);
    font-size: var(--fs-md);
  }

  /* ── PRÓXIMAMENTE ── */
  .soon {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding: clamp(3rem, 8vw, 6rem) var(--space-5);
    border-radius: 26px;
    overflow: hidden;
    text-align: center;
    color: #f4f4f5;
    background: radial-gradient(ellipse at 50% 120%, color-mix(in srgb, var(--acc) 30%, #0b0b10), #0b0b10 65%);
    border: 1px solid color-mix(in srgb, var(--acc) 30%, transparent);
  }

  .soon__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--acc) 14%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--acc) 14%, transparent) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse at 50% 50%, #000 20%, transparent 75%);
    animation: rejilla 14s linear infinite;
  }

  .soon__scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--acc) 16%, transparent) 50%, transparent);
    height: 30%;
    animation: barrido 4.5s ease-in-out infinite;
  }

  .soon__tag {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.75rem;
    color: #d4d4d8;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .soon__tag i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--acc);
    animation: parpadeo 1.2s ease-in-out infinite;
  }

  .soon__title {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    font-size: clamp(2.2rem, 9vw, 6.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .soon__title span {
    display: inline-block;
    background: linear-gradient(180deg, #fff, color-mix(in srgb, var(--acc) 70%, #fff));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: letra 2.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    animation-delay: calc(var(--i) * 0.08s);
  }

  .soon__text {
    position: relative;
    max-width: 36rem;
    color: #b4b4bd;
  }

  .soon__bar {
    position: relative;
    width: min(22rem, 80%);
    height: 6px;
    border-radius: 999px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.08);
  }

  .soon__bar i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 35%;
    border-radius: inherit;
    background: linear-gradient(90deg, transparent, var(--acc), transparent);
    animation: carga 1.8s ease-in-out infinite;
  }

  /* ── lo que tendrá ── */
  .block {
    margin-top: var(--section);
  }

  .block-head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .kicker {
    font-size: var(--fs-sm);
    color: var(--acc);
  }

  .block-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .block-title span {
    color: var(--acc);
  }

  .tendra {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .tendra li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: 14px;
    border: 1px dashed var(--border);
    background: var(--bg-elev);
    color: var(--fg-muted);
    animation: aparecer 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 70ms);
  }

  .tendra__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 10px;
    color: var(--acc);
    background: color-mix(in srgb, var(--acc) 12%, var(--bg));
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  @keyframes parpadeo {
    50% {
      opacity: 0.35;
    }
  }

  @keyframes rejilla {
    to {
      background-position: 44px 44px;
    }
  }

  @keyframes barrido {
    0% {
      transform: translateY(-110%);
    }
    100% {
      transform: translateY(400%);
    }
  }

  @keyframes letra {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    12% {
      transform: translateY(-8px);
    }
    24% {
      transform: translateY(0);
    }
  }

  @keyframes carga {
    0% {
      left: -35%;
    }
    100% {
      left: 100%;
    }
  }

  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (max-width: 720px) {
    .tendra {
      grid-template-columns: 1fr;
    }

    h1 {
      gap: var(--space-3);
    }

    .h1-icon {
      width: 3.2rem;
      height: 3.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .soon__grid,
    .soon__scan,
    .soon__title span,
    .soon__bar i,
    .pill i,
    .soon__tag i,
    .tendra li {
      animation: none;
    }
  }
</style>
