---
// Ficha de venta del sistema de bandas con diseño propio (no el del police):
//  1. hero de cine sobre la portada del vídeo, con precio y compra dentro
//  2. «el ciclo de una banda»: línea de tiempo que se rellena con el scroll
//  3. módulos como pestañas dentro de una tablet (capturas que pasan solas)
//  4. cifras en bento con capturas de fondo
//  5. escalera de rangos y permisos
//  6. documentación como pestañas de archivos en una ventana de editor
//  7. preguntas en tarjetas, cierre con precio y barra de compra fija al bajar
// Datos en src/data/bandas.ts. La usa /pruebas-bandas.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { bandas as b, bandasCiclo, bandasRangos } from "@/data/bandas";
import { fivemPacks } from "@/data/packs";

interface Props { pruebas?: boolean }
const { pruebas = false } = Astro.props;

const euros = (n: number) => n.toLocaleString("es-ES", { minimumFractionDigits: 2 }) + " €";
const precio = euros(b.precio);
const precioAntes = b.precioAntes ? euros(b.precioAntes) : "";
const n2 = (i: number) => String(i + 1).padStart(2, "0");
const yt = b.youtube!;
// archivos de la documentación (los permisos ya salen en la escalera)
const archivos: Record<string, string> = {
  requisitos: "requisitos.md",
  instalacion: "instalacion.md",
  configuracion: "config.lua",
  comandos: "comandos.md",
  actualizar: "actualizar.md",
};
const docs = b.docs.filter((d) => archivos[d.id]);
// capturas para el fondo de algunas cifras del bento
const fondos = ["/fivem/sistema-bandas/media/tiroteo.webp", "/fivem/sistema-bandas/media/mision.webp", "/fivem/sistema-bandas/media/taquilla.webp"];
---

<BaseLayout
  title={pruebas ? `Pruebas · ${b.titulo}` : `${b.titulo} · Script FiveM`}
  description={pruebas ? undefined : `${b.lema}. ${b.lead}`}
  noindex={pruebas}
  intro={false}
>
  <div class="fb" data-no-i18n>
    <div class="container">
      <!-- ── 1. hero ── -->
      <section class="fb-hero" data-hero>
        <div class="fb-hero__fondo" aria-hidden="true">
          <img src="/fivem/sistema-bandas/media/crew.webp" alt="" />
        </div>
        <div class="fb-hero__capas" aria-hidden="true">
          {[b.modulos[0].galeria[0], b.modulos[1].galeria[0], b.modulos[4].galeria[0]].map((g, i) => (
            <img class={`fb-flota fb-flota--${i}`} src={g.src} alt="" data-flota={i} />
          ))}
        </div>

        <div class="fb-hero__txt">
          <nav class="fb-migas mono" aria-label="Migas">
            <a href="/servicios/fivem">scripts-fivem</a><span>/</span><b>{b.recurso}</b><span class="fb-v">v{b.version}</span>
          </nav>
          <h1 class="fb-h1">
            {b.titulo.split(" ").map((w, i) => <span class="fb-pal" style={`--i:${i}`}><span>{w}</span></span>)}
          </h1>
          <p class="fb-lema">{b.lema}</p>
          <div class="fb-fw">
            {b.frameworks.map((f) => <span class="mono">{f}</span>)}
          </div>
          <div class="fb-hero__acc">
            <button type="button" class="fb-play" data-abrir-yt>
              <i aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></i>
              <span>Ver el recorrido<small class="mono">{yt.t}</small></span>
            </button>
          </div>
        </div>

        <aside class="fb-caja">
          <p class="mono fb-caja__k">Oferta de lanzamiento</p>
          <div class="fb-caja__precio">
            <b>{precio}</b>
            {precioAntes && <s>{precioAntes}</s>}
            {b.descuento && <span class="mono">-{b.descuento}%</span>}
          </div>
          <button type="button" class="btn btn-primary fb-comprar" data-comprar>Comprar ahora</button>
          <p class="fb-caja__pie">Pago único · licencia en tu cuenta de Cfx.re</p>
        </aside>
      </section>

      <!-- ── 2. ciclo ── -->
      <section class="fb-sec" data-ciclo>
        <header class="fb-cab" data-rv>
          <p class="mono fb-k">Cómo encaja todo</p>
          <h2 class="fb-h2">El ciclo de <span>una banda</span></h2>
          <p class="fb-sub">{b.modulosSub}</p>
        </header>
        <ol class="fb-ciclo" style={`--n:${bandasCiclo.length}`}>
          <span class="fb-ciclo__linea" aria-hidden="true"><i data-linea></i></span>
          {bandasCiclo.map((c, i) => (
            <li class="fb-paso" data-paso style={`--i:${i}`}>
              <span class="fb-paso__n mono">{n2(i)}</span>
              <span class="fb-paso__img"><img src={c.img} alt="" loading="lazy" /></span>
              <b>{c.t}</b>
              <p>{c.d}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- ── 3. módulos en pestañas ── -->
      <section class="fb-sec" id="modulos">
        <header class="fb-cab" data-rv>
          <p class="mono fb-k">Qué incluye</p>
          <h2 class="fb-h2">{b.modulosTitulo[0]}<span>{b.modulosTitulo[1]}</span></h2>
        </header>

        <div class="fb-mods" data-mods data-rv>
          <div class="fb-tabs" role="tablist" aria-label="Módulos">
            {b.modulos.map((m, i) => (
              <button type="button" role="tab" class:list={["fb-tab", { "is-on": i === 0 }]} aria-selected={i === 0 ? "true" : "false"} data-tab={i}>
                <span class="mono">{n2(i)}</span>
                <b>{m.nombre}</b>
                <small>{m.sub}</small>
                <i class="fb-tab__barra" aria-hidden="true"></i>
              </button>
            ))}
          </div>

          <div class="fb-panel">
            <div class="fb-tablet">
              <div class="fb-tablet__pant">
                {b.modulos.map((m, i) => (
                  <div class:list={["fb-diapos", { "is-on": i === 0 }]} data-diapos={i}>
                    {m.galeria.map((g, k) => (
                      <img class:list={{ "is-on": k === 0 }} src={g.src} alt={g.t} loading={i === 0 ? "eager" : "lazy"} />
                    ))}
                    <span class="fb-diapos__pie mono"><i aria-hidden="true"></i>Vídeo en grabación · <span data-pie>{m.galeria[0]?.t}</span></span>
                  </div>
                ))}
              </div>
            </div>
            {b.modulos.map((m, i) => (
              <div class:list={["fb-detalle", { "is-on": i === 0 }]} data-detalle={i} role="tabpanel">
                <p class="fb-detalle__res">{m.resumen}</p>
                <ul class="fb-checks">
                  {m.funciones.map((f, k) => <li style={`--k:${k}`}>{f}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ── 4. cifras en bento ── -->
      <section class="fb-sec">
        <div class="fb-bento">
          {b.cifras.map((c, i) => (
            <div class:list={["fb-cifra", `fb-cifra--${i}`, { "fb-cifra--img": i % 2 === 0 }]} data-rv style={`--i:${i}`}>
              {i % 2 === 0 && <img src={fondos[(i / 2) % fondos.length]} alt="" loading="lazy" aria-hidden="true" />}
              <b data-cuenta={c.v}>{c.v}</b>
              <span>{c.l}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- ── 5. escalera de rangos ── -->
      <section class="fb-sec">
        <header class="fb-cab" data-rv>
          <p class="mono fb-k">Rangos y permisos</p>
          <h2 class="fb-h2">De novato <span>a jefe</span></h2>
          <p class="fb-sub">Así empieza cada banda. Luego el jefe crea hasta 7 rangos y marca uno a uno lo que puede hacer cada uno, desde la tablet.</p>
        </header>
        <ol class="fb-escalera">
          {bandasRangos.map((r, i) => (
            <li class="fb-escalon" data-rv style={`--i:${i}; --w:${52 + i * 12}%`}>
              <div class="fb-escalon__r">
                <span class="mono">{r.n}</span>
                <b>{r.r}</b>
              </div>
              <div class="fb-escalon__p">
                {r.p.map((x) => <span>{x}</span>)}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- ── 6. documentación como editor ── -->
      <section class="fb-sec" id="documentacion">
        <header class="fb-cab" data-rv>
          <p class="mono fb-k">Documentación</p>
          <h2 class="fb-h2">Instalado <span>en cinco minutos</span></h2>
          <p class="fb-sub">Lo mismo que viene dentro del recurso.</p>
        </header>
        <div class="fb-editor" data-editor data-rv>
          <div class="fb-editor__barra">
            <span class="fb-editor__puntos" aria-hidden="true"><i></i><i></i><i></i></span>
            <div class="fb-editor__tabs" role="tablist" aria-label="Archivos">
              {docs.map((d, i) => (
                <button type="button" role="tab" class:list={["mono", { "is-on": i === 0 }]} aria-selected={i === 0 ? "true" : "false"} data-archivo={i}>
                  {archivos[d.id]}
                </button>
              ))}
            </div>
          </div>
          <div class="fb-editor__cuerpo">
            <aside class="fb-editor__arbol mono" aria-hidden="true">
              <p>{b.recurso}/</p>
              <span>├ client/</span>
              <span>├ server/</span>
              <span>├ web/</span>
              <span>├ data/</span>
              <span class="is-on">├ config.lua</span>
              <span>├ kits.lua</span>
              <span>└ fxmanifest.lua</span>
            </aside>
            {docs.map((d, i) => (
              <section class:list={["fb-doc", { "is-on": i === 0 }]} data-doc={i} role="tabpanel">
                <h3>{d.t}</h3>
                {d.intro && <p>{d.intro}</p>}
                {d.pasos && <ol>{d.pasos.map((s) => <li>{s}</li>)}</ol>}
                {d.tabla && (
                  <div class="fb-tabla">
                    <table>
                      <thead><tr>{d.tabla.cols.map((c) => <th>{c}</th>)}</tr></thead>
                      <tbody>{d.tabla.filas.map((f) => <tr>{f.map((c, k) => k === 0 ? <td><code>{c}</code></td> : <td>{c}</td>)}</tr>)}</tbody>
                    </table>
                  </div>
                )}
                {d.codigo && (
                  <div class="fb-code">
                    <button type="button" class="mono" data-copiar>Copiar</button>
                    <pre><code>{d.codigo.txt.split("\n").map((l, k) => <span class="fb-ln"><i>{k + 1}</i>{l}</span>)}</code></pre>
                  </div>
                )}
                {d.nota && <p class="fb-nota">{d.nota}</p>}
              </section>
            ))}
          </div>
        </div>
      </section>

      <!-- ── 7. preguntas ── -->
      <section class="fb-sec">
        <header class="fb-cab" data-rv>
          <p class="mono fb-k">Preguntas</p>
          <h2 class="fb-h2">Antes de <span>comprar</span></h2>
        </header>
        <div class="fb-faq">
          {b.faq.map((f, i) => (
            <article class="fb-q" data-rv style={`--i:${i % 3}`}>
              <span class="mono">{n2(i)}</span>
              <b>{f.q}</b>
              <p>{f.a}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- ── cierre ── -->
      <section class="fb-cierre" data-rv>
        <img src="/fivem/sistema-bandas/media/llegada.webp" alt="" loading="lazy" aria-hidden="true" />
        <div>
          <p class="mono fb-k">{b.recurso}</p>
          <h2>Tu ciudad, <span>repartida por zonas.</span></h2>
        </div>
        <div class="fb-cierre__compra">
          <div class="fb-caja__precio">
            <b>{precio}</b>
            {precioAntes && <s>{precioAntes}</s>}
          </div>
          <button type="button" class="btn btn-primary" data-comprar>Comprar ahora</button>
          <a href="/chat" class="fb-cierre__chat">o pregúntame lo que quieras por el chat</a>
        </div>
      </section>

      <!-- ── otros ── -->
      <section class="fb-sec">
        <header class="fb-cab" data-rv>
          <p class="mono fb-k">Más scripts</p>
          <h2 class="fb-h2">También te puede <span>interesar</span></h2>
        </header>
        <div class="fb-otros">
          {fivemPacks.filter((o) => o.id !== b.id).map((o, i) => (
            <a class="fb-otro" href={`/servicios/fivem/${o.id}`} data-rv style={`--i:${i}`}>
              <img src={o.scripts[0].poster} alt="" loading="lazy" />
              <span class="fb-otro__txt">
                <b>{o.titulo}</b>
                <small>{o.resumen}</small>
              </span>
              <span class="fb-otro__ir" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    </div>

    <!-- barra de compra que aparece al pasar el hero -->
    <div class="fb-barra" data-barra aria-hidden="true">
      <img src={yt.portada} alt="" />
      <b>{b.titulo}</b>
      <span class="fb-barra__precio"><b>{precio}</b>{precioAntes && <s>{precioAntes}</s>}</span>
      <button type="button" class="btn btn-primary" data-comprar tabindex="-1">Comprar</button>
    </div>

    <dialog class="fb-yt" data-yt={yt.id}>
      <button type="button" class="fb-yt__x" data-cerrar-yt aria-label="Cerrar">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <div class="fb-yt__marco" data-yt-marco></div>
    </dialog>

    <div class="fb-toast" role="status" aria-live="polite" data-toast></div>
  </div>
</BaseLayout>

<script>
  const reducido = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];

  // ── toast + comprar ──
  const toastEl = $("[data-toast]");
  let toastT = 0;
  const toast = (t: string) => {
    toastEl.textContent = t;
    toastEl.classList.add("is-on");
    clearTimeout(toastT);
    toastT = window.setTimeout(() => toastEl.classList.remove("is-on"), 2600);
  };
  $$("[data-comprar]").forEach((x) => x.addEventListener("click", () => toast("La tienda abre muy pronto. Mientras, escríbeme por el chat.")));

  // ── hero: capturas flotantes que siguen un poco al ratón ──
  const hero = $("[data-hero]");
  if (!reducido && matchMedia("(hover: hover)").matches) {
    const flotas = $$("[data-flota]", hero);
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      flotas.forEach((f, i) => f.style.setProperty("--m", `translate(${x * (14 + i * 10)}px, ${y * (10 + i * 8)}px)`));
    });
    hero.addEventListener("pointerleave", () => flotas.forEach((f) => f.style.setProperty("--m", "translate(0,0)")));
  }

  // ── vídeo de YouTube en un diálogo ──
  const dlg = $<HTMLDialogElement>("dialog.fb-yt");
  const marco = $("[data-yt-marco]");
  $("[data-abrir-yt]").addEventListener("click", () => {
    marco.innerHTML = "";
    const f = document.createElement("iframe");
    f.src = `https://www.youtube-nocookie.com/embed/${dlg.dataset.yt}?autoplay=1&rel=0&modestbranding=1`;
    f.title = "Sistema de bandas en vídeo";
    f.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
    f.allowFullscreen = true;
    marco.append(f);
    dlg.showModal();
  });
  const cerrarYt = () => { dlg.close(); };
  $("[data-cerrar-yt]").addEventListener("click", cerrarYt);
  dlg.addEventListener("click", (e) => { if (e.target === dlg) cerrarYt(); });
  dlg.addEventListener("close", () => (marco.innerHTML = ""));

  // ── barra de compra fija cuando el hero sale de la pantalla ──
  const barra = $("[data-barra]");
  new IntersectionObserver(([e]) => {
    const on = !e.isIntersecting && e.boundingClientRect.top < 0;
    barra.classList.toggle("is-on", on);
    barra.setAttribute("aria-hidden", on ? "false" : "true");
    barra.querySelector("button")!.tabIndex = on ? 0 : -1;
  }).observe(hero);

  // ── ciclo: la línea se rellena con el scroll y enciende cada paso ──
  const ciclo = $("[data-ciclo]");
  const linea = $("[data-linea]");
  const pasos = $$("[data-paso]", ciclo);
  const pintarCiclo = () => {
    const r = $(".fb-ciclo", ciclo).getBoundingClientRect();
    const vh = innerHeight;
    const k = Math.min(1, Math.max(0, (vh * 0.75 - r.top) / (r.height + vh * 0.2)));
    linea.style.setProperty("--p", String(k));
    pasos.forEach((p, i) => p.classList.toggle("is-on", k >= i / pasos.length));
  };
  addEventListener("scroll", pintarCiclo, { passive: true });
  addEventListener("resize", pintarCiclo);
  pintarCiclo();

  // ── módulos: pestañas; cada una pasa sus capturas sola cada 3,5 s ──
  const mods = $("[data-mods]");
  const tabs = $$<HTMLButtonElement>("[data-tab]", mods);
  const diapos = $$("[data-diapos]", mods);
  const detalles = $$("[data-detalle]", mods);
  const PASO = 3500;
  let modAct = 0;
  let foto = 0;
  let tFoto = 0;
  let encima = false;
  const verFoto = (k: number) => {
    const imgs = $$<HTMLImageElement>("img", diapos[modAct]);
    if (!imgs.length) return;
    foto = (k + imgs.length) % imgs.length;
    imgs.forEach((im, j) => im.classList.toggle("is-on", j === foto));
    const pie = diapos[modAct].querySelector<HTMLElement>("[data-pie]");
    if (pie) pie.textContent = imgs[foto].alt;
  };
  const verMod = (i: number) => {
    modAct = (i + tabs.length) % tabs.length;
    tabs.forEach((t, j) => {
      t.classList.toggle("is-on", j === modAct);
      t.setAttribute("aria-selected", j === modAct ? "true" : "false");
    });
    diapos.forEach((d, j) => d.classList.toggle("is-on", j === modAct));
    // en móvil las pestañas van en fila: que la activa quede a la vista (sin mover la página)
    const fila = tabs[modAct].parentElement!;
    if (fila.scrollWidth > fila.clientWidth) fila.scrollTo({ left: tabs[modAct].offsetLeft - 16, behavior: "smooth" });
    detalles.forEach((d, j) => d.classList.toggle("is-on", j === modAct));
    verFoto(0);
    tFoto = performance.now();
  };
  tabs.forEach((t) => t.addEventListener("click", () => verMod(Number(t.dataset.tab))));
  mods.addEventListener("pointerenter", () => (encima = true));
  mods.addEventListener("pointerleave", () => (encima = false));
  $(".fb-tablet__pant", mods).addEventListener("click", () => { verFoto(foto + 1); tFoto = performance.now(); });
  let modsVisible = false;
  new IntersectionObserver(([e]) => (modsVisible = e.isIntersecting)).observe(mods);
  const tickMods = (now: number) => {
    const n = $$("img", diapos[modAct]).length;
    if (encima || !modsVisible || reducido) tFoto = now - Number(mods.dataset.p ?? 0) * PASO;
    const k = Math.min(1, (now - tFoto) / PASO);
    mods.dataset.p = String(k);
    tabs[modAct].style.setProperty("--p", String((foto + k) / Math.max(1, n)));
    if (k >= 1) {
      // al acabar las capturas del módulo, pasa al siguiente
      if (foto + 1 >= n) verMod(modAct + 1);
      else { verFoto(foto + 1); tFoto = now; }
    }
    requestAnimationFrame(tickMods);
  };
  requestAnimationFrame(tickMods);

  // ── documentación: pestañas de archivos ──
  const ed = $("[data-editor]");
  const archivos = $$<HTMLButtonElement>("[data-archivo]", ed);
  const secciones = $$("[data-doc]", ed);
  archivos.forEach((a) =>
    a.addEventListener("click", () => {
      const i = Number(a.dataset.archivo);
      archivos.forEach((x, j) => { x.classList.toggle("is-on", j === i); x.setAttribute("aria-selected", j === i ? "true" : "false"); });
      secciones.forEach((s, j) => s.classList.toggle("is-on", j === i));
    }),
  );
  $$<HTMLButtonElement>("[data-copiar]", ed).forEach((btn) =>
    btn.addEventListener("click", async () => {
      const lineas = $$(".fb-ln", btn.parentElement!).map((l) => l.lastChild?.textContent ?? "");
      try { await navigator.clipboard.writeText(lineas.join("\n")); btn.textContent = "Copiado"; } catch { btn.textContent = "Error"; }
      setTimeout(() => (btn.textContent = "Copiar"), 1500);
    }),
  );

  // ── aparecer con scroll + contadores ──
  const contar = (el: HTMLElement) => {
    const fin = Number(el.dataset.cuenta);
    if (reducido) return;
    const ini = performance.now();
    const paso = (now: number) => {
      const k = Math.min(1, (now - ini) / 1300);
      el.textContent = String(Math.round(fin * (1 - Math.pow(1 - k, 3))));
      if (k < 1) requestAnimationFrame(paso);
    };
    el.textContent = "0";
    requestAnimationFrame(paso);
  };
  const io = new IntersectionObserver(
    (ents) => ents.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add("is-in");
      e.target.querySelectorAll<HTMLElement>("[data-cuenta]").forEach(contar);
      io.unobserve(e.target);
    }),
    { threshold: 0.15, rootMargin: "0px 0px -6% 0px" },
  );
  document.documentElement.classList.add("fb-js");
  $$("[data-rv]").forEach((el) => io.observe(el));
</script>

<style>
  .fb { position: relative; padding-bottom: var(--space-9); }
  .fb-k { margin: 0; font-size: var(--fs-xs); color: var(--fg-subtle); }
  .fb-sec { margin-top: calc(var(--space-9) * 1.4); }
  .fb-cab { display: grid; gap: var(--space-2); margin-bottom: var(--space-7); max-width: 44rem; }
  .fb-h2 { margin: 0; font-size: clamp(2rem, 1.2rem + 2.6vw, 3.6rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1; }
  .fb-h2 span { color: var(--fg-subtle); }
  .fb-sub { margin: 0; color: var(--fg-muted); line-height: 1.6; }

  /* aparecer con scroll */
  :global(.fb-js) [data-rv] {
    opacity: 0; transform: translateY(30px); filter: blur(6px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), filter 0.9s;
    transition-delay: calc(var(--i, 0) * 80ms);
  }
  :global(.fb-js) [data-rv].is-in { opacity: 1; transform: none; filter: none; }

  /* ── 1. hero ── */
  .fb-hero {
    position: relative; isolation: isolate; overflow: hidden;
    margin-top: var(--space-5); min-height: min(78vh, 720px);
    display: grid; grid-template-columns: minmax(0, 1fr) 320px; align-items: end; gap: var(--space-6);
    padding: clamp(1.5rem, 4vw, 3.5rem); border-radius: 28px; color: #fff; background: #050505;
  }
  .fb-hero__fondo { position: absolute; inset: 0; z-index: -2; }
  .fb-hero__fondo img { width: 100%; height: 100%; object-fit: cover; opacity: 0.55; transform: scale(1.08); animation: fb-zoom 2.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .fb-hero__fondo::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(90deg, #050505 8%, rgb(5 5 5 / 0.6) 50%, rgb(5 5 5 / 0.2)), linear-gradient(0deg, #050505, transparent 55%);
  }
  @keyframes fb-zoom { to { transform: scale(1); } }

  .fb-hero__capas { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .fb-flota {
    position: absolute; width: clamp(180px, 22vw, 330px); aspect-ratio: 16 / 9; object-fit: cover; border-radius: 14px;
    border: 1px solid rgb(255 255 255 / 0.14); box-shadow: 0 30px 60px rgb(0 0 0 / 0.6);
    transform: var(--m, translate(0, 0)) rotate(var(--r)); transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0; animation: fb-entra 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards; animation-delay: calc(0.5s + var(--d));
  }
  .fb-flota--0 { right: 6%; top: 9%; --r: 4deg; --d: 0s; }
  .fb-flota--1 { right: 26%; top: 24%; --r: -5deg; --d: 0.12s; width: clamp(150px, 17vw, 250px); }
  .fb-flota--2 { right: 3%; top: 40%; --r: -2deg; --d: 0.24s; width: clamp(140px, 15vw, 220px); }
  @keyframes fb-entra { from { opacity: 0; translate: 0 30px; } to { opacity: 0.92; translate: 0 0; } }

  .fb-hero__txt { display: grid; gap: var(--space-4); max-width: 40rem; }
  .fb-migas { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: var(--fs-xs); color: rgb(255 255 255 / 0.55); }
  .fb-migas a { color: inherit; text-decoration: none; }
  .fb-migas a:hover { color: #fff; }
  .fb-migas b { color: #fff; font-weight: 500; }
  .fb-v { margin-left: 0.4rem; padding: 0 0.45rem; border: 1px solid rgb(255 255 255 / 0.2); border-radius: 999px; }
  .fb-h1 { margin: 0; font-size: clamp(3rem, 1.5rem + 6vw, 7.2rem); font-weight: 650; letter-spacing: -0.06em; line-height: 0.88; }
  .fb-pal { display: inline-block; overflow: hidden; padding-bottom: 0.08em; margin-right: 0.22em; vertical-align: top; }
  .fb-pal > span { display: inline-block; transform: translateY(105%); animation: fb-sube 1s cubic-bezier(0.16, 1, 0.3, 1) forwards; animation-delay: calc(0.15s + var(--i) * 0.09s); }
  @keyframes fb-sube { to { transform: none; } }
  .fb-lema { margin: 0; font-size: var(--fs-md); color: rgb(255 255 255 / 0.78); max-width: 32rem; }
  .fb-fw { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .fb-fw span { padding: 0.25rem 0.65rem; border-radius: 999px; font-size: 0.72rem; border: 1px solid rgb(255 255 255 / 0.22); background: rgb(255 255 255 / 0.06); }
  .fb-lema, .fb-fw, .fb-hero__acc, .fb-migas, .fb-caja { animation: fb-in 1s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .fb-migas { animation-delay: 0.05s; }
  .fb-lema { animation-delay: 0.45s; }
  .fb-fw { animation-delay: 0.55s; }
  .fb-hero__acc { animation-delay: 0.65s; }
  .fb-caja { animation-delay: 0.75s; }
  @keyframes fb-in { from { opacity: 0; transform: translateY(16px); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }

  .fb-play {
    display: inline-flex; align-items: center; gap: 0.8rem; padding: 0.4rem 1.2rem 0.4rem 0.4rem; border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.2); background: rgb(255 255 255 / 0.08); color: #fff; cursor: pointer; text-align: left;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); transition: background 0.25s, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fb-play:hover { background: rgb(255 255 255 / 0.16); transform: translateY(-2px); }
  .fb-play i { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: #000; animation: fb-latido 2.4s ease-out infinite; }
  .fb-play svg { margin-left: 2px; }
  .fb-play span { display: grid; font-weight: 600; font-size: var(--fs-sm); }
  .fb-play small { font-weight: 400; font-size: 0.68rem; color: rgb(255 255 255 / 0.6); }
  @keyframes fb-latido { 0% { box-shadow: 0 0 0 0 rgb(255 255 255 / 0.5); } 100% { box-shadow: 0 0 0 16px rgb(255 255 255 / 0); } }

  .fb-caja {
    display: grid; gap: var(--space-3); padding: var(--space-5); border-radius: 22px;
    background: rgb(12 12 14 / 0.6); border: 1px solid rgb(255 255 255 / 0.14);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  }
  .fb-caja__k { margin: 0; font-size: 0.68rem; color: rgb(255 255 255 / 0.6); }
  .fb-caja__precio { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.6rem; }
  .fb-caja__precio b { font-size: clamp(2.4rem, 1.8rem + 1.6vw, 3.2rem); font-weight: 600; letter-spacing: -0.05em; line-height: 1; }
  .fb-caja__precio s { position: relative; text-decoration: none; opacity: 0.55; font-size: 1.1rem; }
  .fb-caja__precio s::after {
    content: ""; position: absolute; left: -3px; right: -3px; top: 52%; height: 2px; background: currentColor;
    transform-origin: left; transform: rotate(-8deg) scaleX(0); animation: fb-tacha 0.6s 1.3s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  @keyframes fb-tacha { to { transform: rotate(-8deg) scaleX(1); } }
  .fb-caja__precio span { align-self: center; padding: 0.18rem 0.5rem; border-radius: 999px; background: #fff; color: #000; font-size: 0.72rem; font-weight: 700; }
  .fb-hero .btn-primary { background: #fff; color: #000; border-color: #fff; }
  .fb-comprar { width: 100%; justify-content: center; }
  .fb-caja__pie { margin: 0; font-size: 0.7rem; color: rgb(255 255 255 / 0.55); }

  /* ── 2. ciclo ── */
  .fb-ciclo {
    position: relative; list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: var(--space-4);
  }
  .fb-ciclo__linea { position: absolute; left: 0; right: 0; top: 14px; height: 1px; background: var(--border); }
  .fb-ciclo__linea i { position: absolute; inset: 0; background: var(--fg); transform-origin: left; transform: scaleX(var(--p, 0)); }
  .fb-paso { position: relative; display: grid; gap: 0.6rem; align-content: start; }
  .fb-paso__n {
    position: relative; z-index: 1; width: 29px; height: 29px; border-radius: 50%; display: grid; place-items: center;
    font-size: 0.66rem; background: var(--bg); border: 1px solid var(--border); color: var(--fg-subtle);
    transition: background 0.4s, color 0.4s, border-color 0.4s, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .fb-paso.is-on .fb-paso__n { background: var(--fg); color: var(--bg); border-color: var(--fg); transform: scale(1.12); }
  .fb-paso__img { display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 12px; border: 1px solid var(--border); background: #0b0b0b; }
  .fb-paso__img img { width: 100%; height: 100%; object-fit: cover; display: block; filter: grayscale(1) brightness(0.6); transform: scale(1.08); transition: filter 0.8s, transform 1.2s cubic-bezier(0.16, 1, 0.3, 1); }
  .fb-paso.is-on .fb-paso__img img { filter: none; transform: none; }
  .fb-paso b { font-size: var(--fs-sm); font-weight: 600; letter-spacing: -0.01em; }
  .fb-paso p { margin: 0; font-size: 0.78rem; color: var(--fg-muted); line-height: 1.5; }
  .fb-paso b, .fb-paso p { opacity: 0.35; transition: opacity 0.6s; }
  .fb-paso.is-on b, .fb-paso.is-on p { opacity: 1; }

  /* ── 3. módulos ── */
  .fb-mods { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: var(--space-6); align-items: start; }
  .fb-tabs { display: grid; gap: 0.4rem; position: sticky; top: calc(var(--header-h) + var(--space-5)); }
  .fb-tab {
    position: relative; overflow: hidden; display: grid; grid-template-columns: auto 1fr; column-gap: 0.75rem; row-gap: 0.1rem;
    padding: 0.9rem 1rem; border-radius: 14px; border: 1px solid transparent; background: none; color: var(--fg); text-align: left; cursor: pointer;
    transition: background 0.3s, border-color 0.3s;
  }
  .fb-tab span { grid-row: span 2; font-size: 0.7rem; color: var(--fg-subtle); padding-top: 0.2rem; }
  .fb-tab b { font-size: var(--fs-sm); font-weight: 600; }
  .fb-tab small { font-size: 0.74rem; color: var(--fg-subtle); }
  .fb-tab:hover { background: var(--bg-elev); }
  .fb-tab.is-on { background: var(--bg-elev); border-color: var(--border); }
  .fb-tab__barra { position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; background: var(--fg); transform-origin: left; transform: scaleX(0); }
  .fb-tab.is-on .fb-tab__barra { transform: scaleX(var(--p, 0)); }

  .fb-panel { display: grid; gap: var(--space-5); }
  .fb-tablet { padding: 12px; border-radius: 26px; background: linear-gradient(145deg, #2a2a2a, #0c0c0c); box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7), inset 0 0 0 1px rgb(255 255 255 / 0.08); }
  .fb-tablet__pant { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 16px; background: #000; cursor: pointer; }
  .fb-diapos { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 0.5s, visibility 0.5s; }
  .fb-diapos.is-on { opacity: 1; visibility: visible; }
  .fb-diapos img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.04); transition: opacity 0.7s, transform 4s linear; }
  .fb-diapos img.is-on { opacity: 1; transform: scale(1); }
  .fb-diapos__pie {
    position: absolute; left: 12px; bottom: 12px; display: inline-flex; align-items: center; gap: 0.45rem; max-width: calc(100% - 24px);
    padding: 0.3rem 0.7rem; border-radius: 999px; font-size: 0.68rem; color: #fff; background: rgb(10 10 14 / 0.65);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .fb-diapos__pie i { flex: none; width: 7px; height: 7px; border-radius: 50%; background: #ef4444; animation: fb-parpadeo 1.2s steps(2, start) infinite; }
  @keyframes fb-parpadeo { to { visibility: hidden; } }

  .fb-detalle { display: none; gap: var(--space-4); }
  .fb-detalle.is-on { display: grid; animation: fb-in 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .fb-detalle__res { margin: 0; font-size: var(--fs-md); line-height: 1.55; max-width: 46rem; }
  .fb-checks { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem var(--space-5); }
  .fb-checks li { position: relative; padding-left: 1.6rem; font-size: var(--fs-sm); color: var(--fg-muted); line-height: 1.5; animation: fb-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: calc(var(--k) * 50ms); }
  .fb-checks li::before {
    content: ""; position: absolute; left: 0; top: 0.22em; width: 1rem; height: 1rem; border-radius: 50%; background: var(--fg);
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24zm-1.6 17.2-5-5 1.7-1.7 3.3 3.3 7.2-7.2 1.7 1.7z'/></svg>") center / contain no-repeat;
            mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24zm-1.6 17.2-5-5 1.7-1.7 3.3 3.3 7.2-7.2 1.7 1.7z'/></svg>") center / contain no-repeat;
  }

  /* ── 4. bento ── */
  .fb-bento { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 170px; gap: var(--space-3); }
  .fb-cifra {
    position: relative; overflow: hidden; isolation: isolate; display: flex; flex-direction: column; justify-content: flex-end; gap: 0.2rem;
    padding: var(--space-4); border-radius: var(--radius-tile); border: 1px solid var(--border); background: var(--bg-elev);
  }
  .fb-cifra--0 { grid-column: span 2; grid-row: span 2; }
  .fb-cifra--3 { grid-column: span 2; }
  .fb-cifra--4, .fb-cifra--5 { grid-column: span 2; }
  .fb-cifra img { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(0.45); transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s; }
  .fb-cifra--img { color: #fff; border-color: transparent; }
  .fb-cifra--img:hover img { transform: scale(1.06); filter: grayscale(0.2) brightness(0.5); }
  .fb-cifra b { font-size: clamp(2.4rem, 1.8rem + 2vw, 3.6rem); font-weight: 600; letter-spacing: -0.05em; line-height: 1; }
  .fb-cifra--0 b { font-size: clamp(4rem, 2.6rem + 4vw, 7rem); }
  .fb-cifra span { font-size: var(--fs-xs); opacity: 0.75; }

  /* ── 5. escalera ── */
  .fb-escalera { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .fb-escalon {
    width: var(--w); min-width: min(100%, 520px); display: grid; grid-template-columns: 170px minmax(0, 1fr); align-items: center; gap: var(--space-4);
    padding: 0.85rem 1.1rem; border-radius: 16px; border: 1px solid var(--border); background: var(--bg-elev);
  }
  .fb-escalon:last-child { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .fb-escalon__r { display: flex; align-items: center; gap: 0.7rem; }
  .fb-escalon__r span { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-size: 0.7rem; border: 1px solid currentColor; opacity: 0.7; }
  .fb-escalon__r b { font-weight: 600; font-size: var(--fs-sm); }
  .fb-escalon__p { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .fb-escalon__p span { padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.72rem; border: 1px solid var(--border); color: var(--fg-muted); }
  .fb-escalon:last-child .fb-escalon__p span { border-color: color-mix(in srgb, var(--bg) 30%, transparent); color: var(--bg); }

  /* ── 6. editor ── */
  .fb-editor { border-radius: 20px; border: 1px solid var(--border); background: var(--bg-code, #0d0d0d); overflow: hidden; }
  .fb-editor__barra { display: flex; align-items: center; gap: var(--space-4); padding: 0 0.9rem; border-bottom: 1px solid var(--border); }
  .fb-editor__puntos { display: flex; gap: 6px; flex: none; }
  .fb-editor__puntos i { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }
  .fb-editor__tabs { display: flex; overflow-x: auto; scrollbar-width: none; }
  .fb-editor__tabs button {
    flex: none; padding: 0.85rem 1rem; border: 0; border-bottom: 2px solid transparent; background: none; color: var(--fg-subtle);
    font-size: 0.75rem; cursor: pointer; transition: color 0.2s, border-color 0.2s;
  }
  .fb-editor__tabs button:hover { color: var(--fg); }
  .fb-editor__tabs button.is-on { color: var(--fg); border-bottom-color: var(--fg); }
  .fb-editor__cuerpo { display: grid; grid-template-columns: 200px minmax(0, 1fr); min-height: 380px; }
  .fb-editor__arbol { display: grid; align-content: start; gap: 0.35rem; padding: var(--space-4); border-right: 1px solid var(--border); font-size: 0.72rem; color: var(--fg-subtle); }
  .fb-editor__arbol p { margin: 0 0 0.3rem; color: var(--fg); }
  .fb-editor__arbol .is-on { color: var(--fg); }
  .fb-doc { display: none; gap: var(--space-3); align-content: start; padding: var(--space-5) var(--space-6); }
  .fb-doc.is-on { display: grid; animation: fb-in 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .fb-doc h3 { margin: 0; font-size: var(--fs-lg); font-weight: 600; letter-spacing: -0.02em; }
  .fb-doc p { margin: 0; color: var(--fg-muted); font-size: var(--fs-sm); }
  .fb-doc ol { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.45rem; color: var(--fg-muted); font-size: var(--fs-sm); }
  .fb-tabla { overflow-x: auto; }
  .fb-tabla table { width: 100%; border-collapse: collapse; font-size: var(--fs-xs); }
  .fb-tabla th { text-align: left; font-weight: 500; color: var(--fg-subtle); padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); }
  .fb-tabla td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); color: var(--fg-muted); vertical-align: top; }
  .fb-tabla code { color: var(--fg); font-family: var(--font-mono); white-space: nowrap; }
  .fb-code { position: relative; border-radius: 12px; border: 1px solid var(--border); background: color-mix(in srgb, var(--fg) 3%, transparent); }
  .fb-code button { position: absolute; right: 8px; top: 8px; padding: 0.25rem 0.6rem; border-radius: 8px; border: 1px solid var(--border); background: var(--bg); color: var(--fg-subtle); font-size: 0.68rem; cursor: pointer; }
  .fb-code button:hover { color: var(--fg); }
  .fb-code pre { margin: 0; padding: 0.9rem 0; overflow-x: auto; font-size: 0.78rem; line-height: 1.7; }
  .fb-ln { display: block; padding-right: 1rem; white-space: pre; }
  .fb-ln i { display: inline-block; width: 2.6rem; padding-right: 1rem; text-align: right; font-style: normal; color: var(--fg-subtle); opacity: 0.6; user-select: none; }
  .fb-nota { padding: 0.75rem 1rem; border-radius: 10px; border-left: 2px solid var(--fg); background: color-mix(in srgb, var(--fg) 4%, transparent); }

  /* ── 7. preguntas ── */
  .fb-faq { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .fb-q { display: grid; gap: 0.5rem; align-content: start; padding: var(--space-5); border-radius: var(--radius-tile); border: 1px solid var(--border); transition: border-color 0.3s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
  :global(.fb-js) .fb-q.is-in { transition: opacity 0.9s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), filter 0.9s, border-color 0.3s; }
  .fb-q:hover { border-color: var(--border-strong); transform: translateY(-3px); }
  .fb-q span { font-size: 0.68rem; color: var(--fg-subtle); }
  .fb-q b { font-size: var(--fs-md); font-weight: 600; letter-spacing: -0.02em; line-height: 1.25; }
  .fb-q p { margin: 0; font-size: var(--fs-sm); color: var(--fg-muted); line-height: 1.55; }

  /* ── cierre ── */
  .fb-cierre {
    position: relative; isolation: isolate; overflow: hidden; margin-top: calc(var(--space-9) * 1.4);
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--space-6);
    padding: clamp(1.5rem, 5vw, 4rem); border-radius: 28px; color: #fff; background: #050505;
  }
  .fb-cierre > img { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; opacity: 0.4; filter: grayscale(0.4); }
  .fb-cierre::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, #050505 10%, transparent); }
  .fb-cierre h2 { margin: 0.4rem 0 0; font-size: clamp(2.2rem, 1.2rem + 3.6vw, 4.6rem); font-weight: 600; letter-spacing: -0.05em; line-height: 0.95; }
  .fb-cierre h2 span { color: rgb(255 255 255 / 0.5); }
  .fb-cierre .fb-k { color: rgb(255 255 255 / 0.55); }
  .fb-cierre__compra { display: grid; gap: var(--space-3); justify-items: start; }
  .fb-cierre .btn-primary { background: #fff; color: #000; border-color: #fff; }
  .fb-cierre .fb-caja__precio s::after { animation: none; transform: rotate(-8deg); }
  .fb-cierre__chat { font-size: var(--fs-xs); color: rgb(255 255 255 / 0.65); }
  .fb-cierre__chat:hover { color: #fff; }

