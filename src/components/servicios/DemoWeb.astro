---
// Ejemplo de «Web online»: la web de una clínica dental dentro de un navegador simulado.
//  - Barra de herramientas: dispositivo (la web se adapta con container queries), color
//    de marca, tipografía y modo oscuro.
//  - La web está animada: fondo con manchas en movimiento, contadores, aparición al hacer
//    scroll, opiniones que rotan y una barra de progreso de lectura y scroll con el color
//    de la marca.
//  - Pedir cita: tratamiento, fecha, hora libre y datos. La cita se guarda en «Mis citas»
//    (panel lateral con fecha, cuenta atrás y estado) y llegan notificaciones a la
//    campana: recibida, confirmada y recordatorio.
// Todo vive en memoria: al recargar se pierde y nada se envía.
const colores = ["#0ea5e9", "#10b981", "#f43f5e", "#8b5cf6", "#f59e0b"];
const tratamientos = [
  { id: "revision", nombre: "Revisión y limpieza", precio: "35 €", icono: "🪥", dur: "30 min" },
  { id: "blanqueamiento", nombre: "Blanqueamiento", precio: "180 €", icono: "✨", dur: "60 min" },
  { id: "ortodoncia", nombre: "Ortodoncia invisible", precio: "1ª visita gratis", icono: "😁", dur: "45 min" },
  { id: "implantes", nombre: "Implantes", precio: "Financiado", icono: "🦷", dur: "60 min" },
];
const horas = ["09:00", "09:30", "10:30", "11:00", "12:30", "16:00", "17:00", "18:30"];
const opiniones = [
  { t: "Me quitaron el miedo al dentista. Trato de 10 y sin esperas.", a: "Laura G." },
  { t: "Ortodoncia invisible en 9 meses y sin dolor. ¡Repetiría!", a: "Marcos P." },
  { t: "Pedí cita online un domingo y el lunes ya estaba atendida.", a: "Elena R." },
];
---

<div class="dw" data-demo-web style={`--brand:${colores[0]}`} data-tratamientos={JSON.stringify(tratamientos)}>
  <div class="dw__bar">
    <div class="dw__group" role="group" aria-label="Dispositivo">
      <button type="button" class="dw__dev is-on" data-ancho="100%" aria-pressed="true">🖥 Escritorio</button>
      <button type="button" class="dw__dev" data-ancho="760px" aria-pressed="false">Tablet</button>
      <button type="button" class="dw__dev" data-ancho="390px" aria-pressed="false">Móvil</button>
    </div>
    <div class="dw__group" role="group" aria-label="Color de marca">
      {colores.map((c, i) => <button type="button" class:list={["dw__color", { "is-on": i === 0 }]} style={`--c:${c}`} data-color={c} aria-label={`Color ${c}`} />)}
    </div>
    <div class="dw__group" role="group" aria-label="Tipografía">
      <button type="button" class="dw__font is-on" data-font="sans">Aa</button>
      <button type="button" class="dw__font dw__font--serif" data-font="serif">Aa</button>
    </div>
    <label class="dw__switch">
      <input type="checkbox" class="dw__dark" />
      <span aria-hidden="true"></span>
      oscuro
    </label>
  </div>

  <div class="dw__stage">
    <div class="dw__chrome">
      <span class="dw__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="dw__url mono">🔒 clinicasonrisa.es</span>
      <span class="dw__w mono"></span>
    </div>

    <div class="dw__viewport">
      <div class="site" data-font="sans">
        <span class="site__progress" aria-hidden="true"></span>

        <!-- navegación -->
        <nav class="site__nav">
          <strong class="site__logo"><span>🦷</span> Clínica Sonrisa</strong>
          <ul role="list" class="site__links">
            <li><a href="#s-trat">Tratamientos</a></li>
            <li><a href="#s-opi">Opiniones</a></li>
            <li><a href="#s-cita">Pedir cita</a></li>
          </ul>
          <div class="site__tools">
            <button type="button" class="site__bell" aria-label="Notificaciones" aria-expanded="false">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 8 3 8H3s3-1 3-8"/><path d="M10 20a2 2 0 0 0 4 0"/></svg>
              <b class="site__badge" hidden>0</b>
            </button>
            <button type="button" class="site__mine">
              📅 <span class="site__mine-txt">Mis citas</span> <b class="site__count">0</b>
            </button>
            <button type="button" class="site__burger" aria-label="Menú">☰</button>
          </div>

          <!-- desplegable de notificaciones -->
          <div class="site__notifs" hidden>
            <div class="site__notifs-head">
              <strong>Notificaciones</strong>
              <button type="button" class="site__readall">marcar leídas</button>
            </div>
            <ul role="list" class="site__notifs-list"></ul>
            <p class="site__notifs-empty">Sin notificaciones todavía. Pide una cita 😉</p>
          </div>
        </nav>

        <!-- hero -->
        <header class="site__hero">
          <span class="site__blob site__blob--a" aria-hidden="true"></span>
          <span class="site__blob site__blob--b" aria-hidden="true"></span>
          <div class="site__hero-text">
            <span class="site__tag"><i aria-hidden="true"></i> Primera visita gratuita este mes</span>
            <h4>Tu sonrisa, <em>en las mejores manos</em></h4>
            <p>Odontología general, ortodoncia invisible e implantes en el centro de Sevilla.</p>
            <div class="site__hero-cta">
              <a href="#s-cita" class="site__btn">Reservar cita <span aria-hidden="true">→</span></a>
              <span class="site__rating">⭐ 4,9 · <b data-count="1240">0</b>+ pacientes</span>
            </div>
          </div>
          <div class="site__hero-card" aria-hidden="true">
            <span class="site__smile">😁</span>
            <span class="site__float site__float--a">✓ Sin esperas</span>
            <span class="site__float site__float--b">💳 Financiación 0 %</span>
          </div>
        </header>

        <!-- cifras -->
        <section class="site__stats" data-in>
          <div><b data-count="15">0</b><span>años de experiencia</span></div>
          <div><b data-count="98">0</b><span>% recomiendan</span></div>
          <div><b data-count="6">0</b><span>especialistas</span></div>
        </section>

        <!-- tratamientos -->
        <section class="site__sec" id="s-trat">
          <h5 data-in>Tratamientos</h5>
          <div class="site__cards">
            {
              tratamientos.map((t, i) => (
                <article class="site__card" data-in style={`--d:${i * 80}ms`} data-trat={t.id}>
                  <span class="site__card-ico">{t.icono}</span>
                  <strong>{t.nombre}</strong>
                  <p>{t.precio} · {t.dur}</p>
                  <button type="button" class="site__card-btn">Pedir cita →</button>
                </article>
              ))
            }
          </div>
        </section>

        <!-- opiniones -->
        <section class="site__sec site__opi" id="s-opi" data-in>
          <h5>Lo que dicen nuestros pacientes</h5>
          <div class="site__quotes">
            {
              opiniones.map((o, i) => (
                <blockquote class:list={["site__quote", { "is-on": i === 0 }]}>
                  <p>“{o.t}”</p>
                  <cite>— {o.a} · ⭐⭐⭐⭐⭐</cite>
                </blockquote>
              ))
            }
          </div>
          <div class="site__dots" role="group" aria-label="Opiniones">
            {opiniones.map((_, i) => <button type="button" class:list={{ "is-on": i === 0 }} data-q={i} aria-label={`Opinión ${i + 1}`} />)}
          </div>
        </section>

        <!-- pedir cita -->
        <section class="site__sec" id="s-cita">
          <h5 data-in>Pide tu cita</h5>
          <form class="site__form" data-in novalidate>
            <fieldset class="site__full">
              <legend>1 · Tratamiento</legend>
              <div class="site__chips">
                {
                  tratamientos.map((t, i) => (
                    <label class="site__chip">
                      <input type="radio" name="trat" value={t.id} checked={i === 0} />
                      <span>{t.icono} {t.nombre}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <label>2 · Día<input name="fecha" type="date" required /></label>
            <fieldset class="site__full">
              <legend>3 · Hora <span class="site__hint">(las tachadas están ocupadas)</span></legend>
              <div class="site__hours">
                {
                  horas.map((h, i) => (
                    <label class="site__hour">
                      <input type="radio" name="hora" value={h} disabled={i === 2 || i === 5} />
                      <span>{h}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <label>Nombre<input name="nombre" type="text" autocomplete="off" placeholder="Tu nombre" /></label>
            <label>Teléfono<input name="tel" type="tel" autocomplete="off" placeholder="600 000 000" /></label>
            <p class="site__err site__full" aria-live="polite"></p>
            <button type="submit" class="site__btn site__full">Confirmar cita</button>
          </form>
        </section>

        <footer class="site__foot">© Clínica Sonrisa · Aviso legal · Privacidad · Cookies</footer>

        <!-- panel «Mis citas» -->
        <aside class="site__drawer" aria-label="Mis citas" hidden>
          <div class="site__drawer-head">
            <strong>📅 Mis citas</strong>
            <button type="button" class="site__close" aria-label="Cerrar">✕</button>
          </div>
          <ul role="list" class="site__appts"></ul>
          <div class="site__appts-empty">
            <span>🗓️</span>
            <p>Aún no tienes citas.</p>
            <button type="button" class="site__btn site__goto">Pedir mi primera cita</button>
          </div>
        </aside>
        <div class="site__shade" hidden></div>

        <!-- avisos flotantes -->
        <div class="site__toasts"><div class="site__toasts-in" aria-live="polite"></div></div>
      </div>
    </div>
  </div>
</div>

<script>
  interface Tratamiento {
    id: string;
    nombre: string;
    icono: string;
    dur: string;
  }

  interface Cita {
    id: number;
    trat: Tratamiento;
    fecha: Date;
    nombre: string;
    estado: "pendiente" | "confirmada" | "cancelada";
  }

  interface Aviso {
    texto: string;
    icono: string;
    hora: Date;
    leido: boolean;
  }

  const fmtFecha = new Intl.DateTimeFormat("es-ES", { weekday: "long", day: "numeric", month: "long" });
  const fmtHora = new Intl.DateTimeFormat("es-ES", { hour: "2-digit", minute: "2-digit" });
  const rtf = new Intl.RelativeTimeFormat("es", { numeric: "auto" });

  function cuando(fecha: Date): string {
    const dias = Math.round((new Date(fecha).setHours(0, 0, 0, 0) - new Date().setHours(0, 0, 0, 0)) / 86_400_000);
    return rtf.format(dias, "day");
  }

  document.querySelectorAll<HTMLElement>("[data-demo-web]").forEach((demo) => {
    const tratamientos = JSON.parse(demo.dataset.tratamientos!) as Tratamiento[];
    const vp = demo.querySelector<HTMLElement>(".dw__viewport")!;
    const site = demo.querySelector<HTMLElement>(".site")!;
    const $ = <T extends Element>(s: string) => site.querySelector<T>(s)!;
    const citas: Cita[] = [];
    const avisos: Aviso[] = [];
    let siguiente = 1;

    // ── barra de herramientas ──
    const ancho = demo.querySelector<HTMLElement>(".dw__w")!;
    new ResizeObserver(() => (ancho.textContent = `${Math.round(vp.getBoundingClientRect().width)} px`)).observe(vp);

    const grupo = (sel: string, alPulsar: (b: HTMLButtonElement) => void) =>
      demo.querySelectorAll<HTMLButtonElement>(sel).forEach((b) =>
        b.addEventListener("click", () => {
          demo.querySelectorAll(sel).forEach((x) => {
            x.classList.toggle("is-on", x === b);
            if (x.hasAttribute("aria-pressed")) x.setAttribute("aria-pressed", String(x === b));
          });
          alPulsar(b);
        }),
      );
    grupo(".dw__dev", (b) => (vp.style.width = b.dataset.ancho!));
    grupo(".dw__color", (b) => {
      demo.style.setProperty("--brand", b.dataset.color!);
      site.classList.remove("is-flash");
      void site.offsetWidth;
      site.classList.add("is-flash");
    });
    grupo(".dw__font", (b) => (site.dataset.font = b.dataset.font));
    demo.querySelector<HTMLInputElement>(".dw__dark")!.addEventListener("change", (e) => {
      site.classList.toggle("is-dark", (e.target as HTMLInputElement).checked);
    });

    // ── navegación interna (scroll dentro de la «pantalla») ──
    const irA = (sel: string) => {
      const destino = site.querySelector<HTMLElement>(sel);
      if (destino) vp.scrollTo({ top: destino.offsetTop - 60, behavior: "smooth" });
      site.classList.remove("menu-open");
    };
    site.querySelectorAll<HTMLAnchorElement>('a[href^="#s-"]').forEach((a) =>
      a.addEventListener("click", (e) => {
        e.preventDefault();
        irA(a.getAttribute("href")!);
      }),
    );
    $(".site__burger").addEventListener("click", () => site.classList.toggle("menu-open"));

    // barra de progreso de scroll
    const progreso = $<HTMLElement>(".site__progress");
    vp.addEventListener("scroll", () => {
      const max = vp.scrollHeight - vp.clientHeight;
      progreso.style.transform = `scaleX(${max > 0 ? vp.scrollTop / max : 0})`;
      site.classList.toggle("is-scrolled", vp.scrollTop > 10);
    });

    // aparición al hacer scroll + contadores
    const contar = (b: HTMLElement) => {
      if (b.dataset.done) return;
      b.dataset.done = "1";
      const fin = Number(b.dataset.count);
      const t0 = performance.now();
      const paso = (t: number) => {
        const p = Math.min(1, (t - t0) / 1400);
        b.textContent = Math.round(fin * (1 - (1 - p) ** 3)).toLocaleString("es-ES");
        if (p < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    };
    const io = new IntersectionObserver(
      (entradas) =>
        entradas.forEach((en) => {
          if (!en.isIntersecting) return;
          en.target.classList.add("is-in");
          en.target.querySelectorAll<HTMLElement>("[data-count]").forEach(contar);
          if ((en.target as HTMLElement).dataset.count) contar(en.target as HTMLElement);
          io.unobserve(en.target);
        }),
      { root: vp, threshold: 0.2 },
    );
    site.querySelectorAll("[data-in], [data-count]").forEach((el) => io.observe(el));

    // opiniones que rotan
    let q = 0;
    const quotes = site.querySelectorAll(".site__quote");
    const dots = site.querySelectorAll<HTMLButtonElement>(".site__dots button");
    const verQuote = (n: number) => {
      q = n;
      quotes.forEach((x, i) => x.classList.toggle("is-on", i === n));
      dots.forEach((x, i) => x.classList.toggle("is-on", i === n));
    };
    dots.forEach((d) => d.addEventListener("click", () => verQuote(Number(d.dataset.q))));
    const rot = window.setInterval(() => {
      if (!document.hidden && demo.isConnected) verQuote((q + 1) % quotes.length);
    }, 4500);

    // ── avisos ──
    const toasts = $<HTMLElement>(".site__toasts-in");
    function toast(texto: string, icono = "🔔") {
      const t = document.createElement("div");
      t.className = "site__toast";
      const i = document.createElement("span");
      i.textContent = icono;
      const p = document.createElement("p");
      p.textContent = texto;
      t.append(i, p);
      toasts.append(t);
      setTimeout(() => t.classList.add("is-out"), 3200);
      setTimeout(() => t.remove(), 3600);
    }

    function avisar(texto: string, icono: string) {
      avisos.unshift({ texto, icono, hora: new Date(), leido: false });
      toast(texto, icono);
      pintarAvisos();
      const campana = $<HTMLElement>(".site__bell");
      campana.classList.remove("is-ring");
      void campana.offsetWidth;
      campana.classList.add("is-ring");
    }

    function pintarAvisos() {
      const sinLeer = avisos.filter((a) => !a.leido).length;
      const badge = $<HTMLElement>(".site__badge");
      badge.hidden = !sinLeer;
      badge.textContent = String(sinLeer);
      $<HTMLElement>(".site__notifs-empty").hidden = avisos.length > 0;
      $(".site__notifs-list").replaceChildren(
        ...avisos.slice(0, 8).map((a) => {
          const li = document.createElement("li");
          li.className = a.leido ? "" : "is-new";
          const i = document.createElement("span");
          i.textContent = a.icono;
          const p = document.createElement("p");
          p.textContent = a.texto;
          const h = document.createElement("small");
          h.textContent = fmtHora.format(a.hora);
          li.append(i, p, h);
          return li;
        }),
      );
    }

    const panelAvisos = $<HTMLElement>(".site__notifs");
    $(".site__bell").addEventListener("click", (e) => {
      e.stopPropagation();
      panelAvisos.hidden = !panelAvisos.hidden;
      $(".site__bell").setAttribute("aria-expanded", String(!panelAvisos.hidden));
    });
    $(".site__readall").addEventListener("click", () => {
      avisos.forEach((a) => (a.leido = true));
      pintarAvisos();
    });
    site.addEventListener("click", (e) => {
      if (!panelAvisos.hidden && !(e.target as HTMLElement).closest(".site__notifs, .site__bell")) panelAvisos.hidden = true;
    });

    // ── Mis citas ──
    const drawer = $<HTMLElement>(".site__drawer");
    const sombra = $<HTMLElement>(".site__shade");
    const abrirCitas = (si: boolean) => {
      drawer.hidden = sombra.hidden = !si;
      if (si) {
        drawer.style.top = sombra.style.top = `${vp.scrollTop}px`;
        avisos.forEach((a) => (a.leido = true));
        pintarAvisos();
        pintarCitas();
      }
    };
    $(".site__mine").addEventListener("click", () => abrirCitas(true));
    $(".site__close").addEventListener("click", () => abrirCitas(false));
    sombra.addEventListener("click", () => abrirCitas(false));
    vp.addEventListener("scroll", () => {
      if (!drawer.hidden) drawer.style.top = sombra.style.top = `${vp.scrollTop}px`;
    });
    $(".site__goto").addEventListener("click", () => {
      abrirCitas(false);
      irA("#s-cita");
    });

    function pintarCitas() {
      const activas = citas.filter((c) => c.estado !== "cancelada").length;
      const n = $<HTMLElement>(".site__count");
      n.textContent = String(activas);
      n.classList.toggle("has", activas > 0);
      $<HTMLElement>(".site__appts-empty").hidden = citas.length > 0;
      $(".site__appts").replaceChildren(
        ...[...citas]
          .sort((a, b) => +a.fecha - +b.fecha)
          .map((c) => {
            const li = document.createElement("li");
            li.className = "site__appt";
            li.dataset.estado = c.estado;
            const dia = document.createElement("span");
            dia.className = "site__appt-day";
            dia.innerHTML = "<b></b><small></small>";
            dia.querySelector("b")!.textContent = String(c.fecha.getDate());
            dia.querySelector("small")!.textContent = c.fecha.toLocaleDateString("es-ES", { month: "short" });
            const info = document.createElement("div");
            const titulo = document.createElement("strong");
            titulo.textContent = `${c.trat.icono} ${c.trat.nombre}`;
            const fecha = document.createElement("p");
            fecha.textContent = `${fmtFecha.format(c.fecha)} · ${fmtHora.format(c.fecha)} · ${c.trat.dur}`;
            const meta = document.createElement("p");
            meta.className = "site__appt-meta";
            const estado = document.createElement("span");
            estado.className = "site__pill";
            estado.textContent = c.estado === "pendiente" ? "⏳ pendiente" : c.estado === "confirmada" ? "✓ confirmada" : "✕ cancelada";
            meta.append(estado, ` ${c.estado === "cancelada" ? "" : cuando(c.fecha)}`);
            info.append(titulo, fecha, meta);
            const acciones = document.createElement("div");
            acciones.className = "site__appt-actions";
            if (c.estado !== "cancelada") {
              const cal = document.createElement("button");
              cal.type = "button";
              cal.textContent = "＋ Calendario";
              cal.addEventListener("click", () => toast("Añadida a tu calendario", "🗓️"));
              const cancelar = document.createElement("button");
              cancelar.type = "button";
              cancelar.className = "is-danger";
              cancelar.textContent = "Cancelar";
              cancelar.addEventListener("click", () => {
                c.estado = "cancelada";
                avisar(`Has cancelado tu cita de ${c.trat.nombre.toLowerCase()}`, "🗑️");
                pintarCitas();
              });
              acciones.append(cal, cancelar);
            }
            li.append(dia, info, acciones);
            return li;
          }),
      );
    }

    // ── formulario de cita ──
    const form = $<HTMLFormElement>(".site__form");
    const inputFecha = form.querySelector<HTMLInputElement>('[name="fecha"]')!;
    const hoy = new Date();
    const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    const manana = new Date(hoy);
    manana.setDate(hoy.getDate() + 1);
    inputFecha.min = iso(manana);
    inputFecha.value = iso(manana);

    // «Pedir cita» en una tarjeta de tratamiento: lo marca y baja al formulario
    site.querySelectorAll<HTMLElement>(".site__card").forEach((card) =>
      card.querySelector("button")!.addEventListener("click", () => {
        form.querySelector<HTMLInputElement>(`input[name="trat"][value="${card.dataset.trat}"]`)!.checked = true;
        irA("#s-cita");
      }),
    );

    const err = form.querySelector<HTMLElement>(".site__err")!;
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const nombre = String(d.get("nombre") ?? "").trim();
      const tel = String(d.get("tel") ?? "").replace(/\s/g, "");
      const hora = String(d.get("hora") ?? "");
      const fecha = String(d.get("fecha") ?? "");
      form.querySelectorAll("[aria-invalid]").forEach((x) => x.removeAttribute("aria-invalid"));
      const fallo = (msg: string, campo?: string) => {
        err.textContent = msg;
        if (campo) form.querySelector(`[name="${campo}"]`)?.setAttribute("aria-invalid", "true");
        form.classList.remove("is-shake");
        void form.offsetWidth;
        form.classList.add("is-shake");
      };
      if (!fecha || fecha < inputFecha.min) return fallo("Elige un día a partir de mañana.", "fecha");
      if (!hora) return fallo("Elige una hora libre.");
      if (nombre.length < 2) return fallo("Escribe tu nombre.", "nombre");
      if (!/^[6-9]\d{8}$/.test(tel)) return fallo("Escribe un teléfono de 9 cifras.", "tel");
      err.textContent = "";

      const [hh, mm] = hora.split(":").map(Number);
      const cuando_ = new Date(`${fecha}T00:00`);
      cuando_.setHours(hh, mm);
      const trat = tratamientos.find((t) => t.id === d.get("trat")) ?? tratamientos[0];
      const cita: Cita = { id: siguiente++, trat, fecha: cuando_, nombre: nombre.slice(0, 30), estado: "pendiente" };
      citas.push(cita);
      pintarCitas();

      const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      boton.classList.add("is-done");
      boton.textContent = "✓ ¡Cita solicitada!";
      setTimeout(() => {
        boton.classList.remove("is-done");
        boton.textContent = "Confirmar cita";
      }, 2200);
      $<HTMLElement>(".site__mine").classList.add("is-pop");
      setTimeout(() => $<HTMLElement>(".site__mine").classList.remove("is-pop"), 700);

      avisar(`Cita solicitada: ${trat.nombre}, ${fmtFecha.format(cuando_)} a las ${hora}`, "📨");
      // La clínica la confirma a los pocos segundos y llega un recordatorio
      setTimeout(() => {
        if (cita.estado !== "pendiente") return;
        cita.estado = "confirmada";
        avisar(`¡Confirmada! Te esperamos el ${fmtFecha.format(cuando_)} a las ${hora}`, "✅");
        pintarCitas();
      }, 4000);
      setTimeout(() => {
        if (cita.estado === "confirmada") avisar(`Recordatorio: ${trat.nombre.toLowerCase()} ${cuando(cuando_)} a las ${hora}`, "⏰");
      }, 9000);
      form.querySelectorAll<HTMLInputElement>('input[name="hora"]:checked').forEach((x) => (x.checked = false));
    });

    window.addEventListener("pagehide", () => clearInterval(rot), { once: true });
    pintarAvisos();
    pintarCitas();
  });
</script>

