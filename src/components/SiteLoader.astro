---
// Pantalla de entrada de las páginas interiores: la misma que la de la portada (fondo negro,
// logo y una línea que se llena). En la portada el logo vuela a su sitio y se hace partículas;
// aquí, al terminar, el logo crece y se desvanece (como la cortina del cambio de idioma) y la
// web aparece debajo con un pequeño zoom.
//
// La línea tarda lo mismo que en la portada y la pantalla no se va hasta que la página ha
// cargado (window load), con un tope de 5 s.
// Contrato con el resto: quita html.is-loading al terminar (reveal.ts lo espera) y pone
// html.page-in durante la entrada de la página.
import logoMask from "@/assets/logo-mask.png";
---

<link rel="preload" as="image" href={logoMask.src} />

<div id="site-loader" aria-hidden="true" style={`--logo: url("${logoMask.src}")`}>
  <div class="sl-fondo"></div>
  <div class="sl-logo"></div>
  <div class="sl-barra"><i></i></div>
</div>

<noscript><style is:inline>#site-loader{display:none!important}html.is-loading body>*{opacity:1!important}</style></noscript>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var loader = document.getElementById("site-loader");
    if (!loader) return root.classList.remove("is-loading");
    if (!root.classList.contains("is-loading")) return loader.remove();

    var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    var MIN = reduced ? 200 : 1600; // lo que tarda la línea en llenarse (igual que en la portada)
    var cargada = document.readyState === "complete";
    var minimo = false;
    var done = false;

    // la línea se llena con una transición de CSS (.is-llenando)
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { loader.classList.add("is-llenando"); });
    });
    setTimeout(function () { minimo = true; if (cargada) salir(); }, MIN);
    addEventListener("load", function () { cargada = true; if (minimo) salir(); });

    function salir() {
      if (done) return;
      done = true;
      loader.classList.add("hide");
      // la página ya responde mientras el fondo se desvanece
      setTimeout(function () {
        root.classList.remove("is-loading");
        root.classList.add("page-in");
      }, reduced ? 0 : 250);
      setTimeout(function () { loader.remove(); root.classList.remove("page-in"); }, reduced ? 300 : 1500);
    }

    // Red de seguridad: nunca más de 5 s tapando la web
    setTimeout(salir, 5000);
  })();
</script>

<style is:global>
  html.is-loading,
  html.is-loading body {
    overflow: hidden;
  }

  html.is-loading body > *:not(#site-loader) {
    opacity: 0;
  }

  /* la web aparece debajo de la pantalla con un pequeño zoom */
  html.page-in body > *:not(#site-loader) {
    animation: page-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  #site-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
  }

  #site-loader.hide {
    pointer-events: none;
  }

  /* el fondo va aparte para desvanecerlo mientras el logo crece */
  .sl-fondo {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, #141414 0%, #0a0a0a 70%);
    transition: opacity 1.1s cubic-bezier(0.45, 0, 0.55, 1) 0.15s;
  }

  #site-loader.hide .sl-fondo {
    opacity: 0;
  }

  .sl-logo,
  .sl-barra {
    position: relative;
  }

  .sl-logo {
    width: min(240px, 60vw);
    aspect-ratio: 895 / 879;
    background: #f2f2f2;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
    animation:
      sl-logo-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both,
      sl-respira 2.4s ease-in-out 0.9s infinite;
    transition:
      transform 1.1s cubic-bezier(0.87, 0, 0.13, 1) 0.1s,
      opacity 0.7s ease 0.5s;
  }

  #site-loader.hide .sl-logo {
    animation: none;
    transform: scale(1.18);
    opacity: 0;
  }

  .sl-barra {
    width: 200px;
    height: 2px;
    border-radius: 2px;
    overflow: hidden;
    background: #262626;
    animation: sl-fade 0.6s ease 0.2s both;
    transition:
      opacity 0.4s cubic-bezier(0.55, 0, 1, 0.45),
      transform 0.4s cubic-bezier(0.55, 0, 1, 0.45);
  }

  #site-loader.hide .sl-barra {
    animation: none;
    opacity: 0;
    transform: translateY(10px);
  }

  .sl-barra i {
    display: block;
    height: 100%;
    background: #f2f2f2;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  #site-loader.is-llenando .sl-barra i {
    transform: scaleX(1);
  }

  @keyframes sl-logo-in {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
  }

  @keyframes sl-respira {
    50% {
      opacity: 0.75;
    }
  }

  @keyframes sl-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes page-in {
    from {
      opacity: 0;
      transform: scale(1.035) translateY(30px);
      filter: blur(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #site-loader,
    #site-loader *,
    html.page-in body > *:not(#site-loader) {
      animation: none !important;
      transition-duration: 0.01s !important;
      transition-delay: 0s !important;
    }
  }
</style>
