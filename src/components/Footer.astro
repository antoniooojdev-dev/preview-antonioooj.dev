---
// Pie: descripción, contacto, redes y legal, y debajo el nombre a sangre de lado a lado:
// primero solo el contorno, que se rellena de izquierda a derecha según se baja hasta el
// final (--p, del script de abajo). Va en --fg: negro en modo claro y blanco en oscuro.
import { site, socials } from "@/data/site";

interface Props {
  /** false = sin el nombre de fondo */
  fondo?: boolean;
}

const { fondo = true } = Astro.props;
---

<footer class:list={["footer", { "sin-fondo": !fondo }]} data-pie>
  <div class="container grid">
    <p class="intro">{site.description}</p>

    <div>
      <h2>Contacto</h2>
      <ul role="list">
        <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{site.location}</li>
        <li><a class="link" href="/contacto">Formulario de proyecto</a></li>
      </ul>
    </div>

    <div>
      <h2>Redes</h2>
      <ul role="list">
        {
          socials.map((s) => (
            <li>
              <a class="link" href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2>Legal</h2>
      <ul role="list">
        <li><a class="link" href="/aviso-legal">Aviso legal</a></li>
        <li><a class="link" href="/privacidad">Privacidad</a></li>
      </ul>
    </div>
  </div>

  {
    fondo && (
      <div class="nombre" aria-hidden="true" data-no-i18n>
        <span class="nombre__borde">ANTONIOOOJ</span>
        <span class="nombre__lleno">ANTONIOOOJ</span>
        <i class="nombre__raya" />
      </div>
    )
  }
</footer>

<script>
  // --p = cuánto del pie se ha visto (0 al asomar, 1 al llegar al final de la página)
  const pie = document.querySelector<HTMLElement>("[data-pie]");
  const nombre = pie?.querySelector<HTMLElement>(".nombre");
  if (pie && nombre) {
    let pendiente = false;
    const medir = () => {
      pendiente = false;
      const r = pie.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight - r.top) / Math.min(r.height, innerHeight)));
      nombre.style.setProperty("--p", p.toFixed(4));
    };
    const pedir = () => {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(medir);
      }
    };
    addEventListener("scroll", pedir, { passive: true });
    addEventListener("resize", pedir);
    medir();
  }
</script>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: var(--space-6);
    padding-top: var(--space-8);
    background: var(--bg);
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: var(--fs-sm);
  }

  .footer.sin-fondo {
    padding-bottom: var(--space-8);
  }

  /* el nombre ocupa todo el ancho y se corta por abajo, «a sangre» */
  .nombre {
    --p: 0;
    position: relative;
    container-type: inline-size;
    display: grid;
    justify-items: center;
    margin-top: var(--space-8);
    pointer-events: none;
    user-select: none;
  }

  .nombre span {
    grid-area: 1 / 1;
    font-family: var(--font-display);
    font-size: 11.6cqw;
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.78;
    white-space: nowrap;
    transform: translateY(9%);
  }

  .nombre__borde {
    color: transparent;
    -webkit-text-stroke: 1px var(--fg);
    opacity: 0.35;
  }

  .nombre__lleno {
    color: var(--fg);
    clip-path: inset(0 calc((1 - var(--p)) * 100%) 0 0);
  }

  .nombre__raya {
    position: absolute;
    bottom: 0;
    left: calc(var(--p) * 100%);
    width: 1px;
    height: 34cqw;
    max-height: 100%;
    background: var(--fg);
    opacity: calc(0.3 * (1 - var(--p)));
  }

  .footer a:hover {
    color: var(--fg);
  }

  .grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: var(--space-7);
  }

  .intro {
    max-width: 24rem;
    font-size: var(--fs-md);
    line-height: 1.45;
    color: var(--fg);
  }

  h2 {
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-subtle);
  }

  li + li {
    margin-top: var(--space-2);
  }

  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .intro {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 26rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
