    margin-top: 1.8rem;
  }

  .cl-buscador > span {
    font-weight: 700;
  }

  .cl-zonas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cl-zonas a {
    padding: 0.4rem 0.8rem;
    border: 1.5px solid var(--linea);
    border-radius: 999px;
    background: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .cl-zonas a:hover {
    border-color: var(--c);
    color: var(--c);
  }

  .cl-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .cl-hero__panel {
    position: relative;
    display: grid;
    gap: 1rem;
    animation: cl-sube 0.9s 0.15s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .cl-tarjeta {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: calc(100% - 2.5rem);
    margin: -3.2rem auto 0;
    padding: 1rem 1.2rem;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: var(--r);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(10px);
    box-shadow: 0 24px 50px -24px rgb(15 42 39 / 0.5);
    animation: cl-flota 5s ease-in-out infinite;
  }

  .cl-punto {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.2rem;
    border-radius: 50%;
    background: #22c55e;
    vertical-align: 1px;
    animation: cl-ping 1.8s infinite;
  }

  .cl-tarjeta__ico {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 14px;
    background: var(--claro);
    color: var(--c);
    font-size: 1.2rem;
  }

  .cl-tarjeta small {
    display: block;
    color: var(--gris);
  }

  .cl-tarjeta strong {
    font-size: 1.15rem;
    text-transform: capitalize;
  }

  .cl-tarjeta a {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-left: auto;
    border-radius: 50%;
    background: var(--c);
    color: #fff;
    transition: transform 0.25s;
  }

  .cl-tarjeta a:hover {
    transform: translateX(3px) scale(1.06);
  }

  .cl-cuerpo-deco {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1.15;
    border-radius: 32px;
    background:
      radial-gradient(70% 60% at 30% 20%, rgb(255 255 255 / 0.25), transparent 60%),
      linear-gradient(160deg, #2dd4bf, var(--c) 70%, #115e59);
    color: #fff;
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgb(15 118 110 / 0.8);
  }

  .cl-cuerpo-deco__rejilla {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.08) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(circle at 50% 50%, #000, transparent 75%);
  }

  .cl-cuerpo-deco > i {
    position: relative;
    z-index: 1;
    font-size: 6.5rem;
    filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.25));
  }

  .cl-flota {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.95);
    color: var(--tinta);
    font-size: 0.8rem;
    font-weight: 700;
    box-shadow: 0 14px 30px -14px rgb(0 0 0 / 0.4);
    animation: cl-flota 6s ease-in-out infinite;
  }

  .cl-flota i {
    color: var(--c);
  }

  .cl-flota--a {
    top: 12%;
    left: 7%;
  }

  .cl-flota--b {
    top: 30%;
    right: 6%;
    animation-delay: -3s;
  }

  .cl-onda {
    position: absolute;
    width: 9rem;
    aspect-ratio: 1;
    border: 2px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    animation: cl-onda 3s var(--d) ease-out infinite;
  }

  .cl-sellos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cl-sellos li {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.7rem;
    border: 1px solid rgb(255 255 255 / 0.8);
    border-radius: 14px;
    background: rgb(255 255 255 / 0.7);
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .cl-sellos i {
    color: var(--c);
  }

  /* secciones */
  .cl-sec {
    padding-block: 5.5rem;
  }

  .cl-sec > .cl-wrap {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cl-sec.is-visto > .cl-wrap {
    opacity: 1;
    transform: none;
  }

  .cl-sec h2 {
    font-size: clamp(2rem, 1.3rem + 2.2vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .cl-sec__head {
    max-width: 40rem;
    margin-bottom: 2.4rem;
  }

  .cl-sec__head p {
    margin-top: 0.6rem;
    color: var(--gris);
  }

  .cl-sec__head--fila {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    max-width: none;
  }

  /* tratamientos */
  .cl-trats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .cl-trat {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.65rem;
    height: 100%;
    padding: 1.6rem;
    border: 1.5px solid var(--linea);
    border-radius: 24px;
    background: linear-gradient(180deg, #fff, #fbfefd);
    text-align: left;
    overflow: hidden;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s,
      box-shadow 0.35s;
  }

  /* brillo de color que sube desde abajo al pasar el ratón */
  .cl-trat::before {
    content: "";
    position: absolute;
    inset: auto -20% -60% -20%;
    height: 80%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--c2) 18%, transparent), transparent);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }

  .cl-trat:hover {
    transform: translateY(-6px);
    border-color: var(--c2);
    box-shadow: 0 28px 50px -30px var(--c);
  }

  .cl-trat:hover::before {
    opacity: 1;
  }

  .cl-trat__n {
    position: absolute;
    top: 1.3rem;
    right: 1.4rem;
    color: color-mix(in srgb, var(--c) 22%, transparent);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    transition: color 0.3s;
  }

  .cl-trat:hover .cl-trat__n {
    color: var(--c2);
  }

  .cl-trat__ico {
    display: grid;
    place-items: center;
    width: 3.3rem;
    height: 3.3rem;
    border-radius: 16px;
    background: var(--claro);
    color: var(--c);
    font-size: 1.3rem;
    transition:
      transform 0.4s cubic-bezier(0.3, 1.6, 0.5, 1),
      background 0.3s,
      color 0.3s,
      box-shadow 0.3s;
  }

  .cl-trat:hover .cl-trat__ico {
    background: linear-gradient(145deg, var(--c2), var(--c));
    color: #fff;
    transform: rotate(-8deg) scale(1.05);
    box-shadow: 0 12px 22px -10px var(--c);
  }

  .cl-trat strong {
    font-size: 1.15rem;
  }

  .cl-trat p {
    color: var(--gris);
    font-size: 0.9rem;
  }

  .cl-trat__pie {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--linea);
    font-weight: 700;
  }

  .cl-trat__pie > span:first-child {
    color: var(--gris);
    font-size: 0.88rem;
  }

  .cl-trat__precio {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--claro);
    color: var(--c);
    transition: opacity 0.25s;
  }

  /* «Ver detalles» sustituye al precio al pasar el ratón */
  .cl-trat__ver {
    position: absolute;
    right: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--c);
    font-size: 0.88rem;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.25s,
      transform 0.3s;
  }

  .cl-trat:hover .cl-trat__ver {
    opacity: 1;
    transform: none;
  }

  .cl-trat:hover .cl-trat__precio {
    opacity: 0;
  }

  /* paneles laterales (ficha de tratamiento y «Tus citas») */
  .cl-ficha {
    width: min(30rem, 100vw);
    height: 100dvh;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 0 2rem 2.2rem;
    border: 0;
    background: #fff;
    color: var(--tinta);
    box-shadow: -30px 0 80px -30px rgb(15 42 39 / 0.5);
    overflow-y: auto;
  }

  .cl-ficha[open] {
    display: grid;
    align-content: start;
    gap: 1.1rem;
    animation: cl-entra-dcha 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cl-ficha[open].is-cierra {
    animation: cl-sale-dcha 0.3s cubic-bezier(0.5, 0, 0.75, 0) forwards;
    pointer-events: none;
  }

  .cl-ficha::backdrop {
    background: rgb(15 42 39 / 0.5);
    backdrop-filter: blur(4px);
  }

  .cl-ficha[open]::backdrop {
    animation: cl-fondo-entra 0.4s ease-out;
  }

  .cl-ficha.is-cierra::backdrop {
    animation: cl-fondo-sale 0.3s ease-in forwards;
  }

  .cl-ficha__x {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    color: var(--tinta);
    box-shadow: 0 6px 16px -8px rgb(15 42 39 / 0.4);
    transition: transform 0.3s;
  }

  .cl-ficha__x:hover {
    transform: rotate(90deg);
  }

  /* cabecera con degradado que ocupa todo el ancho del panel */
  .cl-ficha__cab {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    margin-inline: -2rem;
    padding: 2.6rem 2rem 1.6rem;
    background:
      radial-gradient(80% 90% at 100% 0%, rgb(94 234 212 / 0.35), transparent 60%),
      var(--claro);
  }

  .cl-ficha__cab .cl-trat__ico {
    margin-bottom: 0.4rem;
    background: linear-gradient(145deg, var(--c2), var(--c));
    color: #fff;
    box-shadow: 0 12px 24px -12px var(--c);
  }

  .cl-ficha__kicker {
    color: var(--c);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cl-ficha h3 {
    font-size: 1.9rem;
    font-weight: 800;
  }

  .cl-ficha h4 {
    font-size: 0.78rem;
    color: var(--gris);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cl-ficha p {
    color: var(--gris);
  }

  .cl-ficha[open] > :not(.cl-ficha__x, .cl-ficha__cab) {
    animation: cl-sube 0.45s 0.12s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .cl-ficha__datos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  .cl-ficha__datos div {
    padding: 0.95rem 1rem;
    border: 1px solid var(--linea);
    border-radius: 16px;
    background: #fff;
  }

  .cl-ficha__datos dt {
    color: var(--gris);
    font-size: 0.78rem;
  }

  .cl-ficha__datos dd {
    color: var(--c);
    font-size: 1.3rem;
    font-weight: 800;
  }

  .cl-ficha__inc {
    display: grid;
    gap: 0.45rem;
  }

  .cl-ficha__inc li {
    padding: 0.7rem 0.9rem;
    border-radius: 12px;
    background: #f6fbfa;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .cl-ficha__inc i {
    color: var(--c2);
  }

  /* tus citas */
  .cl-miscitas__intro {
    font-size: 0.92rem;
  }

  .cl-miscitas__lista {
    display: grid;
    gap: 0.6rem;
  }

  .cl-micita {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.9rem;
    align-items: start;
    padding: 0.9rem;
    border: 1.5px solid var(--linea);
    border-radius: 18px;
    background: #fff;
    animation: cl-sube 0.4s calc(var(--i) * 60ms + 0.1s) both;
  }

  .cl-micita.is-pasada {
    background: #f8fbfa;
    opacity: 0.7;
  }

  .cl-micita__fecha {
    display: grid;
    justify-items: center;
    width: 3.6rem;
    padding: 0.5rem 0.3rem;
    border-radius: 14px;
    background: linear-gradient(160deg, var(--c2), var(--c));
    color: #fff;
    line-height: 1.1;
    text-transform: capitalize;
  }

  .cl-micita.is-pasada .cl-micita__fecha {
    background: #a7c7c2;
  }

  .cl-micita__fecha small {
    font-size: 0.68rem;
    font-weight: 700;
    opacity: 0.85;
  }

  .cl-micita__fecha strong {
    font-size: 1.5rem;
    font-weight: 800;
  }

  .cl-micita__info {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .cl-micita__info > strong {
    font-size: 0.98rem;
  }

  .cl-micita__estado {
    justify-self: start;
    margin-bottom: 0.15rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: #eef2f1;
    color: var(--gris);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cl-micita__estado.is-prox {
    background: #dcfce7;
    color: #166534;
  }

  .cl-micita__estado.is-hoy {
    background: #fef3c7;
    color: #92400e;
  }

  .cl-micita__dato {
    color: var(--gris);
    font-size: 0.8rem;
  }

  .cl-micita__dato i {
    width: 1rem;
    color: var(--c2);
  }

  .cl-micita__lado {
    display: grid;
    justify-items: end;
    gap: 0.5rem;
  }

  .cl-micita__precio {
    color: var(--c);
    font-size: 1.05rem;
  }

  .cl-micita__cancelar {
    padding: 0.35rem 0.7rem;
    border: 1.5px solid var(--linea);
    border-radius: 10px;
    background: #fff;
    color: var(--gris);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
    transition:
      border-color 0.2s,
      background 0.2s,
      color 0.2s;
  }

  .cl-micita__cancelar:hover {
    border-color: #fca5a5;
    color: #b91c1c;
  }

  .cl-micita__cancelar.is-confirma {
    border-color: #b91c1c;
    background: #b91c1c;
    color: #fff;
  }

  /* test */
  .cl-test-sec {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(40% 60% at 0% 0%, rgb(20 184 166 / 0.28), transparent 70%),
      radial-gradient(40% 60% at 100% 100%, rgb(14 116 144 / 0.35), transparent 70%),
      var(--tinta);
    color: #fff;
  }

  .cl-test-sec h2 {
    color: #fff;
  }

  .cl-test {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 3rem;
    align-items: start;
  }

  .cl-test__intro p {
    margin-top: 0.8rem;
    color: #a7c7c2;
  }

  .cl-test-sec .cl-kicker {
    border-color: rgb(94 234 212 / 0.3);
    background: rgb(255 255 255 / 0.06);
    color: #5eead4;
  }

  .cl-progreso {
    height: 8px;
    margin-top: 2rem;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.12);
    overflow: hidden;
  }

  .cl-progreso i {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--c2), #5eead4);
    transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cl-test__n {
    display: block;
    margin-top: 0.6rem;
    color: #a7c7c2;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .cl-test__caja {
    padding: 2.2rem;
    border-radius: 28px;
    background: #fff;
    color: var(--tinta);
    box-shadow:
      0 0 0 6px rgb(255 255 255 / 0.06),
      0 40px 80px -40px rgb(0 0 0 / 0.6);
  }

  .cl-preg {
    display: grid;
    gap: 1.2rem;
    animation: cl-sube 0.4s both;
  }

  .cl-preg[hidden] {
    display: none;
  }

  .cl-preg h3 {
    font-size: 1.5rem;
  }

  .cl-mapa {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  .cl-silueta__base > * {
    fill: #e7f2f0;
  }

  .cl-zonasvg > * {
    fill: color-mix(in srgb, var(--c2) 22%, transparent);
    stroke: var(--c2);
    stroke-width: 1.5;
    cursor: pointer;
    transition: fill 0.2s;
  }

  .cl-zonasvg > *:hover {
    fill: color-mix(in srgb, var(--c2) 50%, transparent);
  }

  .cl-zonasvg > .is-sel {
    fill: var(--c);
  }

  .cl-mapa__lista p {
    margin-bottom: 0.6rem;
    color: var(--gris);
    font-size: 0.9rem;
  }

  .cl-opciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .cl-opciones button {
    padding: 0.55rem 0.9rem;
    border: 1.5px solid var(--linea);
    border-radius: 12px;
    background: #fff;
    font-weight: 600;
    transition: all 0.2s;
  }

  .cl-opciones button:hover {
    border-color: var(--c2);
    background: #f6fbfa;
    transform: translateY(-1px);
  }

  .cl-opciones button.is-sel {
    border-color: var(--c);
    background: var(--c);
    color: #fff;
  }

  .cl-opciones--grandes {
    display: grid;
  }

  .cl-opciones--grandes button {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.2rem;
    text-align: left;
  }

  .cl-opciones--grandes i {
    width: 1.4rem;
    color: var(--c);
  }

  .cl-opciones--grandes button.is-sel i {
    color: #fff;
  }

  .cl-test__nav {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 1.2rem;
  }

  .cl-test__nav[hidden] {
    display: none;
  }

  .cl-resultado__badge {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: #fef3c7;
    color: #92400e;
    font-weight: 700;
    font-size: 0.8rem;
  }

  .cl-resultado h3 {
    font-size: 2rem;
    color: var(--c);
  }

  .cl-resultado__extra {
    display: grid;
    gap: 0.5rem;
  }

  .cl-resultado__extra li {
    padding: 0.7rem 0.9rem;
    border-radius: 12px;
    background: var(--claro);
    font-size: 0.9rem;
  }

  .cl-resultado__extra i {
    color: #d97706;
  }

  /* cita */
  .cl-cita {
    display: grid;
    grid-template-columns: 1fr 20rem;
    gap: 1.5rem;
    align-items: start;
  }

  .cl-cita__main {
    padding: 2rem;
    border: 1px solid var(--linea);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 30px 60px -45px rgb(15 42 39 / 0.5);
  }

  .cl-pasos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-bottom: 1.8rem;
    counter-reset: paso;
  }

  .cl-pasos li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1rem;
    color: var(--gris);
    font-size: 0.8rem;
    font-weight: 700;
    counter-increment: paso;
  }

  /* número del paso; se convierte en ✓ al completarlo */
  .cl-pasos li::after {
    content: counter(paso);
    display: grid;
    flex-shrink: 0;
    order: -1;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--claro);
    color: var(--gris);
    font-size: 0.75rem;
    transition:
      background 0.3s,
      color 0.3s;
  }

  .cl-pasos li::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 5px;
    border-radius: 99px;
    background: var(--linea);
    transition: background 0.4s;
  }

  .cl-pasos li.is-on {
    color: var(--tinta);
  }

  .cl-pasos li.is-on::before {
    background: linear-gradient(90deg, var(--c2), var(--c));
  }

  .cl-pasos li.is-on::after {
    background: var(--c);
    color: #fff;
  }

  .cl-pasos li.is-hecho::after {
    content: "✓";
  }

  .cl-cpaso {
    animation: cl-sube 0.35s both;
  }

  .cl-cpaso[hidden] {
    display: none;
  }

  .cl-elige {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .cl-elige__op {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1rem;
    border: 1.5px solid var(--linea);
    border-radius: 14px;
    background: #fff;
    text-align: left;
    transition: all 0.2s;
  }

  .cl-elige__op > i {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
    background: var(--claro);
    color: var(--c);
  }

  .cl-elige__op strong {
    display: block;
    font-size: 0.95rem;
  }

  .cl-elige__op small {
    color: var(--gris);
  }

  .cl-elige__op:hover,
  .cl-elige__op.is-sel {
    border-color: var(--c);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 15%, transparent);
  }

  .cl-elige .cl-mini {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    color: #fff;
    font-weight: 800;
    font-size: 0.85rem;
  }

  .cl-cal {
    max-width: 22rem;
  }

  .cl-cal__cab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
    text-transform: capitalize;
  }

  .cl-cal__cab button {
    width: 2.2rem;
    height: 2.2rem;
    border: 0;
    border-radius: 50%;
    background: var(--claro);
  }

  .cl-cal__sem,
  .cl-cal__dias {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.25rem;
    text-align: center;
  }

  .cl-cal__sem {
    color: var(--gris);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .cl-cal__dias .cl-dia {
    aspect-ratio: 1;
    border: 0;
    border-radius: 10px;
    background: transparent;
    font-weight: 600;
  }

  .cl-cal__dias .cl-dia:hover:not(:disabled) {
    background: var(--claro);
  }

  .cl-cal__dias .cl-dia:disabled {
    color: #b9cbc8;
    cursor: not-allowed;
  }

  .cl-cal__dias .cl-dia.is-hoy {
    box-shadow: inset 0 0 0 1.5px var(--c2);
  }

  .cl-cal__dias .cl-dia.is-sel {
    background: var(--c);
    color: #fff;
  }

  .cl-horas {
    margin-top: 1.4rem;
  }

  .cl-horas .cl-horas__t {
    margin-bottom: 0.6rem;
    font-weight: 700;
  }

  .cl-horas .cl-horas__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.6rem, 1fr));
    gap: 0.4rem;
  }

  .cl-horas .cl-hora {
    padding: 0.5rem;
    border: 1.5px solid var(--linea);
    border-radius: 10px;
    background: #fff;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .cl-horas .cl-hora:hover:not(:disabled) {
    border-color: var(--c);
    color: var(--c);
  }

  .cl-horas .cl-hora:disabled {
    opacity: 0.35;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .cl-campos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  .cl-campos label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .cl-ancho {
    grid-column: 1 / -1;
  }

  .cl-campos :is(input, select, textarea) {
    padding: 0.75rem 0.9rem;
    border: 1.5px solid var(--linea);
    border-radius: 12px;
    font-weight: 400;
    outline: none;
  }

  .cl-campos :is(input, select, textarea):focus {
    border-color: var(--c);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 15%, transparent);
  }

  .cl-check {
    display: flex !important;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500 !important;
  }

  .cl-check input {
    accent-color: var(--c);
  }

  .cl-error {
    min-height: 1.2em;
    margin-bottom: 0.6rem;
    color: #b91c1c;
    font-size: 0.85rem;
  }

  .cl-hecho {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    padding: 1.5rem;
    text-align: center;
  }

  .cl-hecho__ico {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--c);
    color: #fff;
    font-size: 1.8rem;
    animation: cl-pop 0.5s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .cl-hecho h3 {
    font-size: 1.8rem;
  }

  .cl-hecho p {
    max-width: 30rem;
    color: var(--gris);
  }

  .cl-hecho__codigo {
    padding: 0.4rem 0.9rem;
    border: 1.5px dashed color-mix(in srgb, var(--c) 40%, transparent);
    border-radius: 10px;
    background: var(--claro);
    color: var(--c);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .cl-hecho__btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .cl-volver {
    margin-top: 1rem;
    border: 0;
    background: none;
    color: var(--gris);
    font-weight: 600;
  }

  .cl-volver[hidden] {
    display: none;
  }

  .cl-resumen {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 1rem;
    padding: 1.6rem;
    border: 1px solid color-mix(in srgb, var(--c2) 25%, transparent);
    border-radius: 28px;
    background:
      radial-gradient(90% 50% at 100% 0%, rgb(94 234 212 / 0.3), transparent 65%),
      var(--claro);
  }

  .cl-resumen h3 {
    font-size: 1.3rem;
  }

  .cl-resumen dl {
    display: grid;
    gap: 0.8rem;
  }

  .cl-resumen dt {
    color: var(--gris);
    font-size: 0.8rem;
  }

  .cl-resumen dt i {
    width: 1.1rem;
    color: var(--c);
  }

  .cl-resumen dd {
    font-weight: 700;
  }

  .cl-resumen dd::first-letter {
    text-transform: uppercase;
  }

  .cl-resumen__total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1.5px dashed var(--linea);
  }

  .cl-resumen__total strong {
    font-size: 1.6rem;
    color: var(--c);
  }

  /* equipo */
  .cl-equipo-sec {
    background: var(--claro);
  }

  .cl-filtro {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    padding: 0.3rem;
    border-radius: 14px;
    background: #fff;
  }

  .cl-filtro button {
    padding: 0.45rem 0.85rem;
    border: 0;
    border-radius: 10px;
    background: transparent;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--gris);
    transition: all 0.2s;
  }

  .cl-filtro button[aria-pressed="true"] {
    background: var(--c);
    color: #fff;
  }

  .cl-equipo {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .cl-profe {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding: 1.7rem 1rem 1.4rem;
    border: 1px solid #fff;
    border-radius: 24px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--t) 9%, #fff), #fff 45%);
    text-align: center;
    overflow: hidden;
    transition:
      opacity 0.4s,
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.4s,
      box-shadow 0.4s;
  }

  .cl-profe:hover:not(.is-fuera) {
    transform: translateY(-5px);
    box-shadow: 0 26px 44px -30px var(--t);
  }

  .cl-profe.is-fuera {
    opacity: 0.25;
    transform: scale(0.94);
    filter: grayscale(1);
  }

  .cl-profe__foto {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    margin-bottom: 0.6rem;
    border-radius: 50%;
    background: linear-gradient(145deg, color-mix(in srgb, var(--t) 60%, #fff), var(--t));
    color: #fff;
    font-size: 1.4rem;
    font-weight: 800;
    box-shadow:
      0 0 0 4px #fff,
      0 0 0 6px color-mix(in srgb, var(--t) 30%, transparent),
      0 16px 26px -12px var(--t);
    transition: transform 0.4s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .cl-profe:hover .cl-profe__foto {
    transform: scale(1.06) rotate(-4deg);
  }

  .cl-profe > span {
    color: var(--c);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .cl-profe small {
    color: var(--gris);
    font-size: 0.72rem;
  }

  /* mutuas y tarifas */
  .cl-tarifas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .cl-busca {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.4rem;
    padding: 0 1rem;
    border: 1.5px solid var(--linea);
    border-radius: 14px;
    color: var(--gris);
  }

  .cl-busca:focus-within {
    border-color: var(--c);
  }

  .cl-busca input {
    flex: 1;
    padding: 0.9rem 0;
    border: 0;
    outline: none;
  }

  .cl-mutua-res {
    margin-top: 0.8rem;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    background: #f4f8f7;
    color: var(--gris);
    font-size: 0.9rem;
  }

  .cl-mutua-res.is-si {
    background: #dcfce7;
    color: #166534;
  }

  .cl-mutua-res.is-no {
    background: #fef3c7;
    color: #92400e;
  }

  .cl-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.4rem;
  }

  .cl-logos li {
    padding: 0.35rem 0.7rem;
    border-radius: 8px;
    background: #f4f8f7;
    color: var(--gris);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .cl-precios {
    padding: 2rem;
    border-radius: 28px;
    background:
      radial-gradient(70% 50% at 100% 0%, rgb(20 184 166 / 0.3), transparent 70%),
      var(--tinta);
    color: #fff;
    box-shadow: 0 40px 70px -45px rgb(15 42 39 / 0.9);
  }

  .cl-precios__lista li {
    transition: padding 0.25s;
  }

  .cl-precios__lista li:hover {
    padding-inline: 0.4rem;
  }

  .cl-precios__cab {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
  }

  .cl-precios__cab h3 {
    font-size: 1.6rem;
  }

  .cl-precios .cl-filtro {
    background: rgb(255 255 255 / 0.08);
  }

  .cl-precios .cl-filtro button {
    color: #a7c7c2;
  }

  .cl-precios .cl-filtro button[aria-pressed="true"] {
    background: var(--c2);
    color: var(--tinta);
  }

  .cl-precios__lista li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  .cl-precios__lista i {
    width: 1.3rem;
    color: #5eead4;
  }

  .cl-precio {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .cl-precio s {
    color: #7fa8a2;
    font-size: 0.85rem;
  }

  .cl-precio strong {
    font-size: 1.1rem;
  }

  .cl-ahorro {
    margin-top: 1rem;
    color: #5eead4;
    font-size: 0.9rem;
    font-weight: 600;
  }

  /* faq */
  .cl-faq-sec {
    background: var(--claro);
  }

  .cl-faq {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 3rem;
  }

  .cl-faq__lista {
    display: grid;
    gap: 0.6rem;
  }

  .cl-faq__lista details {
    border: 1.5px solid transparent;
    border-radius: 18px;
    background: #fff;
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }

  .cl-faq__lista details:hover {
    border-color: var(--linea);
  }

  .cl-faq__lista details.is-abierto {
    border-color: color-mix(in srgb, var(--c2) 45%, transparent);
    box-shadow: 0 20px 40px -30px var(--c);
  }

  .cl-faq__lista summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.3rem;
    font-weight: 700;
    list-style: none;
    cursor: pointer;
    transition: color 0.2s;
  }

  .cl-faq__lista details.is-abierto summary,
  .cl-faq__lista summary:hover {
    color: var(--c);
  }

  .cl-faq__lista summary::-webkit-details-marker {
    display: none;
  }

  .cl-faq__n {
    flex-shrink: 0;
    color: color-mix(in srgb, var(--c) 35%, transparent);
    font-size: 0.85rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    transition: color 0.3s;
  }

  .cl-faq__lista details.is-abierto .cl-faq__n {
    color: var(--c2);
  }

  .cl-faq__q {
    flex: 1;
  }

  .cl-faq__mas {
    position: relative;
    flex-shrink: 0;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--claro);
    transition:
      background 0.3s,
      transform 0.45s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .cl-faq__mas::before,
  .cl-faq__mas::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 2px;
    margin: -1px 0 0 -5px;
    border-radius: 2px;
    background: var(--c);
    transition:
      transform 0.35s,
      background 0.3s;
  }

  .cl-faq__mas::after {
    transform: rotate(90deg);
  }

  .cl-faq__lista details.is-abierto .cl-faq__mas {
    background: var(--c);
    transform: rotate(180deg);
  }

  .cl-faq__lista details.is-abierto .cl-faq__mas::before,
  .cl-faq__lista details.is-abierto .cl-faq__mas::after {
    background: #fff;
  }

  .cl-faq__lista details.is-abierto .cl-faq__mas::after {
    transform: rotate(0);
  }

  .cl-faq__lista details p {
    padding: 0 1.3rem 1.25rem 3.3rem;
    color: var(--gris);
  }

  /* pie */
  .cl-pie {
    position: relative;
    padding-block: 0 6.5rem;
    background:
      radial-gradient(50% 40% at 100% 0%, rgb(20 184 166 / 0.18), transparent 70%),
      var(--tinta);
    color: #a7c7c2;
  }

  /* la llamada final queda a caballo entre la última sección y el pie */
  .cl-pie__cta {
    position: relative;
    top: -3.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: -1rem;
    padding: 2.2rem 2.4rem;
    border-radius: 28px;
    background:
      radial-gradient(60% 120% at 100% 0%, rgb(255 255 255 / 0.22), transparent 60%),
      linear-gradient(135deg, var(--c2), var(--c) 55%, #115e59);
    color: #fff;
    overflow: hidden;
    box-shadow: 0 40px 70px -40px rgb(15 118 110 / 0.9);
  }

  .cl-pie__cta h2 {
    max-width: 30rem;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .cl-pie__cta p {
    margin-top: 0.4rem;
    color: #ccfbf1;
  }

  .cl-pie__cta-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .cl-pie__in {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .cl-pie strong {
    color: #fff;
  }

  .cl-pie__marca {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .cl-pie__marca .cl-logo small {
    color: #7fa8a2;
  }

  .cl-pie__marca p {
    max-width: 19rem;
    font-size: 0.9rem;
  }

  .cl-pie__redes {
    display: flex;
    gap: 0.5rem;
  }

  .cl-pie__redes a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 12px;
    color: #e6fffa;
    transition:
      background 0.25s,
      border-color 0.25s,
      transform 0.25s;
  }

  .cl-pie__redes a:hover {
    border-color: var(--c2);
    background: var(--c);
    transform: translateY(-2px);
  }

  .cl-pie__col {
    display: grid;
    align-content: start;
    gap: 0.65rem;
    font-size: 0.9rem;
  }

  .cl-pie__col > strong {
    margin-bottom: 0.3rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cl-pie__col a {
    justify-self: start;
    text-decoration: none;
    transition:
      color 0.2s,
      transform 0.2s;
  }

  .cl-pie__col a:hover {
    color: #5eead4;
    transform: translateX(3px);
  }

  .cl-pie__horario {
    display: grid;
    gap: 0.45rem;
  }

  .cl-pie__horario li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px dashed rgb(255 255 255 / 0.1);
  }

  .cl-pie__horario li span:last-child {
    color: #e6fffa;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .cl-pie__horario .is-cerrado {
    color: #7fa8a2 !important;
  }

  .cl-pie__dato i {
    width: 1.2rem;
    color: #5eead4;
  }

  .cl-pie__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    color: #7fa8a2;
    font-size: 0.8rem;
  }

  .cl-pie__legal {
    display: flex;
    gap: 1.2rem;
  }

  .cl-pie__legal a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .cl-pie__legal a:hover {
    color: #fff;
  }

  .cl-wa {
    position: fixed;
    right: 1.2rem;
    bottom: 5rem;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--c);
    color: #fff;
    font-size: 1.3rem;
    box-shadow: 0 14px 30px -10px var(--c);
    animation: cl-flota 4s ease-in-out infinite;
  }

  @keyframes cl-flota {
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes cl-onda {
    from {
      transform: scale(0.6);
      opacity: 1;
    }
    to {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @keyframes cl-sube {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes cl-pop {
    from {
      transform: scale(0.3);
    }
  }

