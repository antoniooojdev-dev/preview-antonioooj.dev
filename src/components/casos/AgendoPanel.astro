---
// Caso «Agendo» · panel del equipo de la Barbería Navaja (/servicios/app/agendo/panel).
// - Entrada eligiendo quién eres: el administrador ve a todo el equipo; cada barbero, solo lo suyo.
// - Inicio: todas las citas agendadas (próximas, hoy, pasadas, canceladas), el equipo ahora y las reservas web.
// - Agenda: semana de UN profesional, con su turno marcado (fuera de turno no se puede citar) y citas arrastrables.
// - Equipo: horario de cada uno (editable por el administrador), su carga de la semana y sus próximas citas.
// - Clientes, servicios y estadísticas.
// Comparte los datos con la web pública vía src/scripts/agendo/datos.ts.
const WEB = "/servicios/app/agendo";
---

<div class="pa" data-pa>
  <!-- entrada -->
  <section class="pa-login" data-pa-login hidden>
    <div class="pa-login__fondo" aria-hidden="true"></div>
    <div class="pa-login__txt">
      <span class="pa-logo"><span><i class="fa-solid fa-calendar-check"></i></span>Agendo</span>
      <h1>El panel de <em>Barbería Navaja</em></h1>
      <p>Cada profesional ve su agenda con su horario. El administrador ve a todo el equipo, las reservas que llegan desde la web y cómo va el negocio.</p>
      <ul role="list" class="pa-login__pts">
        <li><i class="fa-solid fa-user-clock"></i> Agenda por profesional según su turno</li>
        <li><i class="fa-solid fa-globe"></i> Las reservas de la web aparecen al momento</li>
        <li><i class="fa-solid fa-chart-line"></i> Ocupación e ingresos de la semana</li>
      </ul>
    </div>
    <div class="pa-login__caja">
      <h2>¿Quién entra?</h2>
      <p>Demo: elige un perfil, no hace falta contraseña.</p>
      <div class="pa-login__lista" data-pa-quien></div>
      <a class="pa-login__web" href={WEB}><i class="fa-solid fa-arrow-left"></i> Ir a la web de la barbería</a>
    </div>
  </section>

  <!-- app -->
  <div class="pa-app" data-pa-app hidden>
    <aside class="pa-side">
      <div class="pa-side__top">
        <span class="pa-logo"><span><i class="fa-solid fa-calendar-check"></i></span>Agendo</span>
        <div class="pa-negocio">
          <span class="pa-negocio__ico"><i class="fa-solid fa-scissors"></i></span>
          <span><strong>Barbería Navaja</strong><small data-pa-negocio-sub></small></span>
        </div>
      </div>
      <nav class="pa-menu" data-pa-menu aria-label="Secciones">
        <button type="button" data-vista="inicio"><i class="fa-solid fa-house"></i><span>Inicio</span><em data-pa-badge></em></button>
        <button type="button" data-vista="agenda"><i class="fa-solid fa-calendar-week"></i><span>Agenda</span></button>
        <button type="button" data-vista="equipo"><i class="fa-solid fa-user-clock"></i><span>Equipo y horarios</span></button>
        <button type="button" data-vista="clientes"><i class="fa-solid fa-address-book"></i><span>Clientes</span></button>
        <button type="button" data-vista="servicios" data-admin><i class="fa-solid fa-scissors"></i><span>Servicios</span></button>
        <button type="button" data-vista="stats" data-admin><i class="fa-solid fa-chart-simple"></i><span>Estadísticas</span></button>
      </nav>
      <div class="pa-side__pie">
        <a class="pa-side__web" href={WEB} target="_blank"><i class="fa-solid fa-arrow-up-right-from-square"></i> Ver la web pública</a>
        <button type="button" class="pa-side__mini" data-pa-reset><i class="fa-solid fa-rotate-left"></i> Restablecer ejemplo</button>
        <div class="pa-yo" data-pa-yo></div>
      </div>
    </aside>

    <main class="pa-main">
      <header class="pa-top">
        <div class="pa-top__titulo">
          <h1 data-pa-titulo>Inicio</h1>
          <p data-pa-sub></p>
        </div>
        <div class="pa-top__acc">
          <div class="pa-seg" data-solo-vista="agenda">
            <button type="button" data-pa-sem="-1" aria-label="Semana anterior"><i class="fa-solid fa-chevron-left"></i></button>
            <button type="button" data-pa-hoy>Hoy</button>
            <button type="button" data-pa-sem="1" aria-label="Semana siguiente"><i class="fa-solid fa-chevron-right"></i></button>
          </div>
          <label class="pa-buscar" data-solo-vista="clientes"><i class="fa-solid fa-magnifying-glass"></i><input type="search" placeholder="Buscar cliente o teléfono…" data-pa-buscar-cli /></label>
          <button type="button" class="pa-btn" data-pa-nueva><i class="fa-solid fa-plus"></i> Nueva cita</button>
        </div>
      </header>

      <!-- inicio -->
      <section class="pa-vista" data-vista-panel="inicio">
        <div class="pa-kpis" data-pa-kpis></div>
        <div class="pa-inicio">
          <div class="pa-card pa-citas">
            <div class="pa-citas__cab">
              <h2>Citas agendadas</h2>
              <div class="pa-filtros" data-pa-filtros>
                <button type="button" data-f="proximas">Próximas <em></em></button>
                <button type="button" data-f="hoy">Hoy <em></em></button>
                <button type="button" data-f="pasadas">Pasadas <em></em></button>
                <button type="button" data-f="canceladas">Canceladas <em></em></button>
              </div>
            </div>
            <div class="pa-citas__barra">
              <label class="pa-buscar pa-buscar--suave"><i class="fa-solid fa-magnifying-glass"></i><input type="search" placeholder="Cliente o teléfono…" data-pa-busca /></label>
              <select class="pa-select" data-pa-fbarb aria-label="Profesional"></select>
            </div>
            <div class="pa-citas__lista" data-pa-lista></div>
          </div>
          <div class="pa-inicio__lado">
            <div class="pa-card pa-ahora">
              <h2>El equipo ahora</h2>
              <div data-pa-ahora></div>
            </div>
            <div class="pa-card pa-web">
              <h2><i class="fa-solid fa-globe"></i> Últimas reservas web</h2>
              <ul role="list" data-pa-web></ul>
            </div>
          </div>
        </div>
      </section>

      <!-- agenda -->
      <section class="pa-vista" data-vista-panel="agenda" hidden>
        <div class="pa-agenda-cab">
          <div class="pa-tabs" data-pa-tabs></div>
          <div class="pa-agenda-resumen" data-pa-ag-resumen></div>
        </div>
        <div class="pa-card pa-cal">
          <div class="pa-cal__scroll">
            <div class="pa-cal__cab" data-pa-cab></div>
            <div class="pa-cal__cuerpo" data-pa-cuerpo>
              <div class="pa-cal__horas" data-pa-horas></div>
              <div class="pa-cal__cols" data-pa-cols></div>
            </div>
          </div>
        </div>
        <footer class="pa-cal__pie">
          <div class="pa-leyenda" data-pa-leyenda></div>
          <p><i class="fa-solid fa-hand-pointer"></i> Pulsa un hueco dentro del turno para citar · arrastra una cita para moverla</p>
        </footer>
      </section>

      <!-- equipo -->
      <section class="pa-vista" data-vista-panel="equipo" hidden>
        <div class="pa-equipo" data-pa-equipo></div>
      </section>

      <!-- clientes -->
      <section class="pa-vista" data-vista-panel="clientes" hidden>
        <div class="pa-clientes">
          <div class="pa-card pa-card--tabla">
            <table class="pa-tabla">
              <thead><tr><th>Cliente</th><th>Teléfono</th><th>Visitas</th><th>Gastado</th><th>Próxima cita</th></tr></thead>
              <tbody data-pa-cli></tbody>
            </table>
          </div>
          <aside class="pa-card pa-ficha" data-pa-ficha>
            <div class="pa-vacio"><i class="fa-solid fa-address-card"></i><p>Elige un cliente para ver su ficha, su historial y sus próximas citas.</p></div>
          </aside>
        </div>
      </section>

      <!-- servicios -->
      <section class="pa-vista" data-vista-panel="servicios" hidden>
        <ul role="list" class="pa-servicios" data-pa-servicios></ul>
      </section>

      <!-- estadísticas -->
      <section class="pa-vista" data-vista-panel="stats" hidden>
        <div class="pa-kpis" data-pa-skpis></div>
        <div class="pa-graficas">
          <div class="pa-card pa-panel">
            <h2>Ingresos por día <small data-pa-rango></small></h2>
            <div class="pa-barras" data-pa-barras></div>
          </div>
          <div class="pa-card pa-panel">
            <h2>Ocupación por profesional</h2>
            <div class="pa-ocup" data-pa-ocup></div>
          </div>
          <div class="pa-card pa-panel pa-panel--ancho">
            <h2>Servicios más pedidos</h2>
            <div class="pa-hbarras" data-pa-hbarras></div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <!-- modal de cita -->
  <dialog class="pa-modal" data-pa-modal aria-labelledby="pa-modal-t">
    <form class="pa-form" data-pa-form novalidate>
      <header class="pa-form__cab">
        <div>
          <h2 id="pa-modal-t" data-pa-modal-t>Nueva cita</h2>
          <p data-pa-modal-sub></p>
        </div>
        <button type="button" class="pa-ico" data-pa-cerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
      </header>
      <div class="pa-form__cuerpo">
        <label>Cliente
          <input name="cliente" list="pa-lista-cli" autocomplete="off" placeholder="Nombre del cliente" />
          <datalist id="pa-lista-cli" data-pa-datalist></datalist>
        </label>
        <label>Teléfono<input name="tel" inputmode="tel" placeholder="600 000 000" /></label>
        <label>Servicio<select name="servicio"></select></label>
        <label>Profesional<select name="barbero"></select></label>
        <label>Día<input type="date" name="fecha" /></label>
        <label>Hora<select name="hora"></select></label>
        <p class="pa-turno pa-ancho" data-pa-turno></p>
        <div class="pa-ancho pa-campo">
          <span>Estado</span>
          <div class="pa-estados" data-pa-estados>
            <button type="button" data-e="confirmada"><i class="fa-solid fa-circle-check"></i> Confirmada</button>
            <button type="button" data-e="llego"><i class="fa-solid fa-user-check"></i> Atendida</button>
            <button type="button" data-e="noshow"><i class="fa-solid fa-user-xmark"></i> No vino</button>
            <button type="button" data-e="cancelada"><i class="fa-solid fa-ban"></i> Cancelada</button>
          </div>
        </div>
        <label class="pa-ancho">Notas<textarea name="notas" rows="2" placeholder="Degradado bajo, barba perfilada…"></textarea></label>
        <p class="pa-error pa-ancho" data-pa-error></p>
      </div>
      <footer class="pa-form__pie">
        <button type="button" class="pa-btn pa-btn--peligro" data-pa-borrar hidden><i class="fa-solid fa-trash"></i> Borrar</button>
        <button type="button" class="pa-btn pa-btn--suave" data-pa-cancelar>Cerrar</button>
        <button type="submit" class="pa-btn">Guardar cita</button>
      </footer>
    </form>
  </dialog>

  <!-- modal de horario -->
  <dialog class="pa-modal" data-pa-hmodal aria-labelledby="pa-hmodal-t">
    <form class="pa-form" data-pa-hform novalidate>
      <header class="pa-form__cab">
        <div>
          <h2 id="pa-hmodal-t" data-pa-hmodal-t>Horario</h2>
          <p>Marca los días que trabaja y sus turnos. El segundo turno es opcional (para partir el día).</p>
        </div>
        <button type="button" class="pa-ico" data-pa-hcerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
      </header>
      <div class="pa-form__cuerpo pa-hdias" data-pa-hdias></div>
      <p class="pa-error" data-pa-herror></p>
      <footer class="pa-form__pie">
        <button type="button" class="pa-btn pa-btn--suave" data-pa-hcancelar>Cancelar</button>
        <button type="submit" class="pa-btn">Guardar horario</button>
      </footer>
    </form>
  </dialog>

  <div class="pa-toast" data-pa-toast role="status"></div>
</div>

<script>
  import { cargar, guardar, alCambiar, restablecer, serv, barb, huecos, choque, dentroDeHorario, turnosDe, turnosTxt, horaTxt, hhmm, euro, iniciales, inicioDia, masDias, lunes, aLas, sameDay, nuevoId, normalTel, estadoAhora, minutosDeTrabajo, DIAS, H_INI, H_FIN, DIA, type Datos, type Cita, type Barbero, type Estado, type Turnos } from "@/scripts/agendo/datos";

  const raiz = document.querySelector<HTMLElement>("[data-pa]")!;
  const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = raiz) => el.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = raiz) => [...el.querySelectorAll<T>(s)];
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, clase = "", texto = "") {
    const e = document.createElement(tag);
    if (clase) e.className = clase;
    if (texto) e.textContent = texto;
    return e;
  }
  const ico = (n: string) => Object.assign(document.createElement("i"), { className: `fa-solid fa-${n}` });
  const boton = (clase: string, ...hijos: (Node | string)[]) => {
    const b = el("button", clase);
    b.type = "button";
    b.append(...hijos);
    return b;
  };
  const avatar = (b: Barbero, clase = "") => {
    const a = el("span", `pa-av ${clase}`, iniciales(`${b.n} ${b.apellido}`));
    a.style.setProperty("--c", b.c);
    return a;
  };
  const ALTO_H = 64; // px por hora
  raiz.style.setProperty("--h", `${ALTO_H}px`);
  const ORDEN = [1, 2, 3, 4, 5, 6, 0]; // días de lunes a domingo
  const diaCorto = new Intl.DateTimeFormat("es-ES", { weekday: "short" });
  const fechaCorta = new Intl.DateTimeFormat("es-ES", { day: "numeric", month: "short" });
  const fechaDia = (ms: number) => new Date(ms).toLocaleDateString("es-ES", { weekday: "long", day: "numeric", month: "long" });
  const fin = (c: Cita) => c.inicio + serv(datos, c.servicio).min * 60_000;
  const ESTADOS: Record<Estado, [string, string]> = {
    confirmada: ["Confirmada", "circle-check"],
    llego: ["Atendida", "user-check"],
    noshow: ["No vino", "user-xmark"],
    cancelada: ["Cancelada", "ban"],
  };
  function hace(ms: number) {
    const m = Math.round((Date.now() - ms) / 60_000);
    if (m < 1) return "ahora mismo";
    if (m < 60) return `hace ${m} min`;
    if (m < 1440) return `hace ${Math.round(m / 60)} h`;
    const d = Math.round(m / 1440);
    return d === 1 ? "ayer" : `hace ${d} días`;
  }
  function etiquetaDia(ms: number) {
    const d = inicioDia(ms);
    const hoy = inicioDia();
    if (d === hoy) return "Hoy";
    if (d === masDias(hoy, 1)) return "Mañana";
    if (d === masDias(hoy, -1)) return "Ayer";
    return fechaDia(ms);
  }

  let datos: Datos = cargar();

  function toast(t: string) {
    const caja = $("[data-pa-toast]");
    caja.textContent = t;
    caja.classList.add("is-on");
    clearTimeout(Number(caja.dataset.t));
    caja.dataset.t = String(setTimeout(() => caja.classList.remove("is-on"), 2800));
  }

  // ── sesión: quién ha entrado ─────
  const CLAVE_SESION = "agendo-v3-sesion";
  let yo: string | null = null;
  try {
    yo = sessionStorage.getItem(CLAVE_SESION);
  } catch {}
  const esAdmin = () => yo === datos.barberos[0].id;
  const yoB = () => barb(datos, yo!);
  /** las citas que ve quien ha entrado: el administrador todas, cada barbero las suyas */
  const visibles = () => (esAdmin() ? datos.citas : datos.citas.filter((c) => c.barbero === yo));

  function pintarLogin() {
    $("[data-pa-quien]").replaceChildren(
      ...datos.barberos.map((b, i) => {
        const txt = el("span", "pa-quien__txt");
        txt.append(el("strong", "", `${b.n} ${b.apellido}`), el("small", "", i === 0 ? "Administrador · ve a todo el equipo" : `${b.rol} · ve su agenda`));
        const est = estadoAhora(b);
        const pill = el("span", `pa-pill${est.activo ? " is-on" : ""}`);
        pill.append(el("i"), est.activo ? "Trabajando" : est.txt.replace("Ya ha terminado hoy", "Terminó"));
        const b2 = boton("pa-quien", avatar(b), txt, pill, ico("arrow-right"));
        b2.addEventListener("click", () => entrar(b.id));
        return b2;
      }),
    );
  }

  function entrar(id: string | null) {
    yo = id;
    try {
      if (id) sessionStorage.setItem(CLAVE_SESION, id);
      else sessionStorage.removeItem(CLAVE_SESION);
    } catch {}
    arrancar();
  }

  function arrancar() {
    if (yo && !datos.barberos.some((b) => b.id === yo)) yo = null;
    $("[data-pa-login]").hidden = !!yo;
    $("[data-pa-app]").hidden = !yo;
    if (!yo) return pintarLogin();
    agendaDe = yo;
    filtroBarb = "todos";
    $$("[data-admin]").forEach((x) => (x.hidden = !esAdmin()));
    $("[data-pa-fbarb]").hidden = !esAdmin();
    $("[data-pa-negocio-sub]").textContent = `${datos.barberos.length} profesionales · Valencia`;
    const b = yoB();
    const quien = el("div", "pa-yo__txt");
    quien.append(el("strong", "", `${b.n} ${b.apellido}`), el("small", "", esAdmin() ? "Administrador" : b.rol));
    const salir = boton("pa-ico pa-ico--osc", ico("right-from-bracket"));
    salir.title = "Cambiar de usuario";
    salir.setAttribute("aria-label", "Cambiar de usuario");
    salir.addEventListener("click", () => entrar(null));
    $("[data-pa-yo]").replaceChildren(avatar(b), quien, salir);
    const v = location.hash.slice(1);
    irVista(v in TITULOS && (esAdmin() || !["servicios", "stats"].includes(v)) ? v : "inicio");
  }

  // ── vistas ─────
  let vista = "inicio";
  const TITULOS: Record<string, string> = {
    inicio: "Inicio",
    agenda: "Agenda",
    equipo: "Equipo y horarios",
    clientes: "Clientes",
    servicios: "Servicios",
    stats: "Estadísticas",
  };
  const sub = (t: string) => ($("[data-pa-sub]").textContent = t);
  function irVista(v: string) {
    vista = v;
    $$<HTMLButtonElement>("[data-pa-menu] button").forEach((b) => b.toggleAttribute("aria-current", b.dataset.vista === v));
    $$("[data-vista-panel]").forEach((p) => (p.hidden = p.dataset.vistaPanel !== v));
    $$("[data-solo-vista]").forEach((x) => (x.hidden = x.dataset.soloVista !== v));
    $("[data-pa-titulo]").textContent = v === "inicio" ? saludo() : TITULOS[v];
    sub("");
    history.replaceState(null, "", v === "inicio" ? location.pathname : `#${v}`);
    pintar();
    $(".pa-main").scrollTop = 0;
    if (v === "agenda") bajarAHora();
  }
  $$<HTMLButtonElement>("[data-pa-menu] button").forEach((b) => b.addEventListener("click", () => irVista(b.dataset.vista!)));

  function saludo() {
    const h = new Date().getHours();
    return `${h < 6 ? "Buenas noches" : h < 14 ? "Buenos días" : h < 21 ? "Buenas tardes" : "Buenas noches"}, ${yoB().n}`;
  }

  function pintar() {
    if (!yo) return;
    const hoy = visibles().filter((c) => sameDay(c.inicio, Date.now()) && c.estado === "confirmada").length;
    $("[data-pa-badge]").textContent = hoy ? String(hoy) : "";
    if (vista === "inicio") pintarInicio();
    if (vista === "agenda") pintarAgenda();
    if (vista === "equipo") pintarEquipo();
    if (vista === "clientes") pintarClientes();
    if (vista === "servicios") pintarServicios();
    if (vista === "stats") pintarStats();
  }

  // ── inicio ─────
  type Filtro = "proximas" | "hoy" | "pasadas" | "canceladas";
  let filtro: Filtro = "proximas";
  let filtroBarb = "todos";
  let limite = 40;

  function kpi(icono: string, titulo: string, valor: string, nota: string, color = "#6366f1") {
    const d = el("div", "pa-card pa-kpi");
    d.style.setProperty("--c", color);
    const chip = el("span", "pa-kpi__ico");
    chip.append(ico(icono));
    d.append(chip, el("span", "pa-kpi__t", titulo), el("strong", "", valor), el("small", "", nota));
    return d;
  }

  function filtrar(f: Filtro) {
    const ahora = Date.now();
    const v = visibles();
    if (f === "proximas") return v.filter((c) => c.inicio >= ahora && c.estado !== "cancelada").sort((a, b) => a.inicio - b.inicio);
    if (f === "hoy") return v.filter((c) => sameDay(c.inicio, ahora) && c.estado !== "cancelada").sort((a, b) => a.inicio - b.inicio);
    if (f === "pasadas") return v.filter((c) => c.inicio < ahora && c.estado !== "cancelada").sort((a, b) => b.inicio - a.inicio);
    return v.filter((c) => c.estado === "cancelada").sort((a, b) => b.inicio - a.inicio);
  }

  function pintarInicio() {
    $("[data-pa-titulo]").textContent = saludo();
    const ahora = Date.now();
    const mias = visibles();
    const deHoy = mias.filter((c) => sameDay(c.inicio, ahora) && c.estado !== "cancelada");
    const atendidas = deHoy.filter((c) => c.estado === "llego").length;
    const sig = mias.filter((c) => c.inicio >= ahora && c.estado === "confirmada").sort((a, b) => a.inicio - b.inicio)[0];
    const web = mias.filter((c) => c.origen === "web" && c.creada >= ahora - 7 * DIA);
    const caja = deHoy.filter((c) => c.estado !== "noshow").reduce((s, c) => s + serv(datos, c.servicio).p, 0);
    sub(`${fechaDia(ahora).replace(/^./, (x) => x.toUpperCase())} · ${esAdmin() ? "todo el equipo" : "tu agenda"}`);
    $("[data-pa-kpis]").replaceChildren(
      kpi("calendar-day", "Citas hoy", String(deHoy.length), `${atendidas} atendidas · ${deHoy.length - atendidas} pendientes`, "#6366f1"),
      kpi("clock", "Siguiente cita", sig ? hhmm(sig.inicio) : "—", sig ? `${sig.cliente}${sameDay(sig.inicio, ahora) ? "" : ` · ${etiquetaDia(sig.inicio).toLowerCase()}`}` : "No hay más citas", "#f59e0b"),
      kpi("globe", "Reservas web", String(web.length), "en los últimos 7 días", "#10b981"),
      kpi("euro-sign", "Caja prevista hoy", euro.format(caja), esAdmin() ? "todo el equipo" : "tus servicios", "#ec4899"),
    );

    // filtros con su número
    $$<HTMLButtonElement>("[data-pa-filtros] button").forEach((b) => {
      const f = b.dataset.f as Filtro;
      b.setAttribute("aria-pressed", String(f === filtro));
      $("em", b).textContent = String(filtrar(f).length);
    });
    const sel = $<HTMLSelectElement>("[data-pa-fbarb]");
    sel.replaceChildren(Object.assign(el("option", "", "Todo el equipo"), { value: "todos" }), ...datos.barberos.map((b) => Object.assign(el("option", "", b.n), { value: b.id })));
    sel.value = filtroBarb;

    const q = $<HTMLInputElement>("[data-pa-busca]").value.toLowerCase().trim();
    const lista = filtrar(filtro).filter((c) => (filtroBarb === "todos" || c.barbero === filtroBarb) && (!q || c.cliente.toLowerCase().includes(q) || c.tel.includes(q)));
    const caja2 = $("[data-pa-lista]");
    caja2.replaceChildren();
    if (!lista.length) {
      const v = el("div", "pa-vacio");
      v.append(ico("calendar-xmark"), el("p", "", q ? `Nada con «${q}».` : "No hay citas en esta lista."));
      caja2.append(v);
    }
    let diaActual = -1;
    let grupo: HTMLElement | null = null;
    lista.slice(0, limite).forEach((c) => {
      const d = inicioDia(c.inicio);
      if (d !== diaActual) {
        diaActual = d;
        const n = lista.filter((x) => inicioDia(x.inicio) === d).length;
        const cab = el("div", `pa-grupo__cab${d === inicioDia() ? " is-hoy" : ""}`);
        cab.append(el("strong", "", etiquetaDia(d)), el("span", "", d === inicioDia() || d === masDias(inicioDia(), 1) ? fechaCorta.format(d) : ""), el("em", "", n === 1 ? "1 cita" : `${n} citas`));
        grupo = el("div", "pa-grupo");
        grupo.append(cab);
        caja2.append(grupo);
      }
      grupo!.append(filaCita(c));
    });
    if (lista.length > limite) {
      const mas = boton("pa-mas", `Ver ${Math.min(40, lista.length - limite)} más`);
      mas.addEventListener("click", () => {
        limite += 40;
        pintarInicio();
      });
      caja2.append(mas);
    }

    pintarEquipoAhora();
    pintarWeb();
  }

  function filaCita(c: Cita) {
    const s = serv(datos, c.servicio);
    const b = barb(datos, c.barbero);
    const f = boton(`pa-fila is-${c.estado}${c.inicio <= Date.now() && Date.now() < fin(c) && c.estado !== "cancelada" ? " is-ahora" : ""}`);
    f.style.setProperty("--c", s.c);
    const hora = el("span", "pa-fila__hora");
    hora.append(el("strong", "", hhmm(c.inicio)), el("small", "", `${s.min} min`));
    const txt = el("span", "pa-fila__txt");
    const nom = el("strong", "", c.cliente);
    if (c.origen === "web") {
      const w = el("em", "pa-web-tag");
      w.append(ico("globe"), " Web");
      nom.append(w);
    }
    txt.append(nom, el("small", "", `${s.n}${c.notas ? ` · ${c.notas}` : ""}`));
    const quien = el("span", "pa-fila__quien");
    quien.append(avatar(b, "pa-av--sm"), b.n);
    const est = el("span", `pa-estado is-${c.estado}`);
    est.append(ico(ESTADOS[c.estado][1]), ` ${ESTADOS[c.estado][0]}`);
    f.append(hora, txt, quien, est, el("span", "pa-fila__precio", euro.format(s.p)));
    f.addEventListener("click", () => abrirModal(c));
    return f;
  }

  function pintarEquipoAhora() {
    const ahora = Date.now();
    $("[data-pa-ahora]").replaceChildren(
      ...datos.barberos.map((b) => {
        const est = estadoAhora(b);
        const suyas = datos.citas.filter((c) => c.barbero === b.id && c.estado !== "cancelada");
        const hoy = suyas.filter((c) => sameDay(c.inicio, ahora));
        const enCurso = hoy.find((c) => c.inicio <= ahora && ahora < fin(c));
        const sig = hoy.filter((c) => c.inicio > ahora).sort((a, x) => a.inicio - x.inicio)[0];
        const puede = esAdmin() || b.id === yo;
        const fila = boton(`pa-miembro${puede ? "" : " is-solo"}`);
        fila.style.setProperty("--c", b.c);
        const txt = el("span", "pa-miembro__txt");
        txt.append(el("strong", "", b.n), el("small", "", turnosDe(b, ahora).length ? `Hoy ${turnosTxt(turnosDe(b, ahora))}` : "Hoy libra"));
        const dcha = el("span", "pa-miembro__dcha");
        const pill = el("span", `pa-pill${est.activo ? " is-on" : ""}${enCurso ? " is-ocupado" : ""}`);
        pill.append(el("i"), enCurso ? `Con ${enCurso.cliente.split(" ")[0]}` : est.activo ? "Libre" : est.txt.replace("Ya ha terminado hoy", "Terminó"));
        dcha.append(pill, el("small", "", sig ? `Siguiente ${hhmm(sig.inicio)}` : `${hoy.length} citas hoy`));
        fila.append(avatar(b), txt, dcha);
        if (puede)
          fila.addEventListener("click", () => {
            agendaDe = b.id;
            semana = lunes();
            irVista("agenda");
          });
        else fila.disabled = true;
        return fila;
      }),
    );
  }

  function pintarWeb() {
    const lista = visibles()
      .filter((c) => c.origen === "web")
      .sort((a, b) => b.creada - a.creada)
      .slice(0, 6);
    const caja = $("[data-pa-web]");
    caja.replaceChildren();
    if (!lista.length) caja.append(el("li", "pa-muted", "Aún no hay reservas desde la web."));
    lista.forEach((c) => {
      const s = serv(datos, c.servicio);
      const li = el("li");
      const b = boton("pa-webr");
      b.style.setProperty("--c", s.c);
      const t = el("span");
      t.append(el("strong", "", c.cliente), el("small", "", `${s.n} con ${barb(datos, c.barbero).n} · ${etiquetaDia(c.inicio)} ${hhmm(c.inicio)}`));
      b.append(el("i", "pa-webr__punto"), t, el("em", "", hace(c.creada)));
      b.addEventListener("click", () => abrirModal(c));
      li.append(b);
      caja.append(li);
    });
