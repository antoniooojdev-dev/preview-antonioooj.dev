  // ── agenda de un profesional ─────
  let agendaDe = "";
  let semana = lunes();

  function diasDeAgenda(b: Barbero) {
    // de lunes a sábado; el domingo solo si ese profesional trabaja
    return Array.from({ length: 7 }, (_, i) => masDias(semana, i)).filter((d, i) => i < 6 || turnosDe(b, d).length);
  }

  function pintarAgenda() {
    if (!esAdmin()) agendaDe = yo!;
    const b = barb(datos, agendaDe);
    raiz.style.setProperty("--quien", b.c);
    // pestañas: una por profesional (solo el administrador puede cambiar)
    const tabs = $("[data-pa-tabs]");
    tabs.replaceChildren(
      ...(esAdmin() ? datos.barberos : [b]).map((x) => {
        const t = boton("pa-tab", avatar(x, "pa-av--sm"), x.n);
        t.style.setProperty("--c", x.c);
        t.setAttribute("aria-pressed", String(x.id === b.id));
        t.addEventListener("click", () => {
          agendaDe = x.id;
          pintarAgenda();
        });
        return t;
      }),
    );

    const dias = diasDeAgenda(b);
    const iniSem = semana.getTime();
    const delaSemana = datos.citas.filter((c) => c.barbero === b.id && c.inicio >= iniSem && c.inicio < masDias(iniSem, 7));
    const activas = delaSemana.filter((c) => c.estado !== "cancelada");
    const minTrabajo = minutosDeTrabajo(b, iniSem, 7);
    const minOcupados = activas.filter((c) => c.estado !== "noshow").reduce((s, c) => s + serv(datos, c.servicio).min, 0);
    sub(`${b.n} ${b.apellido} · ${fechaCorta.format(iniSem)} – ${fechaCorta.format(masDias(iniSem, 6))} ${new Date(masDias(iniSem, 6)).getFullYear()}`);
    const res = $("[data-pa-ag-resumen]");
    res.replaceChildren(
      ...[
        ["calendar-check", `${activas.length} citas`],
        ["clock", `${Math.round(minTrabajo / 60)} h de turno`],
        ["gauge-high", `${minTrabajo ? Math.round((minOcupados / minTrabajo) * 100) : 0}% ocupado`],
        ["euro-sign", euro.format(activas.filter((c) => c.estado !== "noshow").reduce((s, c) => s + serv(datos, c.servicio).p, 0))],
      ].map(([i, t]) => {
        const x = el("span");
        x.append(ico(i), t);
        return x;
      }),
    );

    const cab = $("[data-pa-cab]");
    const cols = $("[data-pa-cols]");
    cab.style.setProperty("--n", String(dias.length));
    cols.style.setProperty("--n", String(dias.length));
    cab.replaceChildren(el("span"));
    cols.replaceChildren();
    const hoy = inicioDia();
    const alto = (H_FIN - H_INI) * ALTO_H;

    dias.forEach((d) => {
      const turnos = turnosDe(b, d);
      const suyas = delaSemana.filter((c) => sameDay(c.inicio, d));
      const ocup = suyas.filter((c) => c.estado !== "cancelada" && c.estado !== "noshow").reduce((s, c) => s + serv(datos, c.servicio).min, 0);
      const disp = turnos.reduce((s, [a, z]) => s + (z - a) * 60, 0);
      const c = el("div", `pa-cab-dia${d === hoy ? " is-hoy" : ""}${turnos.length ? "" : " is-libra"}`);
      const f = el("span", "pa-cab-dia__fecha");
      f.append(el("small", "", diaCorto.format(d).replace(".", "")), el("strong", "", String(new Date(d).getDate())));
      const info = el("span", "pa-cab-dia__info");
      info.append(el("small", "", turnos.length ? turnosTxt(turnos) : "Libra"), el("em", "", turnos.length ? `${suyas.filter((x) => x.estado !== "cancelada").length} citas` : ""));
      const barra = el("i", "pa-cab-dia__barra");
      barra.style.setProperty("--p", `${disp ? Math.min(100, (ocup / disp) * 100) : 0}%`);
      c.append(f, info, barra);
      cab.append(c);

      const col = el("div", `pa-col${d === hoy ? " is-hoy" : ""}`);
      col.dataset.dia = String(d);
      col.style.height = `${alto}px`;
      // lo que queda fuera de su turno, rayado
      let prev = H_INI;
      const tramos: [number, number, string][] = [];
      for (const [a, z] of turnos) {
        if (a > prev) tramos.push([prev, a, prev === H_INI ? `Entra a las ${horaTxt(a)}` : "Descanso"]);
        prev = Math.max(prev, z);
      }
      if (!turnos.length) tramos.push([H_INI, H_FIN, `${b.n} libra`]);
      else if (prev < H_FIN) tramos.push([prev, H_FIN, `Sale a las ${horaTxt(prev)}`]);
      tramos.forEach(([a, z, t]) => {
        const x = el("div", "pa-fuera");
        x.style.top = `${(a - H_INI) * ALTO_H}px`;
        x.style.height = `${(z - a) * ALTO_H}px`;
        if ((z - a) * ALTO_H >= 28) x.append(el("span", "", t));
        x.addEventListener("click", () => toast(turnos.length ? `${b.n} no trabaja a esa hora (${turnosTxt(turnos)})` : `${b.n} no trabaja este día`));
        col.append(x);
      });
      suyas.sort((a, x) => Number(a.estado === "cancelada") - Number(x.estado === "cancelada")).forEach((cita) => col.append(bloqueCita(cita)));
      if (d === hoy) {
        const ahora = new Date();
        const h = ahora.getHours() + ahora.getMinutes() / 60;
        if (h >= H_INI && h <= H_FIN) {
          const linea = el("div", "pa-linea-ahora");
          linea.style.top = `${(h - H_INI) * ALTO_H}px`;
          linea.append(el("span", "", hhmm(ahora.getTime())));
          col.append(linea);
        }
      }
      col.addEventListener("click", (e) => {
        if (e.target !== col) return;
        const h = H_INI + Math.floor((e.offsetY / ALTO_H) * 4) / 4;
        const ms = aLas(d, h);
        if (ms < Date.now()) return toast("Esa hora ya ha pasado");
        if (!dentroDeHorario(b, ms, 15)) return toast(`${b.n} no trabaja a esa hora`);
        abrirModal(null, ms, b.id);
      });
      cols.append(col);
    });

    $("[data-pa-horas]").replaceChildren(
      ...Array.from({ length: H_FIN - H_INI }, (_, i) => {
        const s = el("span", "", `${String(H_INI + i).padStart(2, "0")}:00`);
        s.style.height = `${ALTO_H}px`;
        return s;
      }),
    );
    $("[data-pa-leyenda]").replaceChildren(
      ...datos.servicios.map((s) => {
        const x = el("span");
        const p = el("i");
        p.style.background = s.c;
        x.append(p, s.n);
        return x;
      }),
    );
  }

  function bloqueCita(c: Cita) {
    const s = serv(datos, c.servicio);
    const b = boton(`pa-cita is-${c.estado}`);
    const d = new Date(c.inicio);
    const h = d.getHours() + d.getMinutes() / 60;
    b.style.top = `${(h - H_INI) * ALTO_H + 1}px`;
    b.style.height = `${(s.min / 60) * ALTO_H - 3}px`;
    b.style.setProperty("--c", s.c);
    if (s.min < 30) b.classList.add("is-corta");
    b.setAttribute("aria-label", `${c.cliente}, ${hhmm(c.inicio)}, ${s.n}, ${ESTADOS[c.estado][0]}`);
    b.title = `${hhmm(c.inicio)}–${hhmm(fin(c))} · ${c.cliente} · ${s.n} · ${ESTADOS[c.estado][0]}${c.origen === "web" ? " · reservada en la web" : ""}`;
    const top = el("span", "pa-cita__hora", `${hhmm(c.inicio)}–${hhmm(fin(c))}`);
    if (c.origen === "web") top.append(ico("globe"));
    if (c.estado !== "confirmada") top.append(ico(ESTADOS[c.estado][1]));
    b.append(top, el("strong", "", c.cliente), el("span", "pa-cita__serv", s.n));
    if (c.estado === "cancelada") b.addEventListener("click", () => abrirModal(c));
    else arrastrable(b, c);
    return b;
  }

  // arrastrar para mover (a otra hora o a otro día, dentro del turno); un clic sin moverse abre la cita
  function arrastrable(b: HTMLElement, c: Cita) {
    b.addEventListener("click", (e) => e.detail === 0 && abrirModal(c));
    b.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      const y0 = e.clientY;
      const x0 = e.clientX;
      const top0 = parseFloat(b.style.top);
      let movido = false;
      b.setPointerCapture(e.pointerId);
      const mover = (ev: PointerEvent) => {
        const dy = ev.clientY - y0;
        if (!movido && Math.abs(dy) + Math.abs(ev.clientX - x0) < 5) return;
        movido = true;
        b.classList.add("is-arrastrando");
        const paso = ALTO_H / 4;
        b.style.top = `${Math.round((top0 + dy) / paso) * paso}px`;
        b.style.translate = `${ev.clientX - x0}px 0`;
      };
      const soltar = (ev: PointerEvent) => {
        b.removeEventListener("pointermove", mover);
        b.removeEventListener("pointerup", soltar);
        if (!movido) return abrirModal(c);
        b.style.visibility = "hidden";
        const debajo = document.elementFromPoint(ev.clientX, ev.clientY)?.closest<HTMLElement>(".pa-col");
        b.style.visibility = "";
        const dia = debajo ? Number(debajo.dataset.dia) : inicioDia(c.inicio);
        const min = serv(datos, c.servicio).min;
        const h = Math.max(H_INI, Math.min(H_FIN - min / 60, H_INI + parseFloat(b.style.top) / ALTO_H));
        const nueva = aLas(dia, h);
        const quien = barb(datos, c.barbero);
        const otro = choque(datos, c.barbero, nueva, min, c.id);
        if (nueva < Date.now()) toast("No se puede mover al pasado");
        else if (!dentroDeHorario(quien, nueva, min)) toast(`Fuera del turno de ${quien.n}`);
        else if (otro) toast(`${quien.n} ya tiene a ${otro.cliente.split(" ")[0]} a esa hora`);
        else {
          c.inicio = nueva;
          guardar(datos);
          toast(`Cita movida: ${etiquetaDia(nueva).toLowerCase()} a las ${hhmm(nueva)}`);
        }
        pintarAgenda();
      };
      b.addEventListener("pointermove", mover);
      b.addEventListener("pointerup", soltar);
    });
  }

  function bajarAHora() {
    const b = barb(datos, agendaDe);
    const t = turnosDe(b, Date.now());
    const h = Math.max(new Date().getHours() - 1, t[0]?.[0] ?? H_INI);
    $(".pa-cal__scroll").scrollTop = Math.max(0, (h - H_INI) * ALTO_H - 8);
  }

  $$<HTMLButtonElement>("[data-pa-sem]").forEach((b) =>
    b.addEventListener("click", () => {
      semana = new Date(masDias(semana, Number(b.dataset.paSem) * 7));
      pintarAgenda();
    }),
  );
  $("[data-pa-hoy]").addEventListener("click", () => {
    semana = lunes();
    pintarAgenda();
    bajarAHora();
  });

  // ── equipo y horarios ─────
  function pintarEquipo() {
    sub(esAdmin() ? "El horario de cada profesional decide qué horas se pueden reservar en la web." : "Horarios del equipo esta semana.");
    const iniSem = lunes().getTime();
    const hoyN = new Date().getDay();
    $("[data-pa-equipo]").replaceChildren(
      ...datos.barberos.map((b, i) => {
        const card = el("article", "pa-card pa-miembro-card");
        card.style.setProperty("--c", b.c);
        const est = estadoAhora(b);
        const cab = el("header", "pa-mc__cab");
        const nom = el("div");
        nom.append(el("h3", "", `${b.n} ${b.apellido}`), el("small", "", i === 0 ? `${b.rol} · administrador` : b.rol));
        const pill = el("span", `pa-pill${est.activo ? " is-on" : ""}`);
        pill.append(el("i"), est.txt);
        cab.append(avatar(b, "pa-av--xl"), nom, pill);

        // horario semanal en una línea de tiempo de 9:00 a 21:00
        const sem = el("div", "pa-mc__sem");
        ORDEN.forEach((d) => {
          const t = b.horario[d];
          const fila = el("div", `pa-mc__dia${d === hoyN ? " is-hoy" : ""}${t.length ? "" : " is-libra"}`);
          const pista = el("span", "pa-mc__pista");
          t.forEach(([a, z]) => {
            const seg = el("i");
            seg.style.left = `${((a - H_INI) / (H_FIN - H_INI)) * 100}%`;
            seg.style.width = `${((z - a) / (H_FIN - H_INI)) * 100}%`;
            pista.append(seg);
          });
          fila.append(el("strong", "", DIAS[d].slice(0, 3)), pista, el("small", "", turnosTxt(t)));
          sem.append(fila);
        });
        const regla = el("div", "pa-mc__regla");
        regla.append(el("span"), ...[9, 12, 15, 18, 21].map((h) => el("em", "", `${h}h`)), el("span"));

        // la semana actual en números
        const suyas = datos.citas.filter((c) => c.barbero === b.id && c.inicio >= iniSem && c.inicio < masDias(iniSem, 7) && c.estado !== "cancelada" && c.estado !== "noshow");
        const minT = minutosDeTrabajo(b, iniSem, 7);
        const minO = suyas.reduce((s, c) => s + serv(datos, c.servicio).min, 0);
        const nums = el("div", "pa-mc__nums");
        [
          ["Citas", String(suyas.length)],
          ["Horas", `${Math.round(minT / 60)} h`],
          ["Ocupación", `${minT ? Math.round((minO / minT) * 100) : 0}%`],
          ["Ingresos", euro.format(suyas.reduce((s, c) => s + serv(datos, c.servicio).p, 0))],
        ].forEach(([k, v]) => {
          const x = el("div");
          x.append(el("small", "", k), el("strong", "", v));
          nums.append(x);
        });

        const prox = el("div", "pa-mc__prox");
        prox.append(el("h4", "", "Próximas citas"));
        const proximas = datos.citas.filter((c) => c.barbero === b.id && c.inicio >= Date.now() && c.estado === "confirmada").sort((a, x) => a.inicio - x.inicio);
        if (!proximas.length) prox.append(el("p", "pa-muted", "Ninguna."));
        proximas.slice(0, 3).forEach((c) => {
          const x = boton("pa-mini-cita");
          x.style.setProperty("--c", serv(datos, c.servicio).c);
          const dia = etiquetaDia(c.inicio);
          x.append(el("strong", "", `${["Hoy", "Mañana"].includes(dia) ? dia : `${diaCorto.format(c.inicio).replace(".", "")} ${fechaCorta.format(c.inicio)}`} · ${hhmm(c.inicio)}`), el("span", "", `${c.cliente} · ${serv(datos, c.servicio).n}`));
          x.addEventListener("click", () => abrirModal(c));
          if (!esAdmin() && b.id !== yo) x.disabled = true;
          prox.append(x);
        });

        const acc = el("footer", "pa-mc__acc");
        if (esAdmin() || b.id === yo) {
          const ver = boton("pa-btn pa-btn--suave", ico("calendar-week"), " Ver su agenda");
          ver.addEventListener("click", () => {
            agendaDe = b.id;
            semana = lunes();
            irVista("agenda");
          });
          acc.append(ver);
        }
        if (esAdmin()) {
          const ed = boton("pa-btn", ico("pen"), " Editar horario");
          ed.addEventListener("click", () => abrirHorario(b));
          acc.append(ed);
        }
        card.append(cab, sem, regla, nums, prox, acc);
        return card;
      }),
    );
  }

  // ── modal de horario ─────
  const hmodal = $<HTMLDialogElement>("[data-pa-hmodal]");
  const hform = $<HTMLFormElement>("[data-pa-hform]");
  let horarioDe: Barbero | null = null;

  function abrirHorario(b: Barbero) {
    horarioDe = b;
    $("[data-pa-hmodal-t]").textContent = `Horario de ${b.n}`;
    $("[data-pa-herror]").textContent = "";
    $("[data-pa-hdias]").replaceChildren(
      ...ORDEN.map((d) => {
        const t = b.horario[d];
        const fila = el("div", `pa-hdia${t.length ? "" : " is-off"}`);
        fila.dataset.d = String(d);
        const chk = Object.assign(el("input"), { type: "checkbox", checked: t.length > 0 });
        const lab = el("label", "pa-hdia__n");
        lab.append(chk, DIAS[d]);
        const campos = el("div", "pa-hdia__turnos");
        const hora = (v: number | undefined, n: string) => Object.assign(el("input"), { type: "time", step: "900", min: horaTxt(H_INI), max: horaTxt(H_FIN), value: v === undefined ? "" : horaTxt(v), name: n });
        const t1 = el("span", "pa-hdia__t");
        t1.append(hora(t[0]?.[0] ?? 9, "a1"), "–", hora(t[0]?.[1] ?? 14, "z1"));
        const t2 = el("span", "pa-hdia__t");
        t2.append(hora(t[1]?.[0], "a2"), "–", hora(t[1]?.[1], "z2"));
        campos.append(t1, el("small", "", "y"), t2);
        chk.addEventListener("change", () => fila.classList.toggle("is-off", !chk.checked));
        fila.append(lab, campos);
        return fila;
      }),
    );
    hmodal.showModal();
  }

  const aHoras = (v: string) => {
    if (!v) return NaN;
    const [h, m] = v.split(":").map(Number);
    return h + m / 60;
  };

  hform.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!horarioDe) return;
    const err = $("[data-pa-herror]");
    const nuevo: Turnos[] = [[], [], [], [], [], [], []];
    for (const fila of $$("[data-pa-hdias] .pa-hdia")) {
      const d = Number(fila.dataset.d);
      if (!$<HTMLInputElement>("input[type=checkbox]", fila).checked) continue;
      const v = (n: string) => aHoras($<HTMLInputElement>(`input[name=${n}]`, fila).value);
      const [a1, z1, a2, z2] = [v("a1"), v("z1"), v("a2"), v("z2")];
      if (!(a1 < z1)) return (err.textContent = `${DIAS[d]}: el turno debe empezar antes de acabar.`);
      if (a1 < H_INI || z1 > H_FIN) return (err.textContent = `${DIAS[d]}: el local abre de ${horaTxt(H_INI)} a ${horaTxt(H_FIN)}.`);
      nuevo[d].push([a1, z1]);
      if (!Number.isNaN(a2) || !Number.isNaN(z2)) {
        if (!(a2 < z2) || a2 < z1 || z2 > H_FIN) return (err.textContent = `${DIAS[d]}: el segundo turno debe ir después del primero y acabar antes de las ${horaTxt(H_FIN)}.`);
        nuevo[d].push([a2, z2]);
      }
    }
    horarioDe.horario = nuevo;
    guardar(datos);
    hmodal.close();
    // citas ya dadas que se quedan fuera del nuevo horario
    const fuera = datos.citas.filter((c) => c.barbero === horarioDe!.id && c.inicio >= Date.now() && c.estado === "confirmada" && !dentroDeHorario(horarioDe!, c.inicio, serv(datos, c.servicio).min));
    toast(fuera.length ? `Horario guardado. Ojo: ${fuera.length} ${fuera.length === 1 ? "cita queda" : "citas quedan"} fuera del turno` : `Horario de ${horarioDe.n} guardado`);
    pintar();
  });
  $("[data-pa-hcerrar]").addEventListener("click", () => hmodal.close());
  $("[data-pa-hcancelar]").addEventListener("click", () => hmodal.close());
  hmodal.addEventListener("click", (e) => e.target === hmodal && hmodal.close());

  // ── modal de cita ─────
  const modal = $<HTMLDialogElement>("[data-pa-modal]");
  const form = $<HTMLFormElement>("[data-pa-form]");
  let editando: Cita | null = null;
  let estado: Estado = "confirmada";
  const campo = <T extends HTMLElement>(n: string) => form.elements.namedItem(n) as unknown as T;
  const fechaInput = (ms: number) => {
    const d = new Date(ms);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  };
  const diaDelInput = () => {
    const [y, m, d] = campo<HTMLInputElement>("fecha").value.split("-").map(Number);
    return y ? new Date(y, m - 1, d).getTime() : NaN;
  };

  function abrirModal(c: Cita | null, inicio?: number, barbero?: string) {
    if (c && !esAdmin() && c.barbero !== yo) return;
    editando = c;
    $("[data-pa-modal-t]").textContent = c ? c.cliente : "Nueva cita";
    $("[data-pa-modal-sub]").textContent = c ? `${c.origen === "web" ? "Reservada en la web" : "Creada en el panel"} ${hace(c.creada)}` : "Solo se ofrecen las horas libres dentro del turno.";
    campo<HTMLSelectElement>("servicio").replaceChildren(...datos.servicios.map((s) => Object.assign(el("option", "", `${s.n} · ${s.min} min · ${s.p} €`), { value: s.id })));
    const quienes = esAdmin() ? datos.barberos : [yoB()];
    campo<HTMLSelectElement>("barbero").replaceChildren(...quienes.map((b) => Object.assign(el("option", "", b.n), { value: b.id })));
    campo<HTMLSelectElement>("barbero").disabled = !esAdmin();
    $("[data-pa-datalist]").replaceChildren(...datos.clientes.map((x) => Object.assign(el("option"), { value: x.n })));
    const ms = c?.inicio ?? inicio ?? Date.now();
    campo<HTMLInputElement>("cliente").value = c?.cliente ?? "";
    campo<HTMLInputElement>("tel").value = c?.tel ?? "";
    campo<HTMLSelectElement>("servicio").value = c?.servicio ?? datos.servicios[0].id;
    campo<HTMLSelectElement>("barbero").value = c?.barbero ?? barbero ?? (esAdmin() && vista === "agenda" ? agendaDe : yo!);
    campo<HTMLInputElement>("fecha").value = fechaInput(ms);
    campo<HTMLTextAreaElement>("notas").value = c?.notas ?? "";
    estado = c?.estado ?? "confirmada";
    pintarEstado();
    // una cita nueva salta al primer día (en dos semanas) en que ese profesional tiene huecos
    if (!c) {
      let dia = inicioDia(ms);
      for (let i = 0; i < 14 && !huecos(datos, campo<HTMLSelectElement>("barbero").value, dia, campo<HTMLSelectElement>("servicio").value).length; i++) dia = masDias(dia, 1);
      campo<HTMLInputElement>("fecha").value = fechaInput(dia);
    }
    pintarHoras(ms);
    $("[data-pa-borrar]").hidden = !c || !esAdmin();
    $("[data-pa-error]").textContent = "";
    modal.showModal();
    if (!c) campo<HTMLInputElement>("cliente").focus();
  }

  /** Rellena el desplegable de horas con los huecos libres del profesional ese día */
  function pintarHoras(preferida?: number) {
    const sel = campo<HTMLSelectElement>("hora");
    const quiero = preferida ?? Number(sel.value);
    const dia = diaDelInput();
    const b = barb(datos, campo<HTMLSelectElement>("barbero").value);
    const sId = campo<HTMLSelectElement>("servicio").value;
    const turnos = Number.isNaN(dia) ? [] : turnosDe(b, dia);
    $("[data-pa-turno]").textContent = Number.isNaN(dia) ? "" : turnos.length ? `${b.n} trabaja ese día: ${turnosTxt(turnos)}` : `${b.n} libra ese día`;
    $("[data-pa-turno]").classList.toggle("is-libra", !turnos.length);
    let lista = Number.isNaN(dia) ? [] : huecos(datos, b.id, dia, sId, editando?.id);
    // al editar, la hora que ya tenía la cita siempre se puede mantener
    if (editando && sameDay(editando.inicio, dia) && !lista.includes(editando.inicio)) lista = [...lista, editando.inicio].sort((a, x) => a - x);
    if (!lista.length) {
      sel.replaceChildren(Object.assign(el("option", "", "Sin horas libres"), { value: "" }));
      return;
    }
    sel.replaceChildren(...lista.map((ms) => Object.assign(el("option", "", hhmm(ms)), { value: String(ms) })));
    // mantiene la misma hora del día si existe; si no, la más cercana
    const objetivo = Number.isNaN(quiero) ? lista[0] : aLas(dia, new Date(quiero).getHours() + new Date(quiero).getMinutes() / 60);
    const cerca = lista.reduce((m, x) => (Math.abs(x - objetivo) < Math.abs(m - objetivo) ? x : m), lista[0]);
    sel.value = String(cerca);
  }
  ["servicio", "barbero", "fecha"].forEach((n) => campo<HTMLElement>(n).addEventListener("change", () => pintarHoras()));
  campo<HTMLInputElement>("cliente").addEventListener("change", () => {
    const cli = datos.clientes.find((x) => x.n.toLowerCase() === campo<HTMLInputElement>("cliente").value.trim().toLowerCase());
    if (cli && !campo<HTMLInputElement>("tel").value) campo<HTMLInputElement>("tel").value = cli.tel;
  });

  function pintarEstado() {
    $$<HTMLButtonElement>("[data-pa-estados] button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.e === estado)));
  }
  $$<HTMLButtonElement>("[data-pa-estados] button").forEach((b) =>
    b.addEventListener("click", () => {
      estado = b.dataset.e as Estado;
      pintarEstado();
    }),
  );
  $("[data-pa-cerrar]").addEventListener("click", () => modal.close());
  $("[data-pa-cancelar]").addEventListener("click", () => modal.close());
  modal.addEventListener("click", (e) => e.target === modal && modal.close());
  $("[data-pa-nueva]").addEventListener("click", () => abrirModal(null, Date.now(), vista === "agenda" ? agendaDe : undefined));

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const err = $("[data-pa-error]");
    const nombre = campo<HTMLInputElement>("cliente").value.trim().replace(/\s+/g, " ");
    const tel = normalTel(campo<HTMLInputElement>("tel").value);
    if (nombre.length < 2) return (err.textContent = "Escribe el nombre del cliente.");
    if (tel && tel.length !== 9) return (err.textContent = "El teléfono debe tener 9 cifras.");
    const inicio = Number(campo<HTMLSelectElement>("hora").value);
    const b = barb(datos, campo<HTMLSelectElement>("barbero").value);
    const s = serv(datos, campo<HTMLSelectElement>("servicio").value);
    if (!inicio) return (err.textContent = `${b.n} no tiene horas libres ese día para ${s.n.toLowerCase()}.`);
    const igual = editando && editando.inicio === inicio && editando.barbero === b.id && editando.servicio === s.id;
    if (!igual && estado !== "cancelada") {
      if (!dentroDeHorario(b, inicio, s.min)) return (err.textContent = `Fuera del turno de ${b.n}.`);
      const otro = choque(datos, b.id, inicio, s.min, editando?.id);
      if (otro) return (err.textContent = `${b.n} ya tiene cita con ${otro.cliente} a las ${hhmm(otro.inicio)}.`);
    }
    const cli = datos.clientes.find((c) => c.n.toLowerCase() === nombre.toLowerCase() || (tel && normalTel(c.tel) === tel));
    if (!cli) datos.clientes.push({ n: nombre, tel });
    else if (tel && !cli.tel) cli.tel = tel;
    const nueva = !editando;
    const cita: Cita = {
      id: editando?.id ?? nuevoId(),
      cliente: nombre,
      tel: tel || cli?.tel || "",
      servicio: s.id,
      barbero: b.id,
      inicio,
      estado,
      notas: campo<HTMLTextAreaElement>("notas").value.trim(),
      origen: editando?.origen ?? "panel",
      creada: editando?.creada ?? Date.now(),
    };
    if (editando) Object.assign(editando, cita);
    else datos.citas.push(cita);
    guardar(datos);
    modal.close();
    if (vista === "agenda") {
      agendaDe = b.id;
      semana = lunes(inicio);
    }
    pintar();
    toast(nueva ? `Cita creada para ${nombre.split(" ")[0]} · ${etiquetaDia(inicio).toLowerCase()} ${hhmm(inicio)}` : "Cita actualizada");
  });

  $("[data-pa-borrar]").addEventListener("click", () => {
    const btn = $("[data-pa-borrar]");
    if (!editando) return;
    // borrar en dos pasos (sin ventanas del navegador)
    if (!btn.classList.contains("is-seguro")) {
      btn.classList.add("is-seguro");
      btn.lastChild!.textContent = " ¿Seguro?";
      setTimeout(() => {
        btn.classList.remove("is-seguro");
        btn.lastChild!.textContent = " Borrar";
      }, 3000);
      return;
    }
    datos.citas = datos.citas.filter((x) => x.id !== editando!.id);
    guardar(datos);
    modal.close();
    pintar();
    toast("Cita borrada");
  });
  modal.addEventListener("close", () => {
    const btn = $("[data-pa-borrar]");
    btn.classList.remove("is-seguro");
    btn.lastChild!.textContent = " Borrar";
  });

  // ── clientes ─────
  let cliSel = "";
  function resumenCliente(n: string) {
    const suyas = visibles().filter((c) => c.cliente === n);
    const pasadas = suyas.filter((c) => c.inicio < Date.now() && c.estado === "llego");
    const favoritos = pasadas.reduce<Record<string, number>>((a, c) => ((a[c.servicio] = (a[c.servicio] ?? 0) + 1), a), {});
    return {
      todas: suyas,
      visitas: pasadas.length,
      gastado: pasadas.reduce((s, c) => s + serv(datos, c.servicio).p, 0),
      proximas: suyas.filter((c) => c.inicio >= Date.now() && c.estado === "confirmada").sort((a, b) => a.inicio - b.inicio),
      noshow: suyas.filter((c) => c.estado === "noshow").length,
      favorito: Object.entries(favoritos).sort((a, b) => b[1] - a[1])[0]?.[0],
    };
  }
  function pintarClientes() {
    const q = $<HTMLInputElement>("[data-pa-buscar-cli]").value.toLowerCase().trim();
    // cada barbero ve solo a los clientes que ha atendido o tiene citados
    const conmigo = new Set(visibles().map((c) => c.cliente));
    const lista = datos.clientes.filter((c) => (esAdmin() || conmigo.has(c.n)) && (!q || c.n.toLowerCase().includes(q) || c.tel.includes(q))).sort((a, b) => a.n.localeCompare(b.n));
    sub(`${lista.length} ${lista.length === 1 ? "cliente" : "clientes"}${q ? ` con «${q}»` : ""}`);
    $("[data-pa-cli]").replaceChildren(
      ...lista.map((c) => {
        const r = resumenCliente(c.n);
        const tr = el("tr", c.n === cliSel ? "is-sel" : "");
        const nom = el("td");
        const quien = el("span", "pa-cli");
        quien.append(el("span", "pa-av pa-av--gris", iniciales(c.n)), c.n);
        nom.append(quien);
        const prox = r.proximas[0];
        tr.append(nom, el("td", "", c.tel || "—"), el("td", "", String(r.visitas)), el("td", "", euro.format(r.gastado)), el("td", "", prox ? `${fechaCorta.format(prox.inicio)} · ${hhmm(prox.inicio)}` : "—"));
        tr.addEventListener("click", () => {
          cliSel = c.n;
          pintarClientes();
        });
        return tr;
      }),
    );
    pintarFicha();
  }
  function pintarFicha() {
    const caja = $("[data-pa-ficha]");
    if (!cliSel) return;
    const c = datos.clientes.find((x) => x.n === cliSel);
    if (!c) return;
    const r = resumenCliente(cliSel);
    caja.replaceChildren();
    const cab = el("div", "pa-ficha__cab");
    const txt = el("div");
    const tel = el("p", "pa-muted");
    tel.append(ico("phone"), ` ${c.tel || "Sin teléfono"}`);
    txt.append(el("h3", "", c.n), tel);
    cab.append(el("span", "pa-av pa-av--xl pa-av--gris", iniciales(c.n)), txt);
    const kp = el("div", "pa-ficha__kpis");
    [
      ["Visitas", String(r.visitas)],
      ["Gastado", euro.format(r.gastado)],
      ["No vino", String(r.noshow)],
    ].forEach(([k, v]) => {
      const d = el("div");
      d.append(el("small", "", k), el("strong", "", v));
      kp.append(d);
    });
    caja.append(cab, kp);
    if (r.favorito) caja.append(el("p", "pa-ficha__fav", `Suele pedir: ${serv(datos, r.favorito).n}`));
    caja.append(el("h4", "", "Próximas citas"));
    if (!r.proximas.length) caja.append(el("p", "pa-muted", "Ninguna."));
    r.proximas.slice(0, 4).forEach((x) => {
      const b = boton("pa-mini-cita");
      b.style.setProperty("--c", serv(datos, x.servicio).c);
      b.append(el("strong", "", `${fechaCorta.format(x.inicio)} · ${hhmm(x.inicio)}`), el("span", "", `${serv(datos, x.servicio).n} con ${barb(datos, x.barbero).n}`));
      b.addEventListener("click", () => abrirModal(x));
      caja.append(b);
    });
    caja.append(el("h4", "", "Historial"));
    const hist = r.todas.filter((x) => x.inicio < Date.now()).sort((a, b) => b.inicio - a.inicio);
    if (!hist.length) caja.append(el("p", "pa-muted", "Sin visitas todavía."));
    const ul = el("ul", "pa-hist");
    ul.setAttribute("role", "list");
    hist.slice(0, 5).forEach((x) => {
      const li = el("li", `is-${x.estado}`);
      li.append(el("span", "", fechaCorta.format(x.inicio)), el("span", "", serv(datos, x.servicio).n), el("em", "", ESTADOS[x.estado][0]));
      ul.append(li);
    });
    caja.append(ul);
    const nueva = boton("pa-btn pa-btn--full", ico("plus"), " Darle cita");
    nueva.addEventListener("click", () => {
      abrirModal(null, masDias(Date.now(), 1) + 10 * 3_600_000);
      campo<HTMLInputElement>("cliente").value = c.n;
      campo<HTMLInputElement>("tel").value = c.tel;
    });
    caja.append(nueva);
  }
  $("[data-pa-buscar-cli]").addEventListener("input", pintarClientes);

  // ── servicios ─────
  function pintarServicios() {
    sub("Cambia precios y duraciones: se aplican a la web, a las citas nuevas y a las estadísticas.");
    const iniSem = lunes().getTime();
    $("[data-pa-servicios]").replaceChildren(
      ...datos.servicios.map((s) => {
        const li = el("li", "pa-card pa-serv");
        li.style.setProperty("--c", s.c);
        const min = Object.assign(el("input"), { type: "number", min: "10", max: "120", step: "5", value: String(s.min) });
        const p = Object.assign(el("input"), { type: "number", min: "1", max: "200", step: "1", value: String(s.p) });
        const campoServ = (txt: string, input: HTMLInputElement, unidad: string) => {
          const l = el("label", "pa-serv__campo");
          const caja = el("span", "pa-serv__input");
          caja.append(input, el("em", "", unidad));
          l.append(el("span", "", txt), caja);
          return l;
        };
        const n = datos.citas.filter((c) => c.servicio === s.id && c.inicio >= iniSem && c.inicio < masDias(iniSem, 7) && c.estado !== "cancelada").length;
        const cab = el("div", "pa-serv__cab");
        const i = el("span", "pa-serv__ico");
        i.append(ico(s.ico));
        const t = el("div");
        t.append(el("strong", "", s.n), el("small", "", s.d));
        cab.append(i, t);
        const campos = el("div", "pa-serv__campos");
        campos.append(campoServ("Duración", min, "min"), campoServ("Precio", p, "€"));
        li.append(cab, campos, el("span", "pa-serv__uso", n === 1 ? "1 cita esta semana" : `${n} citas esta semana`));
        const cambiar = () => {
          s.min = Math.max(10, Number(min.value) || s.min);
          s.p = Math.max(1, Number(p.value) || s.p);
          guardar(datos);
          toast(`${s.n}: ${s.min} min · ${s.p} €`);
        };
        min.addEventListener("change", cambiar);
        p.addEventListener("change", cambiar);
        return li;
      }),
    );
  }

  // ── estadísticas ─────
  function pintarStats() {
    const ini = lunes().getTime();
    sub(`Semana del ${fechaCorta.format(ini)} al ${fechaCorta.format(masDias(ini, 6))}`);
    const sem = datos.citas.filter((c) => c.inicio >= ini && c.inicio < masDias(ini, 7) && c.estado !== "cancelada");
    const validas = sem.filter((c) => c.estado !== "noshow");
    const ingresos = validas.reduce((s, c) => s + serv(datos, c.servicio).p, 0);
    const minutos = validas.reduce((s, c) => s + serv(datos, c.servicio).min, 0);
    const capacidad = datos.barberos.reduce((s, b) => s + minutosDeTrabajo(b, ini, 7), 0);
    const noshow = sem.length - validas.length;
    const web = sem.filter((c) => c.origen === "web").length;
    $("[data-pa-skpis]").replaceChildren(
      kpi("euro-sign", "Ingresos", euro.format(ingresos), "esta semana", "#10b981"),
      kpi("calendar-check", "Citas", String(sem.length), `${validas.length} atendidas o previstas`, "#6366f1"),
      kpi("gauge-high", "Ocupación", `${capacidad ? Math.round((minutos / capacidad) * 100) : 0}%`, "de las horas de turno", "#f59e0b"),
      kpi("globe", "Desde la web", `${sem.length ? Math.round((web / sem.length) * 100) : 0}%`, `${web} reservas online`, "#0ea5e9"),
      kpi("user-xmark", "No vinieron", String(noshow), `${sem.length ? Math.round((noshow / sem.length) * 100) : 0}% de las citas`, "#f43f5e"),
    );
    $("[data-pa-rango]").textContent = `${fechaCorta.format(ini)} – ${fechaCorta.format(masDias(ini, 6))}`;
    const porDia = Array.from({ length: 7 }, (_, d) => validas.filter((c) => sameDay(c.inicio, masDias(ini, d))).reduce((s, c) => s + serv(datos, c.servicio).p, 0));
    const max = Math.max(...porDia, 1);
    $("[data-pa-barras]").replaceChildren(
      ...porDia.map((v, d) => {
        const col = el("div", `pa-barra${sameDay(masDias(ini, d), Date.now()) ? " is-hoy" : ""}`);
        const b = el("i");
        b.style.height = `${(v / max) * 100}%`;
        b.style.animationDelay = `${d * 0.05}s`;
        col.append(el("span", "", v ? euro.format(v) : ""), b, el("small", "", diaCorto.format(masDias(ini, d)).replace(".", "")));
        return col;
      }),
    );
    $("[data-pa-ocup]").replaceChildren(
      ...datos.barberos.map((b) => {
        const suyas = validas.filter((c) => c.barbero === b.id);
        const minT = minutosDeTrabajo(b, ini, 7);
        const p = minT ? Math.round((suyas.reduce((s, c) => s + serv(datos, c.servicio).min, 0) / minT) * 100) : 0;
        const fila = el("div", "pa-ocup__fila");
        fila.style.setProperty("--c", b.c);
        const txt = el("div", "pa-ocup__txt");
        txt.append(el("strong", "", b.n), el("small", "", `${suyas.length} citas · ${euro.format(suyas.reduce((s, c) => s + serv(datos, c.servicio).p, 0))} · ${Math.round(minT / 60)} h de turno`));
        const barra = el("div", "pa-ocup__barra");
        const i = el("i");
        i.style.width = `${p}%`;
        barra.append(i);
        fila.append(avatar(b), txt, el("strong", "pa-ocup__p", `${p}%`), barra);
        return fila;
      }),
    );
    const porServ = datos.servicios.map((s) => ({ s, n: validas.filter((c) => c.servicio === s.id).length })).sort((a, b) => b.n - a.n);
    const maxS = Math.max(...porServ.map((x) => x.n), 1);
    $("[data-pa-hbarras]").replaceChildren(
      ...porServ.map(({ s, n }) => {
        const f = el("div", "pa-hbarra");
        f.style.setProperty("--c", s.c);
        const pista = el("span", "pa-hbarra__pista");
        const i = el("i");
        i.style.width = `${(n / maxS) * 100}%`;
        pista.append(i);
        f.append(el("span", "pa-hbarra__n", s.n), pista, el("strong", "", `${n} · ${euro.format(n * s.p)}`));
        return f;
      }),
    );
  }

  // ── restablecer ─────
  $("[data-pa-reset]").addEventListener("click", () => {
    datos = restablecer();
    semana = lunes();
    pintar();
    toast("Datos de ejemplo restablecidos");
  });

  // ── arranque y avisos de la web ─────
  alCambiar((d) => {
    const antes = new Set(datos.citas.map((c) => c.id));
    datos = d;
    const nuevas = datos.citas.filter((c) => !antes.has(c.id) && c.origen === "web" && (esAdmin() || c.barbero === yo));
    if (nuevas.length) toast(`Nueva reserva web: ${nuevas[0].cliente.split(" ")[0]} · ${etiquetaDia(nuevas[0].inicio).toLowerCase()} ${hhmm(nuevas[0].inicio)}`);
    pintar();
  });
  setInterval(() => (vista === "agenda" || vista === "inicio") && !modal.open && pintar(), 60_000);
  arrancar();
</script>

