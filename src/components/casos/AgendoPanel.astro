  $$<HTMLButtonElement>("[data-pa-filtros] button").forEach((b) =>
    b.addEventListener("click", () => {
      filtro = b.dataset.f as Filtro;
      limite = 40;
      pintarInicio();
    }),
  );
  $("[data-pa-busca]").addEventListener("input", () => {
    limite = 40;
    pintarInicio();
  });
  $<HTMLSelectElement>("[data-pa-fbarb]").addEventListener("change", (e) => {
    filtroBarb = (e.target as HTMLSelectElement).value;
    pintarInicio();
