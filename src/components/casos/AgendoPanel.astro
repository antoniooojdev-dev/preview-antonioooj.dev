    grid-template-columns: 3.6rem minmax(0, 1fr) 7.5rem 7.5rem 3rem;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    padding: 0.7rem 1.2rem;
    border: 0;
    border-bottom: 1px solid var(--linea);
    background:
      linear-gradient(var(--c), var(--c)) left / 3px 100% no-repeat,
      var(--panel);
    text-align: left;
    transition: background-color 0.15s;
  }

  .pa-fila:hover {
    background-color: #fafaff;
  }

  .pa-fila.is-ahora {
    background-color: color-mix(in srgb, var(--acento) 6%, #fff);
  }

  .pa-fila.is-cancelada,
  .pa-fila.is-noshow {
    opacity: 0.6;
  }

  .pa-fila__hora {
    display: grid;
  }

  .pa-fila__hora strong {
    font-variant-numeric: tabular-nums;
  }

  .pa-fila__hora small,
  .pa-fila__txt small {
    color: var(--gris-2);
    font-size: 0.74rem;
  }

  .pa-fila__txt {
    display: grid;
    min-width: 0;
  }

  .pa-fila__txt strong,
  .pa-fila__txt small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pa-web-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.45rem;
    padding: 0.05rem 0.4rem;
    border-radius: 6px;
    background: #ecfdf5;
    color: #059669;
    font-size: 0.66rem;
    font-style: normal;
    font-weight: 700;
    vertical-align: 1px;
  }

  .pa-fila__quien {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--gris);
    font-size: 0.82rem;
  }

  .pa-estado {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: fit-content;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .pa-estado.is-confirmada {
    background: #eef2ff;
    color: #4f46e5;
  }

  .pa-estado.is-llego {
    background: #ecfdf5;
    color: #059669;
  }

  .pa-estado.is-noshow {
    background: #fff7ed;
    color: #c2410c;
  }

  .pa-estado.is-cancelada {
    background: #fef2f2;
    color: #dc2626;
  }

  .pa-fila__precio {
    color: var(--gris);
    font-weight: 600;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .pa-mas {
    width: 100%;
    padding: 0.9rem;
    border: 0;
    background: none;
    color: var(--acento);
    font-weight: 600;
  }

  .pa-ahora,
  .pa-web {
    display: grid;
    gap: 0.8rem;
    padding: 1.1rem 1.1rem 0.8rem;
  }

  .pa-web h2 i {
    margin-right: 0.3rem;
    color: #10b981;
  }

  [data-pa-ahora] {
    display: grid;
    gap: 0.3rem;
  }

  .pa-miembro {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem;
    border: 0;
    border-radius: 12px;
    background: none;
    text-align: left;
    transition: background 0.15s;
  }

  .pa-miembro:not(:disabled):hover {
    background: var(--suave);
  }

  .pa-miembro:disabled {
    cursor: default;
  }

  .pa-miembro__txt,
  .pa-miembro__dcha {
    display: grid;
  }

  .pa-miembro__txt {
    flex: 1;
    min-width: 0;
  }

  .pa-miembro__txt small,
  .pa-miembro__dcha small {
    color: var(--gris-2);
    font-size: 0.72rem;
  }

  .pa-miembro__dcha {
    justify-items: end;
    gap: 0.2rem;
  }

  [data-pa-web] {
    display: grid;
    gap: 0.2rem;
  }

  .pa-webr {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    padding: 0.55rem 0.5rem;
    border: 0;
    border-radius: 10px;
    background: none;
    text-align: left;
  }

  .pa-webr:hover {
    background: var(--suave);
  }

  .pa-webr__punto {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 20%, transparent);
  }

  .pa-webr span {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .pa-webr strong {
    font-size: 0.85rem;
  }

  .pa-webr small {
    color: var(--gris);
    font-size: 0.74rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pa-webr em {
    color: var(--gris-2);
    font-size: 0.7rem;
    font-style: normal;
    white-space: nowrap;
  }

  .pa-vacio {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    padding: 3rem 1.5rem;
    color: var(--gris);
    text-align: center;
  }

  .pa-vacio i {
    color: #d1d5db;
    font-size: 2rem;
  }

  /* ── agenda ── */
  .pa-agenda-cab {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .pa-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 4px;
    border: 1px solid var(--linea);
    border-radius: 14px;
    background: var(--panel);
  }

  .pa-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem 0.4rem 0.45rem;
    border: 0;
    border-radius: 10px;
    background: none;
    color: var(--gris);
    font-weight: 600;
    transition: all 0.2s;
  }

  .pa-tab:hover {
    background: var(--suave);
  }

  .pa-tab[aria-pressed="true"] {
    background: color-mix(in srgb, var(--c) 12%, #fff);
    color: var(--tinta);
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--c) 45%, transparent);
  }

  .pa-agenda-resumen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pa-agenda-resumen span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--linea);
    border-radius: 999px;
    background: var(--panel);
    color: var(--gris);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .pa-agenda-resumen i {
    color: var(--quien, var(--acento));
  }

  .pa-cal {
    overflow: hidden;
  }

  .pa-cal__scroll {
    max-height: calc(100dvh - 15rem);
    min-height: 26rem;
    overflow: auto;
  }

  .pa-cal__cab,
  .pa-cal__cuerpo {
    min-width: 46rem;
  }

  .pa-cal__cab {
    position: sticky;
    top: 0;
    z-index: 3;
    display: grid;
    grid-template-columns: 3.6rem repeat(var(--n, 6), minmax(0, 1fr));
    border-bottom: 1px solid var(--linea);
    background: var(--panel);
  }

  .pa-cab-dia {
    position: relative;
    display: grid;
    gap: 0.3rem;
    padding: 0.7rem 0.75rem 0.8rem;
    border-left: 1px solid var(--linea);
  }

  .pa-cab-dia__fecha {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .pa-cab-dia__fecha small {
    color: var(--gris);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .pa-cab-dia__fecha strong {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .pa-cab-dia.is-hoy .pa-cab-dia__fecha strong {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--quien, var(--acento));
    color: #fff;
    font-size: 1rem;
  }

  .pa-cab-dia__info {
    display: flex;
    justify-content: space-between;
    gap: 0.3rem;
    font-size: 0.68rem;
  }

  .pa-cab-dia__info small {
    color: var(--gris);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pa-cab-dia__info em {
    color: var(--gris-2);
    font-style: normal;
    white-space: nowrap;
  }

  .pa-cab-dia.is-libra .pa-cab-dia__info small {
    color: #dc2626;
    font-weight: 600;
  }

  .pa-cab-dia__barra {
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(var(--quien, var(--acento)), var(--quien, var(--acento))) left / var(--p) 100% no-repeat, var(--suave);
  }

  .pa-cal__cuerpo {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
  }

  .pa-cal__horas span {
    display: block;
    padding-right: 0.5rem;
    color: var(--gris-2);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
    translate: 0 -0.45rem;
  }

  .pa-cal__horas span:first-child {
    visibility: hidden;
  }

  .pa-cal__cols {
    display: grid;
    grid-template-columns: repeat(var(--n, 6), minmax(0, 1fr));
  }

  .pa-col {
    position: relative;
    border-left: 1px solid var(--linea);
    background:
      repeating-linear-gradient(to bottom, var(--linea) 0 1px, transparent 1px calc(var(--h) / 2)),
      transparent;
    background-size: 100% var(--h);
    cursor: copy;
  }

  .pa-col.is-hoy {
    background-color: color-mix(in srgb, var(--quien, var(--acento)) 3%, transparent);
  }

  .pa-fuera {
    position: absolute;
    inset-inline: 0;
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(-45deg, rgb(17 24 39 / 0.035) 0 6px, rgb(17 24 39 / 0.07) 6px 12px);
    cursor: not-allowed;
  }

  .pa-fuera span {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.85);
    color: var(--gris-2);
    font-size: 0.68rem;
    font-weight: 600;
    pointer-events: none;
  }

  .pa-cita {
    position: absolute;
    left: 4px;
    right: 4px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    padding: 0.32rem 0.5rem;
    border: 0;
    border-radius: 9px;
    background: color-mix(in srgb, var(--c) 13%, #fff);
    box-shadow: inset 3px 0 0 var(--c);
    color: color-mix(in srgb, var(--c) 55%, #111827);
    font-size: 0.74rem;
    line-height: 1.25;
    text-align: left;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    transition:
      box-shadow 0.15s,
      transform 0.15s;
  }

  .pa-cita:hover {
    z-index: 2;
    box-shadow:
      inset 3px 0 0 var(--c),
      0 8px 20px -8px color-mix(in srgb, var(--c) 60%, transparent);
    transform: scale(1.015);
  }

  .pa-cita strong {
    color: var(--tinta);
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pa-cita__hora {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.66rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .pa-cita__hora i {
    font-size: 0.62rem;
  }

  .pa-cita__hora i:first-of-type {
    margin-left: auto;
  }

  .pa-cita__serv {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pa-cita.is-corta {
    flex-direction: row;
    align-items: center;
    gap: 0.4rem;
    padding-block: 0;
  }

  .pa-cita.is-corta .pa-cita__serv {
    display: none;
  }

  .pa-cita.is-corta .pa-cita__hora i {
    display: none;
  }

  .pa-cita.is-llego {
    background: color-mix(in srgb, var(--c) 7%, #fff);
    opacity: 0.8;
  }

  .pa-cita.is-noshow {
    background: repeating-linear-gradient(-45deg, #fff7ed 0 5px, #ffedd5 5px 10px);
    box-shadow: inset 3px 0 0 #f97316;
    color: #9a3412;
  }

  .pa-cita.is-cancelada {
    z-index: 0;
    border: 1.5px dashed #fca5a5;
    background: rgb(255 255 255 / 0.7);
    box-shadow: none;
    color: #dc2626;
    opacity: 0.7;
    cursor: pointer;
  }

  .pa-cita.is-cancelada strong {
    color: #dc2626;
    text-decoration: line-through;
  }

  .pa-cita.is-arrastrando {
    z-index: 5;
    box-shadow: 0 18px 40px -10px rgb(17 24 39 / 0.45);
    opacity: 0.92;
    cursor: grabbing;
  }

  .pa-linea-ahora {
    position: absolute;
    inset-inline: 0;
    z-index: 4;
    height: 2px;
    background: #ef4444;
    pointer-events: none;
  }

  .pa-linea-ahora::before {
    content: "";
    position: absolute;
    left: -5px;
    top: -4px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ef4444;
  }

  .pa-linea-ahora span {
    position: absolute;
    right: 4px;
    top: -1.2rem;
    padding: 0 0.3rem;
    border-radius: 4px;
    background: #ef4444;
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
  }

  .pa-cal__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    color: var(--gris);
    font-size: 0.78rem;
  }

  .pa-leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .pa-leyenda span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pa-leyenda i {
    width: 9px;
    height: 9px;
    border-radius: 3px;
  }

  /* ── equipo ── */
  .pa-equipo {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
    gap: 1.2rem;
  }

  .pa-miembro-card {
    position: relative;
    display: grid;
    gap: 1.1rem;
    padding: 1.3rem;
    overflow: hidden;
  }

  .pa-miembro-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 5.5rem;
    background: linear-gradient(120deg, color-mix(in srgb, var(--c) 16%, #fff), transparent);
    pointer-events: none;
  }

  .pa-mc__cab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .pa-mc__cab > div {
    flex: 1;
  }

  .pa-mc__cab h3 {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .pa-mc__cab small {
    color: var(--gris);
  }

  .pa-mc__sem {
    display: grid;
    gap: 0.35rem;
  }

  .pa-mc__dia {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) 8.5rem;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
  }

  .pa-mc__dia strong {
    color: var(--gris);
    font-weight: 600;
  }

  .pa-mc__dia small {
    color: var(--gris);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .pa-mc__dia.is-hoy strong {
    color: var(--c);
    font-weight: 800;
  }

  .pa-mc__dia.is-libra small {
    color: var(--gris-2);
  }

  .pa-mc__pista {
    position: relative;
    height: 0.7rem;
    border-radius: 999px;
    background: var(--suave);
  }

  .pa-mc__pista i {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--c) 75%, #fff), var(--c));
  }

  .pa-mc__dia.is-hoy .pa-mc__pista {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 25%, transparent);
  }

  .pa-mc__regla {
    display: grid;
    grid-template-columns: 3rem repeat(4, 1fr) 0 9.1rem;
    margin-top: -0.6rem;
    color: var(--gris-2);
    font-size: 0.62rem;
  }

  .pa-mc__regla em {
    font-style: normal;
    translate: -40% 0;
  }

  .pa-mc__nums {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
  }

  .pa-mc__nums div,
  .pa-ficha__kpis div {
    display: grid;
    padding: 0.6rem 0.7rem;
    border-radius: 11px;
    background: var(--suave);
  }

  .pa-mc__nums small,
  .pa-ficha__kpis small {
    color: var(--gris);
    font-size: 0.68rem;
  }

  .pa-mc__nums strong,
  .pa-ficha__kpis strong {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .pa-mc__prox {
    display: grid;
    gap: 0.35rem;
  }

  .pa-mc__prox h4,
  .pa-ficha h4 {
    color: var(--gris);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pa-mini-cita {
    display: grid;
    gap: 0.05rem;
    padding: 0.5rem 0.7rem;
    border: 0;
    border-radius: 10px;
    background:
      linear-gradient(var(--c), var(--c)) left / 3px 100% no-repeat,
      var(--suave);
    text-align: left;
  }

  .pa-mini-cita:not(:disabled):hover {
    background-color: #eceef4;
  }

  .pa-mini-cita:disabled {
    cursor: default;
  }

  .pa-mini-cita strong {
    font-size: 0.8rem;
  }

  .pa-mini-cita strong::first-letter {
    text-transform: uppercase;
  }

  .pa-mini-cita span {
    color: var(--gris);
    font-size: 0.75rem;
  }

  .pa-mc__acc {
    display: flex;
    gap: 0.5rem;
  }

  .pa-mc__acc .pa-btn {
    flex: 1;
  }

  /* modal de horario */
  .pa-hdias {
    grid-template-columns: 1fr !important;
    gap: 0.4rem !important;
  }

  .pa-hdia {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--linea);
    border-radius: 12px;
    transition: opacity 0.2s;
  }

  .pa-hdia.is-off .pa-hdia__turnos {
    opacity: 0.35;
    pointer-events: none;
  }

  .pa-hdia__n {
    display: flex !important;
    flex-direction: row !important;
    align-items: center;
    gap: 0.55rem !important;
    min-width: 7rem;
    color: var(--tinta) !important;
    font-size: 0.88rem !important;
  }

  .pa-hdia__n input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--acento);
  }

  .pa-hdia__turnos {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gris-2);
  }

  .pa-hdia__t {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .pa-hdia__t input {
    width: 6.2rem;
    padding: 0.35rem 0.45rem !important;
  }

  /* ── clientes ── */
  .pa-clientes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 21rem;
    align-items: start;
    gap: 1.2rem;
  }

  .pa-card--tabla {
    overflow: auto;
  }

  .pa-tabla {
    width: 100%;
    border-collapse: collapse;
    white-space: nowrap;
  }

  .pa-tabla th {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--linea);
    background: #fafbfc;
    color: var(--gris);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: left;
    text-transform: uppercase;
  }

  .pa-tabla td {
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--linea);
    color: var(--gris);
  }

  .pa-tabla tbody tr {
    cursor: pointer;
    transition: background 0.1s;
  }

  .pa-tabla tbody tr:hover {
    background: #fafaff;
  }

  .pa-tabla tr.is-sel {
    background: #eef2ff;
  }

  .pa-cli {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--tinta);
    font-weight: 600;
  }

  .pa-cli .pa-av {
    width: 1.9rem;
    height: 1.9rem;
    font-size: 0.62rem;
  }

  .pa-ficha {
    position: sticky;
    top: 0;
    display: grid;
    gap: 0.8rem;
    padding: 1.2rem;
  }

  .pa-ficha__cab {
    display: flex;
    align-items: center;
