    background:
      repeating-linear-gradient(-45deg, rgb(0 0 0 / 0.07) 0 10px, transparent 10px 20px),
      linear-gradient(160deg, #bef264, var(--c) 45%, #4d7c0f);
    color: var(--fondo);
    transform: rotate(-8deg) skewX(-4deg);
    box-shadow:
      0 0 0 6px rgb(132 204 22 / 0.12),
      0 40px 80px -30px rgb(132 204 22 / 0.7);
    animation: fj-flota 6s ease-in-out infinite;
  }

  .fj-placa i {
    font-size: 4.5rem;
    transform: rotate(-20deg);
  }

  .fj-placa span {
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.9rem;
    line-height: 0.9;
    text-align: center;
  }

  .fj-flota {
    position: absolute;
    display: grid;
    gap: 0.1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--linea);
    border-radius: 14px;
    background: rgb(21 26 18 / 0.92);
    backdrop-filter: blur(10px);
    box-shadow: 0 24px 40px -20px rgb(0 0 0 / 0.8);
    animation: fj-flota 5s ease-in-out infinite;
  }

  .fj-flota--clase {
    left: -4%;
    bottom: 14%;
    min-width: 12rem;
    border-left: 3px solid var(--c);
  }

  .fj-flota--clase small {
    color: var(--c);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .fj-flota--clase strong {
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1;
  }

  .fj-flota--clase span {
    color: var(--gris);
    font-size: 0.78rem;
  }

  .fj-flota--socios {
    top: 8%;
    right: -2%;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--gris);
    animation-delay: -2.5s;
  }

  .fj-flota--socios strong {
    color: var(--txt);
  }

  .fj-flota__caras {
    display: flex;
  }

  .fj-flota__caras i {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    margin-left: -0.4rem;
    border: 2px solid var(--panel);
    border-radius: 50%;
    background: var(--t);
    color: var(--fondo);
    font-size: 0.7rem;
    font-style: normal;
    font-weight: 800;
  }

  .fj-flota__caras i:first-child {
    margin-left: 0;
  }

  /* cinta en movimiento */
  .fj-cinta {
    position: relative;
    z-index: 2;
    padding-block: 0.9rem;
    background: var(--c);
    color: var(--fondo);
    overflow: hidden;
    transform: rotate(-1.5deg) scale(1.03);
    box-shadow: 0 20px 40px -20px rgb(132 204 22 / 0.6);
  }

  .fj-cinta > div {
    display: flex;
    width: max-content;
    animation: fj-cinta 30s linear infinite;
  }

  .fj-cinta span {
    display: inline-flex;
    align-items: center;
    gap: 1.6rem;
    padding-right: 1.6rem;
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .fj-cinta i {
    font-size: 1rem;
  }

  .fj-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.2rem;
  }

  .fj-hero__datos {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, auto) 1fr;
    gap: 2.5rem;
    margin-top: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--linea);
  }

  .fj-hero__datos strong {
    display: block;
    font-family: "Bebas Neue", sans-serif;
    font-size: 3rem;
    font-weight: 400;
    line-height: 1;
  }

  .fj-hero__datos span {
    color: var(--gris);
    font-size: 0.85rem;
  }

  .fj-aforo {
    justify-self: end;
    min-width: 14rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--linea);
    border-radius: 12px;
    background: var(--panel);
  }

  .fj-aforo__t {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .fj-aforo__t i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ef4444;
    animation: fj-parpadeo 1.2s infinite;
  }

  .fj-aforo__barra {
    display: block;
    height: 6px;
    margin-top: 0.5rem;
    border-radius: 99px;
    background: var(--linea);
    overflow: hidden;
  }

  .fj-aforo__barra i {
    display: block;
    height: 100%;
    border-radius: inherit;
    transition: width 1s;
  }

  /* secciones */
  .fj-sec {
    padding-block: 5.5rem;
  }

  .fj-sec > .fj-wrap {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fj-sec.is-visto > .fj-wrap {
    opacity: 1;
    transform: none;
  }

  .fj-sec h2 {
    font-size: clamp(2.8rem, 1.8rem + 3.5vw, 4.6rem);
    text-transform: uppercase;
  }

  .fj-sec__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.2rem;
    margin-bottom: 2.4rem;
  }

  .fj-sec__head--centro {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .fj-filtros,
  .fj-toggle,
  .fj-tabs,
  .fj-seg {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0.3rem;
    border: 1px solid var(--linea);
    border-radius: 10px;
    background: var(--panel);
  }

  .fj-filtros button,
  .fj-toggle button,
  .fj-tabs button,
  .fj-seg button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--gris);
    font-weight: 700;
    font-size: 0.85rem;
    transition: all 0.2s;
  }

  .fj-filtros button i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--t);
  }

  :is(.fj-filtros, .fj-toggle, .fj-seg) button[aria-pressed="true"],
  .fj-tabs button[aria-selected="true"] {
    background: var(--txt);
    color: var(--fondo);
  }

  .fj-toggle em {
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
    background: var(--c);
    color: var(--fondo);
    font-style: normal;
    font-size: 0.7rem;
  }

  /* horario */
  .fj-horario {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .fj-dia {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 0.6rem;
    border: 1px solid var(--linea);
    border-radius: 14px;
    background: linear-gradient(180deg, var(--panel), color-mix(in srgb, var(--panel) 60%, var(--fondo)));
  }

  .fj-dia.is-hoy {
    border-color: var(--c);
    background:
      linear-gradient(180deg, rgb(132 204 22 / 0.12), transparent 40%),
      var(--panel);
    box-shadow: 0 20px 40px -26px var(--c);
  }

  .fj-dia__t {
    padding: 0.2rem 0.3rem 0.4rem;
    border-bottom: 1px solid var(--linea);
    color: var(--gris);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .fj-dia.is-hoy .fj-dia__t::after {
    content: " · hoy";
    color: var(--c);
  }

  .fj-clase {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.65rem;
    border: 0;
    border-left: 3px solid var(--t);
    border-radius: 8px;
    background: var(--panel2);
    text-align: left;
    transition: transform 0.2s, opacity 0.3s, background 0.2s;
  }

  .fj-clase:hover {
    transform: translateY(-2px) scale(1.02);
    background: color-mix(in srgb, var(--t) 15%, var(--panel2));
    box-shadow: 0 12px 22px -14px var(--t);
  }

  .fj-clase.is-fuera {
    opacity: 0.15;
    pointer-events: none;
  }

  .fj-clase__h {
    color: var(--t);
    font-weight: 800;
    font-size: 0.78rem;
  }

  .fj-clase strong {
    font-size: 0.88rem;
    line-height: 1.2;
  }

  .fj-clase__m {
    color: var(--gris);
    font-size: 0.72rem;
  }

  .fj-clase__ok {
    display: none;
    margin-top: 0.2rem;
    color: var(--t);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .fj-clase.is-reservada {
    background: color-mix(in srgb, var(--t) 22%, var(--panel2));
  }

  .fj-clase.is-reservada .fj-clase__ok {
    display: block;
  }

  .fj-nota {
    margin-top: 1rem;
    color: var(--gris);
    font-size: 0.85rem;
  }

  .fj-modal {
    width: min(28rem, 92vw);
    padding: 2rem;
    border: 1px solid var(--linea);
    border-top: 4px solid var(--t);
    border-radius: 18px;
    background:
      radial-gradient(80% 60% at 100% 0%, color-mix(in srgb, var(--t) 22%, transparent), transparent 65%),
      var(--panel);
    color: var(--txt);
    box-shadow: 0 50px 100px -30px rgb(0 0 0 / 0.9);
  }

  .fj-modal[open] {
    display: grid;
    gap: 1rem;
    animation: fj-pop 0.35s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .fj-modal[open].is-cierra {
    animation: fj-cierra 0.26s cubic-bezier(0.5, 0, 0.75, 0) forwards;
    pointer-events: none;
  }

  .fj-modal::backdrop {
    background: rgb(0 0 0 / 0.75);
    backdrop-filter: blur(6px);
  }

  .fj-modal[open]::backdrop {
    animation: fj-fondo-entra 0.3s ease-out;
  }

  .fj-modal.is-cierra::backdrop {
    animation: fj-fondo-sale 0.26s ease-in forwards;
  }

  .fj-modal__x {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border: 0;
    border-radius: 50%;
    background: var(--panel2);
    transition:
      transform 0.25s,
      background 0.25s,
      color 0.25s;
  }

  .fj-modal__x:hover {
    background: var(--t);
    color: var(--fondo);
    transform: rotate(90deg);
  }

  .fj-modal__tipo {
    color: var(--t);
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .fj-modal h3 {
    font-size: 2.6rem;
  }

  .fj-modal__datos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .fj-modal__datos div {
    padding: 0.7rem;
    border-radius: 10px;
    background: var(--panel2);
  }

  .fj-modal__datos dt {
    color: var(--gris);
    font-size: 0.75rem;
  }

  .fj-modal__datos dd {
    font-weight: 700;
  }

  .fj-plazas {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.4rem;
  }

  .fj-plazas__barra {
    grid-column: 1 / -1;
    height: 8px;
    border-radius: 99px;
    background: var(--linea);
    overflow: hidden;
  }

  .fj-plazas__barra i {
    display: block;
    height: 100%;
    background: var(--t);
    transition: width 0.5s;
  }

  /* tarifas */
  .fj-tarifas-sec {
    background: var(--panel);
  }

  .fj-planes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .fj-plan {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.8rem;
    padding: 2rem;
    border: 1px solid var(--linea);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.02), transparent 40%),
      var(--fondo);
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s,
      box-shadow 0.35s;
  }

  .fj-plan:hover {
    transform: translateY(-6px);
    border-color: #3d4a35;
    box-shadow: 0 30px 50px -34px rgb(0 0 0 / 0.9);
  }

  .fj-plan.is-dest {
    border: 2px solid var(--c);
    background:
      radial-gradient(90% 50% at 50% 0%, rgb(132 204 22 / 0.18), transparent 70%),
      var(--fondo);
    box-shadow: 0 30px 60px -30px var(--c);
  }

  .fj-plan.is-dest:hover {
    box-shadow: 0 40px 70px -30px var(--c);
  }

  .fj-plan__dest {
    position: absolute;
    top: -0.8rem;
    left: 50%;
    padding: 0.25rem 0.8rem;
    border-radius: 4px;
    background: var(--c);
    color: var(--fondo);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    translate: -50% 0;
  }

  .fj-plan h3 {
    font-size: 2.6rem;
  }

  .fj-plan > p {
    color: var(--gris);
  }

  .fj-plan__precio {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .fj-plan__precio strong {
    font-family: "Bebas Neue", sans-serif;
    font-size: 4.2rem;
    font-weight: 400;
    line-height: 1;
  }

  .fj-plan__precio span {
    color: var(--gris);
  }

  .fj-plan__anual {
    min-height: 1.2em;
    color: var(--c);
    font-weight: 600;
  }

  .fj-plan ul {
    display: grid;
    gap: 0.55rem;
    margin-block: 0.8rem;
  }

  .fj-plan li i {
    width: 1.2rem;
    color: var(--c);
  }

  .fj-plan li.is-no {
    color: #55604f;
    text-decoration: line-through;
  }

  .fj-plan li.is-no i {
    color: #55604f;
  }

  /* calculadora */
  .fj-calc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .fj-tabs {
    width: fit-content;
    margin-block: 1.4rem;
  }

  .fj-campos {
    display: grid;
    gap: 1.1rem;
  }

  .fj-campos label {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    font-weight: 700;
  }

  .fj-campos label[hidden],
  .fj-seg[hidden] {
    display: none;
  }

  .fj-campos output {
    color: var(--c);
  }

  /* deslizadores con pista rellena (el relleno se dibuja con --p desde el script) */
  .fj-campos input[type="range"] {
    grid-column: 1 / -1;
    height: 8px;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--c) var(--p, 50%), var(--linea) var(--p, 50%));
    appearance: none;
    cursor: pointer;
  }

  .fj-campos input[type="range"]::-webkit-slider-thumb {
    width: 22px;
    height: 22px;
    border: 4px solid var(--fondo);
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 2px var(--c), 0 6px 14px -4px var(--c);
    appearance: none;
    transition: transform 0.2s;
  }

  .fj-campos input[type="range"]:active::-webkit-slider-thumb {
    transform: scale(1.2);
  }

  .fj-campos input[type="range"]::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 4px solid var(--fondo);
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 2px var(--c);
  }

  .fj-campos select {
    grid-column: 1 / -1;
    padding: 0.7rem;
    border: 1px solid var(--linea);
    border-radius: 8px;
    background: var(--panel);
  }

  .fj-seg {
    width: fit-content;
  }

  .fj-resultado {
    display: grid;
    justify-items: center;
    padding: 2.5rem;
    border: 1px solid var(--linea);
    border-radius: 24px;
    background:
      radial-gradient(70% 60% at 50% 30%, rgb(132 204 22 / 0.12), transparent 70%),
      var(--panel);
    text-align: center;
    box-shadow: 0 40px 70px -45px rgb(132 204 22 / 0.5);
  }

  .fj-campos select {
    color: var(--txt);
  }

  .fj-gauge {
    width: 100%;
    max-width: 18rem;
  }

  .fj-gauge path {
    fill: none;
    stroke-width: 16;
    stroke-linecap: round;
  }

  .fj-gauge__fondo {
    stroke: var(--linea);
  }

  .fj-gauge__valor {
    stroke: var(--c);
    stroke-dasharray: 0 100;
    transition: stroke-dasharray 0.6s cubic-bezier(0.16, 1, 0.3, 1), stroke 0.3s;
  }

  .fj-resultado__n {
    margin-top: -2.8rem;
    font-family: "Bebas Neue", sans-serif;
    font-size: 4.5rem;
    font-weight: 400;
    line-height: 1;
  }

  .fj-resultado__u {
    color: var(--gris);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .fj-resultado__t {
    max-width: 22rem;
    margin-top: 1rem;
    color: var(--gris);
  }

  .fj-macros {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    width: 100%;
    margin-top: 1.4rem;
  }

  .fj-macros[hidden] {
    display: none;
  }

  .fj-macros div {
    padding: 0.7rem;
    border-radius: 10px;
    background: var(--panel2);
  }

  .fj-macros span {
    display: block;
    color: var(--gris);
    font-size: 0.72rem;
  }

  /* coaches */
  .fj-coaches {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .fj-coach {
    position: relative;
    height: 21rem;
    perspective: 900px;
    outline: none;
  }

  /* inicial gigante de fondo en la cara delantera */
  .fj-coach__cara--frente::before {
    content: attr(data-ini);
    position: absolute;
    left: 1rem;
    top: 0.5rem;
    color: color-mix(in srgb, var(--t) 14%, transparent);
    font-family: "Bebas Neue", sans-serif;
    font-size: 11rem;
    line-height: 1;
  }

  .fj-coach__cara--frente::after {
    content: "Pasa el ratón ↻";
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    color: var(--gris);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .fj-coach__cara--frente > * {
    position: relative;
  }

  .fj-coach__cara {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: end;
    gap: 0.3rem;
    padding: 1.5rem;
    border-radius: 16px;
    backface-visibility: hidden;
    transition: transform 0.7s cubic-bezier(0.3, 1.2, 0.4, 1);
  }

  .fj-coach__cara--frente {
    background:
      radial-gradient(circle at 70% 30%, color-mix(in srgb, var(--t) 45%, transparent), transparent 60%),
      var(--panel);
    border: 1px solid var(--linea);
  }

  .fj-coach__cara--frente i {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    font-size: 3.5rem;
    color: var(--t);
    opacity: 0.9;
  }

  .fj-coach__cara strong {
    font-family: "Bebas Neue", sans-serif;
    font-size: 2rem;
    font-weight: 400;
  }

  .fj-coach__cara--frente span {
    color: var(--t);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .fj-coach__cara--dorso {
    align-content: center;
    background: var(--t);
    color: var(--fondo);
    transform: rotateY(180deg);
  }

  .fj-coach__cara--dorso ul {
    display: grid;
    gap: 0.5rem;
    font-weight: 700;
  }

  .fj-coach:hover .fj-coach__cara--frente,
  .fj-coach:focus-visible .fj-coach__cara--frente {
    transform: rotateY(-180deg);
  }

  .fj-coach:hover .fj-coach__cara--dorso,
  .fj-coach:focus-visible .fj-coach__cara--dorso {
    transform: rotateY(0);
  }

  /* prueba */
  .fj-prueba-sec {
    background:
      linear-gradient(120deg, color-mix(in srgb, var(--c) 18%, transparent), transparent 60%),
      var(--panel);
  }

  .fj-prueba {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .fj-prueba p {
    margin-top: 1rem;
