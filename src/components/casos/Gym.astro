---
// Caso «Forja Training Club» (gimnasio, marca ficticia): aforo en vivo, horario semanal de
// clases filtrable con reserva de plaza (se guarda en el navegador), tarifas mensual/anual,
// calculadoras de IMC y calorías, entrenadores y pase de prueba con código QR.

const tipos = [
  { id: "fuerza", t: "Fuerza", c: "#84cc16" },
  { id: "cardio", t: "Cardio", c: "#f97316" },
  { id: "combate", t: "Combate", c: "#ef4444" },
  { id: "mente", t: "Cuerpo y mente", c: "#38bdf8" },
];

const clases = [
  { id: "c1", n: "Cross Training", tipo: "fuerza", d: 0, h: "07:00", min: 50, coach: "Dani", nivel: "Todos", plazas: 16 },
  { id: "c2", n: "Spinning", tipo: "cardio", d: 0, h: "09:30", min: 45, coach: "Sara", nivel: "Todos", plazas: 22 },
  { id: "c3", n: "Yoga Flow", tipo: "mente", d: 0, h: "19:00", min: 60, coach: "Iris", nivel: "Inicio", plazas: 18 },
  { id: "c4", n: "Boxeo", tipo: "combate", d: 0, h: "20:15", min: 60, coach: "Rubén", nivel: "Medio", plazas: 14 },
  { id: "c5", n: "Halterofilia", tipo: "fuerza", d: 1, h: "07:00", min: 60, coach: "Dani", nivel: "Avanzado", plazas: 10 },
  { id: "c6", n: "HIIT", tipo: "cardio", d: 1, h: "13:30", min: 30, coach: "Sara", nivel: "Medio", plazas: 20 },
  { id: "c7", n: "Pilates", tipo: "mente", d: 1, h: "18:00", min: 50, coach: "Iris", nivel: "Todos", plazas: 14 },
  { id: "c8", n: "Kickboxing", tipo: "combate", d: 1, h: "20:00", min: 60, coach: "Rubén", nivel: "Todos", plazas: 16 },
  { id: "c9", n: "Cross Training", tipo: "fuerza", d: 2, h: "07:00", min: 50, coach: "Dani", nivel: "Todos", plazas: 16 },
  { id: "c10", n: "Spinning", tipo: "cardio", d: 2, h: "19:00", min: 45, coach: "Sara", nivel: "Todos", plazas: 22 },
  { id: "c11", n: "Movilidad", tipo: "mente", d: 2, h: "13:30", min: 40, coach: "Iris", nivel: "Inicio", plazas: 15 },
  { id: "c12", n: "Glúteo y pierna", tipo: "fuerza", d: 3, h: "09:30", min: 45, coach: "Marta", nivel: "Todos", plazas: 18 },
  { id: "c13", n: "HIIT", tipo: "cardio", d: 3, h: "18:00", min: 30, coach: "Sara", nivel: "Medio", plazas: 20 },
  { id: "c14", n: "Boxeo", tipo: "combate", d: 3, h: "20:15", min: 60, coach: "Rubén", nivel: "Medio", plazas: 14 },
  { id: "c15", n: "Cross Training", tipo: "fuerza", d: 4, h: "07:00", min: 50, coach: "Dani", nivel: "Todos", plazas: 16 },
  { id: "c16", n: "Yoga Flow", tipo: "mente", d: 4, h: "19:00", min: 60, coach: "Iris", nivel: "Todos", plazas: 18 },
  { id: "c17", n: "Spinning", tipo: "cardio", d: 4, h: "13:30", min: 45, coach: "Sara", nivel: "Todos", plazas: 22 },
  { id: "c18", n: "Open Box", tipo: "fuerza", d: 5, h: "10:00", min: 90, coach: "Marta", nivel: "Todos", plazas: 25 },
  { id: "c19", n: "Kickboxing", tipo: "combate", d: 5, h: "11:30", min: 60, coach: "Rubén", nivel: "Todos", plazas: 16 },
  { id: "c20", n: "Yoga Restaurativo", tipo: "mente", d: 6, h: "10:30", min: 60, coach: "Iris", nivel: "Inicio", plazas: 18 },
];

const planes = [
  { id: "basico", n: "Básico", m: 29, desc: "Sala de musculación y cardio", inc: [true, false, false, false, false], dest: false },
  { id: "total", n: "Total", m: 45, desc: "Sala + todas las clases dirigidas", inc: [true, true, true, false, false], dest: true },
  { id: "elite", n: "Élite", m: 79, desc: "Todo + entrenador personal", inc: [true, true, true, true, true], dest: false },
];
const ventajas = ["Sala de fuerza y cardio", "Clases dirigidas ilimitadas", "App con tus rutinas", "2 sesiones PT al mes", "Nutricionista"];

const coaches = [
  { n: "Dani Roca", r: "Fuerza y halterofilia", ico: "dumbbell", esp: ["Halterofilia olímpica", "Cross Training", "Ex-competidor nacional"], c: "#84cc16" },
  { n: "Sara León", r: "Cardio y HIIT", ico: "heart-pulse", esp: ["Spinning certificada", "HIIT", "Maratoniana"], c: "#f97316" },
  { n: "Rubén Díaz", r: "Deportes de combate", ico: "hand-fist", esp: ["Boxeo", "Kickboxing", "Defensa personal"], c: "#ef4444" },
  { n: "Iris Moll", r: "Yoga y movilidad", ico: "spa", esp: ["Yoga Vinyasa", "Pilates", "Respiración"], c: "#38bdf8" },
];
---

<div class="fj" data-fj>
  <header class="fj-head" data-fj-head>
    <div class="fj-wrap fj-head__in">
      <a href="#inicio" class="fj-logo"><span>F</span>FORJA<small>TRAINING CLUB</small></a>
      <nav class="fj-nav">
        <a href="#clases">Clases</a>
        <a href="#tarifas">Tarifas</a>
        <a href="#calculadora">Calculadora</a>
        <a href="#equipo">Equipo</a>
      </nav>
      <a href="#prueba" class="fj-btn">Prueba gratis</a>
    </div>
  </header>

  <main>
    <!-- portada -->
    <section class="fj-hero" id="inicio">
      <div class="fj-hero__fondo" aria-hidden="true">
        {Array.from({ length: 12 }, (_, i) => <span style={`--i:${i}`} />)}
      </div>
      <div class="fj-wrap fj-hero__in">
        <div class="fj-hero__txt">
          <span class="fj-etq"><i class="fa-solid fa-bolt"></i> Abierto 6:00 – 23:00 · 365 días</span>
          <h1>Forja tu <span>mejor</span> versión</h1>
          <p>1.200 m² de entrenamiento, 60 clases a la semana y coaches que te conocen por tu nombre. Sin permanencia.</p>
          <div class="fj-hero__ctas">
            <a href="#prueba" class="fj-btn fj-btn--xl">Primera clase gratis <i class="fa-solid fa-arrow-right"></i></a>
            <a href="#clases" class="fj-btn fj-btn--linea fj-btn--xl">Ver horario</a>
          </div>
        </div>

        <!-- visual de la portada: placa inclinada con anillos y tarjetas flotantes -->
        <div class="fj-hero__visual" aria-hidden="true">
          <span class="fj-anillo fj-anillo--1"></span>
          <span class="fj-anillo fj-anillo--2"></span>
          <div class="fj-placa">
            <i class="fa-solid fa-dumbbell"></i>
            <span>NO PAIN<br />NO FORJA</span>
          </div>
          <div class="fj-flota fj-flota--clase">
            <small>Próxima clase</small>
            <strong data-fj-prox>–</strong>
            <span data-fj-prox-t></span>
          </div>
          <div class="fj-flota fj-flota--socios">
            <span class="fj-flota__caras"><i style="--t:#84cc16">D</i><i style="--t:#f97316">S</i><i style="--t:#ef4444">R</i></span>
            <span><strong>4,9 ★</strong> 900 reseñas</span>
          </div>
        </div>

        <div class="fj-hero__datos">
          <div><strong data-contar="1840">0</strong><span>socios</span></div>
          <div><strong data-contar="60">0</strong><span>clases / semana</span></div>
          <div><strong data-contar="1200">0</strong><span>m² de sala</span></div>
          <div class="fj-aforo">
            <span class="fj-aforo__t"><i></i> Aforo ahora</span>
            <strong data-fj-aforo>–</strong>
            <span class="fj-aforo__barra"><i data-fj-aforo-barra></i></span>
          </div>
        </div>
      </div>
    </section>

    <!-- cinta en movimiento -->
    <div class="fj-cinta" aria-hidden="true">
      <div>
        {
          [0, 1].map(() => (
            <span>
              Sin matrícula <i class="fa-solid fa-bolt" /> Sin permanencia <i class="fa-solid fa-bolt" /> 60 clases a la semana <i class="fa-solid fa-bolt" /> Abierto 365 días <i class="fa-solid fa-bolt" /> Coaches certificados <i class="fa-solid fa-bolt" /> Primera clase gratis <i class="fa-solid fa-bolt" />
            </span>
          ))
        }
      </div>
    </div>

    <!-- clases -->
    <section class="fj-sec" id="clases">
      <div class="fj-wrap">
        <div class="fj-sec__head">
          <div>
            <span class="fj-etq fj-etq--n" data-n="01">Horario semanal</span>
            <h2>Elige tu clase</h2>
          </div>
          <div class="fj-filtros" data-fj-tipos>
            <button type="button" data-tipo="todas" aria-pressed="true">Todas</button>
            {
              tipos.map((t) => (
                <button type="button" data-tipo={t.id} aria-pressed="false" style={`--t:${t.c}`}>
                  <i /> {t.t}
                </button>
              ))
            }
          </div>
        </div>
        <div class="fj-horario" data-fj-horario>
          {
            ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"].map((dia, d) => (
              <div class="fj-dia" data-d={d}>
                <span class="fj-dia__t">{dia}</span>
                {clases
                  .filter((c) => c.d === d)
                  .sort((a, b) => a.h.localeCompare(b.h))
                  .map((c) => {
                    const t = tipos.find((x) => x.id === c.tipo)!;
                    return (
                      <button type="button" class="fj-clase" data-clase={c.id} data-tipo={c.tipo} style={`--t:${t.c}`}>
                        <span class="fj-clase__h">{c.h}</span>
                        <strong>{c.n}</strong>
                        <span class="fj-clase__m">
                          {c.min} min · {c.coach}
                        </span>
                        <span class="fj-clase__ok">
                          <i class="fa-solid fa-check" /> Reservada
                        </span>
                      </button>
                    );
                  })}
              </div>
            ))
          }
        </div>
        <p class="fj-nota"><i class="fa-solid fa-circle-info"></i> Pulsa una clase para ver los detalles y reservar plaza. Tus reservas se guardan en este navegador.</p>
      </div>
      <dialog class="fj-modal" data-fj-modal>
        <button type="button" class="fj-modal__x" data-fj-modal-x aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
        <span class="fj-modal__tipo" data-m="tipo"></span>
        <h3 data-m="n"></h3>
        <dl class="fj-modal__datos">
          <div><dt><i class="fa-solid fa-clock"></i> Hora</dt><dd data-m="h"></dd></div>
          <div><dt><i class="fa-solid fa-hourglass-half"></i> Duración</dt><dd data-m="min"></dd></div>
          <div><dt><i class="fa-solid fa-user"></i> Coach</dt><dd data-m="coach"></dd></div>
          <div><dt><i class="fa-solid fa-signal"></i> Nivel</dt><dd data-m="nivel"></dd></div>
        </dl>
        <div class="fj-plazas">
          <span>Plazas libres</span>
          <strong data-m="libres"></strong>
          <span class="fj-plazas__barra"><i data-m="barra"></i></span>
        </div>
        <button type="button" class="fj-btn fj-btn--xl fj-btn--full" data-fj-reservar>Reservar plaza</button>
      </dialog>
    </section>

    <!-- tarifas -->
    <section class="fj-sec fj-tarifas-sec" id="tarifas">
      <div class="fj-wrap">
        <div class="fj-sec__head fj-sec__head--centro">
          <span class="fj-etq fj-etq--n" data-n="02">Tarifas</span>
          <h2>Sin matrícula. Sin permanencia.</h2>
          <div class="fj-toggle" data-fj-periodo>
            <button type="button" data-p="mes" aria-pressed="true">Mensual</button>
            <button type="button" data-p="anual" aria-pressed="false">Anual <em>-20%</em></button>
          </div>
        </div>
        <div class="fj-planes">
          {
            planes.map((p) => (
              <article class:list={["fj-plan", { "is-dest": p.dest }]}>
                {p.dest && <span class="fj-plan__dest">El más elegido</span>}
                <h3>{p.n}</h3>
                <p>{p.desc}</p>
                <div class="fj-plan__precio">
                  <strong data-precio-mes={p.m}>{p.m}</strong>
                  <span>€/mes</span>
                </div>
                <small class="fj-plan__anual" data-anual-txt />
                <ul role="list">
                  {ventajas.map((v, i) => (
                    <li class:list={{ "is-no": !p.inc[i] }}>
                      <i class={`fa-solid fa-${p.inc[i] ? "check" : "xmark"}`} /> {v}
                    </li>
                  ))}
                </ul>
                <a href="#prueba" class:list={["fj-btn", "fj-btn--full", { "fj-btn--linea": !p.dest }]}>
                  Empezar con {p.n}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- calculadora -->
    <section class="fj-sec" id="calculadora">
      <div class="fj-wrap fj-calc">
        <div>
          <span class="fj-etq fj-etq--n" data-n="03">Herramientas</span>
          <h2>Calcula tu punto de partida</h2>
          <div class="fj-tabs" role="tablist" data-fj-calc-tabs>
            <button type="button" role="tab" data-tab="imc" aria-selected="true">IMC</button>
            <button type="button" role="tab" data-tab="kcal" aria-selected="false">Calorías diarias</button>
          </div>
          <form class="fj-campos" data-fj-calc onsubmit="return false">
            <div class="fj-seg" data-fj-sexo>
              <button type="button" data-v="h" aria-pressed="true"><i class="fa-solid fa-mars"></i> Hombre</button>
              <button type="button" data-v="m" aria-pressed="false"><i class="fa-solid fa-venus"></i> Mujer</button>
            </div>
            <label>Peso <output data-out="peso">75 kg</output><input type="range" name="peso" min="40" max="150" value="75" /></label>
            <label>Altura <output data-out="altura">175 cm</output><input type="range" name="altura" min="140" max="210" value="175" /></label>
            <label data-solo="kcal">Edad <output data-out="edad">30 años</output><input type="range" name="edad" min="16" max="80" value="30" /></label>
            <label data-solo="kcal">Actividad
              <select name="act">
                <option value="1.2">Sedentaria</option>
                <option value="1.375">Ligera (1-3 días)</option>
                <option value="1.55" selected>Moderada (3-5 días)</option>
                <option value="1.725">Alta (6-7 días)</option>
              </select>
            </label>
            <label data-solo="kcal">Objetivo
              <select name="obj">
                <option value="-400">Perder grasa</option>
                <option value="0" selected>Mantenerme</option>
                <option value="300">Ganar músculo</option>
              </select>
            </label>
          </form>
        </div>
        <div class="fj-resultado" data-fj-res>
          <svg viewBox="0 0 200 120" class="fj-gauge" aria-hidden="true">
            <path d="M20 110 A80 80 0 0 1 180 110" pathLength="100" class="fj-gauge__fondo"></path>
            <path d="M20 110 A80 80 0 0 1 180 110" pathLength="100" class="fj-gauge__valor" data-fj-gauge></path>
          </svg>
          <strong class="fj-resultado__n" data-fj-res-n>–</strong>
          <span class="fj-resultado__u" data-fj-res-u></span>
          <p class="fj-resultado__t" data-fj-res-t></p>
          <div class="fj-macros" data-fj-macros hidden>
            <div><span>Proteína</span><strong data-macro="p"></strong></div>
            <div><span>Carbohidratos</span><strong data-macro="c"></strong></div>
            <div><span>Grasas</span><strong data-macro="g"></strong></div>
          </div>
        </div>
      </div>
    </section>

    <!-- equipo -->
    <section class="fj-sec" id="equipo">
      <div class="fj-wrap">
        <div class="fj-sec__head">
          <div>
            <span class="fj-etq fj-etq--n" data-n="04">Coaches</span>
            <h2>Quién te va a entrenar</h2>
          </div>
        </div>
        <ul role="list" class="fj-coaches">
          {
            coaches.map((c) => (
              <li class="fj-coach" style={`--t:${c.c}`} tabindex="0">
                <div class="fj-coach__cara fj-coach__cara--frente" data-ini={c.n[0]}>
                  <i class={`fa-solid fa-${c.ico}`} />
                  <strong>{c.n}</strong>
                  <span>{c.r}</span>
                </div>
                <div class="fj-coach__cara fj-coach__cara--dorso">
                  <strong>{c.n.split(" ")[0]}</strong>
                  <ul role="list">
                    {c.esp.map((e) => (
                      <li>
                        <i class="fa-solid fa-bolt" /> {e}
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- prueba gratis -->
    <section class="fj-sec fj-prueba-sec" id="prueba">
      <div class="fj-wrap fj-prueba">
        <div>
          <span class="fj-etq fj-etq--n" data-n="05">Pase de prueba</span>
          <h2>Tu primera clase, gratis</h2>
          <p>Elige clase, deja tus datos y enseña el código en recepción. Sin compromiso.</p>
        </div>
        <form class="fj-pform" data-fj-prueba novalidate>
          <label>Clase que quieres probar
            <select name="clase">{clases.map((c) => <option value={c.id}>{c.n} · {["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"][c.d]} {c.h}</option>)}</select>
          </label>
          <label>Nombre<input name="nombre" autocomplete="name" /></label>
          <label>Teléfono<input name="tel" type="tel" autocomplete="tel" /></label>
          <p class="fj-error" data-fj-error></p>
          <button type="submit" class="fj-btn fj-btn--xl fj-btn--full">Conseguir mi pase <i class="fa-solid fa-ticket"></i></button>
        </form>
        <div class="fj-pase" data-fj-pase hidden>
          <div class="fj-pase__qr" data-fj-qr></div>
          <div>
            <span class="fj-etq">Pase de prueba</span>
            <strong data-fj-pase-n></strong>
            <p data-fj-pase-t></p>
            <code data-fj-pase-c></code>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="fj-pie">
    <div class="fj-wrap">
      <div class="fj-pie__cta">
        <h2>¿Empezamos <span>hoy?</span></h2>
        <a href="#prueba" class="fj-btn fj-btn--xl">Reservar clase gratis <i class="fa-solid fa-arrow-right"></i></a>
      </div>

      <div class="fj-pie__cols">
        <div class="fj-pie__marca">
          <a href="#inicio" class="fj-logo"><span>F</span>FORJA<small>TRAINING CLUB</small></a>
          <p>1.200 m² para entrenar fuerza, cardio, combate y movilidad. Sin matrícula y sin permanencia.</p>
          <div class="fj-pie__redes">
            <a href="#inicio" aria-label="Instagram"><i class="fa-solid fa-camera"></i></a>
            <a href="#inicio" aria-label="YouTube"><i class="fa-solid fa-play"></i></a>
            <a href="#inicio" aria-label="WhatsApp"><i class="fa-solid fa-comment-dots"></i></a>
          </div>
        </div>
        <nav class="fj-pie__col" aria-label="Club">
          <strong>Club</strong>
          <a href="#clases">Horario de clases</a>
          <a href="#tarifas">Tarifas</a>
          <a href="#calculadora">Calculadora</a>
          <a href="#equipo">Coaches</a>
        </nav>
        <div class="fj-pie__col">
          <strong>Horario</strong>
          <span>Lunes a domingo</span>
          <span class="fj-pie__grande">6:00 – 23:00</span>
          <span>Festivos incluidos</span>
        </div>
        <div class="fj-pie__col">
          <strong>Dónde</strong>
          <span><i class="fa-solid fa-location-dot"></i> Av. del Deporte 42, Sevilla</span>
          <span><i class="fa-solid fa-phone"></i> 954 000 000</span>
          <span><i class="fa-solid fa-square-parking"></i> Parking gratis para socios</span>
        </div>
      </div>

      <div class="fj-pie__base">
        <span>© {new Date().getFullYear()} Forja Training Club</span>
        <span class="fj-pie__legal"><a href="#inicio">Aviso legal</a><a href="#inicio">Privacidad</a><a href="#inicio">Cookies</a></span>
      </div>
    </div>
  </footer>

  <script type="application/json" data-fj-datos set:html={JSON.stringify({ clases, tipos })} />
</div>

<script>
  interface Clase {
    id: string;
    n: string;
    tipo: string;
    d: number;
    h: string;
    min: number;
    coach: string;
    nivel: string;
    plazas: number;
  }

  const raiz = document.querySelector<HTMLElement>("[data-fj]")!;
  const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = raiz) => el.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = raiz) => [...el.querySelectorAll<T>(s)];
  const datos = JSON.parse($("[data-fj-datos]").textContent!) as { clases: Clase[]; tipos: { id: string; t: string; c: string }[] };
  const CLAVE = "forja-reservas";
  const reservas = new Set<string>(leer());

  function leer(): string[] {
    try {
      return JSON.parse(localStorage.getItem(CLAVE) ?? "[]");
    } catch {
      return [];
    }
  }
  function guardar() {
    try {
      localStorage.setItem(CLAVE, JSON.stringify([...reservas]));
    } catch {}
  }

  addEventListener("scroll", () => $("[data-fj-head]").classList.toggle("is-baja", scrollY > 30), { passive: true });

  // contadores de la portada
  $$("[data-contar]").forEach((n) => {
    const fin = Number(n.dataset.contar);
    const t0 = performance.now();
    const paso = (t: number) => {
      const p = Math.min(1, (t - t0) / 1600);
      n.textContent = Math.round(fin * (1 - Math.pow(1 - p, 3))).toLocaleString("es-ES");
      if (p < 1) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  });

  // aforo según la hora (picos a las 8, 14 y 19-21)
  function aforo() {
    const h = new Date().getHours() + new Date().getMinutes() / 60;
    const pct = h < 6 || h >= 23 ? 0 : Math.round(15 + 45 * Math.exp(-((h - 8) ** 2) / 2) + 30 * Math.exp(-((h - 14) ** 2) / 1.5) + 60 * Math.exp(-((h - 19.5) ** 2) / 2.5));
    const v = Math.min(96, pct);
    $("[data-fj-aforo]").textContent = h < 6 || h >= 23 ? "Cerrado" : `${v}%`;
    const barra = $("[data-fj-aforo-barra]");
    barra.style.width = `${v}%`;
    barra.style.background = v > 75 ? "#ef4444" : v > 50 ? "#f59e0b" : "#84cc16";
  }
  aforo();
  setInterval(aforo, 60_000);

  // ── horario ─────
  const clase = (id: string) => datos.clases.find((c) => c.id === id)!;
  // ocupación fija por clase (para que «plazas libres» no cambie cada vez)
  const ocupadas = (c: Clase) => Math.floor(((Math.sin(c.id.length * 31 + c.d * 7 + Number(c.h.slice(0, 2))) + 1) / 2) * (c.plazas - 2)) + (reservas.has(c.id) ? 1 : 0);

  function pintarReservas() {
    $$<HTMLButtonElement>("[data-clase]").forEach((b) => b.classList.toggle("is-reservada", reservas.has(b.dataset.clase!)));
  }
  pintarReservas();

  // marca hoy
  const hoy = (new Date().getDay() + 6) % 7;
  $(`.fj-dia[data-d="${hoy}"]`).classList.add("is-hoy");

  // próxima clase (para la tarjeta de la portada): la primera que empiece a partir de ahora
  function proxima() {
    const ahora = new Date();
    const min = ahora.getHours() * 60 + ahora.getMinutes();
    const DIAS_C = ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"];
    for (let i = 0; i < 8; i++) {
      const d = (hoy + i) % 7;
      const del = datos.clases
        .filter((c) => c.d === d)
        .map((c) => ({ c, m: Number(c.h.slice(0, 2)) * 60 + Number(c.h.slice(3)) }))
        .filter((x) => i > 0 || x.m > min)
        .sort((a, b) => a.m - b.m)[0];
      if (!del) continue;
      $("[data-fj-prox]").textContent = del.c.n;
      $("[data-fj-prox-t]").textContent = `${i === 0 ? "Hoy" : i === 1 ? "Mañana" : DIAS_C[d]} · ${del.c.h} · con ${del.c.coach}`;
      return;
    }
  }
  proxima();
  setInterval(proxima, 60_000);

  $$<HTMLButtonElement>("[data-fj-tipos] button").forEach((b) =>
    b.addEventListener("click", () => {
      $$("[data-fj-tipos] button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      const t = b.dataset.tipo!;
      $$<HTMLElement>("[data-clase]").forEach((c) => c.classList.toggle("is-fuera", t !== "todas" && c.dataset.tipo !== t));
    }),
  );

  const modal = $<HTMLDialogElement>("[data-fj-modal]");
  let abierta = "";
  function pintarModal() {
    const c = clase(abierta);
    const t = datos.tipos.find((x) => x.id === c.tipo)!;
    modal.style.setProperty("--t", t.c);
    $('[data-m="tipo"]', modal).textContent = t.t;
    $('[data-m="n"]', modal).textContent = c.n;
    $('[data-m="h"]', modal).textContent = `${["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"][c.d]} ${c.h}`;
    $('[data-m="min"]', modal).textContent = `${c.min} min`;
    $('[data-m="coach"]', modal).textContent = c.coach;
    $('[data-m="nivel"]', modal).textContent = c.nivel;
    const libres = c.plazas - ocupadas(c);
    $('[data-m="libres"]', modal).textContent = `${libres} de ${c.plazas}`;
    $('[data-m="barra"]', modal).style.width = `${(1 - libres / c.plazas) * 100}%`;
    const b = $<HTMLButtonElement>("[data-fj-reservar]", modal);
    const mia = reservas.has(c.id);
    b.textContent = mia ? "Cancelar mi reserva" : libres ? "Reservar plaza" : "Clase completa";
    b.disabled = !mia && !libres;
    b.classList.toggle("fj-btn--linea", mia);
  }
  $$<HTMLButtonElement>("[data-clase]").forEach((b) =>
    b.addEventListener("click", () => {
      abierta = b.dataset.clase!;
      pintarModal();
      modal.showModal();
    }),
  );
  $("[data-fj-reservar]", modal).addEventListener("click", () => {
    reservas.has(abierta) ? reservas.delete(abierta) : reservas.add(abierta);
    guardar();
    pintarReservas();
    pintarModal();
  });
  // al cerrar, la ficha se encoge y se desvanece (lo pinta .is-cierra) antes de quitarla
  function cerrarModal() {
    if (!modal.open || modal.classList.contains("is-cierra")) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return modal.close();
    modal.classList.add("is-cierra");
    setTimeout(() => {
      modal.classList.remove("is-cierra");
      modal.close();
    }, 260);
  }
  modal.addEventListener("cancel", (e) => {
    e.preventDefault();
    cerrarModal();
  });
  $("[data-fj-modal-x]", modal).addEventListener("click", cerrarModal);
  modal.addEventListener("click", (e) => e.target === modal && cerrarModal());

  // ── tarifas ─────
  $$<HTMLButtonElement>("[data-fj-periodo] button").forEach((b) =>
    b.addEventListener("click", () => {
      $$("[data-fj-periodo] button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      const anual = b.dataset.p === "anual";
      $$<HTMLElement>("[data-precio-mes]").forEach((s) => {
        const m = Number(s.dataset.precioMes);
        const fin = anual ? Math.round(m * 0.8) : m;
        const ini = Number(s.textContent);
        const t0 = performance.now();
        const paso = (t: number) => {
          const p = Math.min(1, (t - t0) / 400);
          s.textContent = String(Math.round(ini + (fin - ini) * p));
          if (p < 1) requestAnimationFrame(paso);
        };
        requestAnimationFrame(paso);
        const txt = s.closest(".fj-plan")!.querySelector<HTMLElement>("[data-anual-txt]")!;
        txt.textContent = anual ? `${fin * 12} € al año · ahorras ${(m - fin) * 12} €` : "Pago mensual, cancela cuando quieras";
      });
    }),
  );
  $$<HTMLElement>("[data-anual-txt]").forEach((t) => (t.textContent = "Pago mensual, cancela cuando quieras"));

  // ── calculadora ─────
  const form = $<HTMLFormElement>("[data-fj-calc]");
  let tab = "imc";
  let sexo = "h";
  function calcular() {
    const v = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement).value);
    const peso = v("peso");
    const altura = v("altura");
    const edad = v("edad");
    $('[data-out="peso"]').textContent = `${peso} kg`;
    $('[data-out="altura"]').textContent = `${altura} cm`;
    $('[data-out="edad"]').textContent = `${edad} años`;
    $$<HTMLInputElement>('input[type="range"]', form).forEach((r) => r.style.setProperty("--p", `${((Number(r.value) - Number(r.min)) / (Number(r.max) - Number(r.min))) * 100}%`));
    const gauge = $("[data-fj-gauge]");
    if (tab === "imc") {
      const imc = peso / (altura / 100) ** 2;
      const [txt, color] = imc < 18.5 ? ["Bajo peso", "#38bdf8"] : imc < 25 ? ["Peso saludable", "#84cc16"] : imc < 30 ? ["Sobrepeso", "#f59e0b"] : ["Obesidad", "#ef4444"];
      $("[data-fj-res-n]").textContent = imc.toFixed(1);
      $("[data-fj-res-u]").textContent = "IMC";
      $("[data-fj-res-t]").textContent = `${txt}. El IMC es orientativo: no distingue músculo de grasa.`;
      gauge.style.strokeDasharray = `${Math.min(100, ((imc - 15) / 25) * 100)} 100`;
      gauge.style.stroke = color;
      $("[data-fj-macros]").hidden = true;
    } else {
      // Mifflin-St Jeor
      const bmr = 10 * peso + 6.25 * altura - 5 * edad + (sexo === "h" ? 5 : -161);
      const kcal = Math.round(bmr * v("act") + v("obj"));
      $("[data-fj-res-n]").textContent = kcal.toLocaleString("es-ES");
      $("[data-fj-res-u]").textContent = "kcal al día";
      $("[data-fj-res-t]").textContent = v("obj") < 0 ? "Déficit suave para perder grasa sin perder fuerza." : v("obj") > 0 ? "Superávit ligero para ganar músculo." : "Para mantener tu peso actual.";
      gauge.style.strokeDasharray = `${Math.min(100, ((kcal - 1200) / 2800) * 100)} 100`;
      gauge.style.stroke = "#84cc16";
      const prot = Math.round(peso * 2);
      const gras = Math.round((kcal * 0.25) / 9);
      const carb = Math.round((kcal - prot * 4 - gras * 9) / 4);
      $('[data-macro="p"]').textContent = `${prot} g`;
      $('[data-macro="c"]').textContent = `${carb} g`;
      $('[data-macro="g"]').textContent = `${gras} g`;
      $("[data-fj-macros]").hidden = false;
    }
  }
  form.addEventListener("input", calcular);
  $$<HTMLButtonElement>("[data-fj-calc-tabs] button").forEach((b) =>
    b.addEventListener("click", () => {
      tab = b.dataset.tab!;
      $$("[data-fj-calc-tabs] button").forEach((x) => x.setAttribute("aria-selected", String(x === b)));
      $$("[data-solo]").forEach((x) => (x.hidden = x.dataset.solo !== tab));
      $("[data-fj-sexo]").hidden = tab === "imc";
      calcular();
    }),
  );
  $$<HTMLButtonElement>("[data-fj-sexo] button").forEach((b) =>
    b.addEventListener("click", () => {
      sexo = b.dataset.v!;
      $$("[data-fj-sexo] button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      calcular();
    }),
  );
  $$("[data-solo]").forEach((x) => (x.hidden = true));
  $("[data-fj-sexo]").hidden = true;
  calcular();

  // ── pase de prueba con «QR» ─────
  const fp = $<HTMLFormElement>("[data-fj-prueba]");
  fp.addEventListener("submit", (e) => {
    e.preventDefault();
    const fd = new FormData(fp);
    const err = $("[data-fj-error]");
    if (String(fd.get("nombre")).trim().length < 2) return (err.textContent = "Escribe tu nombre.");
    if (!/^[0-9 +]{9,}$/.test(String(fd.get("tel")))) return (err.textContent = "Revisa el teléfono.");
    err.textContent = "";
    const c = clase(String(fd.get("clase")));
    const codigo = "FJ" + Math.random().toString(36).slice(2, 8).toUpperCase();
    // dibujo tipo QR a partir del código (decorativo)
    const qr = $("[data-fj-qr]");
    qr.replaceChildren();
    let s = [...codigo].reduce((a, ch) => a * 31 + ch.charCodeAt(0), 7);
    for (let i = 0; i < 121; i++) {
      s = (s * 1103515245 + 12345) & 0x7fffffff;
      const fila = Math.floor(i / 11);
      const col = i % 11;
      const esquina = (fila < 3 && col < 3) || (fila < 3 && col > 7) || (fila > 7 && col < 3);
      const celda = document.createElement("i");
      if (esquina || s % 2) celda.className = "is-on";
      qr.append(celda);
    }
    $("[data-fj-pase-n]").textContent = String(fd.get("nombre"));
    $("[data-fj-pase-t]").textContent = `${c.n} · ${["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"][c.d]} a las ${c.h}`;
    $("[data-fj-pase-c]").textContent = codigo;
    fp.hidden = true;
    $("[data-fj-pase]").hidden = false;
  });

  const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add("is-visto"), io.unobserve(e.target))), { threshold: 0.1 });
  $$(".fj-sec").forEach((s) => io.observe(s));
</script>

<style is:global>
  .fj {
