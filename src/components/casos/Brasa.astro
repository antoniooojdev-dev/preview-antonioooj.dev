---

<div class="bo" data-bo>
  <!-- animación de entrada: se dibuja la llama, sube el nombre y se abre el telón (solo CSS; el script la quita al acabar o al pulsar) -->
  <div class="bo-intro" data-bo-intro aria-hidden="true">
    <div class="bo-intro__centro">
      <svg class="bo-intro__logo" viewBox="0 0 40 40" width="84" height="84">
        <circle cx="20" cy="20" r="18.5" pathLength="1"></circle>
        <path d="M20 9c3 5 8 7 8 14a8 8 0 0 1-16 0c0-4 2-6 4-8 0 3 1 5 3 5 0-4-1-7 1-11z" pathLength="1"></path>
      </svg>
      <span class="bo-intro__nombre"><span>Brasa</span> <em>&amp;</em> <span>Olivo</span></span>
      <span class="bo-intro__sub">Cocina de brasa · Valencia · 1998</span>
      <i class="bo-intro__barra"></i>
    </div>
  </div>

  <!-- barra superior con estado en vivo -->
  <div class="bo-top">
    <div class="bo-wrap bo-top__in">
      <a class="bo-top__dato" href="#reservar"><i class="fa-solid fa-phone"></i> 963 000 000</a>
    </div>
  </div>

  <!-- cabecera -->
  <header class="bo-head" data-bo-head>
    <div class="bo-wrap bo-head__in">
      <a href="#inicio" class="bo-logo" aria-label="Brasa & Olivo, inicio">
        <svg viewBox="0 0 40 40" width="38" height="38" aria-hidden="true">
          <circle cx="20" cy="20" r="19" fill="#c2410c"></circle>
          <path d="M20 9c3 5 8 7 8 14a8 8 0 0 1-16 0c0-4 2-6 4-8 0 3 1 5 3 5 0-4-1-7 1-11z" fill="#faf3e8"></path>
        </svg>
        <span>Brasa <em>&amp;</em> Olivo</span>
      </a>
      <nav class="bo-nav" data-bo-nav aria-label="Secciones">
        <a href="#menu-dia">Menú del día</a>
        <a href="#carta">Carta</a>
        <a href="#nosotros">Nosotros</a>
        <a href="#resenas">Reseñas</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a href="#reservar" class="bo-btn bo-btn--sm">Reservar mesa</a>
      <button type="button" class="bo-burger" aria-label="Abrir menú" aria-expanded="false" data-bo-burger>
        <span></span><span></span>
      </button>
    </div>
  </header>

  <main>
    <!-- portada -->
    <section class="bo-hero" id="inicio">
      <div class="bo-wrap bo-hero__in">
        <div class="bo-hero__txt">
          <span class="bo-kicker bo-entra" style="--d:0"><i class="fa-solid fa-fire-flame-curved"></i> Cocina de brasa desde 1998</span>
          <h1 class="bo-entra" style="--d:1">Fuego lento, producto de mercado y <em>sobremesas largas.</em></h1>
          <p class="bo-entra" style="--d:2">Arroces de leña, carnes maduradas y verduras de nuestra huerta en el corazón de Valencia. Reserva en un minuto y te guardamos la mejor mesa.</p>
          <div class="bo-hero__ctas bo-entra" style="--d:3">
            <a href="#reservar" class="bo-btn">Reservar mesa <i class="fa-solid fa-arrow-right"></i></a>
            <a href="#carta" class="bo-btn bo-btn--linea">Ver la carta</a>
          </div>
          <dl class="bo-hero__datos bo-entra" style="--d:4">
            <div><dt>4,8 <i class="fa-solid fa-star"></i></dt><dd>1.240 reseñas</dd></div>
            <div><dt>45 días</dt><dd>de maduración</dd></div>
            <div><dt>Km 0</dt><dd>huerta propia</dd></div>
          </dl>
        </div>
        <!-- foto de portada con tarjetas flotantes -->
        <div class="bo-hero__media">
          <div class="bo-hero__foto">
            <img src={`${FOTOS}/hero.jpg`} alt="Paella valenciana recién hecha a la leña" width="576" height="720" fetchpriority="high" />
          </div>
          <a href="#carta" class="bo-flota bo-flota--plato" data-bo-estrella>
            <img src={`${FOTOS}/senyoret.jpg`} alt="" width="56" height="56" />
            <span><small>Plato estrella</small><strong>Arroz del senyoret</strong></span>
          </a>
          <div class="bo-flota bo-flota--nota" aria-hidden="true">
            <span class="bo-estrellas">{[1, 2, 3, 4, 5].map(() => <i class="fa-solid fa-star" />)}</span>
            <span><strong>4,8</strong> · 1.240 reseñas</span>
          </div>
          <span class="bo-sello" aria-hidden="true">
            <svg viewBox="0 0 100 100">
              <defs><path id="bo-circulo" d="M50 50m-37 0a37 37 0 1 1 74 0a37 37 0 1 1-74 0"></path></defs>
              <text><textPath href="#bo-circulo">ARROZ DE LEÑA · FUEGO LENTO · </textPath></text>
            </svg>
            <i class="fa-solid fa-fire-flame-curved"></i>
          </span>
        </div>
      </div>
      <div class="bo-cinta" aria-hidden="true">
        <div class="bo-cinta__pista">
          {
            [0, 1].map(() => (
              <span>
                Arroces de leña <i class="fa-solid fa-fire" /> Carnes maduradas <i class="fa-solid fa-fire" /> Pescado de lonja <i class="fa-solid fa-fire" /> Huerta propia <i class="fa-solid fa-fire" /> Terraza <i class="fa-solid fa-fire" /> Vinos de la tierra <i class="fa-solid fa-fire" />
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <!-- menú del día -->
    <section class="bo-sec bo-dia" id="menu-dia">
