  <footer class="bo-pie">
    <div class="bo-wrap bo-pie__in">
      <div class="bo-logo"><span>Brasa <em>&amp;</em> Olivo</span></div>
      <p>Cocina de brasa · Valencia · Desde 1998</p>
      <div class="bo-pie__redes">
        <a href="#inicio" aria-label="Instagram"><i class="fa-solid fa-camera"></i></a>
        <a href="#inicio" aria-label="Correo"><i class="fa-solid fa-envelope"></i></a>
        <a href="#reservar" aria-label="Reservar"><i class="fa-solid fa-calendar"></i></a>
      </div>
    </div>
  </footer>

  <!-- datos de la carta para el script -->
  <script type="application/json" data-bo-datos set:html={JSON.stringify({ carta, categorias, alergenos, fotos: FOTOS })} />
</div>

<script>
  interface Plato {
    n: string;
    d: string;
    p: number;
    cat: string;
    img: string;
    larga: string;
    vino: string;
    info?: string;
    tags?: string[];
    al?: string[];
  }

  const raiz = document.querySelector<HTMLElement>("[data-bo]")!;
  const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = raiz) => el.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = raiz) => [...el.querySelectorAll<T>(s)];
  const datos = JSON.parse($("[data-bo-datos]").textContent!) as {
    carta: Plato[];
    categorias: { id: string; t: string; ico: string }[];
    alergenos: { id: string; t: string; ico: string }[];
    fotos: string;
  };
  const foto = (p: Plato) => `${datos.fotos}/${p.img}.jpg`;

  // ── animación de entrada: la hace el CSS; aquí se quita del DOM al acabar o al pulsarla ─────
  const intro = $("[data-bo-intro]");
  const quitarIntro = () => intro.remove();
  intro.addEventListener("animationend", (e) => e.target === intro && quitarIntro());
  intro.addEventListener("click", () => {
    intro.classList.add("is-salta");
    raiz.style.setProperty("--intro", "0.3s");
    setTimeout(quitarIntro, 450);
  });
  const euro = new Intl.NumberFormat("es-ES", { style: "currency", currency: "EUR" });
  const ico = (n: string) => Object.assign(document.createElement("i"), { className: `fa-solid fa-${n}` });
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, clase = "", texto = "") {
    const e = document.createElement(tag);
    if (clase) e.className = clase;
    if (texto) e.textContent = texto;
    return e;
  }

  // ── cabecera: sombra al bajar y menú en móvil ─────
  const cab = $("[data-bo-head]");
  addEventListener("scroll", () => cab.classList.toggle("is-baja", scrollY > 30), { passive: true });
  const burger = $<HTMLButtonElement>("[data-bo-burger]");
  burger.addEventListener("click", () => {
    const abierto = cab.classList.toggle("is-menu");
    burger.setAttribute("aria-expanded", String(abierto));
  });
  $$("[data-bo-nav] a").forEach((a) => a.addEventListener("click", () => cab.classList.remove("is-menu")));

  // ── horario y «abierto ahora» ─────
  // [día 0=domingo..6] → turnos [inicio, fin] en horas decimales
  const HORARIO: [number, number][][] = [
    [[13, 16.5]],
    [],
    [[13, 16], [20, 23.5]],
    [[13, 16], [20, 23.5]],
    [[13, 16], [20, 23.5]],
    [[13, 16.5], [20, 24]],
    [[13, 16.5], [20, 24]],
  ];
  const DIAS = ["Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado"];
  const hhmm = (h: number) => `${String(Math.floor(h) % 24).padStart(2, "0")}:${h % 1 ? "30" : "00"}`;

  const tbody = $("[data-bo-horario] tbody");
  [1, 2, 3, 4, 5, 6, 0].forEach((d) => {
    const tr = el("tr");
    if (d === new Date().getDay()) tr.className = "is-hoy";
    tr.append(el("th", "", DIAS[d]), el("td", "", HORARIO[d].length ? HORARIO[d].map(([a, b]) => `${hhmm(a)}–${hhmm(b)}`).join(" · ") : "Cerrado"));
    tbody.append(tr);
  });

  // ── menú del día ─────
  const MENUS: Record<number, string[][]> = {
    1: [["Crema de calabaza asada", "Ensalada de garbanzos"], ["Arroz al horno", "Merluza a la brasa"], ["Flan de la abuela", "Fruta de temporada"]],
    2: [["Esgarraet con pan tostado", "Gazpacho de fresa"], ["Fideuà de marisco", "Pollo de corral al ajillo"], ["Arroz con leche", "Fruta de temporada"]],
    3: [["Ensaladilla de la casa", "Sopa de verduras"], ["Arroz de pato y setas", "Bacalao confitado"], ["Tarta de queso", "Fruta de temporada"]],
    4: [["Alcachofas a la brasa", "Crema de puerros"], ["Paella valenciana", "Albóndigas en salsa"], ["Natillas caseras", "Fruta de temporada"]],
    5: [["Tomate con ventresca", "Hummus de remolacha"], ["Arroz negro", "Secreto ibérico"], ["Torrija", "Fruta de temporada"]],
  };
  const diasMenu = $("[data-bo-dias]");
  const hoy = new Date().getDay();
  let diaMenu = MENUS[hoy] ? hoy : 1;
  [1, 2, 3, 4, 5].forEach((d) => {
    const b = el("button", "", DIAS[d].slice(0, 3));
    b.type = "button";
    b.setAttribute("role", "tab");
    b.dataset.d = String(d);
    if (d === hoy) b.append(el("small", "", "hoy"));
    b.addEventListener("click", () => {
      diaMenu = d;
      pintarMenu();
    });
    diasMenu.append(b);
  });

  function pintarMenu() {
    $$<HTMLButtonElement>("button", diasMenu).forEach((b) => b.setAttribute("aria-selected", String(Number(b.dataset.d) === diaMenu)));
    $("[data-bo-dia-nombre]").textContent = DIAS[diaMenu].toLowerCase();
    const ol = $("[data-bo-dia-platos]");
    ol.replaceChildren(
      ...MENUS[diaMenu].map((opciones, i) => {
        const li = el("li");
        li.style.setProperty("--i", String(i));
        li.append(el("span", "bo-dia__n", ["Primero", "Segundo", "Postre"][i]), el("strong", "", opciones.join(" o ")));
        return li;
      }),
    );
  }
  pintarMenu();

  // ── carta con filtros ─────
  const filtros = { cat: "todo", texto: "", tags: new Set<string>(), sin: new Set<string>() };
  const icoAl = Object.fromEntries(datos.alergenos.map((a) => [a.id, a]));
  const ICO_TAG: Record<string, [string, string]> = {
    vegano: ["leaf", "Vegano"],
    vegetariano: ["carrot", "Vegetariano"],
    picante: ["pepper-hot", "Picante"],
    chef: ["award", "Recomendado"],
  };
  const normal = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  const nombreCat = Object.fromEntries(datos.categorias.map((c) => [c.id, c.t]));

  function etiquetas(p: Plato, conAlergenos = true) {
    const caja = el("div", "bo-plato-item__tags");
    p.tags?.forEach((t) => {
      const s = el("span", `bo-tag bo-tag--${t}`);
      s.append(ico(ICO_TAG[t][0]), ICO_TAG[t][1]);
      caja.append(s);
    });
    if (conAlergenos)
      p.al?.forEach((a) => {
        const s = el("span", "bo-al");
        s.title = `Contiene ${icoAl[a].t.toLowerCase()}`;
        s.append(ico(icoAl[a].ico));
        caja.append(s);
      });
    return caja;
  }

  // platos visibles con los filtros actuales (la ficha navega entre ellos)
  let lista: Plato[] = [];

  function pintarCarta() {
    lista = datos.carta.filter(
      (p) =>
        (filtros.cat === "todo" || p.cat === filtros.cat) &&
        (!filtros.texto || normal(p.n + " " + p.d).includes(filtros.texto)) &&
        [...filtros.tags].every((t) => p.tags?.includes(t) || (t === "vegetariano" && p.tags?.includes("vegano"))) &&
        ![...filtros.sin].some((a) => p.al?.includes(a)),
    );
    const ul = $("[data-bo-platos]");
    ul.replaceChildren(
      ...lista.map((p, i) => {
        const li = el("li");
        li.style.setProperty("--i", String(i));
        const b = el("button", `bo-plato-item${p.tags?.includes("chef") ? " is-chef" : ""}`);
        b.type = "button";
        b.setAttribute("aria-label", `${p.n}, ${euro.format(p.p)}. Ver detalles`);
        b.addEventListener("click", () => abrirFicha(i));

        const media = el("div", "bo-plato-item__img");
        const img = Object.assign(document.createElement("img"), { src: foto(p), alt: "", loading: "lazy", width: 900, height: 675 });
        media.append(img, el("span", "bo-precio", euro.format(p.p)));
        if (p.tags?.includes("chef")) {
          const chef = el("span", "bo-plato-item__chef");
          chef.append(ico("award"), "Del chef");
          media.append(chef);
        }

        const cuerpo = el("div", "bo-plato-item__cuerpo");
        const ver = el("span", "bo-plato-item__ver", "Ver detalles");
        ver.append(ico("arrow-right"));
        cuerpo.append(el("strong", "", p.n), el("p", "", p.d), etiquetas(p), ver);
        b.append(media, cuerpo);
        li.append(b);
        return li;
      }),
    );
    $("[data-bo-vacio]").hidden = lista.length > 0;
    $("[data-bo-cuenta]").textContent = `${lista.length} ${lista.length === 1 ? "plato" : "platos"}`;
    const activos = (filtros.texto ? 1 : 0) + filtros.tags.size + filtros.sin.size;
    $("[data-bo-limpiar]").hidden = !activos;
    const nf = $("[data-bo-nfiltros]");
    nf.hidden = !activos;
    nf.textContent = String(activos);
    $("[data-bo-buscar-x]").hidden = !filtros.texto;
  }

  $$<HTMLButtonElement>("[data-bo-cats] button").forEach((b) =>
    b.addEventListener("click", () => {
      filtros.cat = b.dataset.cat!;
      $$("[data-bo-cats] button").forEach((x) => x.setAttribute("aria-selected", String(x === b)));
      pintarCarta();
    }),
  );
  $$<HTMLButtonElement>("[data-bo-tags] button, [data-bo-alergenos] button").forEach((b) =>
    b.addEventListener("click", () => {
      const grupo = b.dataset.tag ? filtros.tags : filtros.sin;
      const clave = b.dataset.tag ?? b.dataset.al!;
      grupo.has(clave) ? grupo.delete(clave) : grupo.add(clave);
      b.setAttribute("aria-pressed", String(grupo.has(clave)));
      pintarCarta();
    }),
  );
  const buscar = $<HTMLInputElement>("[data-bo-buscar]");
  buscar.addEventListener("input", () => {
    filtros.texto = normal(buscar.value.trim());
    pintarCarta();
  });
  $("[data-bo-buscar-x]").addEventListener("click", () => {
    buscar.value = "";
    filtros.texto = "";
    pintarCarta();
    buscar.focus();
  });
  $("[data-bo-limpiar]").addEventListener("click", () => {
    filtros.texto = "";
    filtros.tags.clear();
    filtros.sin.clear();
    $<HTMLInputElement>("[data-bo-buscar]").value = "";
    $$("[data-bo-tags] button, [data-bo-alergenos] button").forEach((b) => b.setAttribute("aria-pressed", "false"));
    pintarCarta();
  });
  pintarCarta();

  // ── ficha de detalle de un plato ─────
  const ficha = $<HTMLDialogElement>("[data-bo-ficha]");
  let enFicha = 0;

  function abrirFicha(i: number) {
    enFicha = (i + lista.length) % lista.length;
    const p = lista[enFicha];
    const img = $<HTMLImageElement>("[data-bo-ficha-img]", ficha);
    img.src = foto(p);
    img.alt = p.n;
    $("[data-bo-ficha-chef]", ficha).hidden = !p.tags?.includes("chef");
    $("[data-bo-ficha-cat]", ficha).textContent = nombreCat[p.cat];
    $("[data-bo-ficha-nombre]", ficha).textContent = p.n;
    $("[data-bo-ficha-precio]", ficha).textContent = euro.format(p.p);
    const info = $("[data-bo-ficha-info]", ficha);
    info.hidden = !p.info;
    info.replaceChildren(ico("circle-info"), ` ${p.info ?? ""}`);
    $("[data-bo-ficha-larga]", ficha).textContent = p.larga;
    $("[data-bo-ficha-tags]", ficha).replaceChildren(...etiquetas(p, false).children);
    const al = $("[data-bo-ficha-al]", ficha);
    al.replaceChildren(
      ...(p.al?.length
        ? p.al.map((a) => {
            const li = el("li");
            li.append(ico(icoAl[a].ico), icoAl[a].t);
            return li;
          })
        : [el("li", "is-ninguno", "Sin alérgenos principales")]),
    );
    $("[data-bo-ficha-vino]", ficha).textContent = p.vino;
    $("[data-bo-ficha-pos]", ficha).textContent = `${enFicha + 1} / ${lista.length}`;
    $$<HTMLButtonElement>("[data-bo-ficha-nav]", ficha).forEach((b) => (b.disabled = lista.length < 2));
    if (!ficha.open) {
      ficha.showModal();
      document.documentElement.classList.add("bo-sin-scroll");
    } else $(".bo-ficha__foto img", ficha).animate([{ opacity: 0.3, scale: "1.04" }, { opacity: 1, scale: "1" }], { duration: 350, easing: "ease-out" });
  }

  // al cerrar, la ficha baja y se desvanece (lo pinta .is-cierra) antes de quitarla
  const sinMovimiento = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
  function cerrarFicha() {
    if (!ficha.open || ficha.classList.contains("is-cierra")) return;
    if (sinMovimiento()) return ficha.close();
    ficha.classList.add("is-cierra");
    setTimeout(() => {
      ficha.classList.remove("is-cierra");
      ficha.close();
    }, 300);
  }
  ficha.addEventListener("cancel", (e) => {
    e.preventDefault();
    cerrarFicha();
  });
  ficha.addEventListener("close", () => document.documentElement.classList.remove("bo-sin-scroll"));
  $("[data-bo-ficha-cerrar]", ficha).addEventListener("click", cerrarFicha);
  ficha.addEventListener("click", (e) => e.target === ficha && cerrarFicha());
  $$<HTMLButtonElement>("[data-bo-ficha-nav]", ficha).forEach((b) => b.addEventListener("click", () => abrirFicha(enFicha + Number(b.dataset.boFichaNav))));
  ficha.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") abrirFicha(enFicha + 1);
    if (e.key === "ArrowLeft") abrirFicha(enFicha - 1);
  });
  $("[data-bo-ficha-reservar]", ficha).addEventListener("click", cerrarFicha);

  // la tarjeta «plato estrella» de la portada abre su ficha
  $("[data-bo-estrella]").addEventListener("click", (e) => {
    e.preventDefault();
    const i = lista.findIndex((p) => p.img === "senyoret");
    if (i >= 0) abrirFicha(i);
    else location.hash = "carta";
  });

  // ── reserva en 3 pasos ─────
  const res = { personas: 2, fecha: null as Date | null, hora: "" };
  const fechaLarga = new Intl.DateTimeFormat("es-ES", { weekday: "long", day: "numeric", month: "long" });
  const caja = $("[data-bo-res]");

  function irPaso(p: string) {
    $$("[data-paso]", caja).forEach((x) => (x.hidden = x.dataset.paso !== p));
    $$("[data-paso-ind]", caja).forEach((x) => {
      const n = Number(x.dataset.pasoInd);
      x.classList.toggle("is-on", p === "ok" || n <= Number(p));
      x.classList.toggle("is-hecho", p === "ok" || n < Number(p));
    });
  }

  // los próximos 14 días (cerrado el lunes)
  const fechas = $("[data-bo-fechas]");
  for (let i = 0; i < 14; i++) {
    const d = new Date();
    d.setHours(12, 0, 0, 0);
    d.setDate(d.getDate() + i);
    const b = el("button", "bo-fecha");
    b.type = "button";
    const cerrado = !HORARIO[d.getDay()].length;
    b.disabled = cerrado;
    b.append(el("small", "", i === 0 ? "Hoy" : i === 1 ? "Mañana" : DIAS[d.getDay()].slice(0, 3)), el("strong", "", String(d.getDate())), el("small", "", cerrado ? "cerrado" : d.toLocaleDateString("es-ES", { month: "short" })));
    b.addEventListener("click", () => {
      res.fecha = d;
      $$(".bo-fecha", fechas).forEach((x) => x.classList.toggle("is-sel", x === b));
      $<HTMLButtonElement>('[data-siguiente="2"]', caja).disabled = false;
    });
    fechas.append(b);
  }

  $$<HTMLButtonElement>("[data-pers]", caja).forEach((b) =>
    b.addEventListener("click", () => {
      res.personas = Math.min(12, Math.max(1, res.personas + Number(b.dataset.pers)));
      $("[data-bo-pers]", caja).textContent = String(res.personas);
    }),
  );

  // disponibilidad «realista» pero fija para cada día y número de personas
  function libre(fecha: Date, hora: string) {
    const semilla = fecha.getDate() * 31 + hora.charCodeAt(0) * 7 + Number(hora.slice(3)) + res.personas * 13;
    return (Math.sin(semilla) * 10000) % 1 > (res.personas > 6 ? 0.35 : -0.55);
  }

  function pintarHoras() {
    const f = res.fecha!;
    $("[data-bo-resumen1]", caja).innerHTML = "";
    $("[data-bo-resumen1]", caja).append(ico("calendar"), ` ${fechaLarga.format(f)} · ${res.personas} ${res.personas === 1 ? "persona" : "personas"}`);
    const turnos = HORARIO[f.getDay()];
    (["comida", "cena"] as const).forEach((t, i) => {
      const caj = $(`[data-bo-horas="${t}"]`, caja);
      caj.replaceChildren();
      const turno = turnos[i];
      if (!turno) {
        caj.append(el("span", "bo-muted", "Ese día no abrimos en este turno."));
        return;
      }
      for (let h = turno[0]; h <= turno[1] - 1.5; h += 0.5) {
        const hora = hhmm(h);
        const b = el("button", "bo-hora", hora);
        b.type = "button";
        const esHoyPasado = f.toDateString() === new Date().toDateString() && h <= new Date().getHours() + 1;
        b.disabled = esHoyPasado || !libre(f, hora);
        if (b.disabled) b.title = "Completo";
        b.addEventListener("click", () => {
          res.hora = hora;
          $$(".bo-hora", caja).forEach((x) => x.classList.toggle("is-sel", x === b));
          $<HTMLButtonElement>('[data-siguiente="3"]', caja).disabled = false;
        });
        caj.append(b);
      }
    });
  }

  $$<HTMLButtonElement>("[data-siguiente]", caja).forEach((b) =>
    b.addEventListener("click", () => {
      const p = b.dataset.siguiente!;
      if (p === "2") {
        res.hora = "";
        $<HTMLButtonElement>('[data-siguiente="3"]', caja).disabled = true;
        pintarHoras();
      }
      if (p === "3") {
        const r = $("[data-bo-resumen2]", caja);
        r.replaceChildren(ico("calendar-check"), ` ${fechaLarga.format(res.fecha!)} a las ${res.hora} · ${res.personas} pers.`);
      }
      irPaso(p);
    }),
  );
  $$<HTMLButtonElement>("[data-atras]", caja).forEach((b) => b.addEventListener("click", () => irPaso(b.dataset.atras!)));

  const form = $<HTMLFormElement>('form[data-paso="3"]', caja);
  let codigo = "";
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const err = $("[data-bo-error]", caja);
    if (String(fd.get("nombre")).trim().length < 2) return (err.textContent = "Escribe tu nombre.");
    if (!/^[0-9 +]{9,}$/.test(String(fd.get("tel")))) return (err.textContent = "Revisa el teléfono.");
    if (!/^\S+@\S+\.\S+$/.test(String(fd.get("email")))) return (err.textContent = "Revisa el email.");
    err.textContent = "";
    codigo = "BO-" + Math.random().toString(36).slice(2, 7).toUpperCase();
    $("[data-bo-ok-txt]", caja).textContent = `${String(fd.get("nombre")).split(" ")[0]}, te esperamos el ${fechaLarga.format(res.fecha!)} a las ${res.hora} (${res.personas} pers.). Te hemos enviado la confirmación a ${fd.get("email")}.`;
    $("[data-bo-ok-codigo]", caja).textContent = `Código de reserva · ${codigo}`;
    irPaso("ok");
  });

  // .ics para el calendario, generado en el navegador
  $("[data-bo-ics]", caja).addEventListener("click", () => {
    const f = res.fecha!;
    const [hh, mm] = res.hora.split(":").map(Number);
    const ini = new Date(f);
    ini.setHours(hh, mm, 0, 0);
    const fin = new Date(ini.getTime() + 2 * 3600_000);
    const fmt = (d: Date) => d.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}/, "");
    const ics = [
      "BEGIN:VCALENDAR",
      "VERSION:2.0",
      "PRODID:-//Brasa y Olivo//Reservas//ES",
      "BEGIN:VEVENT",
      `UID:${codigo}@brasayolivo.example`,
      `DTSTAMP:${fmt(new Date())}`,
      `DTSTART:${fmt(ini)}`,
      `DTEND:${fmt(fin)}`,
      `SUMMARY:Reserva en Brasa & Olivo (${res.personas} pers.)`,
      "LOCATION:C/ de la Mar 14\\, Valencia",
      "END:VEVENT",
      "END:VCALENDAR",
    ].join("\r\n");
    const a = Object.assign(document.createElement("a"), {
      href: URL.createObjectURL(new Blob([ics], { type: "text/calendar" })),
      download: `reserva-${codigo}.ics`,
    });
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
  $("[data-bo-otra]", caja).addEventListener("click", () => {
    form.reset();
    res.fecha = null;
    $$(".bo-fecha", fechas).forEach((x) => x.classList.remove("is-sel"));
    $<HTMLButtonElement>('[data-siguiente="2"]', caja).disabled = true;
    irPaso("1");
  });

  // ── galería con visor ─────
  const visor = $<HTMLDialogElement>("[data-bo-visor]");
  const fotos = $$<HTMLButtonElement>(".bo-foto");
  let actual = 0;
  function verFoto(i: number) {
    actual = (i + fotos.length) % fotos.length;
    const f = fotos[actual].querySelector("img")!;
    const caja = $("[data-bo-visor-foto]", visor);
    const img = caja.querySelector("img")!;
    img.src = f.src;
    img.alt = f.alt;
    caja.querySelector("figcaption")!.textContent = f.alt;
    caja.animate([{ opacity: 0, transform: "scale(0.96)" }, { opacity: 1, transform: "none" }], { duration: 300, easing: "ease-out" });
  }
  fotos.forEach((f, i) =>
    f.addEventListener("click", () => {
      verFoto(i);
      visor.showModal();
    }),
  );
  $("[data-bo-visor-cerrar]", visor).addEventListener("click", () => visor.close());
  visor.addEventListener("click", (e) => e.target === visor && visor.close());
  $$<HTMLButtonElement>("[data-bo-visor-nav]", visor).forEach((b) => b.addEventListener("click", () => verFoto(actual + Number(b.dataset.boVisorNav))));
  visor.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") verFoto(actual + 1);
    if (e.key === "ArrowLeft") verFoto(actual - 1);
  });

  // ── carrusel de reseñas (avanza solo y se para al pasar el ratón) ─────
  const car = $("[data-bo-carrusel]");
  const pista = $(".bo-carrusel__pista", car);
  const n = pista.children.length;
  const puntos = $("[data-bo-puntos]", car);
  let idx = 0;
  for (let i = 0; i < n; i++) {
    const p = el("button");
    p.type = "button";
    p.setAttribute("aria-label", `Reseña ${i + 1}`);
    p.addEventListener("click", () => mover(i));
    puntos.append(p);
  }
  function mover(i: number) {
    idx = (i + n) % n;
    pista.style.transform = `translateX(-${idx * 100}%)`;
    [...puntos.children].forEach((p, j) => p.classList.toggle("is-on", j === idx));
  }
  $$<HTMLButtonElement>("[data-bo-car]", car).forEach((b) => b.addEventListener("click", () => mover(idx + Number(b.dataset.boCar))));
  let auto = setInterval(() => mover(idx + 1), 5000);
  car.addEventListener("pointerenter", () => clearInterval(auto));
  car.addEventListener("pointerleave", () => (auto = setInterval(() => mover(idx + 1), 5000)));
  mover(0);

  // ── FAQ: cada respuesta se despliega y se recoge animando la altura ─────
  $$<HTMLDetailsElement>(".bo-faq details").forEach((d) => {
    const sum = d.querySelector("summary")!;
    const resp = d.querySelector("p")!;
    let anim: Animation | null = null;
    sum.addEventListener("click", (e) => {
      e.preventDefault();
      const abrir = !d.classList.contains("is-abierto");
      d.classList.toggle("is-abierto", abrir);
      if (sinMovimiento()) return (d.open = abrir);
      const ini = d.offsetHeight;
      anim?.cancel();
      d.open = true;
      const fin = abrir ? d.offsetHeight : sum.offsetHeight + (d.offsetHeight - d.clientHeight);
      d.style.overflow = "hidden";
      anim = d.animate({ height: [`${ini}px`, `${fin}px`] }, { duration: 420, easing: "cubic-bezier(0.22, 1, 0.36, 1)" });
      resp.animate(abrir ? { opacity: [0, 1], transform: ["translateY(-6px)", "none"] } : { opacity: [1, 0] }, { duration: abrir ? 420 : 220, easing: "ease-out" });
      anim.onfinish = () => {
        anim = null;
        d.open = abrir;
        d.style.overflow = "";
      };
    });
  });

  // ── aparición al hacer scroll ─────
  const io = new IntersectionObserver(
    (es) =>
      es.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-visto");
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.12 },
  );
  $$(".bo-sec").forEach((s) => io.observe(s));
</script>

<style is:global>
  .bo {
    --c: #c2410c;
    --c2: #7c2d12;
    --crema: #faf3e8;
    --crema2: #f3e7d3;
    --tinta: #241a12;
    --gris: #6f6256;
    --linea: #e6d8c3;
    --verde: #4d7c0f;
    --r: 22px;
    /* lo que tarda la animación de apertura: la portada entra justo después */
    --intro: 2.1s;
    background: var(--crema);
    color: var(--tinta);
    font-family: "Inter", system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.55;
  }

  .bo h1,
  .bo h2,
  .bo h3 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }

  .bo-wrap {
    width: min(100% - 2.5rem, 76rem);
    margin-inline: auto;
  }

  .bo-muted {
    color: var(--gris);
  }

  .bo-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.9rem;
    color: var(--c);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.85rem 1.4rem;
    border: 1.5px solid var(--c);
    border-radius: 999px;
    background: var(--c);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s, background 0.2s, color 0.2s, box-shadow 0.2s;
  }

  .bo-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -10px var(--c);
  }

  .bo-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .bo-btn--linea {
    background: transparent;
    color: var(--c);
  }

  .bo-btn--sm {
    padding: 0.6rem 1.1rem;
    font-size: 0.9rem;
  }

  .bo-btn--full {
    width: 100%;
  }

  /* animación de apertura */
  .bo-intro {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: grid;
    place-items: center;
    background: radial-gradient(60% 60% at 50% 55%, #43200c, var(--tinta) 72%);
    color: var(--crema);
    cursor: pointer;
    animation: bo-intro-sale 0.9s 1.9s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }

  .bo-intro.is-salta {
    animation: bo-intro-sale 0.45s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }

  .bo-intro__centro {
    display: grid;
    justify-items: center;
    gap: 1rem;
    animation: bo-centro-sale 0.6s 1.7s ease-in forwards;
  }

  .bo-intro__logo {
    animation: bo-brillo 1.2s 0.9s ease-in-out;
  }

  .bo-intro__logo :is(circle, path) {
    fill: transparent;
    stroke: #f97316;
    stroke-width: 1.1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: bo-trazo 1s 0.15s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .bo-intro__logo path {
    animation:
      bo-trazo 0.9s 0.35s cubic-bezier(0.65, 0, 0.35, 1) forwards,
      bo-relleno 0.4s 1.05s forwards;
  }

  .bo-intro__nombre {
    display: flex;
    gap: 0.35em;
    overflow: hidden;
    padding-bottom: 0.1em;
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(2.3rem, 1.5rem + 4vw, 3.8rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .bo-intro__nombre > * {
    display: inline-block;
    animation: bo-letra 0.8s 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .bo-intro__nombre > :nth-child(2) {
    animation-delay: 0.6s;
    color: #fb923c;
  }

  .bo-intro__nombre > :nth-child(3) {
    animation-delay: 0.7s;
  }

  .bo-intro__sub {
    color: #d8c8b2;
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    animation: bo-sube 0.6s 0.9s both;
  }

  .bo-intro__barra {
    width: 9rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #fb923c, #c2410c);
    transform-origin: left;
    animation: bo-barra 1.5s 0.15s cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  @media (prefers-reduced-motion: no-preference) {
    html:has(.bo-intro) {
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bo-intro {
      display: none;
    }

    .bo {
      --intro: 0s;
    }
  }

  html.bo-sin-scroll {
    overflow: hidden;
  }

  /* barra superior */
  .bo-top {
    background: var(--tinta);
    color: #e9dcc8;
    font-size: 0.82rem;
  }

  .bo-top__in {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: 0.5rem;
  }

  .bo-top__dato {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
    opacity: 0.85;
  }

  .bo-top__dato:first-of-type {
    margin-left: auto;
  }

  /* barra de desplazamiento con los colores de la casa: pista crema y tirador de brasa.
     Chrome ignora ::-webkit-scrollbar si hay scrollbar-color, por eso Firefox va aparte */
  @supports not selector(::-webkit-scrollbar) {
    html:has(.bo) {
      scrollbar-width: thin;
      scrollbar-color: #c2410c #f3e7d3;
    }

    .bo * {
      scrollbar-width: thin;
      scrollbar-color: #d6b48f transparent;
    }
  }

  html:has(.bo)::-webkit-scrollbar {
    width: 14px;
  }

  html:has(.bo)::-webkit-scrollbar-track {
    background: #f3e7d3;
    box-shadow: inset 1px 0 0 #e6d8c3;
  }

  html:has(.bo)::-webkit-scrollbar-thumb {
    border: 3px solid transparent;
    border-radius: 999px;
    background: linear-gradient(180deg, #ea580c, #9a3412) padding-box;
  }

  html:has(.bo)::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, #f97316, #c2410c) padding-box;
  }

  html:has(.bo)::-webkit-scrollbar-thumb:active {
    background: #7c2d12 padding-box;
  }

  .bo ::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  .bo ::-webkit-scrollbar-thumb {
    border: 3px solid transparent;
    border-radius: 999px;
    background: #d6b48f padding-box;
  }

  .bo ::-webkit-scrollbar-thumb:hover {
    background: var(--c) padding-box;
  }

  /* cabecera */
  .bo-head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--crema) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .bo-head.is-baja {
    border-color: var(--linea);
    box-shadow: 0 8px 30px -20px rgb(0 0 0 / 0.3);
  }

  .bo-head__in {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4.5rem;
  }

  .bo-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: "Fraunces", serif;
    font-size: 1.4rem;
    font-weight: 700;
    text-decoration: none;
  }

  .bo-logo em {
    color: var(--c);
    font-style: italic;
  }

  .bo-nav {
    display: flex;
    gap: 1.6rem;
    margin-left: auto;
  }

  .bo-nav a {
    position: relative;
    font-weight: 500;
    text-decoration: none;
  }

  .bo-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--c);
    transform: scaleX(0);
    transition: transform 0.3s;
  }

  .bo-nav a:hover::after {
    transform: scaleX(1);
  }

  .bo-burger {
    display: none;
    width: 2.6rem;
    height: 2.6rem;
    border: 0;
    border-radius: 50%;
    background: var(--crema2);
  }

  .bo-burger span {
    display: block;
    width: 18px;
    height: 2px;
    margin: 4px auto;
    background: var(--tinta);
    transition: transform 0.3s;
  }

  /* portada */
  .bo-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 70% at 85% 30%, #f6dcc0 0%, transparent 70%),
      var(--crema);
  }

  .bo-hero__in {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 3rem;
    padding-block: 4.5rem 5rem;
  }

  .bo-hero h1 {
    font-size: clamp(2.6rem, 1.4rem + 4.4vw, 5rem);
  }

  .bo-hero h1 em {
    color: var(--c);
  }

  .bo-hero__txt > p {
    max-width: 32rem;
    margin-top: 1.4rem;
    color: var(--gris);
    font-size: 1.1rem;
  }

  .bo-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .bo-hero__datos {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin-top: 2.6rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--linea);
  }

  .bo-hero__datos dt {
    font-family: "Fraunces", serif;
    font-size: 1.6rem;
    font-weight: 700;
  }

  .bo-hero__datos dt i {
    font-size: 1rem;
    color: #eab308;
  }

  .bo-hero__datos dd {
    color: var(--gris);
    font-size: 0.85rem;
  }

  /* foto de portada con tarjetas flotantes */
  .bo-hero__media {
    position: relative;
    justify-self: center;
    width: min(100%, 30rem);
  }

  .bo-hero__foto {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px 32px 32px;
    overflow: hidden;
    box-shadow: 0 50px 90px -40px rgb(90 35 5 / 0.65);
    animation: bo-revela 1.3s calc(var(--intro) + 0.1s) cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .bo-hero__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: bo-acerca 1.8s calc(var(--intro) + 0.1s) cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .bo-hero__foto::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(36 26 18 / 0.35));
  }

  .bo-flota {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 1rem 0.6rem 0.6rem;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 18px;
    background: rgb(255 252 247 / 0.82);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 20px 40px -20px rgb(60 25 5 / 0.45);
    font-size: 0.85rem;
    text-decoration: none;
    animation: bo-flota-entra 0.8s calc(var(--intro) + var(--d, 0.6s)) cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .bo-flota--plato {
    left: -2.5rem;
    bottom: 3.5rem;
    --d: 0.7s;
    transition: transform 0.25s;
  }

  .bo-flota--plato:hover {
    transform: translateY(-3px);
  }

  .bo-flota--plato img {
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 12px;
    object-fit: cover;
  }

  .bo-flota--plato span {
    display: grid;
    line-height: 1.25;
  }

  .bo-flota small {
    color: var(--c);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .bo-flota strong {
    font-family: "Fraunces", serif;
    font-size: 1.02rem;
  }

  .bo-flota--nota {
    top: 2.5rem;
    right: -1.5rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding: 0.7rem 1rem;
    --d: 0.9s;
  }

  .bo-sello {
    position: absolute;
    top: -1.2rem;
    left: -1.2rem;
    display: grid;
    place-items: center;
    width: 7.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--c);
    color: #fff;
    box-shadow: 0 16px 30px -12px var(--c);
    animation: bo-flota-entra 0.8s calc(var(--intro) + 0.5s) cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .bo-sello svg {
    position: absolute;
    inset: 0;
    animation: bo-girar 18s linear infinite;
  }

  .bo-sello text {
    fill: currentColor;
    font-family: "Inter", sans-serif;
    font-size: 9.6px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .bo-sello > i {
    font-size: 1.6rem;
  }

  /* entrada escalonada del texto de portada (tras la animación de apertura) */
  .bo-entra {
    animation: bo-sube-intro 0.9s calc(var(--intro) + var(--d) * 0.09s) cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .bo-cinta {
    overflow: hidden;
    padding-block: 0.9rem;
    background: var(--c);
    color: #fff;
    font-family: "Fraunces", serif;
    font-size: 1.2rem;
    font-style: italic;
  }

  .bo-cinta__pista {
    display: flex;
    width: max-content;
    animation: bo-cinta 40s linear infinite;
  }

  .bo-cinta__pista span {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    padding-right: 1.2rem;
    white-space: nowrap;
  }

  .bo-cinta__pista i {
    font-size: 0.8rem;
    opacity: 0.7;
  }

  /* secciones */
  .bo-sec {
    padding-block: 5.5rem;
  }

  .bo-sec h2 {
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.2rem);
  }

  .bo-sec__head {
    margin-bottom: 2.5rem;
  }

  .bo-sec > .bo-wrap {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bo-sec.is-visto > .bo-wrap {
    opacity: 1;
    transform: none;
  }

  /* menú del día */
  .bo-dia {
    background: var(--crema2);
  }

  .bo-dia__in {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .bo-dia h2 strong {
    color: var(--c);
  }

  .bo-dias {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.6rem;
  }

  .bo-dias button {
    display: grid;
    min-width: 3.6rem;
    padding: 0.55rem 0.7rem;
    border: 1.5px solid var(--linea);
    border-radius: 14px;
    background: var(--crema);
    font-weight: 600;
    transition: all 0.2s;
  }

  .bo-dias button small {
    color: var(--c);
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .bo-dias button[aria-selected="true"] {
    border-color: var(--tinta);
    background: var(--tinta);
    color: var(--crema);
  }

  .bo-dia__platos {
    display: grid;
    gap: 0.8rem;
  }

  .bo-dia__platos li {
    display: grid;
    gap: 0.2rem;
    padding: 1.2rem 1.4rem;
    border-radius: var(--r);
    background: var(--crema);
    border: 1px solid var(--linea);
    animation: bo-sube 0.5s calc(var(--i) * 0.08s) both;
  }

  .bo-dia__n {
    color: var(--c);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .bo-dia__platos strong {
    font-family: "Fraunces", serif;
    font-size: 1.25rem;
    font-weight: 600;
  }

  /* carta */
  .bo-carta {
    display: grid;
    grid-template-columns: 20rem 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  /* panel de filtros: cabecera oscura de brasa y, debajo, los filtros en rejilla a todo el ancho */
  .bo-filtros {
    position: sticky;
    top: 6rem;
    display: grid;
    border: 1px solid var(--linea);
    border-radius: 26px;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 34px 70px -44px rgb(80 40 10 / 0.6);
  }

  .bo-filtros__top {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 1.3rem 1.2rem 1.2rem;
    background:
      radial-gradient(90% 120% at 100% 0%, rgb(234 88 12 / 0.45), transparent 60%),
      linear-gradient(160deg, #3b1d0c, var(--tinta) 70%);
    color: var(--crema);
    overflow: hidden;
  }

  /* brasa que respira en la esquina */
  .bo-filtros__top::after {
    content: "";
    position: absolute;
    top: -2.5rem;
    right: -2rem;
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(251 146 60 / 0.55), transparent 70%);
    filter: blur(6px);
    animation: bo-respira 4s ease-in-out infinite;
    pointer-events: none;
  }

  .bo-filtros__cab {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 2rem;
  }

  .bo-filtros__titulo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .bo-filtros__titulo i {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 10px;
    background: linear-gradient(145deg, #f97316, var(--c));
    color: #fff;
    font-size: 0.85rem;
    box-shadow: 0 8px 18px -8px #f97316;
  }

  .bo-filtros__titulo em {
    display: inline-grid;
    place-items: center;
    min-width: 1.35rem;
    height: 1.35rem;
    padding-inline: 0.35rem;
    border-radius: 999px;
    background: var(--c);
    color: #fff;
    font: 700 0.7rem/1 "Inter", system-ui, sans-serif;
    font-style: normal;
    animation: bo-pop 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .bo-filtros__titulo em[hidden] {
    display: none;
  }

  .bo-buscar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    height: 3.2rem;
    padding: 0 0.4rem 0 1rem;
    border: 1.5px solid rgb(255 255 255 / 0.14);
    border-radius: 14px;
    background: rgb(255 255 255 / 0.08);
    color: #d8c8b2;
    transition:
      border-color 0.2s,
      background 0.2s,
      box-shadow 0.2s,
      color 0.2s;
  }

  .bo-buscar:hover {
    border-color: rgb(255 255 255 / 0.3);
  }

  .bo-buscar:focus-within {
    border-color: #fb923c;
    background: #fff;
    color: var(--c);
    box-shadow: 0 0 0 4px rgb(251 146 60 / 0.25);
  }

  .bo-buscar input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: none;
    color: var(--crema);
    font-size: 0.95rem;
    outline: none;
  }

  .bo-buscar:focus-within input {
    color: var(--tinta);
  }

  .bo-buscar input::placeholder {
    color: #a8977f;
  }

  .bo-buscar input::-webkit-search-cancel-button {
    display: none;
    appearance: none;
  }

  .bo-buscar__x {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 0;
    border-radius: 10px;
    background: var(--crema2);
    color: var(--tinta);
    font-size: 0.85rem;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .bo-buscar__x:hover {
    background: var(--c);
    color: #fff;
  }

  .bo-buscar__x[hidden] {
    display: none;
  }

  .bo-filtro {
    display: grid;
    gap: 0.75rem;
    padding: 1.15rem 1.2rem 1.25rem;
  }

  .bo-filtro + .bo-filtro {
    border-top: 1px dashed var(--linea);
  }

  .bo-filtro__t {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--tinta);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .bo-filtro__t small {
    color: #a8977f;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0;
    text-align: right;
    text-transform: none;
  }

  /* dos columnas iguales: cada filtro ocupa media fila y el panel queda a su medida */
  .bo-chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .bo-chips button {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.6rem;
    border: 1.5px solid var(--linea);
    border-radius: 13px;
    background: var(--crema);
    color: var(--tinta);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.15;
    text-align: left;
    transition:
      border-color 0.2s,
      background 0.2s,
      color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }

  .bo-chips button i {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 8px;
    background: #fff;
    color: var(--c);
    font-size: 0.75rem;
    box-shadow: 0 2px 6px -3px rgb(80 40 10 / 0.35);
    transition:
      color 0.2s,
      background 0.2s,
      transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .bo-chips button:hover {
    border-color: #f0b98c;
    background: #fff7ef;
    transform: translateY(-2px);
    box-shadow: 0 10px 18px -14px var(--c);
  }

  .bo-chips button:hover i {
    transform: rotate(-10deg) scale(1.08);
  }

  .bo-chips button:active {
    transform: scale(0.96);
  }

  .bo-chips button[aria-pressed="true"] {
    border-color: var(--c);
    background: linear-gradient(145deg, #ea580c, var(--c2));
    color: #fff;
    box-shadow: 0 12px 22px -12px var(--c);
  }

  .bo-chips button[aria-pressed="true"] i {
    background: rgb(255 255 255 / 0.18);
    color: #fff;
    box-shadow: none;
  }

  /* marca ✓ en la esquina de un filtro activo */
  .bo-chips button[aria-pressed="true"]::after {
    content: "✓";
    position: absolute;
    top: -0.4rem;
    right: -0.4rem;
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--tinta);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 800;
    animation: bo-pop 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  /* un alérgeno marcado se lee «sin …»: oscuro y con una barra sobre el icono */
  [data-bo-alergenos] button[aria-pressed="true"] {
    border-color: var(--tinta);
    background: linear-gradient(145deg, #3b1d0c, var(--tinta));
    box-shadow: 0 12px 22px -12px var(--tinta);
  }

  [data-bo-alergenos] button[aria-pressed="true"]::after {
    content: "✕";
    background: var(--c);
  }

  [data-bo-alergenos] button i {
    position: relative;
  }

  [data-bo-alergenos] button[aria-pressed="true"] i::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.15em;
    height: 1.5px;
    border-radius: 2px;
    background: #fb923c;
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .bo-limpiar {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    color: #fed7aa;
    font-size: 0.78rem;
    font-weight: 700;
    transition:
      background 0.2s,
      color 0.2s;
    animation: bo-sube 0.25s ease-out;
  }

  .bo-limpiar:hover {
    background: #fff;
    color: var(--c);
  }

  .bo-limpiar[hidden] {
    display: none;
  }

  .bo-tabs {
    display: flex;
    gap: 0.25rem;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    padding: 0.3rem;
    border: 1px solid var(--linea);
    border-radius: 999px;
    background: #fff;
    scrollbar-width: none;
  }

  .bo-tabs button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-weight: 600;
    white-space: nowrap;
    color: var(--gris);
    transition: all 0.2s;
  }

  .bo-tabs button:hover {
    color: var(--tinta);
  }

  .bo-tabs button[aria-selected="true"] {
    background: var(--tinta);
    color: var(--crema);
  }

  .bo-cuenta {
    margin: 1rem 0 0.5rem;
    color: var(--gris);
    font-size: 0.85rem;
  }

  .bo-platos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    gap: 1.1rem;
  }

  .bo-platos > li {
    display: flex;
    animation: bo-sube 0.5s calc(var(--i) * 0.04s) both;
  }

  .bo-plato-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0;
    border: 1px solid var(--linea);
    border-radius: var(--r);
    background: #fff;
    text-align: left;
    overflow: hidden;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s,
      border-color 0.35s;
  }

  .bo-plato-item:hover,
  .bo-plato-item:focus-visible {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--c) 35%, var(--linea));
    box-shadow: 0 28px 50px -30px rgb(80 40 10 / 0.55);
  }

  .bo-plato-item:focus-visible {
    outline: 2px solid var(--c);
    outline-offset: 3px;
  }

  .bo-plato-item__img {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--crema2);
  }

  .bo-plato-item__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bo-plato-item:hover .bo-plato-item__img img {
    transform: scale(1.07);
  }

  .bo-precio {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: rgb(255 252 247 / 0.9);
    backdrop-filter: blur(8px);
    color: var(--tinta);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.4);
  }

  .bo-plato-item__chef {
    position: absolute;
    left: 0.7rem;
    top: 0.7rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    background: var(--c);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .bo-plato-item__cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.15rem 1.1rem;
  }

  .bo-plato-item__cuerpo strong {
    font-family: "Fraunces", serif;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .bo-plato-item__cuerpo p {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--gris);
    font-size: 0.88rem;
  }

  .bo-plato-item__ver {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.4rem;
    color: var(--c);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .bo-plato-item__ver i {
    transition: transform 0.25s;
  }

  .bo-plato-item:hover .bo-plato-item__ver i {
    transform: translateX(4px);
  }

  /* ficha de plato */
  .bo-ficha {
    width: min(100vw - 2rem, 60rem);
    max-height: min(100dvh - 2rem, 42rem);
    padding: 0;
    border: 0;
    border-radius: 30px;
    background: var(--crema);
    color: var(--tinta);
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06),
      0 60px 120px -30px rgb(0 0 0 / 0.65);
  }

  .bo-ficha[open] {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    animation: bo-ficha-entra 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bo-ficha[open].is-cierra {
    animation: bo-ficha-sale 0.3s cubic-bezier(0.5, 0, 0.75, 0) forwards;
    pointer-events: none;
  }

  .bo-ficha::backdrop {
    background: rgb(20 12 6 / 0.72);
    backdrop-filter: blur(10px);
  }

  .bo-ficha[open]::backdrop {
    animation: bo-fondo-entra 0.4s ease-out;
  }

  .bo-ficha.is-cierra::backdrop {
    animation: bo-fondo-sale 0.3s ease-in forwards;
  }

  .bo-ficha__x {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 252 247 / 0.9);
    backdrop-filter: blur(8px);
    box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.4);
    transition: transform 0.25s;
  }

  .bo-ficha__x:hover {
    transform: rotate(90deg);
  }

  .bo-ficha__foto {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    background: var(--crema2);
  }

  .bo-ficha__foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bo-ficha[open] .bo-ficha__foto img {
    animation: bo-acerca 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* degradado para que la foto funda con la ficha y las etiquetas se lean */
  .bo-ficha__foto::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(20 12 6 / 0.35), transparent 28%),
      linear-gradient(0deg, rgb(20 12 6 / 0.45), transparent 35%);
    pointer-events: none;
  }

  .bo-ficha__chef {
    position: absolute;
    left: 1.1rem;
    top: 1.1rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: rgb(255 252 247 / 0.92);
    backdrop-filter: blur(8px);
    color: var(--c);
    font-size: 0.78rem;
    font-weight: 700;
    box-shadow: 0 8px 20px -10px rgb(0 0 0 / 0.5);
  }

  .bo-ficha__chef[hidden] {
    display: none;
  }

  .bo-ficha__cuerpo {
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
    padding: 2.4rem 2.2rem 1.6rem;
    overflow-y: auto;
    background:
      radial-gradient(120% 60% at 100% 0%, rgb(251 146 60 / 0.1), transparent 60%),
      var(--crema);
  }

  /* el contenido entra escalonado al abrir */
  .bo-ficha[open] .bo-ficha__cuerpo > * {
    animation: bo-sube 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .bo-ficha[open] .bo-ficha__cuerpo > :nth-child(2) {
    animation-delay: 0.05s;
  }

  .bo-ficha[open] .bo-ficha__cuerpo > :nth-child(3) {
    animation-delay: 0.1s;
  }

  .bo-ficha[open] .bo-ficha__cuerpo > :nth-child(4) {
    animation-delay: 0.14s;
  }

  .bo-ficha[open] .bo-ficha__cuerpo > :nth-child(n + 5) {
    animation-delay: 0.18s;
  }

  .bo-ficha__cuerpo .bo-kicker {
    margin-bottom: 0;
  }

  .bo-ficha__titulo {
    display: grid;
    gap: 0.5rem;
    padding-right: 2.6rem;
  }

  .bo-ficha__titulo h3 {
    font-size: clamp(1.7rem, 1.2rem + 1.5vw, 2.4rem);
  }

  .bo-ficha__precio {
    justify-self: start;
    color: var(--c);
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.6rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .bo-ficha__info {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: #fff1e6;
    color: var(--c2);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .bo-ficha__info[hidden] {
    display: none;
  }

  .bo-ficha__larga {
    padding-left: 1rem;
    border-left: 3px solid #f6c9a4;
    color: var(--gris);
    font-size: 1rem;
    line-height: 1.65;
  }

  .bo-ficha__bloques {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
  }

  .bo-ficha__bloque {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 1rem 1.05rem;
    border: 1px solid var(--linea);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 14px 30px -26px rgb(80 40 10 / 0.6);
  }

  .bo-ficha__lbl {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gris);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .bo-ficha__lbl i {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 8px;
    background: #fff1e6;
    color: var(--c);
    font-size: 0.75rem;
  }

  .bo-ficha__bloque strong {
    font-family: "Fraunces", serif;
    font-size: 1.1rem;
  }

  .bo-ficha__al {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .bo-ficha__al li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--crema2);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .bo-ficha__al li.is-ninguno {
    background: #ecfccb;
    color: var(--verde);
  }

  .bo-ficha__pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.1rem;
    border-top: 1px solid var(--linea);
  }

  .bo-ficha__nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--gris);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .bo-ficha__nav button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1.5px solid var(--linea);
    border-radius: 50%;
    background: #fff;
    transition:
      border-color 0.2s,
      background 0.2s,
      color 0.2s,
      transform 0.2s;
  }

  .bo-ficha__nav button:hover:not(:disabled) {
    border-color: var(--c);
    background: var(--c);
    color: #fff;
    transform: scale(1.06);
  }

  .bo-ficha__nav button:disabled {
    opacity: 0.4;
  }

  .bo-plato-item__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .bo-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: #ecfccb;
    color: var(--verde);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .bo-tag--picante {
    background: #fee2e2;
    color: #b91c1c;
  }

  .bo-tag--chef {
    background: #ffedd5;
    color: var(--c);
  }

  .bo-al {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--crema2);
    color: var(--gris);
    font-size: 0.7rem;
  }

  .bo-vacio {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    padding: 3rem;
    border: 2px dashed var(--linea);
    border-radius: var(--r);
    color: var(--gris);
    text-align: center;
  }

  .bo-vacio[hidden] {
    display: none;
  }

  .bo-vacio i {
    font-size: 1.8rem;
    color: var(--c);
  }

  /* reserva */
  .bo-reserva {
    background:
      radial-gradient(50% 80% at 0% 100%, color-mix(in srgb, var(--c) 35%, transparent), transparent 70%),
      var(--tinta);
    color: var(--crema);
  }

  .bo-reserva__in {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 4rem;
    align-items: center;
  }

  .bo-reserva__txt p {
    margin-top: 1rem;
    color: #d8c8b2;
  }

  .bo-reserva__ventajas {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.8rem;
  }

  .bo-reserva__ventajas i {
    color: #fb923c;
    margin-right: 0.4rem;
  }

  .bo-res {
    padding: 2rem;
    border-radius: 24px;
    background: var(--crema);
    color: var(--tinta);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
  }

  .bo-res__pasos {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1.6rem;
  }

  .bo-res__pasos li {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.7rem;
    border-bottom: 3px solid var(--linea);
    color: var(--gris);
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.3s;
  }

  .bo-res__pasos span {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--crema2);
    font-size: 0.75rem;
  }

  .bo-res__pasos li.is-on {
    border-color: var(--c);
    color: var(--tinta);
  }

  .bo-res__pasos li.is-on span {
    background: var(--c);
    color: #fff;
  }

  .bo-res__pasos li.is-hecho span {
    background: var(--verde);
  }

  .bo-res__paso {
    display: grid;
    gap: 1rem;
    animation: bo-sube 0.4s both;
  }

  .bo-res__paso[hidden] {
    display: none;
  }

  .bo-res__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .bo-res__lbl {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .bo-stepper {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .bo-stepper button {
    width: 2.4rem;
    height: 2.4rem;
    border: 1.5px solid var(--linea);
    border-radius: 50%;
    background: #fff;
  }

  .bo-stepper output {
    min-width: 1.5rem;
    font-family: "Fraunces", serif;
    font-size: 1.5rem;
    font-weight: 700;
    text-align: center;
  }

  .bo-fechas {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .bo-fecha {
    display: grid;
    justify-items: center;
    padding: 0.5rem 0.2rem;
    border: 1.5px solid var(--linea);
    border-radius: 12px;
    background: #fff;
    transition: all 0.2s;
  }

  .bo-fecha small {
    font-size: 0.65rem;
    color: var(--gris);
    text-transform: capitalize;
  }

  .bo-fecha strong {
    font-size: 1.15rem;
  }

  .bo-fecha:hover:not(:disabled) {
    border-color: var(--c);
  }

  .bo-fecha:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .bo-fecha.is-sel {
    border-color: var(--c);
    background: var(--c);
    color: #fff;
  }

  .bo-fecha.is-sel small {
    color: #ffe4cc;
  }

  .bo-res__resumen {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border-radius: 12px;
    background: var(--crema2);
    font-weight: 600;
    text-transform: capitalize;
  }

  .bo-turno {
    display: grid;
    gap: 0.5rem;
  }

  .bo-horas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .bo-hora {
    padding: 0.45rem 0.85rem;
    border: 1.5px solid var(--linea);
    border-radius: 10px;
    background: #fff;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .bo-hora:disabled {
    text-decoration: line-through;
    opacity: 0.4;
    cursor: not-allowed;
  }

  .bo-hora.is-sel {
    border-color: var(--c);
    background: var(--c);
    color: #fff;
  }

  .bo-res__nav {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .bo-campos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }

  .bo-campos label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .bo-campos__ancho {
    grid-column: 1 / -1;
  }

  .bo-campos input,
  .bo-campos select,
  .bo-campos textarea {
    padding: 0.7rem 0.85rem;
    border: 1.5px solid var(--linea);
    border-radius: 10px;
    background: #fff;
    font-weight: 400;
    outline: none;
  }

  .bo-campos :is(input, select, textarea):focus {
    border-color: var(--c);
  }

  /* «Prefiero terraza»: tarjeta con interruptor; el checkbox real queda oculto pero enfocable */
  .bo-check {
    position: relative;
    display: flex !important;
    align-items: center;
    gap: 0.85rem !important;
    grid-column: 1 / -1;
    padding: 0.75rem 0.95rem;
    border: 1.5px solid var(--linea);
    border-radius: 16px;
    background: #fff;
    cursor: pointer;
    user-select: none;
    transition:
      border-color 0.25s,
      background 0.25s,
      box-shadow 0.25s;
  }

  .bo-check:hover {
    border-color: #d9bfa0;
  }

  .bo-check input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .bo-check__ico {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 12px;
    background: var(--crema2);
    color: var(--c);
    transition:
      background 0.25s,
      color 0.25s,
      transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .bo-check__txt {
    display: grid;
    flex: 1;
    line-height: 1.3;
  }

  .bo-check__txt strong {
    font-size: 0.92rem;
    font-weight: 600;
  }

  .bo-check__txt small {
    color: var(--gris);
    font-size: 0.78rem;
    font-weight: 400;
  }

  .bo-check__sw {
