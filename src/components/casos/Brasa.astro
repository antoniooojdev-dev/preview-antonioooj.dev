// Caso «Brasa & Olivo» (restaurante, marca ficticia): carta con filtros por categoría,
// etiquetas y alérgenos, menú del día según el día de la semana, reserva en 3 pasos con
// huecos por hora, horario con el día de hoy marcado, reseñas, galería con visor y FAQ.
// Cada plato tiene foto (public/casos/brasa/) y ficha de detalle al pulsarlo; la web
// arranca con una animación de entrada.

interface Plato {
  n: string;
  d: string;
  p: number;
  cat: string;
  /** foto en /casos/brasa/<img>.jpg */
  img: string;
  /** texto largo de la ficha */
  larga: string;
  /** maridaje recomendado */
  vino: string;
  /** ración, tiempo… */
  info?: string;
  tags?: ("vegano" | "vegetariano" | "picante" | "chef")[];
  al?: ("gluten" | "lacteos" | "huevo" | "frutos" | "pescado" | "marisco")[];
}

const FOTOS = "/casos/brasa";

