---
import ThemeToggle from "./ThemeToggle.astro";
// solo el monograma «AJ», recortado de logo-mask.png (transparente): se pinta con el color
// del texto, así se ve igual de nítido en los dos temas y sobre lo que pase por debajo
import logoAJ from "@/assets/logo-aj.png";
import { nav, site } from "@/data/site";
import { IDIOMAS } from "@/i18n/dict";
---

<header class="header">
  <div class="container inner">
    <a href="/" class="brand" aria-label={`${site.name}, ir al inicio`}>
      <span class="mark" style={`--logo-aj:url("${logoAJ.src}")`} aria-hidden="true"></span>
      <span class="word">{site.name}</span>
    </a>

    <nav id="main-nav" aria-label="Principal">
      <ul role="list" class="links">
        {
          nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <!-- idioma (src/scripts/i18n.ts) -->
      <div class="lang" data-lang>
        <button type="button" class="lang__btn" aria-haspopup="menu" aria-expanded="false" aria-label="Idioma" title="Idioma">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"></path>
          </svg>
          <span data-lang-actual data-no-i18n>ES</span>
        </button>
        <ul class="lang__menu" role="menu" hidden data-no-i18n>
          {
            IDIOMAS.map((i) => (
              <li role="none">
                <button type="button" role="menuitemradio" aria-checked="false" data-lang-set={i.id}>
                  <b>{i.corto}</b>
                  {i.nombre}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
      <ThemeToggle />
      <!-- Sin sesión, Chat y Contactar pasan por /login; con sesión van directos (ver script) -->
      <a href="/admin" class="btn btn-ghost cta hd-admin" hidden>Admin</a>
      <a href="/login?volver=/chat" class="btn btn-ghost cta" data-con-sesion="/chat">Chat</a>
      <a href="/login?volver=/contacto" class="btn btn-primary cta" data-con-sesion="/contacto">Contactar</a>
      <a href="/cuenta" class="hd-account" hidden aria-label="Mi cuenta" title="Mi cuenta"></a>
      <button class="menu-btn" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="Abrir menú">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  import { avatarEl, copiaLocal, quienSoy, type Yo } from "@/scripts/sesion";
  import { idiomaActual } from "@/scripts/i18n";
  import { cambiarConCortina } from "@/scripts/cortina-idioma";
  import type { Idioma } from "@/i18n/dict";

  // ── idioma ──
  const lang = document.querySelector<HTMLElement>("[data-lang]");
  const langBtn = lang?.querySelector<HTMLButtonElement>(".lang__btn");
  const langMenu = lang?.querySelector<HTMLElement>(".lang__menu");

  function pintarIdioma() {
    const id = idiomaActual();
    const actual = lang?.querySelector("[data-lang-actual]");
    if (actual) actual.textContent = id.toUpperCase();
    lang?.querySelectorAll<HTMLElement>("[data-lang-set]").forEach((b) => b.setAttribute("aria-checked", String(b.dataset.langSet === id)));
  }

  function abrirIdioma(abrir: boolean) {
    if (!langMenu || !langBtn) return;
    langMenu.hidden = !abrir;
    langBtn.setAttribute("aria-expanded", String(abrir));
  }

  pintarIdioma();
  // el botón (ES/EN/PT) cambia mientras la cortina tapa la página
  window.addEventListener("aj:idioma", pintarIdioma);
  langBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    abrirIdioma(!!langMenu?.hidden);
  });
  lang?.querySelectorAll<HTMLElement>("[data-lang-set]").forEach((b) =>
    b.addEventListener("click", async () => {
      abrirIdioma(false);
      // con la cortina de la entrada: el idioma cambia por debajo y se vuelve arriba del todo
      await cambiarConCortina(b.dataset.langSet as Idioma);
      langBtn?.focus({ preventScroll: true });
    }),
  );
  document.addEventListener("click", (e) => !lang?.contains(e.target as Node) && abrirIdioma(false));
  document.addEventListener("keydown", (e) => e.key === "Escape" && abrirIdioma(false));

  const header = document.querySelector<HTMLElement>(".header");
  const btn = header?.querySelector<HTMLButtonElement>(".menu-btn");

  function setOpen(open: boolean) {
    if (!header || !btn) return;
    header.toggleAttribute("data-open", open);
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  }

  btn?.addEventListener("click", () => setOpen(!header?.hasAttribute("data-open")));
  // al tocar fuera del menú abierto, se cierra
  document.addEventListener("click", (e) => {
    if (header?.hasAttribute("data-open") && !header.contains(e.target as Node)) setOpen(false);
  });

  // ── botones de arriba a la derecha: un «pulso» al tocarlos (sobre todo para el móvil) ──
  header?.querySelectorAll<HTMLElement>(".actions > button, .actions > a, .lang__btn").forEach((b) =>
    b.addEventListener("pointerdown", () => {
      b.classList.remove("is-toque");
      void b.offsetWidth; // reinicia la animación si se pulsa seguido
      b.classList.add("is-toque");
    }),
  );
  header?.addEventListener("animationend", (e) => (e.target as HTMLElement).classList.remove("is-toque"));
  header?.querySelectorAll("nav a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false));

  // ── sesión de Discord ──
  const cuenta = header?.querySelector<HTMLAnchorElement>(".hd-account");
  const admin = header?.querySelector<HTMLAnchorElement>(".hd-admin");
  const protegidos = header ? Array.from(header.querySelectorAll<HTMLAnchorElement>("[data-con-sesion]")) : [];

  function pintarSesion(yo: Yo | null) {
    for (const a of protegidos) {
      const destino = a.dataset.conSesion!;
      a.href = yo ? destino : `/login?volver=${destino}`;
    }
    if (admin) admin.hidden = !yo?.admin;
    if (cuenta) {
      cuenta.hidden = !yo;
      cuenta.replaceChildren(...(yo ? [avatarEl(yo.avatar, yo.nombre, "hd-account__avatar")] : []));
      if (yo) cuenta.title = `${yo.nombre} · Mi cuenta`;
    }
  }

  pintarSesion(copiaLocal());
  quienSoy()
    .then(pintarSesion)
    // Sin API no hay login posible: los botones van directos para no dejar a nadie sin contacto
    .catch(() => protegidos.forEach((a) => (a.href = a.dataset.conSesion!)));
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* en las transiciones entre páginas la cabecera se queda quieta y solo se mueve el contenido */
    view-transition-name: cabecera;
    height: var(--header-h);
    /* bastante opaca: en modo claro las bandas negras que pasan por debajo la ensuciaban */
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    transition:
      background-color 0.5s var(--ease),
      border-color 0.5s var(--ease);
    border-bottom: 1px solid var(--border);
  }

  .inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .word {
    font-stretch: 125%;
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.03em;
  }

  .mark {
    display: block;
    width: 30px;
    height: 34px;
    background: var(--fg);
    -webkit-mask: var(--logo-aj) center / contain no-repeat;
    mask: var(--logo-aj) center / contain no-repeat;
    transition:
      background-color 0.5s var(--ease),
      transform 0.5s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .brand:hover .mark {
    transform: rotate(-6deg) scale(1.08);
  }

  .links {
    display: flex;
    gap: var(--space-5);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .brand,
  .links a {
    white-space: nowrap;
  }

  .links a {
    position: relative;
    padding-block: 0.3rem;
    color: var(--fg-muted);
    transition: color var(--dur) var(--ease);
  }

  /* subrayado de señal que entra de izquierda a derecha */
  .links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .links a:hover {
    color: var(--fg);
  }

  .links a:hover::after {
    transform: scaleX(1);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .cta {
    padding: 0.5rem 0.9rem;
  }

  .actions [hidden] {
    display: none;
  }

  /* ── al tocar los botones: se hunden un poco, rebotan y sueltan un aro ── */
  .lang__btn,
  .menu-btn,
  .hd-account,
  .actions :global(.theme-toggle) {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .lang__btn,
  .menu-btn,
  .actions :global(.theme-toggle) {
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform 0.5s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .lang__btn:active,
  .menu-btn:active,
  .actions :global(.theme-toggle:active) {
    transform: scale(0.86);
    transition-duration: 0.12s;
  }

  .actions :global(.is-toque) {
    animation: toque 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @keyframes toque {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--fg) 30%, transparent);
    }
    to {
      box-shadow: 0 0 0 10px color-mix(in srgb, var(--fg) 0%, transparent);
    }
  }

  /* ── idioma ── */
  .lang {
    position: relative;
  }

  .lang__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 2.25rem;
    padding: 0 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .lang__btn[aria-expanded="true"] {
    color: var(--fg);
    border-color: var(--fg);
  }

  @media (hover: hover) {
    .lang__btn:hover {
      color: var(--fg);
      border-color: var(--fg);
    }
  }

  /* en el móvil, el texto ES/EN/PT nítido como los iconos */
  @media (hover: none) {
    .lang__btn {
      color: var(--fg);
    }
  }

  .lang__menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 60;
    display: grid;
    gap: 2px;
    min-width: 11rem;
    padding: 0.35rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 24px 50px -20px rgb(0 0 0 / 0.35);
    transform-origin: top right;
    animation: lang-in 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lang__menu[hidden] {
    display: none;
  }

  @keyframes lang-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.96);
    }
  }

  .lang__menu button {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.55rem 0.7rem;
    border-radius: 11px;
    font-size: var(--fs-sm);
    text-align: left;
    cursor: pointer;
    transition: background var(--dur) var(--ease);
  }

  .lang__menu button:hover {
    background: var(--bg-code);
  }

  .lang__menu b {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 1.5rem;
    border-radius: 6px;
    background: var(--bg-code);
    font-size: 0.6875rem;
  }

  .lang__menu button[aria-checked="true"] {
    font-weight: 700;
  }

  .lang__menu button[aria-checked="true"] b {
    background: var(--fg);
    color: var(--bg-elev);
  }

  .hd-account {
    display: block;
    border-radius: 50%;
    transition: box-shadow var(--dur) var(--ease);
  }

  .hd-account:hover,
  .hd-account:focus-visible {
    box-shadow: 0 0 0 2px var(--fg);
    outline: none;
  }

  .hd-account :global(.hd-account__avatar) {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-code);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }

  .hd-account :global(.hd-account__avatar img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .menu-btn {
    display: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    place-content: center;
    gap: 5px;
  }

  .menu-btn span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--fg);
    transition: transform 0.45s cubic-bezier(0.3, 1.5, 0.5, 1);
  }

  .header[data-open] .menu-btn span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .header[data-open] .menu-btn span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (max-width: 62rem) {
    .menu-btn {
      display: grid;
    }

    /* el menú baja como una persiana y los enlaces entran uno detrás de otro */
    nav {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: var(--space-4) var(--gutter) var(--space-6);
      visibility: hidden;
      clip-path: inset(0 0 100% 0);
      transition:
        clip-path 0.45s cubic-bezier(0.7, 0, 0.2, 1),
        visibility 0s linear 0.45s;
    }

    .header[data-open] nav {
      visibility: visible;
      clip-path: inset(0 0 0 0);
      transition:
        clip-path 0.55s cubic-bezier(0.16, 1, 0.3, 1),
        visibility 0s;
    }

    .links li {
      opacity: 0;
      transform: translateY(-10px);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    .header[data-open] .links li {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.4s ease,
        transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(0.08s + var(--i) * 0.05s);
    }

    .links {
      flex-direction: column;
      gap: 0;
      font-size: var(--fs-md);
    }

    .links a {
      display: block;
      padding-block: var(--space-3);
      border-bottom: 1px solid var(--border);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    nav,
    .header[data-open] nav,
    .links li,
    .header[data-open] .links li,
    .lang__btn,
    .menu-btn,
    .menu-btn span {
      transition-duration: 0.01s !important;
      transition-delay: 0s !important;
    }

    .actions :global(.is-toque) {
      animation: none;
    }
  }

  @media (max-width: 30rem) {
    .cta {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    .brand > .word {
      display: none;
    }
  }
</style>
