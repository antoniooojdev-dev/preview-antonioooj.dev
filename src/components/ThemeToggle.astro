<button class="theme-toggle" type="button" data-theme-toggle aria-label="Cambiar tema claro/oscuro">
  <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.5v2M12 19.5v2M5.28 5.28l1.42 1.42M17.3 17.3l1.42 1.42M2.5 12h2M19.5 12h2M5.28 18.72l1.42-1.42M17.3 6.7l1.42-1.42"></path>
  </svg>
  <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    color: var(--fg);
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  /* con ratón el icono va atenuado y se enciende al pasar; en el móvil, siempre nítido */
  @media (hover: hover) {
    .theme-toggle {
      color: var(--fg-muted);
    }

    .theme-toggle:hover {
      color: var(--fg);
      border-color: var(--border-strong);
    }
  }

  /* los dos iconos están siempre: el que toca entra girando y el otro sale girando */
  .theme-toggle svg {
    grid-area: 1 / 1;
    transition:
      transform 0.55s cubic-bezier(0.3, 1.4, 0.5, 1),
      opacity 0.3s ease;
  }

  /* claro → se muestra la luna; oscuro → el sol */
  .sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }

  :global(:root[data-theme="dark"]) .sun {
    opacity: 1;
    transform: none;
  }

  :global(:root[data-theme="dark"]) .moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.4);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun {
      opacity: 1;
      transform: none;
    }

    :global(:root:not([data-theme="light"])) .moon {
      opacity: 0;
      transform: rotate(90deg) scale(0.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle svg {
      transition: none;
    }
  }
</style>
