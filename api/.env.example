# ── Chat de antonioooj.dev ─────────────────────────────────────
# Copia este archivo como .env y rellénalo.

# App de Discord (https://discord.com/developers/applications → OAuth2).
# En «Redirects» añade: <PUBLIC_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot de esa misma app (pestaña «Bot» → Reset Token). Muestra tu estado de Discord en
# «Sobre mí». Activa «Presence Intent» y «Server Members Intent» e invítalo a un servidor
# en el que estés. Vacío = solo el modo que elijas a mano.
DISCORD_BOT_TOKEN=

# Spotify: la canción que escuchas, en «Sobre mí» (https://developer.spotify.com/dashboard
# → Create app → Web API). En «Redirect URIs» añade la dirección de SPOTIFY_REDIRECT_URI.
# Spotify no admite «localhost»: en local usa http://127.0.0.1:8002/api/spotify/callback.
# En producción, vacío = <API_URL>/api/spotify/callback. Luego conéctala desde el editor
# de «Ahora mismo» (botón «conectar Spotify»).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Bot para mensajes privados (MD): transcripción de los tickets al cerrarlos (al cliente y
# copia a ti) y aviso cuando cierras sesión en el panel. Puede ser un bot aparte
# (DISCORD_NOTIFY_BOT_TOKEN) o, si lo dejas vacío, se usa DISCORD_BOT_TOKEN.
# Requisitos: el bot tiene que estar en un servidor en el que también estén tus clientes
# (Discord no deja mandar MD a quien no comparte servidor con el bot) y ellos no deben
# tener desactivados los MD de miembros de ese servidor. No necesita intents especiales.
DISCORD_NOTIFY_BOT_TOKEN=

# Dirección de la web (sin barra final). En local, la de `npm run dev`.
PUBLIC_URL=http://localhost:4321

# Tu ID de Discord (varios, separados por comas). Con él ves todas las conversaciones.
ADMIN_DISCORD_IDS=
ADMIN_NAME=Antonio

# Clave para firmar la sesión (mín. 32 caracteres). Si se deja vacía se genera
# una y se guarda en data/.session_secret.
SESSION_SECRET=

# Solo si la API va en otro dominio que la web:
#   API_URL=https://api.antonioooj.dev            (dirección de esta API)
#   ALLOWED_ORIGINS=https://antonioooj.dev        (webs que pueden usarla, separadas por comas)
API_URL=
ALLOWED_ORIGINS=

# Panel /admin (bots de Discord)
#   BOTS_ROOTS: carpetas donde buscar proyectos de bots, separadas por ';'
#               (por defecto, la carpeta que contiene el portfolio)
#   PANEL_KEY:  clave para cifrar los tokens pegados a mano (si se deja vacía se
#               genera una en data/.panel_key; si se pierde, hay que volver a pegarlos)
BOTS_ROOTS=
PANEL_KEY=

# Login de prueba sin Discord (/api/auth/dev). SOLO en local: en producción, 0.
DEMO_LOGIN=0

# Login con Google (opcional). https://console.cloud.google.com/apis/credentials → ID de cliente OAuth (Aplicación web)
# URI de redirección autorizado: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login con GitHub (opcional). https://github.com/settings/developers → New OAuth App
# Authorization callback URL: <PUBLIC_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=