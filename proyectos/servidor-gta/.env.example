# ─────────────────────────────────────────────────────────────
#  Configuración de Nyx Community. NO subir este archivo a ningún sitio.
#  Rellena los valores de TU aplicación y TU bot de Discord
#  (https://discord.com/developers/applications). No reutilices los de ClickSense.
# ─────────────────────────────────────────────────────────────

# Login con Discord (OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Añade esta misma URL en OAuth2 > Redirects de la aplicación de Discord
REDIRECT_URI=http://localhost:8001/auth/discord/callback

# Acceso de demostración (solo desde este PC). 0 en producción.
DEMO_LOGIN=0
DEMO_DISCORD_ID=100000000000000001

# Bot de Discord
DISCORD_BOT_TOKEN=
BOT_INTERNAL_TOKEN=
BOT_INTERNAL_PORT=5005
BOT_INTERNAL_URL=http://127.0.0.1:5005/notify
WEB_INTERNAL_URL=http://127.0.0.1:8001

# Permisos (IDs de Discord separados por comas)
MASTER_ADMIN_ID=
STAFF_DISCORD_IDS=

# Web pública y servidor FiveM
PUBLIC_URL=http://localhost:8001
FIVEM_DYNAMIC_URL=

# Test de whitelist
WHITELIST_SALT=

# Sesión: nombre propio de la cookie (así no se pisa con ClickSense en localhost)
SESSION_COOKIE_NAME=nyx_session
# Clave para firmar la sesión (mínimo 32 caracteres). Si se deja vacía se genera sola
# y se guarda en data/.session_secret. Si la cambias, todos tendrán que volver a entrar.
SESSION_SECRET=
