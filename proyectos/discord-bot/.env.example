# Copia este archivo como .env y rellénalo. NUNCA subas el .env a GitHub.

# Discord Developer Portal → tu aplicación → Bot → Reset Token
DISCORD_TOKEN=

# Discord Developer Portal → General Information → Application ID
CLIENT_ID=

# ID de tu servidor (clic derecho → Copiar ID con el modo desarrollador activado).
# Con GUILD_ID los comandos se registran al instante solo en ese servidor.
GUILD_ID=

# ── Avisos de redes (opcional) ───────────────────────────────
# YouTube: https://www.youtube.com/feeds/videos.xml?channel_id=UCxxxxxxxx
YOUTUBE_FEED=
# Instagram / TikTok no tienen RSS oficial: crea uno en rss.app o RSSHub y pega la URL
INSTAGRAM_FEED=
TIKTOK_FEED=
# Twitch: https://dev.twitch.tv/console → Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_USER=
