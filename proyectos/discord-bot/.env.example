# Copia este archivo como .env y rellénalo. NUNCA subas el .env a GitHub.

# Discord Developer Portal → tu aplicación → Bot → Reset Token
DISCORD_TOKEN=

# Discord Developer Portal → General Information → Application ID
CLIENT_ID=

# ID de tu servidor (clic derecho → Copiar ID con el modo desarrollador activado).
# Con GUILD_ID los comandos se registran al instante solo en ese servidor.
GUILD_ID=
